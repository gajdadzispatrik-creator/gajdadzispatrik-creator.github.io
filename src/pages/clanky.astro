---
/**
 * Stránka /clanky — redakční hub. Zdroj pravdy pro OBSAH, pořadí sekcí a
 * role: úkol „Úkol pro Claude Code — podstránka /clanky" (9. 9. 2026) +
 * `docs/content-subpages.md`, kapitola `/clanky` (NÁVRH K UŽIVATELSKÉMU
 * SCHVÁLENÍ — copy převzata doslovně, dvě výjimky viz níže). Zdroj pravdy
 * pro VŠECHNY hodnoty sdílené kostry (osa, pruh, zářez, vnitřní rozpad,
 * gap, velikost/barva kotev, typografická škála): `src/pages/recenze.astro`
 * — na výslovné přání uživatele, sekundárně `pristup.astro`.
 *
 * BEZ DROBEČKOVÉ NAVIGACE — stejně jako `/pristup`/`/recenze`, stránka
 * první úrovně.
 *
 * TRASA — 1:1 STEJNÁ TECHNIKA JAKO `/recenze` (fixní `data-entry`
 * konstanta, `y=40` pod hlavičkou, `bendY` z paty hero textu, tablet/mobil
 * BEZ trasy v hero). Zadání §8 popisuje „nájezd v mezeře mezi hero a prvním
 * zářezem" se dvěma podmínkami a ilustrativními čísly — STEJNÁ formulace
 * se objevila i v zadáních `/pristup` a `/recenze` a u `/pristup` ji
 * uživatel po nasazení výslovně zamítl („ta linka ma jit uplně stejně jako
 * v podstrankach služby") ve prospěch identické pevné techniky sourozenců.
 * `/recenze` s touto pevnou technikou (bez jakékoli vlastní odchylky) byla
 * dodána a schválena beze změny nájezdu. Tahle stránka nemá (na rozdíl od
 * `/pristup`) žádný prvek, který by s fixní pozicí nájezdu kolidoval —
 * použita je proto STEJNÁ fixní technika, ne vlastní „mezera mezi hero a
 * zářezem" výpočet, v souladu se zadání §1 („kde by se lišily od tohoto
 * dokumentu, platí sourozenci") a s už jednou uděleným rozhodnutím
 * uživatele pro identickou situaci.
 *
 * ŽÁDNÝ ČLÁNEK ZATÍM NEEXISTUJE (ověřeno, viz `docs/content-subpages.md`).
 * `articles` pole je PRÁZDNÉ — to je skutečný stav, ve kterém stránka
 * spouští (zadání §7), proto se vykresluje „prázdný stav" (nadpis +
 * vysvětlující věta + dva odkazy), NE řádky se štítkem
 * „ČLÁNEK — PLACEHOLDER". Per-položkové placeholder vykreslování (§4) je
 * v šabloně PŘIPRAVENÉ pro položky s `title: null` (stejný princip jako
 * `ArticlesSection.astro` na homepage), ale s prázdným polem se nikdy
 * neuplatní — mrtvý, ale funkční a strukturálně úplný kód, ne netestovaná
 * díra. Stejně tak `featured` řádek (větší titulek přes obě kolony) je
 * „vypnutá varianta" — CSS/markup existuje, žádná položka `featured: true`
 * v poli není.
 *
 * NOVÁ COPY (dvě provozní stavy, §7 zadání) — dokument `content-subpages.md`
 * ji NEOBSAHUJE, je označená inline komentářem a musí projít samostatným
 * schválením (viz souhrn úkolu):
 * 1) Prázdný stav (žádný článek) — nadpis, věta, dva odkazy.
 * 2) Stav bez výsledku po výběru tématu — pojistka, filtr je postavený tak,
 *    aby na ni běžný uživatel nenarazil (témata bez článků se do filtru
 *    vůbec nepřidávají — viz `topics.filter(...)` níže).
 *
 * TAXONOMIE — 1:1 převzatá z `docs/content-homepage.md` §10 a živé
 * `ArticlesSection.astro` (homepage), needitovaná, žádná nová kategorie.
 *
 * DATOVÝ MODEL — `Article` interface je `ArticlesSection.astro`'s
 * existující tvar (`category`/`title`/`excerpt`/`href`/`lineWidths`)
 * rozšířený o `publishedAt`/`featured`, přesně podle zadání §4 — NE
 * paralelní systém. Až vznikne content collection, oba tvary (tenhle i
 * `ArticlesSection.astro`'s) by měly čerpat ze stejného zdroje.
 *
 * FILTR TÉMAT — čistě klientský JS toggle viditelnosti (`hidden` atribut
 * podle `data-category`), žádný fetch/navigace/query param. Bez JS by byl
 * mrtvý — ale s prázdným `articles` polem se `<nav>` vůbec nevykresluje
 * (zadání §7: „Filtr témat se v prázdném stavu nezobrazuje"), takže se
 * tahle otázka dnes reálně netýká vydávaného stavu; kód je připravený na
 * budoucí data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LineGradientDefs from '../components/LineGradientDefs.astro';
import { BOOKING_URL } from '../data/entity';
import { articleHref, formatDate, getPublishedArticles } from '../data/articles';
import { czechNbsp } from '../lib/rehype-czech-nbsp.mjs';

interface Article {
  category: string;
  title: string | null;
  excerpt: string | null;
  href: string | null;
  publishedAt: string | null;
  isoDate: string | null;
  featured: boolean;
  titleLineWidth: number;
  excerptLineWidths: number[];
}

// Zveřejněné články z src/content/clanky (5. 10. 2026) — nejnovější první.
// Dokud žádný není, platí prázdný stav (viz hlavičkový komentář výše).
const articles: Article[] = (await getPublishedArticles()).map((a) => ({
  category: czechNbsp(a.data.category),
  title: czechNbsp(a.data.title),
  excerpt: czechNbsp(a.data.description),
  href: articleHref(a),
  publishedAt: formatDate(a.data.publishedAt),
  isoDate: a.data.publishedAt.toISOString().slice(0, 10),
  featured: false,
  titleLineWidth: 0,
  excerptLineWidths: [],
}));

const topics = ['Hypotéky a bydlení', 'Finanční plánování', 'Pojištění', 'Investice', 'Penze'];
// Porovnání bez ohledu na nezlomitelné mezery (v `topics` můžou být, kategorie článku je má prosté).
const plainSpace = (s: string) => s.replace(/ /g, ' ');
const availableTopics = topics.filter((t) => articles.some((a) => plainSpace(a.category) === plainSpace(t)));

const ARTICLES_PAGE_SIZE = 6;
---

<!--
  Zveřejněno 5. 10. 2026 s prvními třemi články: indexovatelné, v sitemap,
  odkaz v menu, patičce a v sekci Články na homepage (dřív `noindex`
  a bez odkazů — úkol „Předspouštěcí P0 technické dotažení“, §3).
-->
<BaseLayout
  title="Články o financích | Patrik Gajdadzis"
  description="Praktické články o hypotékách, finančním plánování, pojištění, investicích a penzi. Píšu je srozumitelně, jako finanční poradce z Ostravy."
>
  <Header />
  <main id="hero" class="cla">
    <div class="cla__route" aria-hidden="true">
      {
        [
          { tier: 'mobile', vb: 390, axis: 24, dotOffset: 22, hero: false, entry: 0, r: 0 },
          // Tablet: nájezd shora v 90 % šířky (jako notebook), obloukem pod hero
          // textem k ose — stejně jako /pristup a /o-mne (28. 9. 2026).
          { tier: 'tablet', vb: 834, axis: 40, dotOffset: 44, hero: true, entry: 750, entryRatio: 0.9, r: 22 },
          { tier: 'laptop', vb: 1366, axis: 96, dotOffset: 36, hero: true, entry: 1230, r: 28 },
          { tier: 'desktop', vb: 1440, axis: 120, dotOffset: 36, hero: true, entry: 1300, r: 28 },
        ].map((v) => (
          <svg
            class={`cla__route-svg cla__route-svg--${v.tier}`}
            viewBox={`0 0 ${v.vb} 2600`}
            preserveAspectRatio="none"
            focusable="false"
            data-vb={v.vb}
            data-axis={v.axis}
            data-dot-offset={v.dotOffset}
            data-hero={String(v.hero)}
            data-entry={v.entry}
            data-entry-ratio={v.entryRatio}
            data-radius={v.r}
          >
            {v.hero && (
              <defs>
                <LineGradientDefs id={`cla-line-entry-${v.tier}`} tier={v.tier === 'desktop' ? 'desktop' : v.tier === 'tablet' ? 'tablet' : 'laptop'} x1={v.entry} y1={40} x2={v.entry} y2={140} />
              </defs>
            )}
            <path class="cla__route-path" d={`M ${v.axis} -20 V 2600`} fill="none" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {v.hero && (
              <path
                class="cla__route-path cla__route-entry"
                d={`M ${v.entry} 40 L ${v.entry} 140`}
                fill="none"
                stroke={`url(#cla-line-entry-${v.tier})`}
                stroke-width="1"
                stroke-linecap="round"
              />
            )}
            <path class="cla__route-path cla__route-path--dark" d="M 0 0 V 0" fill="none" stroke="var(--line-on-dark)" stroke-opacity=".3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {(['clanky', 'sluzby'] as const).map((marker) => (
              <g class="cla__marker" data-marker={marker}>
                <line class="cla__notch" x1={v.axis} y1="0" x2={v.axis} y2="0" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" />
                <circle class="cla__dot" cx={v.axis} cy="0" r={v.tier === 'mobile' || v.tier === 'tablet' ? 3.2 : 3.5} fill="var(--emerald)" />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <section class="cla-hero" aria-labelledby="cla-hero-heading">
      <div class="cla-hero__text">
        <h1 id="cla-hero-heading" data-reveal>Finance srozumitelně. A&nbsp;v&nbsp;souvislostech.</h1>
        <p class="cla-hero__lead" data-reveal>
          Píšu o&nbsp;hypotékách, finančním plánování, pojištění, investicích a&nbsp;penzi. Vysvětluji konkrétní
          otázky, které lidé řeší při důležitých finančních rozhodnutích.
        </p>
        <div class="cla-hero__actions" data-reveal>
          <a class="cla-cta" href="#clanky-vypis" data-scroll-target>Procházet články</a>
          <a class="cla-phone" href="tel:+420775217721">
            <svg class="cla-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
          </a>
        </div>
      </div>
    </section>

    <section class="cla-chapter cla-chapter--clanky" aria-labelledby="clanky-heading">
      <div class="cla-chapter__bar" data-reveal data-route-target="clanky">
        <p>Články</p>
      </div>

      <div class="cla-chapter__content">
        <div class="cla-chapter__top">
          <div class="cla-chapter__lead-col" data-reveal>
            <h2 id="clanky-heading" class="cla-h2--dominant">Články, které vám pomohou rozhodovat se&nbsp;s&nbsp;větším přehledem.</h2>
          </div>
          <div class="cla-chapter__support-col" data-reveal>
            <p class="cla-support__text">
              Vyberte si téma, které právě řešíte. U&nbsp;jednotlivých článků najdete vysvětlení, důležité
              souvislosti a&nbsp;odkazy na&nbsp;další informace.
            </p>
          </div>
        </div>

        <div class="cla-articles" id="clanky-vypis" data-reveal>
          {availableTopics.length > 0 && (
            <nav class="cla-topics" aria-label="Témata článků">
              <ul class="cla-topics__list">
                <li>
                  <button type="button" class="cla-topics__btn is-active" data-topic="" aria-current="true">
                    Všechna témata
                  </button>
                </li>
                {availableTopics.map((topic) => (
                  <li>
                    <button type="button" class="cla-topics__btn" data-topic={plainSpace(topic)}>
                      {topic}
                    </button>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {articles.length > 0 ? (
            <>
              <ul class="cla-articles__list" data-articles-list>
                {
                  articles.map((article, i) => (
                    <li>
                      <article
                        class={`cla-article${article.featured ? ' cla-article--featured' : ''}`}
                        data-category={plainSpace(article.category)}
                        data-article-index={i}
                        hidden={i >= ARTICLES_PAGE_SIZE}
                      >
                        <div class="cla-article__meta">
                          <p class="cla-article__category">{article.category}</p>
                          {article.publishedAt && <time datetime={article.isoDate ?? undefined}>{article.publishedAt}</time>}
                        </div>
                        {article.title ? (
                          <div class="cla-article__body">
                            <h3 class="cla-article__title">
                              <a href={article.href ?? '#'}>{article.title}</a>
                            </h3>
                            {article.excerpt && <p class="cla-article__excerpt">{article.excerpt}</p>}
                          </div>
                        ) : (
                          <div class="cla-article__placeholder" aria-hidden="true">
                            <span class="cla-verify-badge">ČLÁNEK — PLACEHOLDER</span>
                            <span class="cla-article__line cla-article__line--title" style={`width:${article.titleLineWidth}%`} />
                            <div class="cla-article__lines">
                              {article.excerptLineWidths.map((w) => (
                                <span class="cla-article__line" style={`width:${w}%`} />
                              ))}
                            </div>
                            {!article.title && <span class="sr-only">Článek bude doplněn</span>}
                          </div>
                        )}
                      </article>
                    </li>
                  ))
                }
              </ul>

              {articles.length > ARTICLES_PAGE_SIZE && (
                <button type="button" class="cla-articles__more" data-articles-more>
                  Zobrazit další články
                </button>
              )}

              {/* Stav bez výsledku po výběru tématu — pojistka (zadání §7).
                  Témata bez článků se do filtru výše vůbec nepřidávají, takže
                  na tenhle blok běžný uživatel nenarazí. */}
              <div class="cla-empty cla-empty--filtered" data-empty-filtered hidden role="status">
                {/* NOVÁ COPY — ČEKÁ NA SCHVÁLENÍ */}
                <p class="cla-empty__heading">K&nbsp;tomuto tématu zatím žádný článek není.</p>
                <p class="cla-empty__text">Zkuste jiné téma, nebo se&nbsp;podívejte na&nbsp;všechny publikované články.</p>
                <button type="button" class="cla-text-link" data-reset-filter>
                  Zobrazit všechny články
                </button>
              </div>
            </>
          ) : (
            <div class="cla-empty" role="status">
              {/* NOVÁ COPY — ČEKÁ NA SCHVÁLENÍ */}
              <p class="cla-empty__heading">Články teprve připravuji.</p>
              <p class="cla-empty__text">
                První texty brzy přidám. Zatím si můžete prohlédnout služby nebo rovnou domluvit nezávaznou
                konzultaci.
              </p>
              <div class="cla-empty__actions">
                <a class="cla-text-link" href="/sluzby">Zobrazit služby</a>
                <a class="cla-text-link" href="/#kontakt">Nezávazná konzultace</a>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="cla-chapter cla-chapter--sluzby" aria-labelledby="sluzby-heading">
      <div class="cla-chapter__bar cla-chapter__bar--muted" data-reveal data-route-target="sluzby">
        <p>Služby</p>
      </div>

      <div class="cla-chapter__content">
        <div class="cla-chapter__top">
          <div class="cla-chapter__lead-col" data-reveal>
            <h2 id="sluzby-heading" class="cla-h2--std">Potřebujete vyřešit konkrétní situaci?</h2>
          </div>
          <div class="cla-chapter__support-col" data-reveal>
            <p class="cla-support__text">
              Článek vám může pomoci zorientovat se. Pokud chcete propočítat vlastní možnosti, zkontrolovat
              současné nastavení nebo připravit další postup, můžeme se&nbsp;podívat přímo na&nbsp;vaši situaci.
            </p>
            <a class="cla-text-link" href="/sluzby">Zobrazit služby</a>
          </div>
        </div>
      </div>
    </section>

    <section class="cla-closing" aria-labelledby="cla-closing-heading">
      <div class="cla-closing__glow" aria-hidden="true"></div>

      <div class="cla-closing__grid">
        <h2 id="cla-closing-heading" data-reveal>Pojďme se&nbsp;podívat na&nbsp;vaši konkrétní otázku.</h2>

        <div class="cla-closing__body" data-reveal>
          <p>
            Ať už řešíte bydlení, současné smlouvy nebo další finanční rozhodnutí, na&nbsp;první konzultaci si
            ujasníme vaši situaci a&nbsp;další postup.
          </p>

          <div class="cla-closing__actions">
            <a class="cla-cta cla-cta--dark" href="/#kontakt">Nezávazná konzultace</a>
            <a class="cla-phone cla-phone--dark" href="tel:+420775217721">
              <svg class="cla-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path
                  d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
            </a>
          </div>

          <a class="closing-booking" href={BOOKING_URL} target="_blank" rel="noopener">Nebo si rovnou vyberte termín online</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { firstLineCenterY } from '../scripts/first-line';
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  const main = document.querySelector('.cla');
  const routeWrap = document.querySelector('.cla__route');

  if (main && routeWrap) {
    const svgs = Array.from(routeWrap.querySelectorAll('.cla__route-svg')) as SVGSVGElement[];
    const heroSection = main.querySelector('.cla-hero') as HTMLElement | null;
    const heroTextEl = main.querySelector('.cla-hero__text') as HTMLElement | null;
    const closingSection = main.querySelector('.cla-closing') as HTMLElement | null;
    const closingHeading = main.querySelector('.cla-closing__grid h2') as HTMLElement | null;
    const markerTargets = {
      clanky: main.querySelector('[data-route-target="clanky"]'),
      sluzby: main.querySelector('[data-route-target="sluzby"]'),
    } as const;

    const HERO_ENTRY_START_Y = 40;
    const HERO_ENTRY_MAX_LENGTH = 100;
    const HERO_ENTRY_MIN_LENGTH = 40;
    const HERO_ENTRY_GAP_BEFORE_BEND = 20;

    const heroArcPath = (entryX: number, axisX: number, r: number, bendY: number, totalHeight: number, entryEndY: number) => {
      const y1 = bendY - r;
      return `M ${entryX} ${entryEndY} V ${y1} A ${r} ${r} 0 0 1 ${entryX - r} ${y1 + r} H ${axisX + r} A ${r} ${r} 0 0 0 ${axisX} ${y1 + 2 * r} V ${totalHeight}`;
    };

    const syncRoute = () => {
      if (!heroSection) return;
      const mainRect = main.getBoundingClientRect();
      if (mainRect.height === 0) return;
      const totalHeight = Math.max(mainRect.height, 1);
      const heroBottom = heroSection.getBoundingClientRect().bottom - mainRect.top;
      const closingTop = closingSection ? closingSection.getBoundingClientRect().top - mainRect.top : totalHeight;

      let bendY = 260;
      if (heroTextEl) {
        const textRect = heroTextEl.getBoundingClientRect();
        const textBottom = textRect.bottom - mainRect.top;
        bendY = Math.min(Math.max(textBottom + 40, 260), heroBottom - 20);
      }

      svgs.forEach((svg) => {
        const isActive = getComputedStyle(svg).display !== 'none';
        const nominalVb = parseFloat(svg.dataset.vb ?? '390');
        const axis = parseFloat(svg.dataset.axis ?? '24');
        const dotOffsetPx = parseFloat(svg.dataset.dotOffset ?? '16');
        const isHero = svg.dataset.hero === 'true';
        const r = parseFloat(svg.dataset.radius ?? '0');

        if (!Number.isFinite(nominalVb) || nominalVb <= 0) return;

        const realWidthNow = isActive ? svg.getBoundingClientRect().width : 0;
        const vb = realWidthNow > 0 ? realWidthNow : nominalVb;
        // Tablet: nájezd v poměru k šířce, jinak pevná tierová konstanta.
        const entryRatio = parseFloat(svg.dataset.entryRatio ?? '');
        const entryX = Number.isFinite(entryRatio) ? entryRatio * vb : parseFloat(svg.dataset.entry ?? '0');

        svg.setAttribute('viewBox', `0 0 ${vb} ${totalHeight}`);

        const lightPath = svg.querySelector('.cla__route-path:not(.cla__route-path--dark)') as SVGPathElement | null;
        const darkPath = svg.querySelector('.cla__route-path--dark') as SVGPathElement | null;

        const axisScaled = (axis / nominalVb) * vb;
        const shift = axisScaled - axis;
        // Mobil (28. 9. 2026): trasa jako na tabletu — od osy pod obsahem hero
        // obloukem doprava, po pravé straně nahoru a pod záhlavím končí do
        // ztracena nájezdovým gradientem (barvy LineGradientDefs tier „tablet").
        // Je-li v hero fotka v pozadí (absolutně nahoře), vede linka ZA ní jako
        // na homepage: nahoře vedle hlavy je vidět, za postavou schovaná a v místě,
        // kde se fotka rozpouští, se plynule znovu objeví (úsek „mid" s vlastním
        // gradientem — v průsvitné části fotky by jinak linka prosvítala).
        // Gradienty a pomocné cesty se v mobilním SVG vytvoří jednou za běhu.
        const mobileFramePath = (endY: number): string | null => {
          if (!heroSection) return null;
          const els = Array.from(heroSection.querySelectorAll('[class*="hero__text"], [class*="hero__photo"], [class*="hero__breadcrumb"], nav')) as HTMLElement[];
          const rects = els.map((e) => e.getBoundingClientRect()).filter((r) => r.height > 0);
          if (!rects.length) return null;
          const bottom = Math.max(...rects.map((r) => r.bottom)) - mainRect.top;
          const fr = 18;
          const rightX = (378 / nominalVb) * vb;
          const y0 = 40;
          const yB = bottom + 28;
          const yE = Math.min(140, yB - fr - 20);
          const NS = 'http://www.w3.org/2000/svg';
          const ensure = (cls: string, stops: [string, string, string][]) => {
            let path = svg.querySelector(`path.${cls}`) as SVGPathElement | null;
            let grad = svg.querySelector(`linearGradient.${cls}`) as SVGLinearGradientElement | null;
            if (!path || !grad) {
              const defs = document.createElementNS(NS, 'defs');
              grad = document.createElementNS(NS, 'linearGradient') as SVGLinearGradientElement;
              grad.id = `${cls}-${Math.random().toString(36).slice(2, 9)}`;
              grad.setAttribute('class', cls);
              grad.setAttribute('gradientUnits', 'userSpaceOnUse');
              stops.forEach(([o, c, op]) => {
                const st = document.createElementNS(NS, 'stop');
                st.setAttribute('offset', o);
                st.setAttribute('stop-color', c);
                st.setAttribute('stop-opacity', op);
                grad!.appendChild(st);
              });
              defs.appendChild(grad);
              svg.insertBefore(defs, svg.firstChild);
              path = document.createElementNS(NS, 'path') as SVGPathElement;
              path.setAttribute('class', cls);
              path.setAttribute('fill', 'none');
              path.setAttribute('stroke', `url(#${grad.id})`);
              path.setAttribute('stroke-width', '1');
              path.setAttribute('stroke-linecap', 'round');
              svg.appendChild(path);
            }
            return { path, grad };
          };
          const entry = ensure('route-mobile-entry', [['0%', '#1E7A5C', '0'], ['34%', '#1E7A5C', '.36'], ['70%', '#255E77', '.24'], ['100%', '#1B4A8A', '.18']]);
          entry.grad.setAttribute('x1', String(rightX));
          entry.grad.setAttribute('x2', String(rightX));
          entry.grad.setAttribute('y1', String(y0));
          entry.grad.setAttribute('y2', String(yE));
          entry.path.setAttribute('d', `M ${rightX} ${y0} L ${rightX} ${yE}`);
          let mainStart = yE;
          const bgPhoto = heroSection.querySelector('[class*="hero__photo"]') as HTMLElement | null;
          if (bgPhoto && getComputedStyle(bgPhoto).position === 'absolute') {
            const pr = bgPhoto.getBoundingClientRect();
            const pTop = pr.top - mainRect.top;
            const yA = pTop + pr.height * 0.44;
            // Pod 72 % výšky fotky je postava už skoro rozpuštěná — linka je až do
            // té výšky schovaná (i přes průsvitnou ruku) a objeví se až pod ní.
            const yD = pTop + pr.height * 0.72;
            const yF = Math.min(pTop + pr.height * 0.9, yB - fr - 1);
            if (yF > yE + 20) {
              const span = yF - yE;
              const pA = Math.max(0, Math.min(1, (yA - yE) / span));
              const pC = Math.max(pA, Math.min(1, pA + 12 / span));
              const pD = Math.max(pC, Math.min(1, (yD - yE) / span));
              const mid = ensure('route-mobile-mid', [['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '0'], ['0%', '#1B4A8A', '0'], ['100%', '#1B4A8A', '.18']]);
              const st = mid.grad.querySelectorAll('stop');
              st[1].setAttribute('offset', String(pA));
              st[2].setAttribute('offset', String(pC));
              st[3].setAttribute('offset', String(pD));
              mid.grad.setAttribute('x1', String(rightX));
              mid.grad.setAttribute('x2', String(rightX));
              mid.grad.setAttribute('y1', String(yE));
              mid.grad.setAttribute('y2', String(yF));
              mid.path.setAttribute('d', `M ${rightX} ${yE} L ${rightX} ${yF}`);
              mainStart = yF;
            }
          }
          return `M ${rightX} ${mainStart} V ${yB - fr} A ${fr} ${fr} 0 0 1 ${rightX - fr} ${yB} H ${axisScaled + fr} A ${fr} ${fr} 0 0 0 ${axisScaled} ${yB + fr} V ${endY}`;
        };
        if (isActive) {
          (main as HTMLElement).style.setProperty('--cla-shift', `${shift}px`);
        }

        if (isHero) {
          const available = bendY - r - HERO_ENTRY_START_Y - HERO_ENTRY_GAP_BEFORE_BEND;
          const entryLength = Math.min(HERO_ENTRY_MAX_LENGTH, Math.max(HERO_ENTRY_MIN_LENGTH, available));
          const entryEndY = HERO_ENTRY_START_Y + entryLength;

          const gradient = svg.querySelector('linearGradient');
          if (gradient) {
            gradient.setAttribute('y1', String(HERO_ENTRY_START_Y));
            gradient.setAttribute('y2', String(entryEndY));
          }

          const entryPath = svg.querySelector('.cla__route-entry') as SVGPathElement | null;
          if (entryPath) entryPath.setAttribute('d', `M ${entryX} ${HERO_ENTRY_START_Y} L ${entryX} ${entryEndY}`);

          if (lightPath) lightPath.setAttribute('d', heroArcPath(entryX, axisScaled, r, bendY, closingTop, entryEndY));
        } else if (lightPath) {
          lightPath.setAttribute('d', mobileFramePath(closingTop) ?? `M ${axisScaled} ${heroBottom - 20} V ${closingTop}`);
        }

        const gapBuffer = 20;
        let darkD = `M ${axisScaled} ${closingTop - 20} V ${totalHeight}`;
        if (darkPath && closingHeading) {
          const hRect = closingHeading.getBoundingClientRect();
          const svgRectNow = svg.getBoundingClientRect();
          const axisRealX = svgRectNow.left + axisScaled * (svgRectNow.width / vb);
          if (hRect.width > 0 && axisRealX >= hRect.left && axisRealX <= hRect.right) {
            const gapTop = hRect.top - mainRect.top - gapBuffer;
            const gapBottom = hRect.bottom - mainRect.top + gapBuffer;
            darkD = `M ${axisScaled} ${closingTop - 20} V ${gapTop} M ${axisScaled} ${gapBottom} V ${totalHeight}`;
          }
        }
        if (darkPath) darkPath.setAttribute('d', darkD);

        if (!isActive) return;

        const svgRect = svg.getBoundingClientRect();
        if (svgRect.height === 0 || svgRect.width === 0) return;
        const scaleY = svgRect.height / totalHeight;
        const scaleX = svgRect.width / vb;

        const axisRealX = svgRect.left + axisScaled * scaleX;
        const targetLocalX = (axisRealX + dotOffsetPx - svgRect.left) / scaleX;

        (Object.keys(markerTargets) as Array<keyof typeof markerTargets>).forEach((key) => {
          const target = markerTargets[key];
          const group = svg.querySelector(`[data-marker="${key}"]`);
          if (!target || !group) return;
          const centerY = firstLineCenterY(target);
          const localY = (centerY - svgRect.top) / scaleY;
          const notch = group.querySelector('.cla__notch');
          const dot = group.querySelector('.cla__dot');
          if (notch) {
            notch.setAttribute('y1', String(localY));
            notch.setAttribute('y2', String(localY));
            notch.setAttribute('x1', String(axisScaled));
            notch.setAttribute('x2', String(targetLocalX));
          }
          if (dot) {
            dot.setAttribute('cy', String(localY));
            dot.setAttribute('cx', String(targetLocalX));
          }
        });
      });
    };

    syncRoute();
    window.addEventListener('resize', syncRoute);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(main);
    }

    if (!reduceMotion) {
      const activeSvg = svgs.find((svg) => getComputedStyle(svg).display !== 'none');
      const paths = activeSvg ? (Array.from(activeSvg.querySelectorAll('.cla__route-path')) as SVGPathElement[]) : [];
      const dots = activeSvg ? (Array.from(activeSvg.querySelectorAll('.cla__dot')) as SVGCircleElement[]) : [];
      paths.forEach((path) => {
        const length = path.getTotalLength();
        if (length === 0) return;
        path.style.strokeDasharray = String(length);
        path.style.strokeDashoffset = String(length);
      });
      dots.forEach((dot) => dot.classList.add('is-pending'));
      window.setTimeout(() => {
        paths.forEach((path) => {
          path.style.transition = 'stroke-dashoffset var(--duration-line) var(--ease-out)';
          path.style.strokeDashoffset = '0';
        });
        window.setTimeout(() => {
          dots.forEach((dot) => {
            dot.classList.remove('is-pending');
            dot.classList.add('is-visible');
          });
        }, 450);
      }, 20);
    }

    const revealEls = Array.from(main.querySelectorAll('[data-reveal]')) as HTMLElement[];

    if (!reduceMotion && revealEls.length && 'IntersectionObserver' in window) {
      revealEls.forEach((el) => el.classList.add('is-pending'));

      const groups = new Map<Element | null, HTMLElement[]>();
      revealEls.forEach((el) => {
        const parent = el.closest('section');
        const list = groups.get(parent) ?? [];
        list.push(el);
        groups.set(parent, list);
      });

      const revealGroup = (section: Element | null) => {
        const els = groups.get(section) ?? [];
        const lastDelay = (els.length - 1) * 70;
        els.forEach((el, i) => {
          window.setTimeout(() => {
            el.classList.remove('is-pending');
            el.classList.add('is-visible');
          }, i * 70);
        });
        window.setTimeout(() => syncRoute(), lastDelay + 520);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              revealGroup(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );

      Array.from(main.querySelectorAll('section')).forEach((section) => observer.observe(section));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  }

  // Hero CTA „Procházet články" — plynulý přesun na výpis na téže stránce.
  const scrollCta = document.querySelector('[data-scroll-target]');
  if (scrollCta) {
    scrollCta.addEventListener('click', (e) => {
      const href = scrollCta.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    });
  }

  // Filtr témat — čistě klientský toggle viditelnosti podle `data-category`.
  // Připraveno pro budoucí data (zadání §4/§15) — s prázdným `articles`
  // polem se `<nav>` vůbec nevykresluje, takže se dnes reálně nespouští.
  const topicsNav = document.querySelector('.cla-topics');
  const articlesList = document.querySelector('[data-articles-list]');
  const emptyFiltered = document.querySelector('[data-empty-filtered]');
  // Filtr témat a „Zobrazit další články" sdílí jeden stav (oprava 6. 10. 2026,
  // test check:funkce): dřív filtr ignoroval stránkování — „Všechna témata"
  // ukázalo všechno a tlačítko zůstalo, při tématu by „další" odkrylo i články
  // z jiných témat. Teď: z článků daného tématu je vidět prvních `limit`,
  // tlačítko jen když jich je víc; změna tématu vrátí limit na začátek.
  // Stejná hodnota jako `ARTICLES_PAGE_SIZE` ve frontmatteru (samostatný kontext).
  const ARTICLES_INCREMENT = 6;
  const moreBtn = document.querySelector('[data-articles-more]') as HTMLButtonElement | null;
  if (articlesList) {
    const buttons = topicsNav ? (Array.from(topicsNav.querySelectorAll('.cla-topics__btn')) as HTMLButtonElement[]) : [];
    const items = Array.from(articlesList.querySelectorAll('.cla-article')) as HTMLElement[];
    let topic = '';
    let limit = ARTICLES_INCREMENT;

    const render = () => {
      const matching = items.filter((item) => !topic || item.dataset.category === topic);
      items.forEach((item) => {
        const idx = matching.indexOf(item);
        item.hidden = idx < 0 || idx >= limit;
        item.classList.toggle('is-first', idx === 0);
      });
      if (moreBtn) moreBtn.hidden = matching.length <= limit;
      if (emptyFiltered) (emptyFiltered as HTMLElement).hidden = matching.length > 0;
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        topic = btn.dataset.topic ?? '';
        limit = ARTICLES_INCREMENT;
        buttons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('is-active', isActive);
          if (isActive) b.setAttribute('aria-current', 'true');
          else b.removeAttribute('aria-current');
        });
        render();
      });
    });

    moreBtn?.addEventListener('click', () => {
      limit += ARTICLES_INCREMENT;
      render();
    });

    // Odkaz s předvybraným tématem (témata v sekci Články na homepage):
    // /clanky?tema=Pojištění#clanky-vypis
    const preset = new URLSearchParams(location.search).get('tema');
    if (preset) buttons.find((b) => b.dataset.topic === preset)?.click();
  }

  const resetFilterBtn = document.querySelector('[data-reset-filter]');
  if (resetFilterBtn) {
    resetFilterBtn.addEventListener('click', () => {
      const allBtn = document.querySelector('.cla-topics__btn[data-topic=""]') as HTMLButtonElement | null;
      if (allBtn) allBtn.click();
    });
  }
</script>

