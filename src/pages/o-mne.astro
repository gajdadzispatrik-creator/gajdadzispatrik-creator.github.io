    pointer-events: none;
  }

  .om-closing__grid {
    position: relative;
    z-index: 2;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .om-closing__grid h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--white);
