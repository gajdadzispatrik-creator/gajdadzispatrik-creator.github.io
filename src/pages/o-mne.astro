    }

    .om-hero__lead {
      font-size: 19px;
    }

    .om-hero__actions {
      flex-direction: row;
      margin-top: 4px;
    }

    .om-hero {
      padding: 112px 96px 90px;
    }

    /* Výřez postavy bez pozadí — větší než původní rám (300×392), vytažený
       nahoru a dolů až ke spodku hero; smí přejít přes trasu (z-index 2). */
    /* Velikost postavy = hero na homepage (šířka ramen ~360–370 px, měřeno):
       rám 780 px vysoký, nahoře 60 px pod hlavičkou (hlava nesmí být
       nalepená na hlavičku), dole přesahuje hero do mezery před první
       kapitolou (výška hero beze změny). */
    .om-hero__photo {
      flex: none;
      width: 500px;
      height: 768px;
      margin: -52px 0 -256px;
      aspect-ratio: auto;
    }

    /* Výřez 373×714 (temeno 16, hlava 97, střed hlavy 157, prsty 591 px —
       scripts/photo-metrics.mjs) v měřítku 1,206: hlava 117 px jako hero
       na /pristup (1. 10. 2026), temeno 22, střed hlavy 191 px. Rám bez
       ořezu — prsty volné ruky smí vyčnívat vlevo (spodek pod rámem je
       v masce průhledný). Rozpuštění od 70 % výšky obrázku (pod rukama) do
       spodku rámu (768 px) — delší přechod (6. 10. 2026, dřív ~52 px). */
    .om-hero__photo,
    .om-hero__photo.is-visible {
      overflow: visible;
      clip-path: none;
    }

    .om-hero__photo img {
      position: absolute;
      top: 2.7px;
      left: 1.6px;
      width: 449.9px;
      max-width: none;
      height: auto;
      object-fit: fill;
      -webkit-mask-image: linear-gradient(180deg, #000 70%, rgba(0, 0, 0, .96) 72.35%, rgba(0, 0, 0, .85) 74.70%, rgba(0, 0, 0, .69) 77.06%, rgba(0, 0, 0, .50) 79.41%, rgba(0, 0, 0, .31) 81.76%, rgba(0, 0, 0, .15) 84.11%, rgba(0, 0, 0, .04) 86.47%, transparent 88.82%);
              mask-image: linear-gradient(180deg, #000 70%, rgba(0, 0, 0, .96) 72.35%, rgba(0, 0, 0, .85) 74.70%, rgba(0, 0, 0, .69) 77.06%, rgba(0, 0, 0, .50) 79.41%, rgba(0, 0, 0, .31) 81.76%, rgba(0, 0, 0, .15) 84.11%, rgba(0, 0, 0, .04) 86.47%, transparent 88.82%);
    }

    /* 138 (dřív 220, rám o 82 px kratší 1. 10. 2026) — rozpuštěný spodek hero fotky jinak končil 10 px nad
       nadpisem kapitoly (rám pak ještě prodloužen o 60 px); pravidlo: fotka → další obsah aspoň ~60 px, stejně
       jako /pristup (28. 9. 2026). */
    .om-chapter--zacatek {
      margin-top: 138px;
    }

