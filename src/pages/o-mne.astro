  /* ============ Jen tablet (768–1199): hero jako homepage a /pristup ============
     28. 9. 2026: text vlevo se stejnou velikostí nadpisu, šířkou a odstupy
     jako Hero.astro a /pristup, fotka vpravo absolutně (ne pod textem na
     plnou šířku). Postava stejně velká jako na /pristup a homepage (hlava
     126 px zdroje → stejná velikost jako tam na každé šířce): --om-w =
     šířka bloku = měřítko × 422, vzorce odvozené z měření /pristup.
     Blok = 820 px zdroje (prsty 738), spodek na spodku hero, pod prsty
     plynulé rozpuštění. Linka vstupuje shora za hlavou (TIERS, entryRatio). */
  @media (min-width: 768px) and (max-width: 1199px) {
    .om-hero {
      position: relative;
      padding: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px) 40px 0;
      padding-inline-start: calc(40 * 100% / 834); /* logo, nadpis i linka na jedné svislé (4. 10. 2026) */
      min-height: clamp(656px, calc(656px + 0.255639 * (100vw - 834px)), 792px);
    }

    .om-hero__text {
      gap: 0;
    }

    .om-hero__text h1 {
      /* V em: nadpis je delší než na /pristup, s 490 px by se od ~900 px
         lámal na 5 řádků — takhle drží 3 řádky jako na 834 px. */
      max-width: 8.6em;
      font-size: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
      line-height: .99;
    }

    .om-hero__lead {
      margin-top: 60px;
      max-width: min(520px, calc(100vw - 392px));
      font-size: clamp(16.5px, calc(16.5px + 0.004699 * (100vw - 834px)), 19px);
    }

    .om-hero__actions {
      margin-top: 46px;
      gap: clamp(32px, calc(32px + 0.007519 * (100vw - 834px)), 36px);
    }

    .om-hero__photo {
      --om-w: max(
        calc(285.3px + 0.0952 * (100vw - 834px)),
        calc(265.7px + 0.2465 * (100vw - 834px))
      );
      position: absolute;
      left: calc(100% - var(--om-w) - 3px);
      bottom: 0;
      width: var(--om-w);
      height: calc(var(--om-w) * 1.9431);
      margin: 0;
      aspect-ratio: auto;
    }

    /* Fotka končí rozpuštěním až na spodku hero — mezera pod ní k „Začátku"
       je jen padding kapitoly (72 px), bez dalších 80 px navíc. */
    .om-chapter--zacatek {
      margin-top: 0;
    }

    /* Výřez 373×714 v šířce 114,6 % rámu = hlava ~85 px na 834 px, stejně
       jako hero na homepage a /pristup (1. 10. 2026). Postava je širší než
       rám — pravý loket končí na kraji okna, prsty volné ruky vyčnívají
       vlevo z rámu (proto bez ořezu; spodek je v masce průhledný).
       Rozpuštění od 70 % výšky obrázku (pod sepnutýma rukama, ty končí na 67,6 %)
       do spodku rámu (88,6 %) — delší přechod na přání uživatele 6. 10. 2026.
       `clip-path: none` — konečný stav odhalení (`inset(0)`) by jinak
       ořízl postavu na rám stejně jako `overflow: hidden`. */
    .om-hero__photo,
    .om-hero__photo.is-visible {
      overflow: visible;
      clip-path: none;
    }

    .om-hero__photo img {
      position: absolute;
      top: 0;
      left: -11.7%;
      width: 114.6%;
      max-width: none;
      height: auto;
      object-fit: fill;
      -webkit-mask-image: linear-gradient(180deg, #000 70%, rgba(0, 0, 0, .96) 72.33%, rgba(0, 0, 0, .85) 74.65%, rgba(0, 0, 0, .69) 76.97%, rgba(0, 0, 0, .50) 79.30%, rgba(0, 0, 0, .31) 81.62%, rgba(0, 0, 0, .15) 83.95%, rgba(0, 0, 0, .04) 86.27%, transparent 88.60%);
              mask-image: linear-gradient(180deg, #000 70%, rgba(0, 0, 0, .96) 72.33%, rgba(0, 0, 0, .85) 74.65%, rgba(0, 0, 0, .69) 76.97%, rgba(0, 0, 0, .50) 79.30%, rgba(0, 0, 0, .31) 81.62%, rgba(0, 0, 0, .15) 83.95%, rgba(0, 0, 0, .04) 86.27%, transparent 88.60%);
    }
  }

  /* Úzký tablet (768–833): užší nadpis a odstavec a postava se zmenšuje
     stejně jako na /pristup (hlava stejně velká). */
  @media (min-width: 768px) and (max-width: 833px) {
    .om-hero__lead {
      max-width: calc(100vw - 420px);
    }

    .om-hero__photo {
      --om-w: calc(284.5px - 0.7608 * (834px - 100vw));
    }
  }

  /* ============ Notebook: 1200–1399 (kalibrace 1366) ============ */
  @media (min-width: 1200px) {
    .om__route-svg--tablet {
      display: none;
    }

    .om__route-svg--laptop {
      display: block;
    }

    /* 56 = (osa 96 + zářez 36 + mezera 20) − section padding 96. */
    .om-chapter__bar p {
