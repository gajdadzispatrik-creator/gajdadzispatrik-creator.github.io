  .om-zacatek__block p {
    margin: 0;
  }

  /* ---------- Velký standalone statement (mezi Klienti a Souvislosti) ---------- */

  /* Levý padding = stejný odstup jako text pruhu kapitoly (osa + zářez +
     mezera), i&nbsp;když tenhle blok sám žádný pruh/kotvu nemá — jinak by
     text začínal na ose trasy nebo přes ni (zjištěno měřením při ověřování
     tohoto úkolu: 24px base padding = přesně osa mobilu, tekst by ji
     protínal). */
  .om-statement-big {
    padding-block: 56px;
    padding-right: 24px;
    padding-left: 60px;
  }

  .om-statement-big p {
    margin: 0;
    max-width: 720px;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--navy);
    text-wrap: pretty;
  }

  /* ---------- Role — faktický blok ---------- */

  .om-facts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .om-facts__row {
    padding: 18px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .om-facts__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* Poslední řádek bez spodního odsazení — konec bloku určuje padding kapitoly. */
  .om-facts__row:last-child {
    padding-bottom: 0;
  }

  .om-facts__row h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }

  .om-facts__row p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .om-facts__pair {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .om-facts__divider {
    width: 1px;
    align-self: stretch;
    background: var(--border);
  }

  /* Číslo + vlastní popisek pod ním (dřív jeden popisek „Google hodnocení."
     pod oběma čísly, jako by i 150+ klientů bylo hodnocení; 28. 9. 2026). */
  .om-facts__row .om-facts__stat {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  /* Obě čísla vždy vedle sebe (popisky se případně zalomí), přes celou
     šířku řádku i v dvousloupcovém gridu na desktopu. */
  .om-facts__row .om-facts__pair {
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 20px;
    grid-column: 1 / -1;
  }

  .om-facts__stat strong {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--navy);
  }

  /* ---------- Tmavé CTA ---------- */

  .om-closing {
    position: relative;
    margin-top: 64px;
    padding-block: 56px;
    overflow: hidden;
