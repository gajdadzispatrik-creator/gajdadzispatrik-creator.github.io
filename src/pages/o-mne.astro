    /* Závěr jako na ostatních podstránkách (/pristup): stejné odsazení
       od linky (osa + 64 px), stejné mezery a velikost nadpisu. */
    .om-closing {
      margin-top: 80px;
      padding-block: 76px;
    }

    .om-closing__grid {
      padding-inline: 40px;
      padding-left: calc(104px + var(--om-shift, 0px));
    }

    .om-closing__grid h2 {
      font-size: 44px;
    }

