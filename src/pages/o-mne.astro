    }

    /* Šířka 650px — nejmenší, na které se „Jsem Patrik Gajdadzis." vejde na
       jeden řádek při 64px (ověřeno měřením, potřeba ~621px + rezerva),
       viz zpětná vazba 10. 9. 2026. Fotografie proto na tomhle stupni ustoupí
       na 300px (viz `.om-hero__photo` níže), aby se s pevnou vstupní
       konstantou trasy (1230px) pořád bezpečně nepotkala. */
    .om-hero__text {
      max-width: 650px;
      flex: none;
      width: 650px;
      gap: 18px;
    }

    .om-hero__text h1 {
      font-size: 64px;
