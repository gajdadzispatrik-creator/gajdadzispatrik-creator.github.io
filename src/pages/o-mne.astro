  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
    }
  }

  /* ============ Mobil (<768): obsah od popisku u tečky, ne na lince ============
     Popisek kapitoly stojí 36 px od kraje sekce (osa 24 + zářez) — obsah
     kapitol i závěrečné sekce začíná na stejné svislici, jako na tabletu
     (28. 9. 2026, dřív nadpisy a text ležely přímo na lince). */
  @media (max-width: 767px) {
    .om-chapter__content {
      padding-left: calc(36px + var(--om-shift, 0px));
    }

    .om-closing__grid {
      padding-left: calc(60px + var(--om-shift, 0px));
    }

    /* Nezlomitelné „Mint reality & finance." (9,9 em) se na úzkém telefonu
       nevešlo do sloupce (přesah 16 px na 360 px) — nadpisy se pod ~380 px
       mírně zmenší, šířka sloupce = 100vw − 84 px. */
    .om-h2--std {
      font-size: min(30px, calc((100vw - 84px) / 9.9));
    }

    /* „…pro co se rozhoduje." je nezlomitelné (9,4 em) — na nejužších
       telefonech (~320 px) přetékalo o 25 px; od ~340 px beze změny. */
    .om-statement-big p {
      font-size: min(28px, calc((100vw - 84px) / 9.4));
    }

    /* Hero: fotka v pozadí, světlá varianta — stejně jako /pristup
       (28. 9. 2026). Rám 560 px jako tam (trasa v JS počítá rozpuštění
       z jeho výšky). Postava stejně velká jako na /pristup: hlava 126 px
       zdroje → ~95 px, tj. obrázek 84,8 % šířky; hlava (32,8 % šířky
       výřezu) uprostřed stránky; temeno ~30 px pod záhlavím. */
    .om-hero {
      position: relative;
      /* 260: minimum, aby text nezakryl obličej. */
      padding-top: 260px;
      /* Hero na výšku displeje pod záhlavím (64 px) jako homepage — text
         a tlačítka přichycené ke spodku, fotka nahoře (29. 9. 2026).
         Spodek 40 px: CTA 100 px nad koncem hero,
         tj. nad plovoucím panelem Safari na iOS 26 (viz pristup.astro). */
      min-height: calc(100vh - 64px);
      min-height: calc(100svh - 64px);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 40px;
    }

    .om-hero__text {
      position: relative;
      z-index: 3;
    }

    .om-hero__photo {
      position: absolute;
      top: 15px;
      left: 0;
      width: 100%;
      height: 560px;
      margin: 0;
      aspect-ratio: auto;
    }

    .om-hero__photo img {
      position: absolute;
      top: 0;
      /* Výřez 373×714: hlava stejně velká a uprostřed jako u předchozí
         fotky (1. 10. 2026). */
      left: 9.1%;
      width: 97.3%;
      height: auto;
      object-fit: fill;
      /* Svisle: rozpuštění na stejné výšce stránky jako /pristup
         (255 → 435 px rámu = 36,5 → 62,3 % výšky obrázku). Vodorovně:
         pravý kraj do ztracena (viditelný kraj ~93,5 % šířky obrázku =
         pravý kraj rámu). */
      -webkit-mask-image:
        linear-gradient(180deg, #000 36.49%, rgba(0, 0, 0, .96) 39.77%, rgba(0, 0, 0, .85) 42.95%, rgba(0, 0, 0, .69) 46.23%, rgba(0, 0, 0, .5) 49.4%, rgba(0, 0, 0, .31) 52.68%, rgba(0, 0, 0, .15) 55.86%, rgba(0, 0, 0, .04) 59.14%, transparent 62.32%),
        linear-gradient(90deg, #000 63.24%, rgba(0, 0, 0, .98) 65.86%, rgba(0, 0, 0, .94) 68.47%, rgba(0, 0, 0, .85) 71.09%, rgba(0, 0, 0, .75) 73.7%, rgba(0, 0, 0, .63) 76.32%, rgba(0, 0, 0, .5) 78.93%, rgba(0, 0, 0, .37) 81.55%, rgba(0, 0, 0, .25) 84.16%, rgba(0, 0, 0, .15) 86.77%, rgba(0, 0, 0, .06) 89.39%, rgba(0, 0, 0, .02) 91.57%, transparent 93.48%);
      -webkit-mask-composite: source-in;
              mask-image:
        linear-gradient(180deg, #000 36.49%, rgba(0, 0, 0, .96) 39.77%, rgba(0, 0, 0, .85) 42.95%, rgba(0, 0, 0, .69) 46.23%, rgba(0, 0, 0, .5) 49.4%, rgba(0, 0, 0, .31) 52.68%, rgba(0, 0, 0, .15) 55.86%, rgba(0, 0, 0, .04) 59.14%, transparent 62.32%),
        linear-gradient(90deg, #000 63.24%, rgba(0, 0, 0, .98) 65.86%, rgba(0, 0, 0, .94) 68.47%, rgba(0, 0, 0, .85) 71.09%, rgba(0, 0, 0, .75) 73.7%, rgba(0, 0, 0, .63) 76.32%, rgba(0, 0, 0, .5) 78.93%, rgba(0, 0, 0, .37) 81.55%, rgba(0, 0, 0, .25) 84.16%, rgba(0, 0, 0, .15) 86.77%, rgba(0, 0, 0, .06) 89.39%, rgba(0, 0, 0, .02) 91.57%, transparent 93.48%);
              mask-composite: intersect;
    }
  }

  /* ============ Tablet: 768–1199 (kalibrace 834) ============ */
  @media (min-width: 768px) {
    .om__route-svg--mobile {
      display: none;
    }

    .om__route-svg--tablet {
      display: block;
    }

    .om-chapter__bar p {
