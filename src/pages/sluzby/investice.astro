---
/**
 * Stránka /sluzby/investice — detail čtvrté služby. Zdroj pravdy pro
 * OBSAH, pořadí sekcí a role: úkol „Úkol pro Claude Code — podstránka
 * /sluzby/investice" (8. 9. 2026) + `docs/content-subpages.md`, kapitola
 * `/sluzby/investice`. Zdroj pravdy pro VŠECHNY hodnoty sdílené kostry
 * (osa, pruh, zářez, vnitřní rozpad, hero padding, gap mezi pruhem a
 * obsahem, velikost/barva kotev, technika ohybu v hero, typografická
 * škála): `src/pages/sluzby/pojisteni.astro` — na výslovné přání
 * uživatele („veškerou typografii, rozteče a geometrii přebíráš ze
 * sourozeneckých stránek"), sekundárně `hypoteky.astro` a
 * `financni-plan.astro`. Texty jsou STAV „NÁVRH K UŽIVATELSKÉMU
 * SCHVÁLENÍ", NESMÍ jít do produkce bez potvrzení textů.
 *
 * Mapování sedmi kapitol zadání na strukturní vzory `pojisteni.astro`
 * (žádná nová kompozice, jen převzetí existujícího vzoru pro danou roli):
 * 1) Cíl (dominantní) — vzor kapitoly „Majetek": `__top` řádek (lead-col
 *    H2 + support-col se dvěma odstavci A eyebrow+seznamem ve STEJNÉM
 *    sloupci), ale závěrečný statement je s emerald svislicí (jako
 *    Dopad/Příjem), ne --plain jako Majetek — podle zadání §6.
 * 2) Rozpočet — vzor kapitoly „Dopad/Příjem": `__top` řádek + `rows`
 *    (název+popis, pět položek), ale závěrečná věta je BEZ svislice
 *    (--plain škála), podle zadání §6 — hybrid, který v pojisteni
 *    samostatně neexistuje, ale používá jen existující dílčí vzory.
 * 3) Riziko — vzor kapitoly „Dopad/Příjem" 1:1 (jeden odstavec místo
 *    dvou, pět rows, bordered statement).
 * 4) Portfolio — vzor kapitoly „Kontrola" 1:1 (statement hned pod H2
 *    v lead-col, dva odstavce v support-col, normální barva pruhu).
 * 5) Průběh — vzor kapitoly „Průběh" 1:1, ale ŠEST kroků místo pěti
 *    (o jeden víc, viz zadání §5) — stejná technika markeru/spojnice.
 * 6) Souvislosti — vzor kapitoly „Kontrola" (statement hned pod H2), ale
 *    s tlumenou barvou pruhu (`--muted`, jako Péče/Otázky) — hybrid podle
 *    zadání §5/§6.
 * 7) Otázky — vzor kapitoly „Otázky" 1:1 (tlumený pruh, FAQ dl/dt/dd,
 *    šest otázek).
 *
 * NÁJEZDOVÝ GRADIENT V HERO — jediné místo, kde tahle stránka NEPŘEBÍRÁ
 * pevnou konstantu ze sourozenců (zadání §7/§9: „y musí být vždy odvozené
 * z reálného layoutu, nikdy pevně napsané nebo převzaté odjinud"). Délka
 * nájezdu (`entryLength`) se dopočítává za běhu ze skutečné mezery mezi
 * začátkem nájezdu (y=40, konvence z CLAUDE.md — odstup od hlavičky) a
 * bodem ohybu trasy (`bendY - r`), ne z pevných 100px `pojisteni.astro`.
 * Pokud je hero kratší (menší `bendY`), nájezd se zkrátí (min. 40px);
 * pokud je dost místa, vyjde na stejných 100px jako u sourozenců — beze
 * změny viditelného výsledku ve standardním případě, ale bez rizika, že
 * gradient skončí uvnitř ohybu nebo za ním.
 *
 * TRASA — jinak stejná technika jako sourozenci: jedna souvislá cesta od
 * hero až po tmavé závěrečné CTA, `axisScaled` procentuální přepočet pro
 * wide-desktop stage, nájezdový gradient jen na desktopu/notebooku
 * (tablet/mobil hero bez trasy vůbec), SEDM kotev (cil/rozpocet/riziko/
 * portfolio/prubeh/souvislosti/otazky), tmavé CTA bez kotvy/zářezu.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineGradientDefs from '../../components/LineGradientDefs.astro';
import { PERSON_ID, breadcrumbList } from '../../data/entity';

const SERVICE_NAME = 'Investiční poradenství a plánování';
const SERVICE_DESCRIPTION =
  'Pomohu vám nastavit nebo zkontrolovat investice podle vašich cílů, času a rizika. Investiční poradenství osobně v Ostravě nebo online po celé ČR.';
const investiceJsonLd = [
  {
    '@type': 'Service',
    name: SERVICE_NAME,
    description: SERVICE_DESCRIPTION,
    url: 'https://patrikgajdadzis.cz/sluzby/investice',
    provider: { '@id': PERSON_ID },
    areaServed: [
      { '@type': 'City', name: 'Ostrava' },
      { '@type': 'Country', name: 'Česko' },
    ],
  },
  breadcrumbList([
    { name: 'Domů', path: '/' },
    { name: 'Služby', path: '/sluzby' },
    { name: SERVICE_NAME, path: '/sluzby/investice' },
  ]),
];

interface RowItem {
  name: string;
  text: string;
}

const rozpocetRows: RowItem[] = [
  { name: 'K čemu mají peníze sloužit', text: 'Jaký cíl chcete financovat a co pro vás bude znamenat jeho splnění.' },
  { name: 'Kdy je budete potřebovat', text: 'Čas určuje, jaké kolísání a jakou dostupnost peněz si můžete dovolit.' },
  { name: 'Jakou rezervu už máte', text: 'Peníze na běžné a nečekané výdaje nemají automaticky patřit do dlouhodobých investic.' },
  { name: 'Kolik můžete pravidelně investovat', text: 'Částka má odpovídat vašemu rozpočtu a ostatním prioritám.' },
  { name: 'Jaké kolísání jste schopni přijmout', text: 'Investice musí odpovídat nejen cíli, ale i tomu, jak budete reagovat na pokles její hodnoty.' },
];

const rizikoRows: RowItem[] = [
  { name: 'Riziko a kolísání', text: 'Jak se může měnit hodnota investice a zda takový průběh odpovídá vašemu cíli a zkušenostem.' },
  { name: 'Dostupnost peněz', text: 'Za jakých podmínek a v jakém čase můžete prostředky potřebovat nebo vybrat.' },
  { name: 'Rozložení investic', text: 'Proč není vhodné stavět celý majetek na jedné investici nebo úzké skupině aktiv.' },
  { name: 'Náklady', text: 'Jaké poplatky a další náklady jsou s investováním spojené a jak ovlivňují výsledek.' },
  { name: 'Daňové souvislosti', text: 'Jaké daňové podmínky mohou být pro zvolený způsob investování relevantní.' },
];

const cilItems: string[] = [
  'vlastní bydlení',
  'budoucí větší výdaje',
  'tvorba dlouhodobého majetku',
  'penze',
];

interface Step {
  heading: string;
  text: string;
}

const steps: Step[] = [
  { heading: 'Ujasníme si cíle', text: 'Co chcete financovat, kdy a jakou částku budete potřebovat.' },
  { heading: 'Projdeme současnou situaci', text: 'Rezervu, závazky, dostupné prostředky a investice, které už máte.' },
  { heading: 'Nastavíme čas a riziko', text: 'Určíme, jaký investiční horizont a míra kolísání odpovídají vašim potřebám a zkušenostem.' },
  { heading: 'Porovnáme vhodné možnosti', text: 'Vysvětlím vám rozdíly v investičním přístupu, riziku, dostupnosti peněz a nákladech.' },
  { heading: 'Pomohu s realizací', text: 'Pokud se rozhodnete investovat, pomohu vám s dalšími kroky a potřebnou dokumentací.' },
  { heading: 'K plánu se budeme vracet', text: 'Když se změní vaše cíle, příjem nebo životní situace, má smysl zkontrolovat, zda investice stále odpovídají tomu, co potřebujete.' },
];

interface Faq {
  q: string;
  a: string;
}

const faqs: Faq[] = [
  { q: 'Jakou částku potřebuji, abych mohl začít investovat?', a: 'Záleží na vašem cíli, rozpočtu a zvoleném způsobu investování. Důležitější než samotná počáteční částka je, aby investování odpovídalo vašim možnostem a neohrozilo potřebnou rezervu.' },
  { q: 'Je lepší investovat pravidelně, nebo jednorázově?', a: 'Záleží na tom, kolik prostředků máte k dispozici, kdy je budete potřebovat a jaké riziko jste ochotni podstoupit. Oba způsoby mohou mít své místo a lze je také kombinovat.' },
  { q: 'Můžu při investování přijít o peníze?', a: 'Ano. Investice nesou riziko a jejich hodnota může klesnout. Míra rizika závisí na konkrétním řešení. Proto je důležité rozumět možným ztrátám a neinvestovat peníze, které budete potřebovat v nevhodnou dobu.' },
  { q: 'Musím kvůli vám převádět své současné investice?', a: 'Ne. Nejdřív se podíváme na to, co už máte. Pokud současné investice odpovídají vašim cílům a potřebám, není důvod je měnit jen kvůli změně poradce.' },
  { q: 'Jak poznám, jaké investiční riziko je pro mě vhodné?', a: 'Posuzujeme váš cíl, investiční horizont, finanční situaci, zkušenosti a schopnost i ochotu nést ztráty. Podle toho lze určit, jaký způsob investování pro vás dává smysl.' },
  { q: 'Pomůžete mi také s investicemi na penzi?', a: 'Ano. Nejdřív si ujasníme, jaký majetek a budoucí příjem chcete vytvořit. Potom můžeme řešit, jakou roli mají v plánu investice, penzijní produkty nebo další majetek.' },
];
---

<BaseLayout
  title="Investiční poradenství a plánování | Patrik Gajdadzis"
  description={SERVICE_DESCRIPTION}
  jsonLd={investiceJsonLd}
>
  <Header />
  <main id="hero" class="inv">
    <div class="inv__route" aria-hidden="true">
      {
        [
          { tier: 'mobile', vb: 390, axis: 24, dotOffset: 22, hero: false, entry: 0, r: 0 },
          // Tablet: nájezd shora v 90 % šířky (jako notebook), obloukem pod hero
          // textem k ose — stejně jako /pristup a /o-mne (28. 9. 2026).
          { tier: 'tablet', vb: 834, axis: 40, dotOffset: 44, hero: true, entry: 750, entryRatio: 0.9, r: 22 },
          { tier: 'laptop', vb: 1366, axis: 96, dotOffset: 36, hero: true, entry: 1230, r: 28 },
          { tier: 'desktop', vb: 1440, axis: 120, dotOffset: 36, hero: true, entry: 1300, r: 28 },
        ].map((v) => (
          <svg
            class={`inv__route-svg inv__route-svg--${v.tier}`}
            viewBox={`0 0 ${v.vb} 2600`}
            preserveAspectRatio="none"
            focusable="false"
            data-vb={v.vb}
            data-axis={v.axis}
            data-dot-offset={v.dotOffset}
            data-hero={String(v.hero)}
            data-entry={v.entry}
            data-entry-ratio={v.entryRatio}
            data-radius={v.r}
          >
            {v.hero && (
              <defs>
                <LineGradientDefs id={`inv-line-entry-${v.tier}`} tier={v.tier === 'desktop' ? 'desktop' : v.tier === 'tablet' ? 'tablet' : 'laptop'} x1={v.entry} y1={40} x2={v.entry} y2={140} />
              </defs>
            )}
            <path class="inv__route-path" d={`M ${v.axis} -20 V 2600`} fill="none" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {v.hero && (
              <path
                class="inv__route-path inv__route-entry"
                d={`M ${v.entry} 40 L ${v.entry} 140`}
                fill="none"
                stroke={`url(#inv-line-entry-${v.tier})`}
                stroke-width="1"
                stroke-linecap="round"
              />
            )}
            <path class="inv__route-path inv__route-path--dark" d="M 0 0 V 0" fill="none" stroke="var(--line-on-dark)" stroke-opacity=".3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {(['cil', 'rozpocet', 'riziko', 'portfolio', 'prubeh', 'souvislosti', 'otazky'] as const).map((marker) => (
              <g class="inv__marker" data-marker={marker}>
                <line class="inv__notch" x1={v.axis} y1="0" x2={v.axis} y2="0" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" />
                <circle class="inv__dot" cx={v.axis} cy="0" r={v.tier === 'mobile' || v.tier === 'tablet' ? 3.2 : 3.5} fill="var(--emerald)" />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <section class="inv-hero" aria-labelledby="inv-hero-heading">
      <nav class="inv-breadcrumb" aria-label="Drobečková navigace">
        <ol>
          <li><a href="/sluzby">Služby</a></li>
          <li aria-current="page">Investice</li>
        </ol>
      </nav>

      <div class="inv-hero__text">
        <h1 id="inv-hero-heading" data-reveal>Investice mají vycházet z&nbsp;toho, na&nbsp;co a&nbsp;kdy peníze potřebujete.</h1>
        <p class="inv-hero__lead" data-reveal>
          Nejdřív si ujasníme, co chcete investováním získat, kdy budete peníze potřebovat a&nbsp;jaké riziko dává
          smysl podstoupit. Potom nastavíme způsob investování, který odpovídá vašim cílům i&nbsp;ostatním financím.
        </p>
        <div class="inv-hero__actions" data-reveal>
          <a class="inv-cta" href="/#kontakt">Nezávazná konzultace</a>
          <a class="inv-phone" href="tel:+420775217721">
            <svg class="inv-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
          </a>
        </div>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--cil" aria-labelledby="cil-heading">
      <div class="inv-chapter__bar" data-reveal data-route-target="cil">
        <p>Cíl</p>
      </div>

      <div class="inv-chapter__content">
        <div class="inv-chapter__top">
          <div class="inv-chapter__lead-col" data-reveal>
            <h2 id="cil-heading" class="inv-h2--dominant">Jinak se&nbsp;investuje na&nbsp;několik let.<br class="br-mobile" /> Jinak na&nbsp;několik desetiletí.</h2>
          </div>
          <div class="inv-chapter__support-col" data-reveal>
            <div class="inv-support__body">
              <p class="inv-support__text">
                Peníze na&nbsp;plánovanou koupi nemovitosti mají jiný účel než majetek, který vytváříte na&nbsp;penzi.
                Rozdílný čas a&nbsp;cíl znamenají i&nbsp;rozdílné nároky na&nbsp;dostupnost peněz a&nbsp;přijatelné
                riziko.
              </p>
              <p class="inv-support__text">
                Proto nezačínám otázkou, který fond nebo investiční produkt vybrat. Nejdřív potřebujeme vědět, jakou
                roli mají peníze ve&nbsp;vašem životě.
              </p>
            </div>
            <div class="inv-cil__list-block">
              <p class="inv-eyebrow">Peníze mohou mít jiný úkol</p>
              <ul class="inv-chapter__list">
                {cilItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <p class="inv-chapter__statement" data-reveal>
          Stejná investice nemusí dávat smysl pro&nbsp;dva různé cíle.
        </p>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--rozpocet" aria-labelledby="rozpocet-heading">
      <div class="inv-chapter__bar" data-reveal data-route-target="rozpocet">
        <p>Rozpočet</p>
      </div>

      <div class="inv-chapter__content">
        <div class="inv-chapter__top">
          <div class="inv-chapter__lead-col" data-reveal>
            <h2 id="rozpocet-heading" class="inv-h2--std">Nejdřív musí fungovat rozpočet a&nbsp;rezerva.</h2>
          </div>
          <div class="inv-chapter__support-col" data-reveal>
            <p class="inv-support__text">
              Investování nemá být na&nbsp;úkor peněz, které můžete potřebovat v&nbsp;nejbližší době. Proto
              se&nbsp;nejdřív podíváme na&nbsp;příjmy, výdaje, závazky, rezervu a&nbsp;plánované větší výdaje.
            </p>
            <p class="inv-support__text">
              Až potom dává smysl určit, kolik můžete investovat pravidelně nebo jednorázově.
            </p>
          </div>
        </div>

        <ul class="inv-rows" data-reveal>
          {
            rozpocetRows.map((r) => (
              <li class="inv-rows__row">
                <span class="inv-rows__name">{r.name}</span>
                <span class="inv-rows__text">{r.text}</span>
              </li>
            ))
          }
        </ul>

        <p class="inv-chapter__statement inv-chapter__statement--plain" data-reveal>
          Až potom vybíráme způsob investování.
        </p>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--riziko" aria-labelledby="riziko-heading">
      <div class="inv-chapter__bar" data-reveal data-route-target="riziko">
        <p>Riziko</p>
      </div>

      <div class="inv-chapter__content">
        <div class="inv-chapter__top">
          <div class="inv-chapter__lead-col" data-reveal>
            <h2 id="riziko-heading" class="inv-h2--std">Důležité je vědět, jaké riziko podstupujete a&nbsp;za&nbsp;co platíte.</h2>
          </div>
          <div class="inv-chapter__support-col" data-reveal>
            <p class="inv-support__text">
              Vyšší očekávaný výnos bývá spojený s&nbsp;vyšším rizikem. Hodnota investice může kolísat a&nbsp;v&nbsp;některých
              obdobích také výrazně klesnout. Proto je důležité rozumět nejen tomu, co může investice
              přinést, ale i&nbsp;tomu, co se&nbsp;může stát cestou.
            </p>
          </div>
        </div>

        <ul class="inv-rows" data-reveal>
          {
            rizikoRows.map((r) => (
              <li class="inv-rows__row">
                <span class="inv-rows__name">{r.name}</span>
                <span class="inv-rows__text">{r.text}</span>
              </li>
            ))
          }
        </ul>

        <p class="inv-chapter__statement" data-reveal>
          Investici máte rozumět i&nbsp;ve&nbsp;chvíli, kdy její hodnota klesá.
        </p>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--portfolio" aria-labelledby="portfolio-heading">
      <div class="inv-chapter__bar" data-reveal data-route-target="portfolio">
        <p>Portfolio</p>
      </div>

      <div class="inv-chapter__content">
        <div class="inv-chapter__lead-col" data-reveal>
          <h2 id="portfolio-heading" class="inv-h2--std">Nejdřív se&nbsp;podívám na&nbsp;to, co už máte.</h2>
          <p class="inv-chapter__statement" data-reveal>Změna portfolia má mít důvod. Ne&nbsp;být cílem sama o&nbsp;sobě.</p>
        </div>

        <div class="inv-chapter__support-col" data-reveal>
          <p class="inv-support__text">
            Pokud už máte investice, není důvod začínat od&nbsp;nuly. Projdeme jejich účel, složení, náklady, riziko
            a&nbsp;to, jestli odpovídají vašim současným cílům.
          </p>
          <p class="inv-support__text">
            Může se&nbsp;ukázat, že současné nastavení dává smysl. Pokud najdeme něco, co stojí za&nbsp;úpravu,
            vysvětlím vám proč a&nbsp;jaké jsou možnosti.
          </p>
        </div>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--prubeh" aria-labelledby="prubeh-heading">
      <div class="inv-chapter__bar" data-reveal data-route-target="prubeh">
        <p>Průběh</p>
      </div>

      <div class="inv-chapter__content inv-chapter__content--single">
        <h2 id="prubeh-heading" class="inv-h2--std inv-h2--prubeh" data-reveal>Od&nbsp;cíle ke&nbsp;konkrétnímu způsobu investování.</h2>

        <ol class="inv-steps" data-reveal>
          {
            steps.map((step, i) => (
              <li class={`inv-step${i === 0 ? ' inv-step--first' : ''}`}>
                <span class="inv-step__marker" aria-hidden="true"></span>
                {i < steps.length - 1 && <span class="inv-step__connector" aria-hidden="true"></span>}
                <h3>{step.heading}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="inv-chapter inv-chapter--souvislosti" aria-labelledby="souvislosti-heading">
      <div class="inv-chapter__bar inv-chapter__bar--muted" data-reveal data-route-target="souvislosti">
        <p>Souvislosti</p>
      </div>

      <div class="inv-chapter__content">
        <div class="inv-chapter__lead-col" data-reveal>
          <h2 id="souvislosti-heading" class="inv-h2--muted">Investování nemá fungovat odděleně od&nbsp;zbytku vašeho života.</h2>
          <p class="inv-chapter__statement" data-reveal>Začneme tím, co chcete vyřešit právě teď.</p>
        </div>

        <div class="inv-chapter__support-col" data-reveal>
          <p class="inv-support__text">
            Výše rezervy, hypotéka, ochrana příjmu nebo plánovaná koupě nemovitosti mohou ovlivnit, kolik peněz má
            smysl investovat a&nbsp;na&nbsp;jak dlouho.
          </p>
          <p class="inv-support__text">
            Proto se&nbsp;při investování dívám i&nbsp;na&nbsp;ostatní důležitá finanční rozhodnutí. Neznamená to
            ale, že kvůli investici musíte automaticky řešit všechny své finance.
