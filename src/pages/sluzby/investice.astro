        <p id="otazky-heading">Otázky</p>
      </div>

      <div class="inv-chapter__content inv-chapter__content--single">
        <dl class="inv-faq" data-reveal>
          {
            faqs.map((faq) => (
              <div class="inv-faq__row">
                <dt>{faq.q}</dt>
                <dd>{faq.a}</dd>
