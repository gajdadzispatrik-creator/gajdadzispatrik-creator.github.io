    position: relative;
    background: var(--bg);
    overflow-x: hidden;
  }

  .inv__route {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .inv__route-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .inv__route-path--dark {
    stroke: var(--line-on-dark);
  }

  .inv__notch {
    stroke: var(--line);
    stroke-opacity: .18;
  }

  .inv__dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  .inv__dot.is-pending {
    opacity: 0;
    transform: scale(.4);
  }

  .inv__dot.is-visible {
    opacity: 1;
    transform: scale(1);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out);
  }

  .inv__route-svg--tablet,
  .inv__route-svg--laptop,
  .inv__route-svg--desktop {
    display: none;
  }

  .inv :focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  [data-reveal].is-pending {
    opacity: 0;
    transform: translateY(10px);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--duration-reveal) var(--ease-out), transform var(--duration-reveal) var(--ease-out);
  }

  [data-route-target].is-pending {
    transform: none;
  }

  [data-route-target].is-visible {
    transform: none;
    transition: opacity var(--duration-reveal) var(--ease-out);
  }

  .inv-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
