    <section class="pen-closing" aria-labelledby="pen-closing-heading">
      <div class="pen-closing__glow" aria-hidden="true"></div>

      <div class="pen-closing__grid">
        <h2 id="pen-closing-heading" data-reveal>Pojďme zjistit, jak jste na&nbsp;tom s&nbsp;přípravou na&nbsp;penzi.</h2>

        <div class="pen-closing__body" data-reveal>
          <p>
            Ať teprve začínáte, už si pravidelně odkládáte nebo chcete vědět, jestli vám současný plán bude stačit,
            na&nbsp;první konzultaci si ujasníme vaši situaci a&nbsp;další postup.
          </p>

          <div class="pen-closing__actions">
            <a class="pen-cta pen-cta--dark" href="/#kontakt">Nezávazná konzultace</a>
            <a class="pen-phone pen-phone--dark" href="tel:+420775217721">
              <svg class="pen-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path
                  d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { firstLineCenterY } from '../../scripts/first-line';
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  const main = document.querySelector('.pen');
  const routeWrap = document.querySelector('.pen__route');

  if (main && routeWrap) {
    const svgs = Array.from(routeWrap.querySelectorAll('.pen__route-svg')) as SVGSVGElement[];
    const heroSection = main.querySelector('.pen-hero') as HTMLElement | null;
    const heroTextEl = main.querySelector('.pen-hero__text') as HTMLElement | null;
    const closingSection = main.querySelector('.pen-closing') as HTMLElement | null;
    const closingHeading = main.querySelector('.pen-closing__grid h2') as HTMLElement | null;
    const markerTargets = {
      castka: main.querySelector('[data-route-target="castka"]'),
      prijem: main.querySelector('[data-route-target="prijem"]'),
      zdroje: main.querySelector('[data-route-target="zdroje"]'),
      role: main.querySelector('[data-route-target="role"]'),
      kontrola: main.querySelector('[data-route-target="kontrola"]'),
      prubeh: main.querySelector('[data-route-target="prubeh"]'),
      vyuziti: main.querySelector('[data-route-target="vyuziti"]'),
      otazky: main.querySelector('[data-route-target="otazky"]'),
    } as const;

    const HERO_ENTRY_START_Y = 40;
    const HERO_ENTRY_MAX_LENGTH = 100;
    const HERO_ENTRY_MIN_LENGTH = 40;
    const HERO_ENTRY_GAP_BEFORE_BEND = 20;

    const heroArcPath = (entryX: number, axisX: number, r: number, bendY: number, totalHeight: number, entryEndY: number) => {
      const y1 = bendY - r;
      return `M ${entryX} ${entryEndY} V ${y1} A ${r} ${r} 0 0 1 ${entryX - r} ${y1 + r} H ${axisX + r} A ${r} ${r} 0 0 0 ${axisX} ${y1 + 2 * r} V ${totalHeight}`;
    };

    const syncRoute = () => {
      if (!heroSection) return;
      const mainRect = main.getBoundingClientRect();
      if (mainRect.height === 0) return;
      const totalHeight = Math.max(mainRect.height, 1);
      const heroBottom = heroSection.getBoundingClientRect().bottom - mainRect.top;
      const closingTop = closingSection ? closingSection.getBoundingClientRect().top - mainRect.top : totalHeight;

      // Stejná technika jako sourozenci — ohyb 40px pod patou hero textu
      // (H1+lead+CTA), s ochranou 260..heroBottom-20.
      let bendY = 260;
      if (heroTextEl) {
        const textRect = heroTextEl.getBoundingClientRect();
        const textBottom = textRect.bottom - mainRect.top;
        bendY = Math.min(Math.max(textBottom + 40, 260), heroBottom - 20);
      }

      svgs.forEach((svg) => {
        const isActive = getComputedStyle(svg).display !== 'none';
        const nominalVb = parseFloat(svg.dataset.vb ?? '390');
        const axis = parseFloat(svg.dataset.axis ?? '24');
        const dotOffsetPx = parseFloat(svg.dataset.dotOffset ?? '16');
        const isHero = svg.dataset.hero === 'true';
        const r = parseFloat(svg.dataset.radius ?? '0');

        if (!Number.isFinite(nominalVb) || nominalVb <= 0) return;

        const realWidthNow = isActive ? svg.getBoundingClientRect().width : 0;
        const vb = realWidthNow > 0 ? realWidthNow : nominalVb;
        // Tablet: nájezd v poměru k šířce, jinak pevná tierová konstanta.
        const entryRatio = parseFloat(svg.dataset.entryRatio ?? '');
        const entryX = Number.isFinite(entryRatio) ? entryRatio * vb : parseFloat(svg.dataset.entry ?? '0');

        svg.setAttribute('viewBox', `0 0 ${vb} ${totalHeight}`);

        const lightPath = svg.querySelector('.pen__route-path:not(.pen__route-path--dark)') as SVGPathElement | null;
        const darkPath = svg.querySelector('.pen__route-path--dark') as SVGPathElement | null;

        const axisScaled = (axis / nominalVb) * vb;
        const shift = axisScaled - axis;
        // Mobil (28. 9. 2026): trasa jako na tabletu — od osy pod obsahem hero
        // obloukem doprava, po pravé straně nahoru a pod záhlavím končí do
        // ztracena nájezdovým gradientem (barvy LineGradientDefs tier „tablet").
        // Je-li v hero fotka v pozadí (absolutně nahoře), vede linka ZA ní jako
        // na homepage: nahoře vedle hlavy je vidět, za postavou schovaná a v místě,
        // kde se fotka rozpouští, se plynule znovu objeví (úsek „mid" s vlastním
        // gradientem — v průsvitné části fotky by jinak linka prosvítala).
        // Gradienty a pomocné cesty se v mobilním SVG vytvoří jednou za běhu.
        const mobileFramePath = (endY: number): string | null => {
          if (!heroSection) return null;
          const els = Array.from(heroSection.querySelectorAll('[class*="hero__text"], [class*="hero__photo"], [class*="hero__breadcrumb"], nav')) as HTMLElement[];
          const rects = els.map((e) => e.getBoundingClientRect()).filter((r) => r.height > 0);
          if (!rects.length) return null;
          const bottom = Math.max(...rects.map((r) => r.bottom)) - mainRect.top;
          const fr = 18;
          const rightX = (378 / nominalVb) * vb;
          const y0 = 40;
          const yB = bottom + 28;
          const yE = Math.min(140, yB - fr - 20);
          const NS = 'http://www.w3.org/2000/svg';
          const ensure = (cls: string, stops: [string, string, string][]) => {
            let path = svg.querySelector(`path.${cls}`) as SVGPathElement | null;
            let grad = svg.querySelector(`linearGradient.${cls}`) as SVGLinearGradientElement | null;
            if (!path || !grad) {
              const defs = document.createElementNS(NS, 'defs');
              grad = document.createElementNS(NS, 'linearGradient') as SVGLinearGradientElement;
              grad.id = `${cls}-${Math.random().toString(36).slice(2, 9)}`;
              grad.setAttribute('class', cls);
              grad.setAttribute('gradientUnits', 'userSpaceOnUse');
              stops.forEach(([o, c, op]) => {
                const st = document.createElementNS(NS, 'stop');
                st.setAttribute('offset', o);
                st.setAttribute('stop-color', c);
                st.setAttribute('stop-opacity', op);
                grad!.appendChild(st);
              });
              defs.appendChild(grad);
              svg.insertBefore(defs, svg.firstChild);
              path = document.createElementNS(NS, 'path') as SVGPathElement;
              path.setAttribute('class', cls);
              path.setAttribute('fill', 'none');
              path.setAttribute('stroke', `url(#${grad.id})`);
              path.setAttribute('stroke-width', '1');
              path.setAttribute('stroke-linecap', 'round');
              svg.appendChild(path);
            }
            return { path, grad };
          };
          const entry = ensure('route-mobile-entry', [['0%', '#1E7A5C', '0'], ['34%', '#1E7A5C', '.36'], ['70%', '#255E77', '.24'], ['100%', '#1B4A8A', '.18']]);
          entry.grad.setAttribute('x1', String(rightX));
          entry.grad.setAttribute('x2', String(rightX));
          entry.grad.setAttribute('y1', String(y0));
          entry.grad.setAttribute('y2', String(yE));
          entry.path.setAttribute('d', `M ${rightX} ${y0} L ${rightX} ${yE}`);
          let mainStart = yE;
          const bgPhoto = heroSection.querySelector('[class*="hero__photo"]') as HTMLElement | null;
          if (bgPhoto && getComputedStyle(bgPhoto).position === 'absolute') {
            const pr = bgPhoto.getBoundingClientRect();
            const pTop = pr.top - mainRect.top;
            const yA = pTop + pr.height * 0.44;
            // Pod 72 % výšky fotky je postava už skoro rozpuštěná — linka je až do
            // té výšky schovaná (i přes průsvitnou ruku) a objeví se až pod ní.
            const yD = pTop + pr.height * 0.72;
            const yF = Math.min(pTop + pr.height * 0.9, yB - fr - 1);
            if (yF > yE + 20) {
              const span = yF - yE;
              const pA = Math.max(0, Math.min(1, (yA - yE) / span));
              const pC = Math.max(pA, Math.min(1, pA + 12 / span));
              const pD = Math.max(pC, Math.min(1, (yD - yE) / span));
              const mid = ensure('route-mobile-mid', [['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '0'], ['0%', '#1B4A8A', '0'], ['100%', '#1B4A8A', '.18']]);
              const st = mid.grad.querySelectorAll('stop');
              st[1].setAttribute('offset', String(pA));
              st[2].setAttribute('offset', String(pC));
              st[3].setAttribute('offset', String(pD));
              mid.grad.setAttribute('x1', String(rightX));
              mid.grad.setAttribute('x2', String(rightX));
              mid.grad.setAttribute('y1', String(yE));
              mid.grad.setAttribute('y2', String(yF));
              mid.path.setAttribute('d', `M ${rightX} ${yE} L ${rightX} ${yF}`);
              mainStart = yF;
            }
          }
          return `M ${rightX} ${mainStart} V ${yB - fr} A ${fr} ${fr} 0 0 1 ${rightX - fr} ${yB} H ${axisScaled + fr} A ${fr} ${fr} 0 0 0 ${axisScaled} ${yB + fr} V ${endY}`;
        };
        if (isActive) {
          (main as HTMLElement).style.setProperty('--pen-shift', `${shift}px`);
        }

        if (isHero) {
          // Nájezd: délka dopočítaná ze skutečné mezery mezi y=40 a bodem
          // ohybu (bendY-r), ne převzatá jako pevná konstanta odjinud —
          // viz hlavičkový komentář stránky.
          const available = bendY - r - HERO_ENTRY_START_Y - HERO_ENTRY_GAP_BEFORE_BEND;
          const entryLength = Math.min(HERO_ENTRY_MAX_LENGTH, Math.max(HERO_ENTRY_MIN_LENGTH, available));
          const entryEndY = HERO_ENTRY_START_Y + entryLength;

          const gradient = svg.querySelector('linearGradient');
          if (gradient) gradient.setAttribute('y2', String(entryEndY));

          const entryPath = svg.querySelector('.pen__route-entry') as SVGPathElement | null;
          if (entryPath) entryPath.setAttribute('d', `M ${entryX} ${HERO_ENTRY_START_Y} L ${entryX} ${entryEndY}`);

          if (lightPath) lightPath.setAttribute('d', heroArcPath(entryX, axisScaled, r, bendY, closingTop, entryEndY));
        } else if (lightPath) {
          lightPath.setAttribute('d', mobileFramePath(closingTop) ?? `M ${axisScaled} ${heroBottom - 20} V ${closingTop}`);
        }

        const gapBuffer = 20;
        let darkD = `M ${axisScaled} ${closingTop - 20} V ${totalHeight}`;
        if (darkPath && closingHeading) {
          const hRect = closingHeading.getBoundingClientRect();
          const svgRectNow = svg.getBoundingClientRect();
          const axisRealX = svgRectNow.left + axisScaled * (svgRectNow.width / vb);
          if (hRect.width > 0 && axisRealX >= hRect.left && axisRealX <= hRect.right) {
            const gapTop = hRect.top - mainRect.top - gapBuffer;
            const gapBottom = hRect.bottom - mainRect.top + gapBuffer;
            darkD = `M ${axisScaled} ${closingTop - 20} V ${gapTop} M ${axisScaled} ${gapBottom} V ${totalHeight}`;
          }
        }
        if (darkPath) darkPath.setAttribute('d', darkD);

        if (!isActive) return;

        const svgRect = svg.getBoundingClientRect();
        if (svgRect.height === 0 || svgRect.width === 0) return;
        const scaleY = svgRect.height / totalHeight;
        const scaleX = svgRect.width / vb;

        const axisRealX = svgRect.left + axisScaled * scaleX;
        const targetLocalX = (axisRealX + dotOffsetPx - svgRect.left) / scaleX;

        (Object.keys(markerTargets) as Array<keyof typeof markerTargets>).forEach((key) => {
          const target = markerTargets[key];
          const group = svg.querySelector(`[data-marker="${key}"]`);
          if (!target || !group) return;
          const centerY = firstLineCenterY(target);
          const localY = (centerY - svgRect.top) / scaleY;
          const notch = group.querySelector('.pen__notch');
          const dot = group.querySelector('.pen__dot');
          if (notch) {
            notch.setAttribute('y1', String(localY));
            notch.setAttribute('y2', String(localY));
            notch.setAttribute('x1', String(axisScaled));
            notch.setAttribute('x2', String(targetLocalX));
          }
          if (dot) {
            dot.setAttribute('cy', String(localY));
            dot.setAttribute('cx', String(targetLocalX));
          }
        });
      });
    };

    syncRoute();
    window.addEventListener('resize', syncRoute);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(main);
    }

    if (!reduceMotion) {
      const activeSvg = svgs.find((svg) => getComputedStyle(svg).display !== 'none');
      const paths = activeSvg ? (Array.from(activeSvg.querySelectorAll('.pen__route-path')) as SVGPathElement[]) : [];
      const dots = activeSvg ? (Array.from(activeSvg.querySelectorAll('.pen__dot')) as SVGCircleElement[]) : [];
      paths.forEach((path) => {
        const length = path.getTotalLength();
        if (length === 0) return;
        path.style.strokeDasharray = String(length);
        path.style.strokeDashoffset = String(length);
      });
      dots.forEach((dot) => dot.classList.add('is-pending'));
      window.setTimeout(() => {
        paths.forEach((path) => {
          path.style.transition = 'stroke-dashoffset var(--duration-line) var(--ease-out)';
          path.style.strokeDashoffset = '0';
        });
        window.setTimeout(() => {
          dots.forEach((dot) => {
            dot.classList.remove('is-pending');
            dot.classList.add('is-visible');
          });
        }, 450);
      }, 20);
    }

    const revealEls = Array.from(main.querySelectorAll('[data-reveal]')) as HTMLElement[];

    if (!reduceMotion && revealEls.length && 'IntersectionObserver' in window) {
      revealEls.forEach((el) => el.classList.add('is-pending'));

      const groups = new Map<Element | null, HTMLElement[]>();
      revealEls.forEach((el) => {
        const parent = el.closest('section');
        const list = groups.get(parent) ?? [];
        list.push(el);
        groups.set(parent, list);
      });

      const revealGroup = (section: Element | null) => {
        const els = groups.get(section) ?? [];
        const lastDelay = (els.length - 1) * 70;
        els.forEach((el, i) => {
          window.setTimeout(() => {
            el.classList.remove('is-pending');
            el.classList.add('is-visible');
          }, i * 70);
        });
        window.setTimeout(() => syncRoute(), lastDelay + 520);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              revealGroup(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );

      Array.from(main.querySelectorAll('section')).forEach((section) => observer.observe(section));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  }
</script>

<style>
  .pen {
    position: relative;
    background: var(--bg);
    overflow-x: hidden;
  }

  .pen__route {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .pen__route-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .pen__route-path--dark {
    stroke: var(--line-on-dark);
  }

  .pen__notch {
    stroke: var(--line);
    stroke-opacity: .18;
  }

  .pen__dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  .pen__dot.is-pending {
    opacity: 0;
    transform: scale(.4);
  }

  .pen__dot.is-visible {
    opacity: 1;
    transform: scale(1);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out);
  }

  .pen__route-svg--tablet,
  .pen__route-svg--laptop,
  .pen__route-svg--desktop {
    display: none;
  }

  .pen :focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  [data-reveal].is-pending {
    opacity: 0;
    transform: translateY(10px);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--duration-reveal) var(--ease-out), transform var(--duration-reveal) var(--ease-out);
  }

  [data-route-target].is-pending {
    transform: none;
  }

  [data-route-target].is-visible {
    transform: none;
    transition: opacity var(--duration-reveal) var(--ease-out);
  }

  .pen-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding-inline: 30px;
    border-radius: var(--radius-btn);
    background: var(--emerald);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    transition: background-color var(--duration-hover) var(--ease-out);
  }

  .pen-cta:hover {
    background: var(--emerald-hover);
  }

  .pen-cta:active {
    transform: translateY(1px);
  }

  .pen-phone {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--navy);
    font-weight: 600;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    transition: color var(--duration-hover) var(--ease-out);
  }

  .pen-phone__icon {
    width: 19px;
    height: 19px;
    flex: none;
  }

  .pen-phone:hover {
    color: var(--emerald);
  }

  .pen-phone--dark {
    color: var(--white);
  }

  .pen-phone--dark:hover {
    color: var(--emerald-light);
  }

  /* ---------- Drobečková navigace ---------- */

  .pen-breadcrumb {
    margin-bottom: 20px;
  }

  .pen-breadcrumb ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .pen-breadcrumb li:not(:last-child)::after {
    content: '/';
    margin: 0 8px;
    color: var(--text-faint);
  }

  .pen-breadcrumb a {
    color: var(--text-quiet);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .pen-breadcrumb a:hover {
    color: var(--navy);
  }

  /* ---------- Hero ---------- */

  .pen-hero {
    padding: 64px 24px 0;
    display: flex;
    flex-direction: column;
  }

  .pen-hero__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pen-hero__text h1 {
    margin: 0;
    font-size: 38px;
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -.05em;
    color: var(--navy);
    text-wrap: pretty;
  }

  .pen-hero__lead {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
    max-width: 560px;
  }

  .pen-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pen-hero__actions .pen-cta {
    width: 100%;
  }

  .pen-hero__actions .pen-phone {
    height: 48px;
    justify-content: center;
    font-size: 16px;
  }

  /* ---------- Kapitoly — sdílené ---------- */

  .pen-chapter {
    padding: 56px 24px;
  }

  .pen-chapter--castka {
    margin-top: 64px;
    background: var(--bg);
  }

  .pen-chapter__bar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .pen-chapter__bar p {
    margin: 0;
    padding-left: calc(36px + var(--pen-shift, 0px));
    font-weight: 700;
    font-size: 18px;
    color: var(--navy);
  }

  .pen-chapter--castka .pen-chapter__bar p {
    color: var(--emerald);
  }

  .pen-chapter__bar--muted p {
    font-weight: 700;
    color: var(--text-nav);
  }

  .pen-chapter__content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pen-chapter__top {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pen-chapter__lead-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pen-chapter__support-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Příjem: podle zadání §5/§7 má support-col TŘI bloky (odstavec,
     eyebrow+seznam, odstavec) — každý přechod je NOVÝ obsahový blok
     (ne pokračování stejné věty), proto stejný větší gap jako mezi
     hlavními bloky uvnitř kapitoly (32/40px), stejná technika jako
     „Cíl" na investice.astro (viz jeho hlavičkový komentář a CLAUDE.md,
     „mezera MEZI BLOKY"), ne těsných 8px pro pokračující myšlenku. */
  .pen-chapter--prijem .pen-chapter__support-col {
    gap: 32px;
  }

  .pen-chapter__lead-col h2,
  .pen-h2--std {
    margin: 0;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--navy);
    text-wrap: pretty;
  }

  .pen-h2--dominant {
    font-size: 34px;
  }

  .pen-h2--std {
    font-size: 30px;
  }

  .pen-support__text {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text);
  }

  .pen-eyebrow {
    margin: 0 0 4px;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pen-chapter__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pen-chapter__list li {
    font-weight: 600;
    font-size: 16.5px;
    color: var(--navy);
    padding: 12px 0;
    border-bottom: 1px solid rgba(27, 74, 138, .14);
  }

  .pen-chapter__list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Stejná škála pro VŠECHNY ohraničené výrazné věty na téhle stránce
     (Částka/Příjem/Role/Kontrola/Využití) jako `investice.astro`'s
     `.inv-chapter__statement` (22→30px na desktopu). */
  .pen-chapter__statement {
    margin: 0;
    padding-left: 16px;
    border-left: 2px solid var(--emerald);
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--navy);
  }

  /* ---------- Zdroje — významová návaznost (zadání §6, nový prvek) ----------
     Postaveno na vzoru `.fp-chain` z `financni-plan.astro` (velká
     typografická sazba, ne diagram; stejná škála 21/30/36/40px). Vlastní
     `margin-top` je JEDINÝ zdroj mezery k `__top` nad ním — rodičovský
     `gap` je proto u téhle kapitoly vypnutý (`.pen-chapter--zdroje
     .pen-chapter__content{gap:0}` níže), stejná technika jako
     `.fp-chapter__content--souvislosti`, jinak by se obě mezery sečetly
     (CLAUDE.md „Konvence: mezera MEZI BLOKY"). Na mobilu/tabletu (§6:
     „jediné místo, kde se mobil kompozičně liší od desktopu") se šipky
     skrývají a tři pojmy se skládají pod sebe na tiché svislici — ne
     emerald statement svislice, ale `--line` stejně tlumená jako notch
     v trase. */
  .pen-chapter--zdroje .pen-chapter__content {
    gap: 0;
  }

  .pen-navaznost {
    margin: 32px 0 0;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 21px;
    line-height: 1.42;
    font-weight: 500;
    letter-spacing: -.02em;
    color: var(--text-muted);
  }

  .pen-navaznost__term {
    font-weight: 700;
    color: var(--navy);
  }

  .pen-navaznost__sep {
    display: none;
  }

  /* ---------- Role — plné řádky s h3 názvem+popisem ---------- */

  .pen-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .pen-rows__row {
    padding: 18px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pen-rows__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* Poslední řádek bez spodního odsazení — konec bloku určuje padding kapitoly. */
  .pen-rows__row:last-child {
    padding-bottom: 0;
  }

  .pen-rows__name {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }

  .pen-rows__text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Průběh ---------- */

  .pen-h2--prubeh {
    max-width: 560px;
  }

  .pen-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 38px;
  }

  .pen-step {
    position: relative;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pen-step__marker {
    position: absolute;
    top: 13px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-quiet);
    transform: translateY(-50%);
  }

  .pen-step--first .pen-step__marker {
    width: 8px;
    height: 8px;
    background: var(--emerald);
  }

  .pen-step__connector {
    position: absolute;
    top: 13px;
    bottom: -51px;
    left: 3px;
    width: 1px;
    background: rgba(27, 74, 138, .18);
  }

  .pen-step--first .pen-step__connector {
    left: 3.5px;
  }

  .pen-step h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--navy-ink);
  }

  .pen-step--first h3 {
    font-size: 21px;
  }

  .pen-step p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  /* ---------- Otázky ---------- */

  .pen-faq {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .pen-faq__row {
    padding: 18px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pen-faq__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* Poslední řádek bez spodního odsazení — konec bloku určuje padding kapitoly. */
  .pen-faq__row:last-child {
    padding-bottom: 0;
  }

  .pen-faq dt {
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
  }

  .pen-faq dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Tmavé CTA ---------- */

  .pen-closing {
    position: relative;
    margin-top: 64px;
    padding-block: 56px;
    overflow: hidden;
    background: linear-gradient(168deg, var(--router-grad-1) 0%, var(--navy) 58%, var(--router-grad-2) 100%);
  }

  .pen-closing__glow {
    position: absolute;
    inset: 0;
    top: 0;
    height: 260px;
    background: radial-gradient(44% 60% at 76% 24%, rgba(46, 152, 115, .13) 0%, rgba(46, 152, 115, 0) 74%);
    pointer-events: none;
  }

  .pen-closing__grid {
    position: relative;
    z-index: 2;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pen-closing__grid h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--white);
    text-wrap: pretty;
  }

  .pen-closing__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pen-closing__body p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, .72);
  }

  .pen-closing__actions {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pen-closing__actions .pen-cta {
    width: 100%;
  }

  .pen-closing__actions .pen-phone {
    height: 48px;
    justify-content: center;
    font-size: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ============ Mobil (<768): obsah od popisku u tečky, ne na lince ============
     Popisek kapitoly stojí 36 px od kraje sekce (osa 24 + zářez) — obsah
     kapitol i závěrečné sekce začíná na stejné svislici, jako na tabletu
     (28. 9. 2026, dřív nadpisy a text ležely přímo na lince). */
  @media (max-width: 767px) {
    .pen-chapter__content {
      padding-left: calc(36px + var(--pen-shift, 0px));
    }

    .pen-closing__grid {
      padding-left: calc(60px + var(--pen-shift, 0px));
    }
  }

  /* ============ Tablet: 768–1199 (kalibrace 834) ============ */
  @media (min-width: 768px) {
    .pen__route-svg--mobile {
      display: none;
    }

    .pen__route-svg--tablet {
      display: block;
    }

    .pen-chapter__bar p {
      padding-left: calc(64px + var(--pen-shift, 0px));
    }

    /* Obsah kapitol od popisku u tečky (osa 40 + 64 = 104 px), ne na ose —
       dřív nadpisy a text ležely přímo na lince. Stejně jako /pristup
       a /sluzby/hypoteky (28. 9. 2026). */
    .pen-chapter__content {
      padding-left: calc(64px + var(--pen-shift, 0px));
    }

    /* Na tabletu nadpis kapitoly NAD textem přes celou šířku (ne dva sloupce
       vedle sebe) — stejně jako /o-mne (28. 9. 2026, přání uživatele).
       Vedle sebe až od notebooku (pravidla přesunutá do bloku 1200+). */
    .pen-chapter__top {
      max-width: 640px;
    }

    .pen-hero {
      padding: 88px 40px 0;
    }

    .pen-hero__text {
      gap: 20px;
    }

    .pen-hero__text h1 {
      font-size: 52px;
      line-height: 1.04;
    }

    .pen-hero__lead {
      font-size: 17.5px;
      max-width: 600px;
    }

    .pen-hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 28px;
    }

    .pen-hero__actions .pen-cta {
      width: auto;
      padding-inline: 28px;
    }

    .pen-hero__actions .pen-phone {
      height: auto;
    }

    .pen-chapter--castka {
      margin-top: 80px;
      padding: 72px 40px;
    }

    .pen-chapter {
      padding: 72px 40px;
    }

    .pen-chapter__bar p {
      font-size: 21px;
    }

    .pen-chapter__bar--muted p {
      font-size: 18px;
    }

    .pen-h2--dominant {
      font-size: 44px;
    }

    .pen-h2--std {
      font-size: 40px;
    }

    .pen-support__text {
      font-size: 18px;
    }

    .pen-chapter__list li {
      font-size: 17px;
    }

    .pen-chapter__statement {
      font-size: 24px;
    }

    .pen-rows__name {
      font-size: 20px;
    }

    .pen-step h3 {
      font-size: 22px;
    }

    .pen-step--first h3 {
      font-size: 24px;
    }

    .pen-faq dt {
      font-size: 19px;
    }

    .pen-navaznost {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0;
      padding-left: 0;
      border-left: none;
      margin-top: 48px;
      font-size: 30px;
    }

    .pen-navaznost__sep {
      display: inline;
      margin: 0 10px;
      font-weight: 500;
      color: var(--text-muted);
    }

    .pen-rows__row {
      display: grid;
      grid-template-columns: 250px 1fr;
      /* gap: 0 za column-gap ho dřív vynuloval — text těsně u názvu (4. 10. 2026). */
      gap: 0 32px;
      align-items: baseline;
    }

    .pen-chapter--prijem .pen-chapter__support-col {
      gap: 40px;
    }

    .pen-steps {
      gap: 44px;
    }

    .pen-step__marker {
      display: block;
      top: 14px;
      width: 8px;
      height: 8px;
    }

    .pen-step--first .pen-step__marker {
      width: 9px;
      height: 9px;
    }

    .pen-step__connector {
      display: block;
      top: 14px;
      bottom: -58px;
      left: 3.5px;
    }

    .pen-step--first .pen-step__connector {
      left: 4px;
    }

    .pen-closing {
      margin-top: 80px;
      padding-block: 76px;
    }

    /* Text od linky odsazený stejně jako obsah kapitol (osa + 64 px). */
    .pen-closing__grid {
      padding-inline: 40px;
      padding-left: calc(104px + var(--pen-shift, 0px));
    }

    .pen-closing__grid h2 {
      font-size: 44px;
    }

    .pen-closing__body p {
      font-size: 17px;
    }

    .pen-closing__actions {
      flex-direction: row;
      gap: 32px;
    }

    .pen-closing__actions .pen-cta {
      width: auto;
      padding-inline: 28px;
    }

    .pen-closing__actions .pen-phone {
      height: auto;
    }
  }

  /* ============ Jen tablet (768–1199): hero text jako homepage ============
     Stejná velikost nadpisu, úvodního textu a odstupy jako Hero.astro,
     /pristup a /o-mne na tabletu (28. 9. 2026, sjednocení na přání
     uživatele). Bez fotky, proto nadpis širší (11em místo 490 px). */
  @media (min-width: 768px) and (max-width: 1199px) {
    .pen-hero {
      padding-top: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
      /* Místo pod tlačítky pro oblouk linky (ohyb 40 px pod textem). */
      padding-bottom: 64px;
    }

    .pen-hero__text {
      gap: 0;
    }

    .pen-hero__text h1 {
      max-width: 11em;
      font-size: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
      line-height: .99;
    }

    .pen-hero__lead {
      margin-top: 60px;
      max-width: 520px;
      font-size: clamp(16.5px, calc(16.5px + 0.004699 * (100vw - 834px)), 19px);
    }

    .pen-hero__actions {
      margin-top: 46px;
      gap: clamp(32px, calc(32px + 0.007519 * (100vw - 834px)), 36px);
    }
  }

  /* ============ Notebook: 1200–1399 (kalibrace 1366) ============ */
  @media (min-width: 1200px) {
    /* Dva sloupce vedle sebe (dřív už od tabletu, teď od notebooku). */
    .pen-chapter__top {
      max-width: none;
    }

    .pen-chapter__top {
      max-width: none;
      flex-direction: row;
      align-items: flex-start;
      gap: 40px;
    }

    .pen-chapter--castka .pen-chapter__lead-col,
    .pen-chapter--prijem .pen-chapter__lead-col,
    .pen-chapter--zdroje .pen-chapter__lead-col,
    .pen-chapter--role .pen-chapter__lead-col,
    .pen-chapter--vyuziti .pen-chapter__lead-col {
      flex: none;
      width: 300px;
    }

    .pen-chapter--castka .pen-chapter__support-col,
    .pen-chapter--prijem .pen-chapter__support-col,
    .pen-chapter--zdroje .pen-chapter__support-col,
    .pen-chapter--role .pen-chapter__support-col,
    .pen-chapter--vyuziti .pen-chapter__support-col {
      flex: 1;
    }

    .pen__route-svg--tablet {
      display: none;
    }

    .pen__route-svg--laptop {
      display: block;
    }

    /* 56 = (osa 96 + zářez 36 + mezera 20) − section padding 96. */
    .pen-chapter__bar p {
      padding-left: calc(56px + var(--pen-shift, 0px));
    }

    .pen-hero__text {
      max-width: 580px;
      gap: 18px;
    }

    .pen-hero__text h1 {
      font-size: 64px;
      line-height: 1.02;
      letter-spacing: -.052em;
    }

    .pen-hero__lead {
      font-size: 19px;
    }

    .pen-hero__actions {
      flex-direction: row;
      margin-top: 4px;
    }

    .pen-hero {
      padding: 112px 96px 90px;
    }

    .pen-chapter--castka {
      margin-top: 100px;
      padding: 88px 96px;
    }

    .pen-chapter {
      padding: 88px 96px;
      display: flex;
      align-items: flex-start;
      gap: 56px;
    }

    .pen-chapter__bar {
      flex: none;
      width: 240px;
      margin-bottom: 0;
    }

    .pen-chapter__bar p {
      font-size: 24px;
    }

    .pen-chapter__bar--muted p {
      font-size: 19px;
    }

    .pen-chapter__content {
      flex: 1;
      padding-left: 0;
    }

    .pen-chapter__content--single {
      gap: 40px;
    }

    .pen-h2--dominant {
      font-size: 50px;
    }

    .pen-h2--std {
      font-size: 44px;
    }

    .pen-chapter__statement {
      font-size: 28px;
    }

    .pen-chapter__top {
      gap: 60px;
    }

    .pen-chapter--castka .pen-chapter__lead-col,
    .pen-chapter--prijem .pen-chapter__lead-col,
    .pen-chapter--zdroje .pen-chapter__lead-col,
    .pen-chapter--role .pen-chapter__lead-col,
    .pen-chapter--vyuziti .pen-chapter__lead-col {
      width: 540px;
    }

    .pen-chapter--kontrola .pen-chapter__content {
      flex-direction: row;
      justify-content: space-between;
      gap: 60px;
    }

    .pen-chapter__lead-col {
      flex: none;
      width: 540px;
    }

    .pen-chapter__support-col {
      flex: 1;
    }

    .pen-navaznost {
      font-size: 36px;
      margin-top: 48px;
    }

    .pen-rows__row {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 16px 0;
    }

    .pen-rows__name {
      font-size: 22px;
    }

    .pen-rows__text {
      font-size: 17px;
    }

    .pen-h2--prubeh {
      max-width: 600px;
    }

    .pen-steps {
      max-width: 600px;
    }

    .pen-step {
      padding-left: 56px;
    }

    .pen-step__marker {
      top: 15px;
    }

    .pen-step__connector {
      top: 15px;
      bottom: -59px;
    }

    .pen-step h3 {
      font-size: 22px;
    }

    .pen-step--first h3 {
      font-size: 24px;
    }

    .pen-faq {
      max-width: 900px;
    }

    .pen-faq__row {
      display: grid;
      grid-template-columns: 340px 1fr;
      column-gap: 56px;
