---
/**
 * Stránka /sluzby/penze — detail páté (poslední) služby. Zdroj pravdy pro
 * OBSAH, pořadí sekcí a role: úkol „Úkol pro Claude Code — podstránka
 * /sluzby/penze" (8. 9. 2026) + `docs/content-subpages.md`, kapitola
 * `/sluzby/penze` (kompletní, NÁVRH K UŽIVATELSKÉMU SCHVÁLENÍ — copy
 * převzata doslovně, beze změny). Zdroj pravdy pro VŠECHNY hodnoty
 * sdílené kostry (osa, pruh, zářez, vnitřní rozpad, hero padding, gap
 * mezi pruhem a obsahem, velikost/barva kotev, technika ohybu v hero,
 * typografická škála): `src/pages/sluzby/investice.astro` — na výslovné
 * přání uživatele, sekundárně `pojisteni.astro`/`financni-plan.astro`/
 * `hypoteky.astro`.
 *
 * ROZPOR MEZI ZADÁNÍM A SKUTEČNOU IMPLEMENTACÍ SOUROZENCŮ (nahlášeno,
 * ne mlčky vyřešeno) — §8 zadání „Nájezd trasy — dvě podmínky" popisuje
 * nájezdový gradient i ohyb trasy umístěný v mezeře MEZI hero a první
 * kapitolou (nájezd začíná pod spodní hranou hero). Žádná ze čtyř
 * sourozeneckých stránek (hypoteky/financni-plan/pojisteni/investice)
 * tuhle geometrii neimplementuje — všechny mají nájezd na OPAČNÉM konci
 * hero (hned pod hlavičkou, y=40–140) a ohyb UVNITŘ hero (těsně pod
 * textem/CTA). Explicitně dotázáno v tomto sezení — uživatel potvrdil
 * ponechat techniku sourozenců beze změny (viz §1 zadání: „pokud pro
 * nějakou roli v sourozencích nenajdeš vzor, zastav se a zeptej").
 * `entryLength` se stejně jako v `investice.astro` dopočítává za běhu ze
 * skutečné mezery mezi y=40 a bodem ohybu (`bendY - r`), ne z pevné
 * konstanty — to je zavedená technika investice.astro, ne odchylka.
 *
 * Mapování osmi kapitol zadání na strukturní vzory `investice.astro`/
 * `pojisteni.astro` (žádná nová kompozice, jen převzetí existujícího
 * vzoru pro danou roli; nová je jen kapitola Zdroje, viz níže):
 * 1) Částka (dominantní) — vzor „Cíl" na investice.astro MINUS
 *    eyebrow+seznam (tady žádný není): `__top` řádek (lead-col H2 +
 *    support-col se třemi odstavci, dva z nich přesunuté z `/sluzby`),
 *    statement na smaragdové svislici.
 * 2) Příjem — vzor „Cíl" 1:1 (eyebrow+seznam v support-col), ale
 *    NAVÍC třetí blok — odstavec PO seznamu (podle zadání §7) — support-col
 *    má tři bloky (odstavec, eyebrow+seznam, odstavec), každý oddělený
 *    stejným větším gapem jako přechod na seznam u „Cíl".
 * 3) Zdroje — NOVÝ prvek „významová návaznost" (zadání §6), který
 *    v žádném sourozenci neexistuje. Postaven na vzoru `.fp-chain`
 *    z `financni-plan.astro` (velká typografická sazba, ne diagram,
 *    stejná škála 21/30/36/40px, `margin-top` jako jediný zdroj mezery
 *    k `__top` nad ním — `gap` rodiče vypnutý stejnou technikou jako
 *    `.fp-chapter__content--souvislosti`). Na mobilu/tabletu se šipky
 *    (`aria-hidden`) skrývají a tři pojmy se skládají pod sebe na tiché
 *    svislici (`--line`, ne emerald statement svislice) — jediné místo
 *    na stránce, kde se mobilní kompozice liší od desktopu (zadání §6).
 * 4) Role — vzor „Rozpočet"/„Riziko" na investice.astro (`__top` +
 *    `rows` + statement), ale řádky nesou `<h3>` místo `<span>` (zadání
 *    §12, přístupnostní požadavek pro tuhle konkrétní kapitolu — jen tři
 *    položky, ne pět).
 * 5) Kontrola — vzor „Portfolio" na investice.astro 1:1 (statement hned
 *    pod H2 v lead-col, dva odstavce v support-col, normální barva pruhu)
 *    — v zadání §5 výslovně potvrzeno jako stejný půdorys.
 * 6) Průběh — vzor „Průběh" 1:1, šest kroků (stejně jako investice.astro).
 * 7) Využití — vzor „Riziko" MINUS rows (jen `__top` + statement,
 *    normální barva pruhu — zadání u ní na rozdíl od Otázek neuvádí
 *    tlumenou barvu).
 * 8) Otázky — vzor „Otázky" 1:1 (tlumený pruh, FAQ dl/dt/dd, šest otázek).
 *
 * TRASA — stejná technika jako investice.astro: jedna souvislá cesta od
 * hero až po tmavé závěrečné CTA, `axisScaled` procentuální přepočet pro
 * wide-desktop stage, nájezdový gradient s dynamicky dopočítanou délkou
 * jen na desktopu/notebooku (tablet/mobil hero bez trasy vůbec), OSM
 * kotev (castka/prijem/zdroje/role/kontrola/prubeh/vyuziti/otazky),
 * tmavé CTA bez kotvy/zářezu.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineGradientDefs from '../../components/LineGradientDefs.astro';
import { PERSON_ID, breadcrumbList } from '../../data/entity';

const SERVICE_NAME = 'Plánování penze a důchodu';
const SERVICE_DESCRIPTION =
  'Pomohu vám spočítat, jaký majetek budete potřebovat na penzi a jak ho postupně vytvářet. Plánování penze v Ostravě nebo online po celé ČR.';
const penzeJsonLd = [
  {
    '@type': 'Service',
    name: SERVICE_NAME,
    description: SERVICE_DESCRIPTION,
    url: 'https://patrikgajdadzis.cz/sluzby/penze',
    provider: { '@id': PERSON_ID },
    areaServed: [
      { '@type': 'City', name: 'Ostrava' },
      { '@type': 'Country', name: 'Česko' },
    ],
  },
  breadcrumbList([
    { name: 'Domů', path: '/' },
    { name: 'Služby', path: '/sluzby' },
    { name: SERVICE_NAME, path: '/sluzby/penze' },
  ]),
];

const prijemItems: string[] = [
  'požadovaný měsíční příjem',
  'očekávané výdaje',
  'bydlení a závazky',
  'předpokládaný věk odchodu do penze',
  'dobu, po kterou má vlastní majetek sloužit',
];

interface RowItem {
  name: string;
  text: string;
}

const roleItems: RowItem[] = [
  { name: 'Penzijní produkty', text: 'Doplňkové penzijní spoření a dlouhodobý investiční produkt mohou mít v plánu svou roli — podrobnosti k jejich pravidlům a podmínkám patří do samostatných odborných článků, kde je lze průběžně aktualizovat.' },
  { name: 'Dlouhodobé investice', text: 'Mohou sloužit k vytváření majetku pro budoucí příjem, ale nesou riziko a jejich vhodnost závisí na konkrétní situaci klienta.' },
  { name: 'Další majetek', text: 'Součástí plánu může být i další majetek, pokud může v budoucnu přinášet příjem nebo být využit k financování penze.' },
];

interface Step {
  heading: string;
  text: string;
}

const steps: Step[] = [
  { heading: 'Ujasníme si váš cíl', text: 'Jaký příjem budete chtít mít a kdy chcete začít využívat vytvořený majetek.' },
  { heading: 'Projdeme současné zdroje', text: 'Státní důchod podle dostupných podkladů, úspory, investice, penzijní produkty a další relevantní majetek.' },
  { heading: 'Spočítáme potřebný majetek', text: 'Odhadneme, kolik bude potřeba vytvořit a jakou část mohou pokrýt současné prostředky a budoucí pravidelné investice.' },
  { heading: 'Nastavíme další postup', text: 'Podíváme se na vhodné možnosti podle času, rizika, dostupnosti peněz a vašich ostatních finančních priorit.' },
  { heading: 'Pomohu s realizací', text: 'Pokud se rozhodnete doporučené kroky provést, pomohu vám s jejich nastavením.' },
  { heading: 'K plánu se budeme vracet', text: 'Když se změní příjem, cíle, majetek nebo pravidla, má smysl plán znovu projít a případně upravit.' },
];

interface Faq {
  q: string;
  a: string;
}

const faqs: Faq[] = [
  { q: 'Kdy je nejlepší začít řešit penzi?', a: 'Čím více času máte, tím větší prostor zpravidla získáte pro postupné vytváření majetku. Smysl ale má začít i později. Důležité je zjistit, jaká je vaše současná situace a jaké možnosti ještě máte.' },
  { q: 'Kolik si mám měsíčně odkládat na penzi?', a: 'Záleží na požadovaném příjmu, době do penze, současném majetku a předpokladech použitého výpočtu. Univerzální částka proto neexistuje. Nejdřív potřebujeme spočítat váš konkrétní cíl.' },
  { q: 'Stačí mi doplňkové penzijní spoření?', a: 'To záleží na tom, kolik odkládáte, jak dlouho, jak jsou prostředky investované a jaký majetek chcete vytvořit. Penzijní spoření může být užitečnou součástí plánu, ale samo o sobě nezaručuje, že budete mít v penzi dostatek peněz.' },
  { q: 'Jaký je rozdíl mezi DPS a DIP?', a: 'Jde o odlišné způsoby dlouhodobého zajištění na stáří s různými pravidly a možnostmi investování. Při výběru je potřeba zohlednit konkrétní podmínky, náklady, riziko, dostupnost prostředků a případné daňové výhody. Aktuální pravidla projdeme podle vaší situace.' },
  { q: 'Co když už mám penzijní spoření nebo investice?', a: 'Nejdřív se podíváme na současné nastavení. Pokud odpovídá vašemu cíli, není důvod ho měnit jen kvůli změně poradce.' },
  { q: 'Můžu si naplánovat penzi dříve než ve státním důchodovém věku?', a: 'Ano. Pokud chcete přestat pracovat dříve nebo postupně omezit pracovní příjem, můžeme spočítat, jaký vlastní majetek byste k tomu potřebovali. Výsledek závisí na vašich cílech, současných prostředcích a použitých předpokladech.' },
];
---

<BaseLayout
  title="Plánování penze a důchodu | Patrik Gajdadzis"
  description={SERVICE_DESCRIPTION}
  jsonLd={penzeJsonLd}
>
  <Header />
  <main id="hero" class="pen">
    <div class="pen__route" aria-hidden="true">
      {
        [
          { tier: 'mobile', vb: 390, axis: 24, dotOffset: 22, hero: false, entry: 0, r: 0 },
          // Tablet: nájezd shora v 90 % šířky (jako notebook), obloukem pod hero
          // textem k ose — stejně jako /pristup a /o-mne (28. 9. 2026).
          { tier: 'tablet', vb: 834, axis: 40, dotOffset: 44, hero: true, entry: 750, entryRatio: 0.9, r: 22 },
          { tier: 'laptop', vb: 1366, axis: 96, dotOffset: 36, hero: true, entry: 1230, r: 28 },
          { tier: 'desktop', vb: 1440, axis: 120, dotOffset: 36, hero: true, entry: 1300, r: 28 },
        ].map((v) => (
          <svg
            class={`pen__route-svg pen__route-svg--${v.tier}`}
            viewBox={`0 0 ${v.vb} 2600`}
            preserveAspectRatio="none"
            focusable="false"
            data-vb={v.vb}
            data-axis={v.axis}
            data-dot-offset={v.dotOffset}
            data-hero={String(v.hero)}
            data-entry={v.entry}
            data-entry-ratio={v.entryRatio}
            data-radius={v.r}
          >
            {v.hero && (
              <defs>
                <LineGradientDefs id={`pen-line-entry-${v.tier}`} tier={v.tier === 'desktop' ? 'desktop' : v.tier === 'tablet' ? 'tablet' : 'laptop'} x1={v.entry} y1={40} x2={v.entry} y2={140} />
              </defs>
            )}
            <path class="pen__route-path" d={`M ${v.axis} -20 V 2600`} fill="none" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {v.hero && (
              <path
                class="pen__route-path pen__route-entry"
                d={`M ${v.entry} 40 L ${v.entry} 140`}
                fill="none"
                stroke={`url(#pen-line-entry-${v.tier})`}
                stroke-width="1"
                stroke-linecap="round"
              />
            )}
            <path class="pen__route-path pen__route-path--dark" d="M 0 0 V 0" fill="none" stroke="var(--line-on-dark)" stroke-opacity=".3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {(['castka', 'prijem', 'zdroje', 'role', 'kontrola', 'prubeh', 'vyuziti', 'otazky'] as const).map((marker) => (
              <g class="pen__marker" data-marker={marker}>
                <line class="pen__notch" x1={v.axis} y1="0" x2={v.axis} y2="0" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" />
                <circle class="pen__dot" cx={v.axis} cy="0" r={v.tier === 'mobile' || v.tier === 'tablet' ? 3.2 : 3.5} fill="var(--emerald)" />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <section class="pen-hero" aria-labelledby="pen-hero-heading">
      <nav class="pen-breadcrumb" aria-label="Drobečková navigace">
        <ol>
          <li><a href="/sluzby">Služby</a></li>
          <li aria-current="page">Penze</li>
        </ol>
      </nav>

      <div class="pen-hero__text">
        <h1 id="pen-hero-heading" data-reveal>Na&nbsp;penzi potřebujete plán, ne jen penzijní produkt.</h1>
        <p class="pen-hero__lead" data-reveal>
          Nejdřív si ujasníme, jaký příjem budete chtít mít, kdy chcete přestat pracovat a&nbsp;jaký majetek už
          vytváříte. Potom spočítáme, kolik bude potřeba postupně odkládat a&nbsp;jakou roli mohou mít ve&nbsp;vašem
          plánu investice, penzijní produkty nebo další majetek.
        </p>
        <div class="pen-hero__actions" data-reveal>
          <a class="pen-cta" href="/#kontakt">Nezávazná konzultace</a>
          <a class="pen-phone" href="tel:+420775217721">
            <svg class="pen-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
          </a>
        </div>
      </div>
    </section>

    <section class="pen-chapter pen-chapter--castka" aria-labelledby="castka-heading">
      <div class="pen-chapter__bar" data-reveal data-route-target="castka">
        <p>Částka</p>
      </div>

      <div class="pen-chapter__content">
        <div class="pen-chapter__top">
          <div class="pen-chapter__lead-col" data-reveal>
            <h2 id="castka-heading" class="pen-h2--dominant">Důležitější než název produktu je vědět, kolik budete potřebovat.</h2>
          </div>
          <div class="pen-chapter__support-col" data-reveal>
            <p class="pen-support__text">
              Mít penzijní spoření ještě neznamená mít vyřešenou penzi. Stejně tak samotná výše pravidelného
              příspěvku neříká, jestli vám vytvořený majetek bude stačit.
            </p>
            <p class="pen-support__text">
              Nejdřív potřebujeme vědět, jaký příjem budete chtít mít, kolik let zbývá do&nbsp;penze a&nbsp;jaký
              majetek už vytváříte.
            </p>
            <p class="pen-support__text">
              Z&nbsp;toho lze určit, kolik bude potřeba dlouhodobě odkládat a&nbsp;jakou roli mají ve&nbsp;vašem
              plánu investice, penzijní produkty nebo další majetek.
            </p>
          </div>
        </div>

        <p class="pen-chapter__statement" data-reveal>
          Cílem není mít penzijko. Cílem je mít z&nbsp;čeho žít.
        </p>
      </div>
    </section>

    <section class="pen-chapter pen-chapter--prijem" aria-labelledby="prijem-heading">
      <div class="pen-chapter__bar" data-reveal data-route-target="prijem">
        <p>Příjem</p>
      </div>

      <div class="pen-chapter__content">
        <div class="pen-chapter__top">
          <div class="pen-chapter__lead-col" data-reveal>
            <h2 id="prijem-heading" class="pen-h2--std">Začněme tím, jak chcete v&nbsp;penzi žít.</h2>
          </div>
          <div class="pen-chapter__support-col" data-reveal>
            <p class="pen-support__text">
              Někdo chce po&nbsp;skončení kariéry výrazně omezit výdaje. Jiný chce cestovat, pomáhat dětem nebo
              si zachovat podobnou životní úroveň jako dnes. Od&nbsp;toho se&nbsp;odvíjí i&nbsp;částka, kterou bude
              potřeba vytvořit.
            </p>
            <div class="pen-prijem__list-block">
              <p class="pen-eyebrow">Při plánování řešíme</p>
              <ul class="pen-chapter__list">
                {prijemItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <p class="pen-support__text">
              Důležité je počítat také s&nbsp;tím, že za&nbsp;několik desetiletí budou mít peníze jinou kupní sílu
              než dnes.
            </p>
          </div>
        </div>

        <p class="pen-chapter__statement" data-reveal>
          Nejdřív si určeme, jaký život má majetek financovat. Potom můžeme počítat, kolik ho bude potřeba.
        </p>
      </div>
    </section>

    <section class="pen-chapter pen-chapter--zdroje" aria-labelledby="zdroje-heading">
      <div class="pen-chapter__bar" data-reveal data-route-target="zdroje">
        <p>Zdroje</p>
      </div>

      <div class="pen-chapter__content">
        <div class="pen-chapter__top">
          <div class="pen-chapter__lead-col" data-reveal>
            <h2 id="zdroje-heading" class="pen-h2--std">Možná už máte část penze vyřešenou. Možná zatím nevíte, jak velkou.</h2>
          </div>
          <div class="pen-chapter__support-col" data-reveal>
            <p class="pen-support__text">
              Při plánování se&nbsp;podíváme na&nbsp;dostupný odhad státního důchodu, současné úspory, investice,
              penzijní produkty a&nbsp;další majetek, který může v&nbsp;budoucnu přinášet příjem nebo sloužit
              k&nbsp;financování penze.
            </p>
            <p class="pen-support__text">
              Potom můžeme odhadnout rozdíl mezi příjmem, který budete chtít mít, a&nbsp;prostředky, které už máte
              nebo pravděpodobně vytvoříte.
            </p>
          </div>
        </div>

        <p class="pen-navaznost" data-reveal>
          <span class="pen-navaznost__term">Požadovaný příjem</span>
          <span class="pen-navaznost__sep" aria-hidden="true">→</span>
          <span class="pen-navaznost__term">dostupné zdroje</span>
          <span class="pen-navaznost__sep" aria-hidden="true">→</span>
          <span class="pen-navaznost__term">částka, kterou je potřeba vytvořit.</span>
        </p>
      </div>
    </section>

    <section class="pen-chapter pen-chapter--role" aria-labelledby="role-heading">
      <div class="pen-chapter__bar" data-reveal data-route-target="role">
        <p>Role</p>
      </div>

      <div class="pen-chapter__content">
        <div class="pen-chapter__top">
          <div class="pen-chapter__lead-col" data-reveal>
            <h2 id="role-heading" class="pen-h2--std">Penzijní produkt je jedna z&nbsp;možností.<br class="br-mobile" /> Ne celý plán.</h2>
          </div>
          <div class="pen-chapter__support-col" data-reveal>
            <p class="pen-support__text">
              Doplňkové penzijní spoření, dlouhodobý investiční produkt, běžné investice nebo další majetek mohou
              mít při přípravě na&nbsp;penzi různé role. Liší se&nbsp;pravidly, dostupností peněz, náklady,
              rizikem i&nbsp;případnými daňovými výhodami nebo příspěvky zaměstnavatele.
            </p>
            <p class="pen-support__text">
              Nejdřív proto potřebujeme vědět, co má konkrétní část majetku plnit. Až potom dává smysl vybírat
              způsob, jakým ji budete vytvářet.
            </p>
          </div>
        </div>

        <ul class="pen-rows" data-reveal>
          {
            roleItems.map((r) => (
              <li class="pen-rows__row">
                <h3 class="pen-rows__name">{r.name}</h3>
                <span class="pen-rows__text">{r.text}</span>
              </li>
            ))
          }
        </ul>

        <p class="pen-chapter__statement" data-reveal>
          Výhoda produktu má smysl jen tehdy, když zapadá do&nbsp;vašeho plánu.
        </p>
      </div>
    </section>

    <section class="pen-chapter pen-chapter--kontrola" aria-labelledby="kontrola-heading">
      <div class="pen-chapter__bar" data-reveal data-route-target="kontrola">
