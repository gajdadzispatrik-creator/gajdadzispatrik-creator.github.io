      </div>

      <div class="pen-chapter__content pen-chapter__content--single">
        <h2 id="prubeh-heading" class="pen-h2--std pen-h2--prubeh" data-reveal>Od&nbsp;představy o&nbsp;penzi ke&nbsp;konkrétnímu plánu.</h2>

        <ol class="pen-steps" data-reveal>
          {
            steps.map((step, i) => (
              <li class={`pen-step${i === 0 ? ' pen-step--first' : ''}`}>
                <span class="pen-step__marker" aria-hidden="true"></span>
                {i < steps.length - 1 && <span class="pen-step__connector" aria-hidden="true"></span>}
