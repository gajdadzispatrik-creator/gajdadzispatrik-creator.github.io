    }

    .hyp-areas__text {
      font-size: 17px;
    }

    /*
     * OPRAVA 1. 9. 2026 (uživatel si všiml, že sloupce na stránce nesedí) —
     * `#steps-heading` (Průběh) není zabalený v `.hyp-chapter__lead-col`
     * (má vlastní H2 mimo něj, sdílí sloupec se seznamem kroků), takže
     * neměl ŽÁDNÝ strop šířky a táhl se přes celou šířku obsahu (799px) —
     * širší než vlastní obsah pod ním (`.hyp-steps`, 640px). Sjednoceno na
     * stejnou šířku jako `.hyp-steps`, aby nadpis a jeho vlastní obsah
     * sdílely stejnou pravou hranu (640px zůstává i po přechodu ostatních
     * kapitol na „roztáhlejší" styl — je to prakticky stejná šířka jako
     * jejich 600px na desktopu).
     */
    #steps-heading {
      max-width: 640px;
    }

    /* Průběh: kotva top:15px (účaří nadpisu), osa odbočky 56px vlevo od
       textu, spojnice bottom: -(mezera 44 + odsazení 15) = -59px — `gap`
       MUSÍ být přesně 44px, jinak spojnice nedosáhne (nebo přesáhne) střed
       následující kotvy. */
    .hyp-steps {
