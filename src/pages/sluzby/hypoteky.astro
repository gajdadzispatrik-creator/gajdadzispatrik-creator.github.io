---
/**
 * Stránka /sluzby/hypoteky — detail hlavní služby. Zdroj pravdy pro
 * rozvržení: úkol „Úkol pro Claude Code — podstránka /sluzby/hypoteky“
 * (1. 9. 2026). Zdroj pravdy pro chování trasy: `src/pages/sluzby.astro`
 * (sourozenecká stránka — stejná osa/zářez/nájezd/axisScaled technika,
 * jen 6 kotev místo 4). Texty přesně podle `docs/content-subpages.md`,
 * kapitola `/sluzby/hypoteky` — copy je STAV „NÁVRH K UŽIVATELSKÉMU
 * SCHVÁLENÍ“, viz souhrn úkolu. NESMÍ jít do produkce bez potvrzení textů.
 *
 * Rozpory/mezery v zadání, které jsem řešil vlastním úsudkem (nahlášeno
 * v souhrnu úkolu, ne mlčky):
 * 1) Zadání říká „tři odstavce přesunuté z /sluzby ... použij je na
 *    místech podle §4“, ale `content-subpages.md`'s vlastní „Archivní
 *    poznámka“ u těchto tří vět výslovně říká, že jejich obsah je už
 *    rozpracovaný (jinou, rozšířenou formulací) v sekcích 1 a 5 návrhu
 *    copy a „jako samostatné věty se v aktuální copy nepoužívají“.
 *    `content-subpages.md` je zdroj pravdy pro copy (§1 zadání) — jeho
 *    vlastní poznámka má přednost, takže tyto tři věty NEJSOU na stránce
 *    použité jako samostatné věty; jejich obsah je už obsažen v Hero a
 *    v kapitole Fáze/Průběh podle schváleného návrhu.
 * 2) Text popisku sloupce kapitoly Rozhodnutí byl původně „Při návrhu
 *    řešení sleduji i“ (doslovně podle §6 zadání) — na výslovné přání
 *    uživatele (1. 9. 2026) zkráceno o koncové „i“ na „Při návrhu řešení
 *    sleduji“.
 * 3) Typografické velikosti nadpisů jednotlivých fází (kapitola Fáze) na
 *    tabletu/mobilu nejsou v zadání dané (jen desktop 30/26px, notebook
 *    „ostatní proporce jako desktop“) — odvozeno proporčně z ostatních
 *    typografických kroků stránky (tablet 26/22px, mobil 22/19px).
 *    Stejně tak vodorovný odsun osy odbočky Průběhu (56px od textu) na
 *    tabletu není v zadání restatnutý — ponechán 56px (zadání dává jiné
 *    číslo jen pro mobil, 22px).
 * 4) Vizuální styl drobečkové navigace (velikost/barva/oddělovač) není v
 *    zadání specifikovaný pixelově — zvolen v souladu s existujícím
 *    „quiet“ textovým stylem webu (13px, `--text-quiet`/`--text-muted`).
 *
 * TRASA — stejná technika jako `sluzby.astro` (viz jeho hlavičkový
 * komentář a CLAUDE.md „Konvence: kontinuální linka, tečky a text“ +
 * „Konvence: wide desktop a centrované designové plátno“): jedna souvislá
 * cesta od hero až po tmavé závěrečné CTA, `axisScaled` procentuální
 * přepočet pro wide-desktop stage (nad `--stage-max`), nájezdový gradient
 * v hero jen na desktopu/notebooku (tablet/mobil hero bez trasy — v hero
 * není bezkolizní koridor, stejný důvod jako na `/sluzby`), 6 kotev
 * (faze/rozhodnuti/oblasti/prubeh/souvislosti/otazky), tmavé CTA bez
 * kotvy/zářezu, jen svislice v `--line-on-dark`. Osa/zářez/mezera kotva→
 * text jsou STEJNÉ hodnoty jako na `/sluzby` (120/96/40/24 · 36/36/44/22 ·
 * 20/20/20/14), takže veškerá route-CSS/JS je z `sluzby.astro` převzatá
 * beze změny čísel, jen s přejmenovanými klíči kotev.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineGradientDefs from '../../components/LineGradientDefs.astro';
import { PERSON_ID, breadcrumbList } from '../../data/entity';

const SERVICE_NAME = 'Hypotéky a financování bydlení';
const SERVICE_DESCRIPTION =
  'Pomohu vám zjistit, na jakou nemovitost dosáhnete, vyřídit hypotéku, refinancování, výstavbu nebo rekonstrukci. Ostrava nebo online po celé ČR.';
const hypotekyJsonLd = [
  {
    '@type': 'Service',
    name: SERVICE_NAME,
    description: SERVICE_DESCRIPTION,
    url: 'https://patrikgajdadzis.cz/sluzby/hypoteky',
    provider: { '@id': PERSON_ID },
    areaServed: [
      { '@type': 'City', name: 'Ostrava' },
      { '@type': 'Country', name: 'Česko' },
    ],
  },
  breadcrumbList([
    { name: 'Domů', path: '/' },
    { name: 'Služby', path: '/sluzby' },
    { name: SERVICE_NAME, path: '/sluzby/hypoteky' },
  ]),
];

interface Phase {
  heading: string;
  highlight?: string;
  paragraphs: string[];
}

const phases: Phase[] = [
  {
    heading: 'Teprve hledáte nemovitost',
    highlight: 'To je ideální chvíle začít.',
    paragraphs: [
      'Nejdřív zjistíme, v jaké ceně můžete nemovitost bezpečně hledat, kolik budete potřebovat vlastních peněz a jaká splátka odpovídá vašemu rozpočtu.',
      'Díky tomu nehledáte naslepo a víte, jaký prostor skutečně máte.',
    ],
  },
  {
    heading: 'Už máte nemovitost vybranou',
    highlight: 'Pak rozhodují i termíny.',
    paragraphs: [
      'Prověříme možnosti financování, podmínky banky a kroky, které je potřeba stihnout podle rezervace a průběhu obchodu.',
    ],
  },
  {
    heading: 'Hypotéku už máte',
    paragraphs: [
      'Podíváme se, zda dává smysl refinancování, změna úvěru, navýšení nebo úprava financování podle vaší současné situace.',
    ],
  },
];

const decisionPoints: string[] = [
  'kolik vlastních prostředků použít,',
  'jak vysoká splátka je dlouhodobě rozumná,',
  'jakou rezervu si ponechat,',
  'podmínky jednotlivých možností financování,',
  'termíny obchodu a čerpání,',
  'možnosti budoucích změn hypotéky.',
];

interface AreaRow {
  name: string;
  text: string;
}

const areaRows: AreaRow[] = [
  { name: 'Koupě bytu nebo domu', text: 'Financování vlastní nemovitosti včetně nastavení vlastních zdrojů a výše úvěru.' },
  { name: 'Výstavba', text: 'Nastavení financování podle průběhu stavby a postupného čerpání.' },
  { name: 'Rekonstrukce', text: 'Hypotéka nebo jiné vhodné financování rekonstrukce podle jejího rozsahu.' },
  { name: 'Refinancování', text: 'Posouzení stávající hypotéky a možností před koncem fixace nebo při jiné vhodné příležitosti.' },
  { name: 'Změna nebo navýšení hypotéky', text: 'Pokud se od sjednání úvěru změnila vaše situace nebo potřebujete další prostředky.' },
];

interface Step {
  heading: string;
  paragraphs: string[];
}

const steps: Step[] = [
  {
    heading: 'Nejdřív spočítáme možnosti',
    paragraphs: [
      'Projdeme příjmy, závazky, vlastní prostředky a plánované bydlení.',
      'Výsledkem je reálný rámec, ve kterém se můžeme pohybovat.',
    ],
  },
  { heading: 'Vybereme vhodné financování', paragraphs: ['Porovnám možnosti podle vaší situace a vysvětlím vám rozdíly, které jsou pro rozhodnutí skutečně důležité.'] },
  { heading: 'Připravíme podklady', paragraphs: ['Řešíme potřebné dokumenty, ocenění nemovitosti a další podmínky pro schválení.'] },
  { heading: 'Schválení a smlouvy', paragraphs: ['Hlídám průběh schvalování a kroky potřebné k podpisu úvěrové dokumentace.'] },
  { heading: 'Čerpání', paragraphs: ['Zkontrolujeme splnění podmínek banky a dotáhneme financování až k čerpání.'] },
];

interface Faq {
  q: string;
  a: string;
}

const faqs: Faq[] = [
  { q: 'Kdy je nejlepší začít řešit hypotéku?', a: 'Ideálně ještě před výběrem konkrétní nemovitosti. Budete předem vědět, na jakou cenu můžete reálně dosáhnout, kolik potřebujete vlastních peněz a jaká splátka je pro vás rozumná.' },
  { q: 'Co když už mám podepsanou rezervaci?', a: 'Pak je potřeba vycházet z konkrétních termínů a podmínek obchodu. Projdeme aktuální situaci a stanovíme další postup podle toho, co už je podepsané a co je potřeba stihnout.' },
  { q: 'Kolik vlastních peněz budu potřebovat?', a: 'Záleží na ceně nemovitosti, jejím ocenění, vašich možnostech a konkrétním způsobu financování. Proto tuto část počítám ještě před tím, než se definitivně nastaví úvěr.' },
  { q: 'Řešíte také refinancování?', a: 'Ano. Stejně tak změny nebo navýšení stávající hypotéky.' },
  { q: 'Musím kvůli hypotéce řešit i ostatní finance?', a: 'Ne. Pokud přijdete kvůli hypotéce, prioritou je hypotéka. Další témata mají smysl otevírat pouze tehdy, pokud jsou pro vaši situaci relevantní.' },
  { q: 'Jak probíhá první konzultace?', a: 'Přibližně 30 minut. Probereme, co řešíte, v jaké jste fázi a jaký by měl být další krok. Konzultace je nezávazná a může proběhnout osobně v Ostravě-Porubě nebo online.' },
];
---

<!--
  SEO title ZMĚNĚN oproti `docs/content-subpages.md` (tam „návrh“, ne
  „schváleno“: „Hypotéky a financování bydlení | Patrik Gajdadzis“) — úkol
  „Předspouštěcí P0 technické dotažení“, §8, výslovně žádá „Hypoteční
  poradce Ostrava | Patrik Gajdadzis“ pro intent „hypoteční poradce
  Ostrava“/„hypotéky Ostrava“. H1 („Hypotéka má začít čísly, ne
  podpisem.“) i meta description beze změny.
-->
<BaseLayout
  title="Hypoteční poradce Ostrava | Patrik Gajdadzis"
  description={SERVICE_DESCRIPTION}
  jsonLd={hypotekyJsonLd}
>
  <Header />
  <main id="hero" class="hyp">
    <div class="hyp__route" aria-hidden="true">
      {
        [
          { tier: 'mobile', vb: 390, axis: 24, dotOffset: 22, hero: false, entry: 0, r: 0 },
          { tier: 'tablet', vb: 834, axis: 40, dotOffset: 44, hero: false, entry: 0, r: 0 },
          { tier: 'laptop', vb: 1366, axis: 96, dotOffset: 36, hero: true, entry: 1230, r: 28 },
          { tier: 'desktop', vb: 1440, axis: 120, dotOffset: 36, hero: true, entry: 1300, r: 28 },
        ].map((v) => (
          <svg
            class={`hyp__route-svg hyp__route-svg--${v.tier}`}
            viewBox={`0 0 ${v.vb} 2400`}
            preserveAspectRatio="none"
            focusable="false"
            data-vb={v.vb}
            data-axis={v.axis}
            data-dot-offset={v.dotOffset}
            data-hero={String(v.hero)}
            data-entry={v.entry}
            data-radius={v.r}
          >
            {v.hero && (
              <defs>
                {/*
                  Nájezdový gradient — stejná technika jako `sluzby.astro`
                  (CLAUDE.md „Konvence: nájezdový gradient jen na SKUTEČNÉM
                  začátku linky“): tahle stránka má vlastní hero, tedy
                  vlastní začátek trasy. y1/y2 musí sedět s
                  HERO_ENTRY_START_Y/HERO_ENTRY_LENGTH v <script> níže.
                */}
                <LineGradientDefs id={`hyp-line-entry-${v.tier}`} tier={v.tier === 'desktop' ? 'desktop' : 'laptop'} x1={v.entry} y1={40} x2={v.entry} y2={140} />
              </defs>
            )}
            <path class="hyp__route-path" d={`M ${v.axis} -20 V 2400`} fill="none" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {v.hero && (
              <path
                class="hyp__route-path hyp__route-entry"
                d={`M ${v.entry} 40 L ${v.entry} 140`}
                fill="none"
                stroke={`url(#hyp-line-entry-${v.tier})`}
                stroke-width="1"
                stroke-linecap="round"
              />
            )}
            <path class="hyp__route-path hyp__route-path--dark" d="M 0 0 V 0" fill="none" stroke="var(--line-on-dark)" stroke-opacity=".3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {(['faze', 'rozhodnuti', 'oblasti', 'prubeh', 'souvislosti', 'otazky'] as const).map((marker) => (
              <g class="hyp__marker" data-marker={marker}>
                <line class="hyp__notch" x1={v.axis} y1="0" x2={v.axis} y2="0" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" />
                <circle class="hyp__dot" cx={v.axis} cy="0" r={v.tier === 'mobile' || v.tier === 'tablet' ? 3.2 : 3.5} fill="var(--emerald)" />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <section class="hyp-hero" aria-labelledby="hyp-hero-heading">
      <nav class="hyp-breadcrumb" aria-label="Drobečková navigace">
        <ol>
          <li><a href="/sluzby">Služby</a></li>
          <li aria-current="page">
            <span class="hyp-breadcrumb__full">Hypotéky a&nbsp;bydlení</span>
            <span class="hyp-breadcrumb__short">Hypotéky</span>
          </li>
        </ol>
      </nav>

      <div class="hyp-hero__text">
        <h1 id="hyp-hero-heading" data-reveal>Hypotéka má začít čísly, ne podpisem.</h1>
        <p class="hyp-hero__lead" data-reveal>
          Nejdřív zjistíme, jaké financování je pro&nbsp;vás reálně dostupné, kolik vlastních peněz budete potřebovat
          a&nbsp;jaká splátka dává smysl pro&nbsp;váš rozpočet. Potom hledáme konkrétní řešení a&nbsp;dotáhneme ho až po&nbsp;čerpání.
        </p>
        <div class="hyp-hero__actions" data-reveal>
          <a class="hyp-cta" href="/#kontakt">Nezávazná konzultace</a>
          <a class="hyp-phone" href="tel:+420775217721">
            <svg class="hyp-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
          </a>
        </div>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--faze" aria-labelledby="faze-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="faze">
        <p>Fáze</p>
      </div>

      <div class="hyp-chapter__content hyp-chapter__content--faze">
        <div class="hyp-chapter__lead-col" data-reveal>
          <h2 id="faze-heading" class="hyp-h2--faze">Hypotéku řeší každý v&nbsp;jiné fázi.</h2>
          <p class="hyp-chapter__lead">
            Někdo ještě nemá vybranou nemovitost. Jiný už podepsal rezervaci. A&nbsp;někdo potřebuje upravit hypotéku,
            kterou několik let splácí. Podle toho se&nbsp;liší i&nbsp;další postup.
          </p>
        </div>

        <ul class="hyp-phases" data-reveal>
          {
            phases.map((phase, i) => (
              <li class={`hyp-phase${i === 0 ? ' hyp-phase--first' : ''}`}>
                <h3>{phase.heading}</h3>
                {phase.highlight && <p class="hyp-phase__highlight">{phase.highlight}</p>}
                <div class="hyp-phase__body">
                  {phase.paragraphs.map((p) => <p class="hyp-phase__text">{p}</p>)}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--decision" aria-labelledby="decision-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="rozhodnuti">
        <p>Rozhodnutí</p>
      </div>

      <div class="hyp-chapter__content">
        <div class="hyp-chapter__lead-col" data-reveal>
          <div class="hyp-decision__intro">
            <h2 id="decision-heading" class="hyp-h2--std">Dobrá hypotéka není jen úroková sazba.</h2>
            <p class="hyp-chapter__lead">Sazba je důležitá. Ale sama o&nbsp;sobě neříká, jestli je financování nastavené dobře.</p>
          </div>
          <blockquote class="hyp-decision__quote">
            Cílem není dostat od&nbsp;banky co nejvyšší úvěr. Cílem je financovat bydlení tak, aby vám po&nbsp;zaplacení
            splátky dál fungoval život.
          </blockquote>
        </div>

        <div class="hyp-chapter__list-col" data-reveal>
          <p class="hyp-chapter__list-label">Při návrhu řešení sleduji</p>
          <ul class="hyp-chapter__list">
            {decisionPoints.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--areas" aria-labelledby="areas-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="oblasti">
        <p>Oblasti</p>
      </div>

      <div class="hyp-chapter__content hyp-chapter__content--single">
        <div class="hyp-chapter__lead-col" data-reveal>
          <h2 id="areas-heading" class="hyp-h2--std">Od&nbsp;prvního propočtu až po&nbsp;čerpání.</h2>
          <p class="hyp-chapter__lead">
            Hypotéka pro&nbsp;mě nekončí schválením úvěru. Řeším s&nbsp;vámi celý proces až po&nbsp;čerpání a&nbsp;hlídám i&nbsp;další
            důležité termíny.
          </p>
        </div>

        <ul class="hyp-areas" data-reveal>
          {
            areaRows.map((row) => (
              <li class="hyp-areas__row">
                <span class="hyp-areas__name">{row.name}</span>
                <span class="hyp-areas__text">{row.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--steps" aria-labelledby="steps-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="prubeh">
        <p>Průběh</p>
      </div>

      <div class="hyp-chapter__content hyp-chapter__content--single">
        <h2 id="steps-heading" class="hyp-h2--std" data-reveal>V&nbsp;každém kroku víte, co se&nbsp;právě řeší.</h2>

        <ol class="hyp-steps" data-reveal>
          {
            steps.map((step, i) => (
              <li class={`hyp-step${i === 0 ? ' hyp-step--first' : ''}`}>
                <span class="hyp-step__marker" aria-hidden="true"></span>
                {i < steps.length - 1 && <span class="hyp-step__connector" aria-hidden="true"></span>}
                <h3>{step.heading}</h3>
                <div class="hyp-step__body">
                  {step.paragraphs.map((p) => <p>{p}</p>)}
                </div>
              </li>
            ))
          }
        </ol>

        <p class="hyp-steps__closing">
          A&nbsp;ani potom hypotéku nemusíte hlídat sami. Důležité budoucí termíny má smysl řešit s&nbsp;předstihem, ne až ve&nbsp;chvíli, kdy hoří.
        </p>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--context" aria-labelledby="context-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="souvislosti">
        <p>Souvislosti</p>
      </div>

      <div class="hyp-chapter__content">
        <div class="hyp-chapter__lead-col" data-reveal>
          <h2 id="context-heading" class="hyp-h2--context">Bydlení nemá spolknout celý finanční plán.</h2>
          <p class="hyp-chapter__lead">Hypotéka bývá jeden z&nbsp;největších finančních závazků v&nbsp;životě.</p>
          <p class="hyp-chapter__lead">
            Proto při jejím nastavení dává smysl přemýšlet nejen nad tím, kolik banka půjčí, ale také nad rezervou,
            běžnými výdaji a&nbsp;tím, co chcete dělat s&nbsp;penězi v&nbsp;dalších letech.
          </p>
        </div>

        <div class="hyp-chapter__statement-col" data-reveal>
          <h3 class="hyp-chapter__statement">Co budete chtít řešit dál, je na&nbsp;vás.</h3>
          <div class="hyp-chapter__statement-body">
            <p class="hyp-chapter__statement-intro">Pokud za&nbsp;mnou přijdete jen kvůli hypotéce, vyřešíme nejdřív hypotéku.</p>
            <p class="hyp-chapter__statement-intro">
              Když při tom narazíme na&nbsp;něco, co má pro&nbsp;financování bydlení skutečný význam, vysvětlím vám proč.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="hyp-chapter hyp-chapter--faq" aria-labelledby="otazky-heading">
      <div class="hyp-chapter__bar" data-reveal data-route-target="otazky">
        <p id="otazky-heading">Otázky</p>
      </div>

      <div class="hyp-chapter__content hyp-chapter__content--single">
        <dl class="hyp-faq" data-reveal>
          {
            faqs.map((faq) => (
              <div class="hyp-faq__row">
                <dt>{faq.q}</dt>
                <dd>{faq.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="hyp-closing" aria-labelledby="hyp-closing-heading">
      <div class="hyp-closing__glow" aria-hidden="true"></div>

      <div class="hyp-closing__grid">
        <h2 id="hyp-closing-heading" data-reveal>Než uděláte další krok, pojďme si ověřit čísla.</h2>

        <div class="hyp-closing__body" data-reveal>
