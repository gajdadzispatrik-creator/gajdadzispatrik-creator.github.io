    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .hyp-chapter__bar p {
    margin: 0;
    padding-left: calc(36px + var(--hyp-shift, 0px));
    font-weight: 700;
    font-size: 21px;
    color: var(--navy);
  }

  /* Fáze je dominantní kapitola: smaragdový pruh, žádná barevná plocha
     ani podtržení — jen barva textu/kotvy. */
  .hyp-chapter--faze .hyp-chapter__bar p {
    color: var(--emerald);
  }

  .hyp-chapter__content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Levý okraj kapitol na tabletu/mobilu — obsah pod pruhem se zarovnává
     na stejnou osu jako text pruhu (osa+zářez+mezera), ne jen na okraj
     sekce (§8/§9 zadání: „Levý okraj kapitol 104/60 px“). */
  .hyp-chapter__content {
    padding-left: 0;
  }

  .hyp-chapter__lead-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /*
   * OPRAVA 1. 9. 2026 (uživatel: kapitola Rozhodnutí „moc namačkaná na
   * sebe“) — citace (`.hyp-decision__quote`) je vizuálně zvýrazněný blok
   * (smaragdová svislice) a potřebuje od úvodního textu víc odstupu než
   * standardní nadpis→text mezera (14px). H2+úvodní text zůstávají svázané
   * ve vlastním `.hyp-decision__intro` (gap 14px, v souladu s konvencí
   * „mezera nadpis → úvodní text“ v CLAUDE.md) — vnější `gap` na
   * `.hyp-chapter__lead-col` je pro tuhle kapitolu zvětšený, takže jde jen
   * o mezeru intro→citace, ne o zásah do H2→text (jeden zdroj mezery na
   * každé úrovni, ne kombinace gap+margin).
   */
  .hyp-decision__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hyp-chapter--decision .hyp-chapter__lead-col {
    gap: 28px;
  }

  .hyp-chapter__lead-col h2,
  .hyp-h2--std {
    margin: 0;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--navy);
    text-wrap: pretty;
  }

  /* Čtyři velikostní skupiny H2 (§6–§9 zadání): Fáze (dominantní,
     největší), "ostatní" (Rozhodnutí/Oblasti/Průběh, sdílí jednu
     velikost), Souvislosti (tlumená, menší) a CTA (`.hyp-closing__grid
     h2`, řešeno samostatně níže). Modifikátorové třídy místo spoléhání
     na vnoření do `.hyp-chapter__lead-col`, protože Průběh má svůj H2
     mimo lead-col (sdílí sloupec se seznamem kroků). */
  .hyp-h2--faze {
    font-size: 34px;
  }

  .hyp-h2--std {
    font-size: 30px;
  }

  .hyp-h2--context {
    font-size: 28px;
  }

  .hyp-chapter__lead {
    margin: 0;
    font-size: 17.5px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--navy);
    max-width: 520px;
  }

  .hyp-chapter__list-label {
    margin: 0 0 4px;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-quiet);
  }

  .hyp-chapter__list li {
    font-weight: 600;
    font-size: 16.5px;
    color: var(--navy);
    padding: 12px 0;
    border-bottom: 1px solid rgba(27, 74, 138, .14);
  }

  .hyp-chapter__list li:last-child {
    border-bottom: none;
  }

  .hyp-decision__quote {
    margin: 0;
    padding-left: 16px;
    border-left: 2px solid var(--emerald);
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
    font-style: normal;
