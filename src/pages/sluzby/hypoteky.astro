    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--navy);
  }

  /* ---------- Fáze ---------- */

  .hyp-phases {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /*
   * OPRAVA 1. 9. 2026 (sjednocení řádkování stejně jako u kapitoly
   * Rozhodnutí) — `gap: 8px` bylo nápadně těsnější než 14px používaných
   * jinde na stránce pro vztah nadpis→text (h3, zvýrazněná věta, odstavec
   * jsou stejná rodina prvků jako H2+úvodní text+citace u Rozhodnutí).
   */
  .hyp-phase {
    padding-top: 28px;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hyp-phase--first {
    padding-top: 0;
    border-top: none;
  }

  .hyp-phase h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--navy);
  }

  .hyp-phase--first h3 {
    font-size: 26px;
  }

  .hyp-phase__highlight {
    margin: 0;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--emerald);
  }

  /*
   * OPRAVA 1. 9. 2026 (uživatel: „tady nemá být tak velké řádkování mezi
   * větami pod nadpisem") — `.hyp-phase`'s 14px gap je správný mezi
   * nadpisem/zvýrazněnou větou a odstavcem, ale MEZI DVĚMA odstavci, které
   * jsou pokračováním jedné myšlenky (fáze 1 má dvě věty), je 14px příliš
   * velké. Samostatný obal s menším gapem — `.hyp-phase` gap (14px) se tak
   * uplatní jen jednou, mezi h3/highlight a CELÝM textovým blokem.
   */
  .hyp-phase__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hyp-phase__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  /* ---------- Oblasti ---------- */

  .hyp-areas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  /* OPRAVA 1. 9. 2026 (sjednocení řádkování) — 6px bylo nekonzistentní s
     14px, které pro vztah název/nadpis→text stránka používá jinde (Fáze,
     Rozhodnutí, Oblasti/Průběh lead-col…). Platí jen do notebooku — od
     1200px `.hyp-areas__row` přechází na dvousloupcový grid vedle sebe
     (`gap: 0` tam, viz níže), kde svislá mezera nedává smysl. */
  .hyp-areas__row {
    padding: 20px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hyp-areas__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .hyp-areas__name {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }

  .hyp-areas__text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Průběh ---------- */

  /* Mobil (§9 zadání): odbočka trasy MÁ být viditelná i tady, jen s
     menšími hodnotami (odsazení osy 22px, mezera 38px, odsazení kotvy
     13px) — ne skrytá jako na zbytku stránky, kde hero nemá trasu vůbec
     (Průběh je samostatná, na hero nezávislá dekorace). */
  /* Bez vlastního `margin-top` — mezera k H2 nad seznamem už jde ze
     `.hyp-chapter__content`'s `gap` (32px base / 40px od notebooku),
     dvojí mezera (gap + margin) by dala víc, než je konzistentní s
     ostatními kapitolami. */
  .hyp-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 38px;
  }

  /* OPRAVA 1. 9. 2026 (sjednocení řádkování) — 6px bylo nekonzistentní
     s 14px, které stránka jinde používá pro vztah nadpis→text. */
  .hyp-step {
    position: relative;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hyp-step h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--navy);
  }

  .hyp-step--first h3 {
    font-size: 21px;
  }

  /*
   * OPRAVA 1. 9. 2026 (stejný důvod jako `.hyp-phase__body` výše) — mezi
   * dvěma větami jednoho kroku (krok 1 má dvě věty) je 14px z `.hyp-step`
   * příliš velké, patří tam menší mezera pokračující myšlenky.
   */
  .hyp-step__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hyp-step p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  /* `translateY(-50%)` — `top`/`odsazení kotvy` popisuje STŘED kotvy (kam
     míří i konec spojnice předchozího kroku), ne horní hranu jejího boxu;
     bez centrování by menší (8px) a větší (9px, první krok) kotva měly
     mírně jiný skutečný střed, i když sdílí stejnou hodnotu `top`. */
  .hyp-step__marker {
    position: absolute;
    top: 13px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-quiet);
    transform: translateY(-50%);
  }

  .hyp-step--first .hyp-step__marker {
    width: 8px;
    height: 8px;
    background: var(--emerald);
  }

  .hyp-step__connector {
    position: absolute;
    top: 13px;
    bottom: -51px;
    left: 3px;
    width: 1px;
    background: rgba(27, 74, 138, .18);
  }

  .hyp-step--first .hyp-step__connector {
    left: 3.5px;
  }

  .hyp-steps__closing {
    margin: 0;
    padding-left: 22px;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--navy);
  }

  /* ---------- Otázky ---------- */

  .hyp-faq {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* OPRAVA 1. 9. 2026 (sjednocení řádkování) — 8px bylo nekonzistentní
     s 14px, které stránka jinde používá pro vztah nadpis→text. Platí jen
     do notebooku — od 1200px `.hyp-faq__row` přechází na dvousloupcový
     grid vedle sebe (viz níže), kde svislá mezera nedává smysl. */
  .hyp-faq__row {
    padding: 20px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hyp-faq__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .hyp-faq dt {
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
  }

  .hyp-faq dd {
