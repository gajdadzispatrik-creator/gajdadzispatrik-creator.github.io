<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const main = document.querySelector('.hyp');
  const routeWrap = document.querySelector('.hyp__route');

  if (main && routeWrap) {
    const svgs = Array.from(routeWrap.querySelectorAll('.hyp__route-svg')) as SVGSVGElement[];
    const heroSection = main.querySelector('.hyp-hero') as HTMLElement | null;
    const heroTextEl = main.querySelector('.hyp-hero__text') as HTMLElement | null;
    const closingSection = main.querySelector('.hyp-closing') as HTMLElement | null;
    const closingHeading = main.querySelector('.hyp-closing__grid h2') as HTMLElement | null;
    const markerTargets = {
      faze: main.querySelector('[data-route-target="faze"]'),
      rozhodnuti: main.querySelector('[data-route-target="rozhodnuti"]'),
      oblasti: main.querySelector('[data-route-target="oblasti"]'),
      prubeh: main.querySelector('[data-route-target="prubeh"]'),
      souvislosti: main.querySelector('[data-route-target="souvislosti"]'),
      otazky: main.querySelector('[data-route-target="otazky"]'),
    } as const;

    // Stejná hodnota/technika jako `sluzby.astro` — nájezd s viditelným
    // odstupem od hlavičky (y=40), ne slepený na její hranici.
    const HERO_ENTRY_START_Y = 40;
    const HERO_ENTRY_LENGTH = 100;

    // Stejná technika jako `sluzby.astro`'s `heroArcPath` — hlavní oblouk
    // začíná AŽ na konci nájezdového gradientu, ne na jeho začátku, aby se
    // obě cesty na úseku nájezdu nepřekrývaly (CLAUDE.md „nájezdová a
    // navazující cesta se nikdy nesmí překrývat“).
    const heroArcPath = (entryX: number, axisX: number, r: number, bendY: number, totalHeight: number) => {
      const y1 = bendY - r;
      return `M ${entryX} ${HERO_ENTRY_START_Y + HERO_ENTRY_LENGTH} V ${y1} A ${r} ${r} 0 0 1 ${entryX - r} ${y1 + r} H ${axisX + r} A ${r} ${r} 0 0 0 ${axisX} ${y1 + 2 * r} V ${totalHeight}`;
    };

    const syncRoute = () => {
      if (!heroSection) return;
      const mainRect = main.getBoundingClientRect();
      const totalHeight = Math.max(mainRect.height, 1);
      const heroBottom = heroSection.getBoundingClientRect().bottom - mainRect.top;
      const closingTop = closingSection ? closingSection.getBoundingClientRect().top - mainRect.top : totalHeight;

      svgs.forEach((svg) => {
        const isActive = getComputedStyle(svg).display !== 'none';
        const nominalVb = parseFloat(svg.dataset.vb ?? '390');
        const axis = parseFloat(svg.dataset.axis ?? '24');
        const dotOffsetPx = parseFloat(svg.dataset.dotOffset ?? '16');
        const isHero = svg.dataset.hero === 'true';
        const entryX = parseFloat(svg.dataset.entry ?? '0');
        const r = parseFloat(svg.dataset.radius ?? '0');

        const realWidthNow = isActive ? svg.getBoundingClientRect().width : 0;
        const vb = realWidthNow > 0 ? realWidthNow : nominalVb;

        svg.setAttribute('viewBox', `0 0 ${vb} ${totalHeight}`);

        const lightPath = svg.querySelector('.hyp__route-path:not(.hyp__route-path--dark)') as SVGPathElement | null;
        const darkPath = svg.querySelector('.hyp__route-path--dark') as SVGPathElement | null;

        // `axisScaled` — stejná OPRAVA jako `sluzby.astro` (CLAUDE.md
        // „Konvence: wide desktop a centrované designové plátno“): pod
        // `--stage-max` no-op, nad ní se celá trasa posune vpravo jako
        // jeden nepřerušený celek, žádný zákrut/hák.
        const axisScaled = (axis / nominalVb) * vb;
        const shift = axisScaled - axis;
        // Nastavit `--hyp-shift` jen z AKTIVNÍHO (viditelného) SVG — smyčka
        // prochází všechny čtyři tiery a bez tohoto stráže by poslední
        // (desktop), i když zrovna `display:none`, vždy přepsal hodnotu
        // nulou (jeho `vb` padá zpět na `nominalVb`, když je neaktivní).
        // Nalezeno při implementaci — stejná chyba existuje i v
        // `sluzby.astro`, ten ale nesmím podle zadání měnit.
        if (isActive) {
          (main as HTMLElement).style.setProperty('--hyp-shift', `${shift}px`);
        }

        if (isHero && heroTextEl) {
          const textRect = heroTextEl.getBoundingClientRect();
          const textBottom = textRect.bottom - mainRect.top;
          const bendY = Math.min(Math.max(textBottom + 40, 260), heroBottom - 20);
          if (lightPath) lightPath.setAttribute('d', `${heroArcPath(entryX, axisScaled, r, bendY, closingTop)}`);
        } else if (lightPath) {
          lightPath.setAttribute('d', `M ${axisScaled} ${heroBottom - 20} V ${closingTop}`);
        }

        // Stejná mezera-v-čáře technika jako `sluzby.astro` u nadpisu
        // tmavého CTA — pokud by osa reálně padla do vodorovného rozsahu
        // nadpisu „Než uděláte další krok...“, čára se v tom úseku (+20px
        // rezerva) vynechá. Na kalibračních šířkách k tomu nedochází
        // (nadpis je vlevo, osa vpravo od něj), ale kontrola zůstává
        // aktivní pro libovolnou budoucí změnu layoutu CTA.
        const gapBuffer = 20;
        let darkD = `M ${axisScaled} ${closingTop - 20} V ${totalHeight}`;
        if (darkPath && closingHeading) {
          const hRect = closingHeading.getBoundingClientRect();
          const svgRectNow = svg.getBoundingClientRect();
          const axisRealX = svgRectNow.left + axisScaled * (svgRectNow.width / vb);
          if (hRect.width > 0 && axisRealX >= hRect.left && axisRealX <= hRect.right) {
            const gapTop = hRect.top - mainRect.top - gapBuffer;
            const gapBottom = hRect.bottom - mainRect.top + gapBuffer;
            darkD = `M ${axisScaled} ${closingTop - 20} V ${gapTop} M ${axisScaled} ${gapBottom} V ${totalHeight}`;
          }
        }
        if (darkPath) darkPath.setAttribute('d', darkD);

        if (!isActive) return;

        const svgRect = svg.getBoundingClientRect();
        if (svgRect.height === 0 || svgRect.width === 0) return;
        const scaleY = svgRect.height / totalHeight;
        const scaleX = svgRect.width / vb;
        svg.style.setProperty('--dot-fix', String(scaleY / scaleX));

        const axisRealX = svgRect.left + axisScaled * scaleX;
        const targetLocalX = (axisRealX + dotOffsetPx - svgRect.left) / scaleX;

        (Object.keys(markerTargets) as Array<keyof typeof markerTargets>).forEach((key) => {
          const target = markerTargets[key];
          const group = svg.querySelector(`[data-marker="${key}"]`);
          if (!target || !group) return;
          const rect = target.getBoundingClientRect();
          const centerY = rect.top + rect.height / 2;
          const localY = (centerY - svgRect.top) / scaleY;
          const notch = group.querySelector('.hyp__notch');
          const dot = group.querySelector('.hyp__dot');
          if (notch) {
            notch.setAttribute('y1', String(localY));
            notch.setAttribute('y2', String(localY));
            notch.setAttribute('x1', String(axisScaled));
            notch.setAttribute('x2', String(targetLocalX));
          }
          if (dot) {
            dot.setAttribute('cy', String(localY));
            dot.setAttribute('cx', String(targetLocalX));
          }
        });
      });
    };

    syncRoute();
    window.addEventListener('resize', syncRoute);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(main);
    }

    if (!reduceMotion) {
      const activeSvg = svgs.find((svg) => getComputedStyle(svg).display !== 'none');
      const paths = activeSvg
        ? (Array.from(activeSvg.querySelectorAll('.hyp__route-path')) as SVGPathElement[])
        : [];
      const dots = activeSvg ? (Array.from(activeSvg.querySelectorAll('.hyp__dot')) as SVGCircleElement[]) : [];
      paths.forEach((path) => {
        const length = path.getTotalLength();
        if (length === 0) return;
        path.style.strokeDasharray = String(length);
        path.style.strokeDashoffset = String(length);
      });
      dots.forEach((dot) => dot.classList.add('is-pending'));
      window.setTimeout(() => {
        paths.forEach((path) => {
          path.style.transition = 'stroke-dashoffset var(--duration-line) var(--ease-out)';
          path.style.strokeDashoffset = '0';
        });
        window.setTimeout(() => {
          dots.forEach((dot) => {
            dot.classList.remove('is-pending');
            dot.classList.add('is-visible');
          });
        }, 450);
      }, 20);
    }

    const revealEls = Array.from(main.querySelectorAll('[data-reveal]')) as HTMLElement[];

    if (!reduceMotion && revealEls.length && 'IntersectionObserver' in window) {
      revealEls.forEach((el) => el.classList.add('is-pending'));

      const groups = new Map<Element | null, HTMLElement[]>();
      revealEls.forEach((el) => {
        const parent = el.closest('section');
        const list = groups.get(parent) ?? [];
        list.push(el);
        groups.set(parent, list);
      });

      const revealGroup = (section: Element | null) => {
        const els = groups.get(section) ?? [];
        const lastDelay = (els.length - 1) * 60;
        els.forEach((el, i) => {
          window.setTimeout(() => {
            el.classList.remove('is-pending');
            el.classList.add('is-visible');
          }, i * 60);
        });
        window.setTimeout(() => syncRoute(), lastDelay + 520);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              revealGroup(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );

      Array.from(main.querySelectorAll('section')).forEach((section) => observer.observe(section));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  }
</script>

<style>
  .hyp {
    position: relative;
    background: var(--bg);
    overflow-x: hidden;
  }

  /* Stejný důvod jako `.sluzby__route` — trasa musí malovat NAD
     `.hyp-closing`'s pozadí (jinak by tmavý úsek mizel pod ním), text a
     CTA uvnitř `.hyp-closing__grid` dostávají vlastní vyšší z-index. */
  .hyp__route {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hyp__route-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hyp__route-path--dark {
    stroke: var(--line-on-dark);
  }

  .hyp__notch {
    stroke: var(--line);
    stroke-opacity: .18;
  }

  .hyp__dot {
    transform: scaleX(var(--dot-fix, 1));
    transform-box: fill-box;
    transform-origin: center;
  }

  .hyp__dot.is-pending {
    opacity: 0;
    transform: scaleX(var(--dot-fix, 1)) scale(.4);
  }

  .hyp__dot.is-visible {
    opacity: 1;
    transform: scaleX(var(--dot-fix, 1)) scale(1);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out);
  }

  .hyp__route-svg--tablet,
  .hyp__route-svg--laptop,
  .hyp__route-svg--desktop {
    display: none;
  }

  .hyp :focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  [data-reveal].is-pending {
    opacity: 0;
    transform: translateY(10px);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--duration-reveal) var(--ease-out), transform var(--duration-reveal) var(--ease-out);
  }

  /* Pruhy s kotvou nesmí mít posun v odhalovací animaci — stejný důvod
     jako `[data-route-target]` v `sluzby.astro`. */
  [data-route-target].is-pending {
    transform: none;
  }

  [data-route-target].is-visible {
    transform: none;
    transition: opacity var(--duration-reveal) var(--ease-out);
  }

  .hyp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding-inline: 30px;
    border-radius: var(--radius-btn);
    background: var(--emerald);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    transition: background-color var(--duration-hover) var(--ease-out);
  }

  .hyp-cta:hover {
    background: var(--emerald-hover);
  }

  .hyp-cta:active {
    transform: translateY(1px);
  }

  .hyp-phone {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--navy);
    font-weight: 600;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    transition: color var(--duration-hover) var(--ease-out);
  }

  .hyp-phone__icon {
    width: 19px;
    height: 19px;
    flex: none;
  }

  .hyp-phone:hover {
    color: var(--emerald);
  }

  .hyp-phone--dark {
    color: var(--white);
  }

  .hyp-phone--dark:hover {
    color: var(--emerald-light);
  }

  /* ---------- Drobečková navigace ---------- */

  .hyp-breadcrumb {
    margin-bottom: 20px;
  }

  .hyp-breadcrumb ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .hyp-breadcrumb li:not(:last-child)::after {
    content: '/';
    margin: 0 8px;
    color: var(--text-faint);
  }

  .hyp-breadcrumb a {
    color: var(--text-quiet);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .hyp-breadcrumb a:hover {
    color: var(--navy);
  }

  .hyp-breadcrumb__short {
    display: none;
  }

  /* ---------- Hero ---------- */

  .hyp-hero {
    padding: 64px 24px 0;
    display: flex;
    flex-direction: column;
  }

  .hyp-hero__text {
    display: flex;
    flex-direction: column;
