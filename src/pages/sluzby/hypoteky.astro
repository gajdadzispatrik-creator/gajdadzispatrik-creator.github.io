    text-wrap: pretty;
  }

  .hyp-hero__lead {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
    max-width: 560px;
  }

  .hyp-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

