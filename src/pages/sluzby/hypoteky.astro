    }

    .hyp-step--first h3 {
      font-size: 24px;
    }

    .hyp-steps__closing {
      padding-left: 56px;
      font-size: 19px;
    }

    /* Otázky: otázka vlevo 340px / odpověď vpravo. */
    .hyp-faq {
      max-width: 900px;
    }

    .hyp-faq__row {
      display: grid;
