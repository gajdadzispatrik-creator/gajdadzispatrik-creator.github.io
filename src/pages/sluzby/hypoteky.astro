    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Tmavé CTA ---------- */

  .hyp-closing {
    position: relative;
    margin-top: 72px;
    padding-block: 56px;
    overflow: hidden;
    background: linear-gradient(174deg, #16324F 0%, #0F2747 44%, #0B1D36 100%);
  }

  .hyp-closing__glow {
    position: absolute;
    inset: 0;
    top: 0;
    height: 260px;
    background: radial-gradient(70% 50% at 78% 20%, rgba(46, 152, 115, .13) 0%, rgba(46, 152, 115, 0) 74%);
    pointer-events: none;
  }

  .hyp-closing__grid {
    position: relative;
    z-index: 2;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hyp-closing__grid h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--white);
    text-wrap: pretty;
  }

  /*
   * OPRAVA 1. 9. 2026 (na žádost uživatele — „okopíruj vlastnosti toho
   * modrého baru ze služeb"): stejný mechanismus jako `.sluzby-closing__body`
   * — jeden zdroj mezery (`gap` na rodiči), děti bez vlastního margin-top,
   * `.hyp-closing__actions` dostává stejný `margin-top: 8px` navíc jako
   * `.sluzby-closing__actions` (sjednoceno, ne vlastní hodnota).
   */
  .hyp-closing__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hyp-closing__body p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, .72);
  }

  .hyp-closing__actions {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hyp-closing__actions .hyp-cta {
    width: 100%;
  }

  .hyp-closing__actions .hyp-phone {
    height: 48px;
    justify-content: center;
    font-size: 16px;
  }

  .hyp-closing__support {
    margin: 0;
    font-size: 14px;
    color: rgba(255, 255, 255, .62);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

