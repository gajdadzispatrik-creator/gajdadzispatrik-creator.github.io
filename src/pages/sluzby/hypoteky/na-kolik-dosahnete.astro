---
/**
 * „Na kolik dosáhnete?" — dotazník k hypotéce, v3 (8. 10. 2026).
 * Zadání: ../Osobní značka/strategie/zadani-web-google-ads.md, část B;
 * otázky v3 podle Patrikova zadání 8. 10. 2026 (to, co potřebuje ke
 * skutečnému výpočtu bonity).
 *
 * Princip i vzhled jako Finanční check-up (/financni-check-up): jedna
 * otázka na obrazovce, postup jako linka s tečkami. Navíc: částky a věk
 * jako číselná pole, příjem a věk zvlášť za každého žadatele, otázky se
 * větví podle odpovědí (OSVČ → paušální výdaje, úvěr → kolik…).
 * Na konci NENÍ žádné číslo (částka, sazba ani splátka) — výpočet pošle
 * Patrik. Odpovědi se odešlou s kontaktem na /api/poptavka.php (zdroj
 * „na-kolik-dosahnete“, e-mail nepovinný), přehledně po žadatelích.
 *
 * Všechny obrazovky jsou ve statickém HTML (check:typo vidí celý text),
 * JS jen počítá cestu podle odpovědí a přepíná, co je vidět.
 * Bez kapitol s trasou (nástroj), linku do patičky kreslí StandaloneRoute.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import StandaloneRoute from '../../../components/StandaloneRoute.astro';
import { BOOKING_URL } from '../../../data/entity';

// Nezlomitelná mezera (U+00A0) za krátkými předložkami/spojkami, za číslem
// a mezi skupinami číslic (CLAUDE.md „Konvence: nezlomitelná mezera").
const NBSP = ' ';
const PREP = /(^|[\s (])([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze|Do|Ke|Na|Od|Po|Pro|Se|Ve|Za|Ze) /g;
const nb = (text: string) =>
  text
    .replace(PREP, `$1$2${NBSP}`)
    .replace(PREP, `$1$2${NBSP}`)
    .replace(/(\d) /g, `$1${NBSP}`)
    .replace(/ (–|—) /g, `${NBSP}$1 `);

type Kind = 'choice' | 'money' | 'age';
interface Screen {
  id: string;
  kind: Kind;
  q: string;
  /** Štítek nad otázkou (který žadatel). */
  who?: 1 | 2;
  options?: string[];
  /** Popisek číselného pole. */
  label?: string;
}

const INCOME_TYPES = ['Zaměstnanec', 'OSVČ', 'Invalidní důchod', 'Rodičovská nebo mateřská', 'Jiný'];

const applicantScreens = (n: 1 | 2): Screen[] => {
  const two = n === 2;
  return [
    {
      id: `typ-${n}`,
      kind: 'choice',
      who: n,
      q: two ? 'Jaký příjem má druhý žadatel?' : 'Jaký máte příjem?',
      options: INCOME_TYPES,
    },
    {
      id: `zam-${n}`,
      kind: 'money',
      who: n,
      q: two ? 'Jaký je čistý měsíční příjem druhého žadatele?' : 'Jaký je váš čistý měsíční příjem?',
      label: 'Čistý měsíční příjem',
    },
    {
      id: `osvc-${n}`,
      kind: 'money',
      who: n,
      q: two
        ? 'Jaké má druhý žadatel příjmy za rok podle posledního daňového přiznání?'
        : 'Jaké máte příjmy za rok podle posledního daňového přiznání?',
      label: 'Příjmy za rok',
    },
    {
      id: `pausal-${n}`,
      kind: 'choice',
      who: n,
      q: two ? 'Uplatňuje druhý žadatel paušální výdaje?' : 'Uplatňujete paušální výdaje?',
      options: ['Ano', 'Ne', 'Nevím'],
    },
    {
      id: `jiny-${n}`,
      kind: 'money',
      who: n,
      q: two ? 'Kolik měsíčně dostává druhý žadatel?' : 'Kolik měsíčně dostáváte?',
      label: 'Měsíčně',
    },
  ];
};

const screens: Screen[] = [
  {
    id: 'ucel',
    kind: 'choice',
    q: 'Na co hypotéku potřebujete?',
    options: ['Koupě bytu', 'Koupě domu', 'Výstavba', 'Rekonstrukce', 'Ještě nevím'],
  },
  { id: 'pocet', kind: 'choice', q: 'Kolik vás bude o hypotéku žádat?', options: ['Jen já', 'Dva'] },
  ...applicantScreens(1),
  ...applicantScreens(2),
  { id: 'uvery', kind: 'choice', q: 'Splácíte nějaké úvěry nebo leasing?', options: ['Ne', 'Ano'] },
  { id: 'uvery-castka', kind: 'money', q: 'Kolik měsíčně celkem?', label: 'Splátky měsíčně' },
  { id: 'karta', kind: 'choice', q: 'Máte kreditní kartu nebo kontokorent?', options: ['Ne', 'Ano'] },
  { id: 'karta-limit', kind: 'money', q: 'Jaký je limit?', label: 'Limit' },
  { id: 'deti', kind: 'choice', q: 'Kolik dětí vyživujete?', options: ['0', '1', '2', '3', '4 a víc'] },
  { id: 'vek', kind: 'age', q: 'Kolik je vám let?' },
  { id: 'uspory', kind: 'choice', q: 'Máte na hypotéku něco naspořeno?', options: ['Ano', 'Ne'] },
  { id: 'nemovitost', kind: 'choice', q: 'Máte jinou nemovitost, kterou můžete dát do zástavy?', options: ['Ano', 'Ne'] },
  { id: 'kdy', kind: 'choice', q: 'Kdy chcete kupovat?', options: ['Do 3 měsíců', 'Do roka', 'Zatím zjišťuji'] },
];

// Tipy podle odpovědí (pravidla v <script>), všechny potvrdil Patrik 8. 10. 2026.
const tips = [
  { id: 'osvc', text: 'U podnikatelů každá banka počítá příjem z daňového přiznání jinak. Ze stejného přiznání může v jiné bance vyjít vyšší částka.' },
  { id: 'vlastni', text: 'Banka obvykle půjčí až 80 % ceny nemovitosti, lidem do 36 let až 90 %. Zbytek je potřeba mít z vlastních zdrojů.' },
  { id: 'uvery', text: 'Každá splátka jiného úvěru snižuje, na kolik dosáhnete. Někdy pomůže úvěr před žádostí doplatit nebo sloučit.' },
  { id: 'jiny', text: 'Banky tyto příjmy posuzují každá jinak. Proto nejdřív vyřešte hypotéku a nemovitost hledejte až podle toho, na kolik dosáhnete.' },
  { id: 'cena', text: 'Děláte to správně: nejdřív zjistit, na kolik dosáhnete, a až potom hledat nemovitost.' },
];

const config = { screens: screens.map(({ id, kind, options }) => ({ id, kind, options })) };
---

<BaseLayout
  title="Na jakou hypotéku dosáhnete? | Patrik Gajdadzis"
  description="Stačí pár otázek. Zdarma spočítám, kolik vám půjčí konkrétní banky, a do jednoho pracovního dne se vám ozvu s výsledkem. 5★ hodnocení na Googlu."
>
  <Header />
  <main id="hero" class="nkd">
    <StandaloneRoute />

    <section class="nkd-hero" aria-labelledby="nkd-heading">
      <div class="nkd-hero__text" data-route-content data-nkd data-config={JSON.stringify(config)}>
        <h1 id="nkd-heading">Spočítám, na&nbsp;kolik dosáhnete.</h1>

        <!-- Úvod -->
        <div class="nkd-step" data-step="intro">
          <p class="nkd-hero__lead">
            Stačí odpovědět na&nbsp;pár otázek. Zdarma spočítám, kolik vám půjčí konkrétní banky, a&nbsp;do&nbsp;jednoho pracovního
            dne se&nbsp;vám ozvu s&nbsp;výsledkem.
          </p>
          <div class="nkd-intro__actions">
            <button class="nkd-cta" type="button" data-start>Začít</button>
          </div>
          <noscript>
            <p class="nkd-meta">
              Dotazník potřebuje zapnutý JavaScript. Zavolejte mi na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
            </p>
          </noscript>
        </div>

        <!-- Otázky: počet i pořadí podle odpovědí, viz flow() ve <script> -->
        <div class="nkd-step nkd-quiz" data-step="quiz" hidden>
          <svg class="nkd-progress" width="260" height="10" viewBox="0 0 260 10" aria-hidden="true" focusable="false">
            <path d="M5 5H255" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" fill="none" />
            <g data-dots></g>
          </svg>
          {/* Bez „z N“: počet otázek se mění podle odpovědí (druhý žadatel,
              OSVČ, úvěr…) a rostoucí číslo by mátlo. Postup ukazují tečky. */}
          <p class="nkd-quiz__count" aria-live="polite">Otázka <span data-count>1</span></p>

          <div class="nkd-questions">
            {
              screens.map((s) => (
                <fieldset class="nkd-question" data-screen={s.id} data-kind={s.kind} hidden>
                  {s.who && (
                    <p class="nkd-question__who" data-who={s.who}>
                      {s.who === 2 ? 'Druhý žadatel' : 'Vy'}
                    </p>
                  )}
                  <legend class="nkd-question__title" tabindex="-1">{nb(s.q)}</legend>
                  {s.kind === 'choice' && (
                    <div class="nkd-options">
                      {s.options!.map((label, oi) => (
                        <button class="nkd-option" type="button" data-option={oi}>
                          <span class="nkd-option__mark" aria-hidden="true" />
                          <span>{nb(label)}</span>
                        </button>
                      ))}
                    </div>
                  )}
                  {s.kind === 'money' && (
                    <div class="nkd-number">
                      <label class="nkd-number__label" for={`nkd-in-${s.id}`}>{nb(s.label ?? '')}</label>
                      <div class="nkd-number__field">
                        <input id={`nkd-in-${s.id}`} type="text" inputmode="numeric" autocomplete="off" data-input aria-describedby={`nkd-err-${s.id}`} />
                        <span class="nkd-number__unit" aria-hidden="true">Kč</span>
                      </div>
                      <p class="nkd-number__error" id={`nkd-err-${s.id}`} hidden>Zadejte prosím částku.</p>
                      <button class="nkd-cta nkd-number__next" type="button" data-next>Pokračovat</button>
                    </div>
                  )}
                  {s.kind === 'age' && (
                    <div class="nkd-number">
                      <div class="nkd-number__pair">
                        <div class="nkd-number__item">
                          <label class="nkd-number__label" for="nkd-in-vek-1" data-age-label>Váš věk</label>
                          <div class="nkd-number__field nkd-number__field--short">
                            <input id="nkd-in-vek-1" type="text" inputmode="numeric" autocomplete="off" maxlength="2" data-input data-age="1" aria-describedby="nkd-err-vek" />
                            <span class="nkd-number__unit" aria-hidden="true">let</span>
                          </div>
                        </div>
                        <div class="nkd-number__item" data-age-second hidden>
                          <label class="nkd-number__label" for="nkd-in-vek-2">Věk druhého žadatele</label>
                          <div class="nkd-number__field nkd-number__field--short">
                            <input id="nkd-in-vek-2" type="text" inputmode="numeric" autocomplete="off" maxlength="2" data-input data-age="2" aria-describedby="nkd-err-vek" />
                            <span class="nkd-number__unit" aria-hidden="true">let</span>
                          </div>
                        </div>
                      </div>
                      <p class="nkd-number__error" id="nkd-err-vek" hidden>Zadejte prosím věk.</p>
                      <button class="nkd-cta nkd-number__next" type="button" data-next>Pokračovat</button>
                    </div>
                  )}
                </fieldset>
              ))
            }
          </div>

          <button class="nkd-back" type="button" data-back>Zpět</button>
        </div>

        <!-- Poslední krok: kam poslat výpočet → tipy → formulář → termín / telefon -->
        <div class="nkd-step nkd-result" data-step="result" hidden>
          <div class="nkd-verdict">
            <h2 class="nkd-verdict__title" tabindex="-1">Kam vám výpočet pošlu?</h2>
            <p class="nkd-verdict__text">
              Spočítám to podle podmínek konkrétních bank. Každá počítá příjem jinak, proto to dělám ručně. Ozvu se&nbsp;do&nbsp;jednoho
              pracovního dne.
            </p>
          </div>

          <div class="nkd-tips" data-tips hidden>
            <p class="nkd-tips__label">Čeho jsem si všiml</p>
            <ul class="nkd-tips__list">
              {tips.map((t) => <li data-tip={t.id} hidden>{nb(t.text)}</li>)}
            </ul>
          </div>

          <form class="nkd-form" method="post" action="/api/poptavka.php" novalidate>
            <p class="nkd-form__errors" role="alert" hidden></p>
            <div class="nkd-hp" aria-hidden="true">
              <label for="nkd-website">Nevyplňujte</label>
              <input id="nkd-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="vyplneno-ms" value="" />
            <input type="hidden" name="zdroj" value="na-kolik-dosahnete" />
            <input type="hidden" name="oblast" value="Hypotéka a bydlení" />
            <input type="hidden" name="situace" value="" />

            <!-- Komu výpočet posíláte: fotka, jméno, kdy se ozve (jako u kontaktního formuláře). -->
            <div class="nkd-person">
              <img class="nkd-person__photo" src="/email/patrik-gajdadzis.jpg" width="64" height="64" alt="" loading="lazy" />
              <p class="nkd-person__text">
                <strong>Patrik Gajdadzis</strong>
                <span>Ozvu se&nbsp;do&nbsp;jednoho pracovního dne.</span>
              </p>
              <p class="nkd-person__proof">5<span class="nkd-person__star" aria-hidden="true">★</span><span class="sr-only"> hvězdiček,</span> hodnocení na&nbsp;Googlu&nbsp;· zdarma</p>
            </div>

            <div class="nkd-form__grid">
              <div class="nkd-field">
                <label for="nkd-jmeno">Jméno a&nbsp;příjmení <span class="nkd-required" aria-hidden="true">*</span></label>
                <input id="nkd-jmeno" name="jmeno" type="text" autocomplete="name" required aria-describedby="nkd-jmeno-chyba" />
                <p class="nkd-field__error" id="nkd-jmeno-chyba" hidden></p>
              </div>
              <div class="nkd-field">
                <label for="nkd-telefon">Telefon <span class="nkd-required" aria-hidden="true">*</span></label>
                <input id="nkd-telefon" name="telefon" type="tel" autocomplete="tel" required aria-describedby="nkd-telefon-chyba" />
                <p class="nkd-field__error" id="nkd-telefon-chyba" hidden></p>
              </div>
              <div class="nkd-field nkd-field--wide">
                <label for="nkd-email">E-mail <span class="nkd-optional">(nepovinný)</span></label>
                <input id="nkd-email" name="email" type="email" autocomplete="email" aria-describedby="nkd-email-chyba" />
                <p class="nkd-field__error" id="nkd-email-chyba" hidden></p>
              </div>
            </div>

            <button class="nkd-cta nkd-form__submit" type="submit">Chci výpočet</button>

            <p class="nkd-status nkd-status--error" role="alert" hidden>
              Odpovědi se&nbsp;nepodařilo odeslat. Zkuste to znovu nebo mi zavolejte na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
            </p>

            <p class="nkd-privacy">
              Údaje použiji pouze pro&nbsp;vyřízení vaší poptávky a&nbsp;navazující komunikaci. <a href="/zpracovani-osobnich-udaju">Zásady zpracování osobních údajů</a>
            </p>
          </form>

          <p class="nkd-status nkd-status--success" role="status" tabindex="-1" hidden>
            Díky, odpovědi mi dorazily. Spočítám to a&nbsp;ozvu se&nbsp;do&nbsp;jednoho pracovního dne.
          </p>

          <div class="nkd-alt">
            <p class="nkd-alt__label">Raději hned?</p>
            <div class="nkd-alt__actions">
              <a class="nkd-alt__btn" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat termín</a>
              <a class="nkd-alt__btn" href="tel:+420775217721">Zavolat</a>
            </div>
          </div>

          <button class="nkd-back" type="button" data-restart>Projít znovu</button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  interface ScreenCfg {
    id: string;
    kind: 'choice' | 'money' | 'age';
    options?: string[];
  }

  const root = document.querySelector<HTMLElement>('[data-nkd]');
  if (root) {
    const { screens } = JSON.parse(root.dataset.config ?? '{}') as { screens: ScreenCfg[] };
    const byId = new Map(screens.map((s) => [s.id, s]));
    const els = new Map(
      Array.from(root.querySelectorAll<HTMLElement>('[data-screen]')).map((el) => [el.dataset.screen ?? '', el]),
    );
    // Odpovědi: u výběru index možnosti, u částky/věku číslo.
    const answers: Record<string, number> = {};
    let index = 0;
    let startedAt: number | null = null;

    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const totalEl = root.querySelector<HTMLElement>('[data-total]');
    const dotsG = root.querySelector<SVGGElement>('[data-dots]');
    const form = root.querySelector<HTMLFormElement>('.nkd-form');
    const success = root.querySelector<HTMLElement>('.nkd-status--success');

    const two = () => answers.pocet === 1;
    // Obrazovka s částkou podle druhu příjmu (0 zaměstnanec, 1 OSVČ, jinak „kolik měsíčně“).
    const incomeScreens = (n: number) => {
      const typ = answers[`typ-${n}`];
      if (typ === 1) return [`osvc-${n}`, `pausal-${n}`];
      if (typ === undefined || typ === 0) return [`zam-${n}`];
      return [`jiny-${n}`];
    };
    // Cesta dotazníkem podle dosavadních odpovědí (nezodpovězené větve = nejkratší).
    const flow = () => [
      'ucel',
      'pocet',
      `typ-1`,
      ...incomeScreens(1),
      ...(two() ? ['typ-2', ...incomeScreens(2)] : []),
      'uvery',
      ...(answers.uvery === 1 ? ['uvery-castka'] : []),
      'karta',
      ...(answers.karta === 1 ? ['karta-limit'] : []),
      'deti',
      'vek',
      'uspory',
      'nemovitost',
      'kdy',
    ];

    const showStep = (name: string) => steps.forEach((s) => (s.hidden = s.dataset.step !== name));

    const renderDots = (total: number, current: number) => {
      if (!dotsG) return;
      const ns = 'http://www.w3.org/2000/svg';
      dotsG.replaceChildren(
        ...Array.from({ length: total }, (_, i) => {
          const c = document.createElementNS(ns, 'circle');
          c.setAttribute('cx', String(5 + (total > 1 ? (i * 250) / (total - 1) : 0)));
          c.setAttribute('cy', '5');
          c.setAttribute('r', '2.4');
          c.setAttribute('class', `nkd-progress__dot${i < current ? ' is-done' : ''}${i === current ? ' is-current' : ''}`);
          return c;
        }),
      );
    };

    const formatKc = (n: number) => n.toLocaleString('cs-CZ');
    const parseNum = (v: string) => {
      const digits = v.replace(/[^\d]/g, '');
      return digits ? Number(digits) : NaN;
    };

    const show = (i: number) => {
      const path = flow();
      index = Math.max(0, Math.min(i, path.length - 1));
      const id = path[index];
      els.forEach((el, key) => (el.hidden = key !== id));
      const el = els.get(id)!;
      el.querySelectorAll<HTMLElement>('[data-who="1"]').forEach((w) => (w.hidden = !two()));
      if (id === 'vek') {
        const second = el.querySelector<HTMLElement>('[data-age-second]');
        if (second) second.hidden = !two();
        const label = el.querySelector<HTMLElement>('[data-age-label]');
        if (label) label.hidden = !two();
      }
      // Předvyplnit dřívější odpověď (při návratu „Zpět“).
      el.querySelectorAll<HTMLElement>('[data-option]').forEach((o) =>
        o.classList.toggle('is-selected', Number(o.dataset.option) === answers[id]),
      );
      el.querySelectorAll<HTMLInputElement>('[data-input]').forEach((input) => {
        const key = input.dataset.age ? `vek-${input.dataset.age}` : id;
        input.value = answers[key] !== undefined ? (input.dataset.age ? String(answers[key]) : formatKc(answers[key])) : '';
      });
      el.querySelector<HTMLElement>('.nkd-number__error')?.setAttribute('hidden', '');
      if (countEl) countEl.textContent = String(index + 1);
      if (totalEl) totalEl.textContent = String(path.length);
      renderDots(path.length, index);
      if (root.getBoundingClientRect().top < 0) root.scrollIntoView({ block: 'start' });
      const firstInput = el.querySelector<HTMLInputElement>('[data-input]');
      if (firstInput) firstInput.focus({ preventScroll: true });
      else el.querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
    };

    const next = () => {
      const path = flow();
      if (index + 1 < path.length) show(index + 1);
      else showResult();
    };

    // --- Shrnutí do e-mailu, přehledně po žadatelích ---
    const label = (id: string) => {
      const s = byId.get(id);
      const v = answers[id];
      return s?.options && v !== undefined ? s.options[v] : '—';
    };
    const applicantLine = (n: number) => {
      const typ = answers[`typ-${n}`];
      const parts = [`příjem: ${label(`typ-${n}`)}`];
      if (typ === 0) parts.push(`čistě ${formatKc(answers[`zam-${n}`])} Kč měsíčně`);
      else if (typ === 1) parts.push(`příjmy za rok podle DP ${formatKc(answers[`osvc-${n}`])} Kč`, `paušální výdaje: ${label(`pausal-${n}`)}`);
      else parts.push(`${formatKc(answers[`jiny-${n}`])} Kč měsíčně`);
      parts.push(`věk ${answers[`vek-${n}`]}`);
      return `${n === 1 ? 'Žadatel 1' : 'Žadatel 2'}: ${parts.join(', ')}`;
    };
    const summary = () =>
      [
        'Odpovědi z nástroje „Na kolik dosáhnete?“ na webu:',
        `Na co: ${label('ucel')}`,
        `Počet žadatelů: ${two() ? '2' : '1'}`,
        '',
        applicantLine(1),
        ...(two() ? [applicantLine(2)] : []),
        '',
        `Úvěry a leasing: ${answers.uvery === 1 ? `ano, ${formatKc(answers['uvery-castka'])} Kč měsíčně` : 'ne'}`,
        `Kreditní karta / kontokorent: ${answers.karta === 1 ? `ano, limit ${formatKc(answers['karta-limit'])} Kč` : 'ne'}`,
        `Děti: ${label('deti')}`,
        `Naspořeno na hypotéku: ${label('uspory')}`,
        `Jiná nemovitost do zástavy: ${label('nemovitost')}`,
        `Kdy kupovat: ${label('kdy')}`,
      ].join('\n');

    const showResult = () => {
      const types = [answers['typ-1'], ...(two() ? [answers['typ-2']] : [])];
      const rules: Record<string, () => boolean> = {
        osvc: () => types.includes(1),
        vlastni: () => answers.uspory === 1,
        uvery: () => answers.uvery === 1,
        jiny: () => types.some((t) => t >= 2),
        cena: () => answers.ucel === 4 || answers.kdy === 2,
      };
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-tip]'));
      // „Jiný příjem“ a „Děláte to správně“ říkají totéž — když platí oba, zůstane „jiný příjem“.
      const hits = items.filter((li) => rules[li.dataset.tip ?? '']?.());
      const hasJiny = hits.some((li) => li.dataset.tip === 'jiny');
      const shown = hits.filter((li) => !(hasJiny && li.dataset.tip === 'cena')).slice(0, 2);
      items.forEach((li) => (li.hidden = !shown.includes(li)));
      const box = root.querySelector<HTMLElement>('[data-tips]');
      if (box) box.hidden = shown.length === 0;

      const situation = form?.elements.namedItem('situace') as HTMLInputElement | null;
      if (situation) situation.value = summary();

      showStep('result');
      root.querySelector<HTMLElement>('.nkd-verdict__title')?.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });
    };

    root.querySelector('[data-start]')?.addEventListener('click', () => {
      startedAt = performance.now();
      showStep('quiz');
      show(0);
    });

    // Výběr z možností.
    els.forEach((el, id) => {
      el.querySelectorAll<HTMLElement>('[data-option]').forEach((option) => {
        option.addEventListener('click', () => {
          answers[id] = Number(option.dataset.option);
          next();
        });
      });
    });

    // Číselná pole: částka (Kč) nebo věk.
    els.forEach((el, id) => {
      const inputs = Array.from(el.querySelectorAll<HTMLInputElement>('[data-input]'));
      if (!inputs.length) return;
      const error = el.querySelector<HTMLElement>('.nkd-number__error');
      const isAge = id === 'vek';
      const submit = () => {
        const visible = inputs.filter((i) => !i.closest('[hidden]'));
        const values = visible.map((i) => parseNum(i.value));
        const ok = values.every((v) => (isAge ? v >= 18 && v <= 99 : v > 0));
        visible.forEach((i, k) => {
          const bad = isAge ? !(values[k] >= 18 && values[k] <= 99) : !(values[k] > 0);
          if (bad) i.setAttribute('aria-invalid', 'true');
          else i.removeAttribute('aria-invalid');
        });
        if (error) error.hidden = ok;
        if (!ok) return;
        visible.forEach((i, k) => {
          answers[isAge ? `vek-${i.dataset.age}` : id] = values[k];
        });
        next();
      };
      inputs.forEach((input) => {
        if (!isAge) {
          input.addEventListener('input', () => {
            const n = parseNum(input.value);
            input.value = Number.isNaN(n) ? '' : formatKc(n);
          });
        } else {
          input.addEventListener('input', () => (input.value = input.value.replace(/[^\d]/g, '')));
        }
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            submit();
          }
        });
      });
      el.querySelector('[data-next]')?.addEventListener('click', submit);
    });

    root.querySelector('[data-back]')?.addEventListener('click', () => {
      if (index > 0) show(index - 1);
      else showStep('intro');
    });

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      Object.keys(answers).forEach((k) => delete answers[k]);
      if (form) {
        form.hidden = false;
        form.reset();
      }
      if (success) success.hidden = true;
      showStep('quiz');
      show(0);
    });

    // --- Formulář: stejná pravidla a cesta jako kontaktní formulář ---
    if (form) {
      const messages: Record<string, string> = {
        jmeno: 'Vyplňte prosím jméno a příjmení.',
        telefon: 'Vyplňte prosím telefonní číslo.',
        email: 'Zkontrolujte prosím e-mailovou adresu.',
      };
      const fields = ['jmeno', 'telefon', 'email'].map((n) => form.elements.namedItem(n) as HTMLInputElement);
      const validate = (input: HTMLInputElement) => {
        const ok = input.checkValidity();
        const err = document.getElementById(`${input.id}-chyba`);
        if (err) {
          err.textContent = ok ? '' : messages[input.name];
          err.hidden = ok;
        }
        if (ok) input.removeAttribute('aria-invalid');
        else input.setAttribute('aria-invalid', 'true');
        return ok;
      };
      fields.forEach((f) => f.addEventListener('blur', () => validate(f)));
      const summaryEl = form.querySelector<HTMLElement>('.nkd-form__errors');
      const errorStatus = form.querySelector<HTMLElement>('.nkd-status--error');
      const submit = form.querySelector<HTMLButtonElement>('.nkd-form__submit');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit?.disabled) return;
        if (errorStatus) errorStatus.hidden = true;
        const allOk = fields.map(validate).every(Boolean);
        if (summaryEl) {
          summaryEl.hidden = allOk;
          summaryEl.textContent = allOk ? '' : 'Zkontrolujte prosím zvýrazněná pole.';
        }
        if (!allOk) return;

        const elapsed = form.elements.namedItem('vyplneno-ms') as HTMLInputElement;
        elapsed.value = String(Math.round(performance.now() - (startedAt ?? 0)));

        if (submit) submit.disabled = true;
        form.setAttribute('aria-busy', 'true');
        let sent = false;
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          });
          const result = (await response.json().catch(() => null)) as { ok?: boolean } | null;
          sent = response.ok && result?.ok === true;
        } catch {
          sent = false;
        } finally {
          if (submit) submit.disabled = false;
          form.removeAttribute('aria-busy');
        }

        if (sent) {
          form.hidden = true;
          if (success) {
            success.hidden = false;
            success.focus({ preventScroll: true });
          }
        } else if (errorStatus) {
          errorStatus.hidden = false;
        }
      });
    }
  }
</script>

