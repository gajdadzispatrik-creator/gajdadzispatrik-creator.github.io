---
/**
 * Vstupní stránka /sluzby/hypoteky/refixace — „Končí vám fixace?“
 * (1. 11. 2026). Zadání: rozbor Reklamy `docs/znalosti/reklama-rozbor-a-navrh-2026-11-01.md`
 * § 7 B1 + B3, schváleno Patrikem 1. 11. 2026 („udělej co doporučuješ“,
 * `_spolecne/rozhodnuti.md`). Cíl: reklama Refixace vede sem místo obecné
 * stránky hypoték.
 *
 * Kostra, osa, pruhy, tečky a typografie 1:1 z `src/pages/kariera.astro`
 * (a ta z `/recenze`), tři markery: formulář / postup / fixace.
 * Formulář má stejná pravidla jako „Na kolik dosáhnete?“ (honeypot, doba
 * vyplnění, POST na /api/poptavka.php se zdrojem „refixace“, e-mail se
 * nevyplňuje — Patrik se ozve telefonicky) a navíc skrytá pole zdroje
 * kliknutí (gclid/UTM, `src/scripts/attribution-fields.ts`, jen se
 * souhlasem s marketingovými cookies).
 *
 * TEXTY: žádné sazby, splátky ani RPSN (§ 91 ZSÚ). Zákonná ustanovení
 * (§ 102 odst. 3 a § 117 odst. 3 písm. d) zák. 257/2016 Sb.) podle znění
 * platného 1. 9. 2024 – 31. 12. 2026, čteno 15. 10. 2026. Všechny texty
 * OVĚŘIT U KVALIFIKOVANÉ OSOBY / compliance BEplanu před nasazením.
 * Slib odpovědi „do jednoho pracovního dne“ podle rozhodnutí V5 (klientovi
 * 1 pracovní den, vnitřní cíl do hodiny).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ServiceReview from '../../../components/ServiceReview.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import LineGradientDefs from '../../../components/LineGradientDefs.astro';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../../../data/entity';
// Fotka u formuláře (jako kontaktní formulář a „Na kolik dosáhnete?“, Patrik 1. 11. 2026).
import personPhoto from '../../../assets/photos/patrik-profilovka.jpg';
import { czechNbsp } from '../../../lib/rehype-czech-nbsp.mjs';

const steps = [
  {
    title: 'Pošlete mi nabídku od banky',
    text: 'Dopis nebo e-mail, ve kterém vám banka oznamuje novou sazbu. Podle zákona ho musí poslat nejpozději 3 měsíce před koncem fixace. Když ještě nepřišel, nevadí, začneme bez něj.',
  },
  {
    title: 'Porovnám ji s nabídkami jiných bank',
    text: 'Dívám se na celkové náklady, ne jen na sazbu, a na podmínky, které banka k nabídce váže, třeba pojištění nebo vedení účtu.',
  },
  {
    title: 'Do jednoho pracovního dne vám řeknu, co dál',
    text: 'Jestli nabídku přijmout, co si u své banky vyjednat, nebo jestli se vyplatí přejít jinam. Po oznámení nové sazby můžete hypotéku 3 měsíce splatit bez poplatku za předčasné splacení.',
  },
  {
    title: 'Rozhodnutí je vaše',
    text: 'Doporučím, nic nevnucuji. Celá služba je pro vás bez poplatků.',
  },
];

const fixation = [
  {
    title: 'Plánujete prodej nebo větší splátku?',
    text: 'Na konci fixace můžete hypotéku splatit nebo přenést bez poplatku. Když v příštích letech počítáte s prodejem nemovitosti nebo s větší mimořádnou splátkou, hodí se fixace, která skončí ve správnou chvíli.',
  },
  {
    title: 'Kolik jistoty potřebujete?',
    text: 'Delší fixace znamená stejnou splátku na delší dobu. Kratší fixace dává dřív možnost změny, ale i riziko vyšší splátky.',
  },
  {
    title: 'Jakou máte rezervu?',
    text: 'Když by vás vyšší splátka finančně zaskočila, dává smysl jistota delší fixace.',
  },
  {
    title: 'Porovnávejte stejné věci',
    text: 'Banky mají pro různé délky fixace různé podmínky. Proto porovnávám nabídky pro více délek fixace najednou a ve stejném nastavení.',
  },
];
---

<BaseLayout
  title="Končí vám fixace hypotéky? Zkontroluji nabídku banky | Patrik Gajdadzis"
  description="Pošlete mi nabídku banky ke konci fixace. Do jednoho pracovního dne vám řeknu, jestli je dobrá a co vyjednat. Bez poplatků, Ostrava a online."
>
  <Header />
  <main id="hero" class="rec">
    <div class="rec__route" aria-hidden="true">
      {
        [
          { tier: 'mobile', vb: 390, axis: 24, dotOffset: 22, hero: false, entry: 0, r: 0 },
          // Tablet: nájezd shora v 90 % šířky (jako notebook), obloukem pod hero
          // textem k ose — stejně jako /pristup a /o-mne (28. 9. 2026).
          { tier: 'tablet', vb: 834, axis: 40, dotOffset: 44, hero: true, entry: 750, entryRatio: 0.9, r: 22 },
          { tier: 'laptop', vb: 1366, axis: 96, dotOffset: 36, hero: true, entry: 1230, r: 28 },
          { tier: 'desktop', vb: 1440, axis: 120, dotOffset: 36, hero: true, entry: 1300, r: 28 },
        ].map((v) => (
          <svg
            class={`rec__route-svg rec__route-svg--${v.tier}`}
            viewBox={`0 0 ${v.vb} 2600`}
            preserveAspectRatio="none"
            focusable="false"
            data-vb={v.vb}
            data-axis={v.axis}
            data-dot-offset={v.dotOffset}
            data-hero={String(v.hero)}
            data-entry={v.entry}
            data-entry-ratio={v.entryRatio}
            data-radius={v.r}
          >
            {v.hero && (
              <defs>
                <LineGradientDefs id={`rec-line-entry-${v.tier}`} tier={v.tier === 'desktop' ? 'desktop' : v.tier === 'tablet' ? 'tablet' : 'laptop'} x1={v.entry} y1={40} x2={v.entry} y2={140} />
              </defs>
            )}
            <path class="rec__route-path" d={`M ${v.axis} -20 V 2600`} fill="none" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {v.hero && (
              <path
                class="rec__route-path rec__route-entry"
                d={`M ${v.entry} 40 L ${v.entry} 140`}
                fill="none"
                stroke={`url(#rec-line-entry-${v.tier})`}
                stroke-width="1"
                stroke-linecap="round"
              />
            )}
            <path class="rec__route-path rec__route-path--dark" d="M 0 0 V 0" fill="none" stroke="var(--line-on-dark)" stroke-opacity=".3" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            {(['formular', 'postup', 'zkusenost', 'fixace'] as const).map((marker) => (
              <g class="rec__marker" data-marker={marker}>
                <line class="rec__notch" x1={v.axis} y1="0" x2={v.axis} y2="0" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" stroke-linecap="round" />
                <circle class="rec__dot" cx={v.axis} cy="0" r={v.tier === 'mobile' || v.tier === 'tablet' ? 3.2 : 3.5} fill="var(--emerald)" />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <section class="rec-hero" aria-labelledby="rec-hero-heading">
      <div class="rec-hero__text">
        <h1 id="rec-hero-heading" data-reveal>Končí vám fixace? Pošlete mi nabídku od&nbsp;banky.</h1>
        <p class="rec-hero__lead" data-reveal>
          Do&nbsp;jednoho pracovního dne vám řeknu, jestli je dobrá a&nbsp;co se&nbsp;dá vyjednat. Porovnám ji s&nbsp;nabídkami
          dalších bank a&nbsp;doporučím, co udělat. Bez poplatků.
        </p>
        <div class="rec-hero__actions" data-reveal>
          <a class="rec-cta" href="#ref-formular" data-scroll-target>Nechat zkontrolovat nabídku</a>
          <a class="rec-phone" href="tel:+420775217721">
            <svg class="rec-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>Zavolat +420&nbsp;775&nbsp;217&nbsp;721</span>
          </a>
        </div>
      </div>
    </section>

    <section class="rec-chapter rec-chapter--lead" id="ref-formular" aria-labelledby="formular-heading">
      <div class="rec-chapter__bar" data-reveal data-route-target="formular">
        <p>Nabídka</p>
      </div>

      <div class="rec-chapter__content">
        <div class="rec-chapter__top">
          <div class="rec-chapter__lead-col" data-reveal>
            <h2 id="formular-heading" class="rec-h2--dominant">Nechte mi kontakt, zbytek zařídím.</h2>
          </div>
          <div class="rec-chapter__support-col" data-reveal>
            <p class="rec-support__text">
              Ozvu se&nbsp;vám a&nbsp;domluvíme se, jak mi nabídku banky pošlete. Stačí ji vyfotit a&nbsp;poslat e-mailem.
            </p>
          </div>
        </div>

        <!-- Dva sloupce jako kontakt na úvodní stránce (ContactSection.astro):
             vlevo rychlé cesty a komu píšete, vpravo formulář (Patrik 1. 11. 2026). -->
        <div class="ref-body">
          <div class="ref-side" data-reveal>
            <div class="ref-side__group">
              <p class="ref-side__label">Raději hned?</p>
              <div class="ref-side__links">
                <a class="ref-side__link" href="tel:+420775217721">Zavolat +420&nbsp;775&nbsp;217&nbsp;721</a>
                <a class="ref-side__link" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat volný termín v&nbsp;kalendáři</a>
              </div>
            </div>

            <div class="ref-side__group">
              <p class="ref-side__label">Nebo napište</p>
              <div class="ref-person">
                <span class="ref-person__avatar">
                  <Image src={personPhoto} width={320} quality={92} alt="" loading="lazy" />
                </span>
                <p class="ref-person__text">
                  <strong>Patrik Gajdadzis</strong>
                  <span>Ozvu se&nbsp;do&nbsp;jednoho pracovního dne.</span>
                </p>
                <p class="ref-person__proof"><span class="ref-nowrap">5<span class="ref-person__star" aria-hidden="true">★</span><span class="sr-only"> hvězdiček,</span> hodnocení na&nbsp;Googlu&nbsp;·</span> <span class="ref-nowrap">zdarma</span></p>
              </div>
            </div>
          </div>

          <div class="ref-main">
            <form class="ref-form" method="post" action="/api/poptavka.php" novalidate data-reveal>
              <p class="ref-form__errors" role="alert" hidden></p>
              <div class="ref-hp" aria-hidden="true">
                <label for="ref-website">Nevyplňujte</label>
                <input id="ref-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <input type="hidden" name="vyplneno-ms" value="" />
              <input type="hidden" name="zdroj" value="refixace" />
              <input type="hidden" name="oblast" value="Hypotéka a bydlení" />
              <input type="hidden" name="gclid" value="" />
              <input type="hidden" name="utm_source" value="" />
              <input type="hidden" name="utm_medium" value="" />
              <input type="hidden" name="utm_campaign" value="" />


              <div class="ref-form__grid">
                <div class="ref-field">
                  <label for="ref-jmeno">Jméno a&nbsp;příjmení <span class="ref-required" aria-hidden="true">*</span></label>
                  <input id="ref-jmeno" name="jmeno" type="text" autocomplete="name" required aria-describedby="ref-jmeno-chyba" />
                  <p class="ref-field__error" id="ref-jmeno-chyba" hidden></p>
                </div>
                <div class="ref-field">
                  <label for="ref-telefon">Telefon <span class="ref-required" aria-hidden="true">*</span></label>
                  <input id="ref-telefon" name="telefon" type="tel" autocomplete="tel" required aria-describedby="ref-telefon-chyba" />
                  <p class="ref-field__error" id="ref-telefon-chyba" hidden></p>
                </div>
                <div class="ref-field ref-field--wide">
                  <label for="ref-konec">Kdy vám končí fixace? <span class="ref-required" aria-hidden="true">*</span></label>
                  <input id="ref-konec" name="konec_fixace" type="text" inputmode="text" placeholder="například 03/2027" maxlength="40" required aria-describedby="ref-konec-chyba" />
                  <p class="ref-field__error" id="ref-konec-chyba" hidden></p>
                </div>
              </div>

              <button class="rec-cta ref-form__submit" type="submit">Odeslat</button>

              <p class="ref-status ref-status--error" role="alert" hidden>
                Zprávu se&nbsp;nepodařilo odeslat. Zkuste to znovu nebo mi zavolejte na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
              </p>

              <p class="ref-privacy">
                Údaje použiji pouze pro&nbsp;vyřízení vaší poptávky a&nbsp;navazující komunikaci. <a href="/zpracovani-osobnich-udaju">Zásady zpracování osobních údajů</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="rec-chapter rec-chapter--postup" aria-labelledby="postup-heading">
      <div class="rec-chapter__bar" data-reveal data-route-target="postup">
        <p>Jak to funguje</p>
      </div>

      <div class="rec-chapter__content">
        <div class="rec-chapter__top">
          <div class="rec-chapter__lead-col" data-reveal>
            <h2 id="postup-heading" class="rec-h2--std">Konec fixace je nejlepší chvíle, kdy hypotéku přenést jinam.</h2>
          </div>
          <div class="rec-chapter__support-col" data-reveal>
            <p class="rec-support__text">
              Nabídka vaší banky často není to nejlepší, co můžete dostat. Stojí za&nbsp;to ji porovnat.
            </p>
          </div>
        </div>

        <div class="rec-reviews">
          <ul class="rec-reviews__list">
            {
              steps.map((item) => (
                <li class="rec-review">
                  <div class="rec-review__quote">
                    <h3 class="rec-review__title">{czechNbsp(item.title)}</h3>
                    <p>{czechNbsp(item.text)}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Zkušenost klienta (Patrik 4. 11. 2026): doslovný výňatek ze skutečné recenze na Google profilu. -->
    <section class="rec-chapter rec-chapter--zkusenost" aria-labelledby="zkusenost-heading">
      <div class="rec-chapter__bar" data-reveal data-route-target="zkusenost">
        <p id="zkusenost-heading">Zkušenost</p>
      </div>

      <div class="rec-chapter__content">
        <div data-reveal>
          <ServiceReview author="Stony K." text={'S panem Patrikem Gajdadzisem spolupracujeme už řadu let a jsme maximálně spokojeni. Dokázal nám pomoci i s vyvázáním člověka z hypotéky a následně zařídil novou s výhodnějším úrokem. … Je vidět, že svou práci dělá srdcem a opravdu mu záleží na lidech.'} />
        </div>
      </div>
    </section>

    <section class="rec-chapter rec-chapter--fixace" aria-labelledby="fixace-heading">
      <div class="rec-chapter__bar" data-reveal data-route-target="fixace">
        <p>Délka fixace</p>
      </div>

      <div class="rec-chapter__content">
        <div class="rec-chapter__top">
          <div class="rec-chapter__lead-col" data-reveal>
            <h2 id="fixace-heading" class="rec-h2--std">Na&nbsp;jak dlouho fixovat?</h2>
          </div>
          <div class="rec-chapter__support-col" data-reveal>
            <p class="rec-support__text">
              Jednu správnou odpověď pro&nbsp;všechny nemám a&nbsp;vývoj sazeb nikdo spolehlivě nepředpoví. Rozhoduje hlavně tohle:
            </p>
          </div>
        </div>

        <div class="rec-reviews">
          <ul class="rec-reviews__list">
            {
              fixation.map((item) => (
                <li class="rec-review">
                  <div class="rec-review__quote">
                    <h3 class="rec-review__title">{czechNbsp(item.title)}</h3>
                    <p>{czechNbsp(item.text)}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="rec-closing" aria-labelledby="rec-closing-heading">
      <div class="rec-closing__glow" aria-hidden="true"></div>

      <div class="rec-closing__grid">
        <h2 id="rec-closing-heading" data-reveal>Nečekejte na&nbsp;poslední chvíli.</h2>

        <div class="rec-closing__body" data-reveal>
          <p>
            Čím dřív nabídky porovnáme, tím víc času máte na&nbsp;rozhodnutí. Zavolejte mi, nebo mi nechte kontakt.
          </p>

          <div class="rec-closing__actions">
            <a class="rec-cta rec-cta--dark" href="#ref-formular">Nechat zkontrolovat nabídku</a>
            <a class="rec-phone rec-phone--dark" href="tel:+420775217721">
              <svg class="rec-phone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path
                  d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
            </a>
          </div>

          <a class="closing-booking" href={BOOKING_URL} target="_blank" rel="noopener">Nebo si rovnou vyberte termín online</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { firstLineCenterY } from '../../../scripts/first-line';
  import { fillAttribution } from '../../../scripts/attribution-fields';
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  const main = document.querySelector('.rec');
  const routeWrap = document.querySelector('.rec__route');

  if (main && routeWrap) {
    const svgs = Array.from(routeWrap.querySelectorAll('.rec__route-svg')) as SVGSVGElement[];
    const heroSection = main.querySelector('.rec-hero') as HTMLElement | null;
    const heroTextEl = main.querySelector('.rec-hero__text') as HTMLElement | null;
    const closingSection = main.querySelector('.rec-closing') as HTMLElement | null;
    const closingHeading = main.querySelector('.rec-closing__grid h2') as HTMLElement | null;
    const markerTargets = {
      formular: main.querySelector('[data-route-target="formular"]'),
      postup: main.querySelector('[data-route-target="postup"]'),
      zkusenost: main.querySelector('[data-route-target="zkusenost"]'),
      fixace: main.querySelector('[data-route-target="fixace"]'),
    } as const;

    const HERO_ENTRY_START_Y = 40;
    const HERO_ENTRY_MAX_LENGTH = 100;
    const HERO_ENTRY_MIN_LENGTH = 40;
    const HERO_ENTRY_GAP_BEFORE_BEND = 20;

    const heroArcPath = (entryX: number, axisX: number, r: number, bendY: number, totalHeight: number, entryEndY: number) => {
      const y1 = bendY - r;
      return `M ${entryX} ${entryEndY} V ${y1} A ${r} ${r} 0 0 1 ${entryX - r} ${y1 + r} H ${axisX + r} A ${r} ${r} 0 0 0 ${axisX} ${y1 + 2 * r} V ${totalHeight}`;
    };

    const syncRoute = () => {
      if (!heroSection) return;
      const mainRect = main.getBoundingClientRect();
      if (mainRect.height === 0) return;
      const totalHeight = Math.max(mainRect.height, 1);
      const heroBottom = heroSection.getBoundingClientRect().bottom - mainRect.top;
      const closingTop = closingSection ? closingSection.getBoundingClientRect().top - mainRect.top : totalHeight;

      let bendY = 260;
      if (heroTextEl) {
        const textRect = heroTextEl.getBoundingClientRect();
        const textBottom = textRect.bottom - mainRect.top;
        bendY = Math.min(Math.max(textBottom + 40, 260), heroBottom - 20);
      }

      svgs.forEach((svg) => {
        const isActive = getComputedStyle(svg).display !== 'none';
        const nominalVb = parseFloat(svg.dataset.vb ?? '390');
        const axis = parseFloat(svg.dataset.axis ?? '24');
        const dotOffsetPx = parseFloat(svg.dataset.dotOffset ?? '16');
        const isHero = svg.dataset.hero === 'true';
        const r = parseFloat(svg.dataset.radius ?? '0');

        if (!Number.isFinite(nominalVb) || nominalVb <= 0) return;

        const realWidthNow = isActive ? svg.getBoundingClientRect().width : 0;
        const vb = realWidthNow > 0 ? realWidthNow : nominalVb;
        // Tablet: nájezd v poměru k šířce, jinak pevná tierová konstanta.
        const entryRatio = parseFloat(svg.dataset.entryRatio ?? '');
        const entryX = Number.isFinite(entryRatio) ? entryRatio * vb : parseFloat(svg.dataset.entry ?? '0');

        svg.setAttribute('viewBox', `0 0 ${vb} ${totalHeight}`);

        const lightPath = svg.querySelector('.rec__route-path:not(.rec__route-path--dark)') as SVGPathElement | null;
        const darkPath = svg.querySelector('.rec__route-path--dark') as SVGPathElement | null;

        const axisScaled = (axis / nominalVb) * vb;
        const shift = axisScaled - axis;
        // Mobil (28. 9. 2026): trasa jako na tabletu — od osy pod obsahem hero
        // obloukem doprava, po pravé straně nahoru a pod záhlavím končí do
        // ztracena nájezdovým gradientem (barvy LineGradientDefs tier „tablet").
        // Je-li v hero fotka v pozadí (absolutně nahoře), vede linka ZA ní jako
        // na homepage: nahoře vedle hlavy je vidět, za postavou schovaná a v místě,
        // kde se fotka rozpouští, se plynule znovu objeví (úsek „mid" s vlastním
        // gradientem — v průsvitné části fotky by jinak linka prosvítala).
        // Gradienty a pomocné cesty se v mobilním SVG vytvoří jednou za běhu.
        const mobileFramePath = (endY: number): string | null => {
          if (!heroSection) return null;
          const els = Array.from(heroSection.querySelectorAll('[class*="hero__text"], [class*="hero__photo"], [class*="hero__breadcrumb"], nav')) as HTMLElement[];
          const rects = els.map((e) => e.getBoundingClientRect()).filter((r) => r.height > 0);
          if (!rects.length) return null;
          const bottom = Math.max(...rects.map((r) => r.bottom)) - mainRect.top;
          const fr = 18;
          const rightX = (378 / nominalVb) * vb;
          const y0 = 40;
          const yB = bottom + 28;
          const yE = Math.min(140, yB - fr - 20);
          const NS = 'http://www.w3.org/2000/svg';
          const ensure = (cls: string, stops: [string, string, string][]) => {
            let path = svg.querySelector(`path.${cls}`) as SVGPathElement | null;
            let grad = svg.querySelector(`linearGradient.${cls}`) as SVGLinearGradientElement | null;
            if (!path || !grad) {
              const defs = document.createElementNS(NS, 'defs');
              grad = document.createElementNS(NS, 'linearGradient') as SVGLinearGradientElement;
              grad.id = `${cls}-${Math.random().toString(36).slice(2, 9)}`;
              grad.setAttribute('class', cls);
              grad.setAttribute('gradientUnits', 'userSpaceOnUse');
              stops.forEach(([o, c, op]) => {
                const st = document.createElementNS(NS, 'stop');
                st.setAttribute('offset', o);
                st.setAttribute('stop-color', c);
                st.setAttribute('stop-opacity', op);
                grad!.appendChild(st);
              });
              defs.appendChild(grad);
              svg.insertBefore(defs, svg.firstChild);
              path = document.createElementNS(NS, 'path') as SVGPathElement;
              path.setAttribute('class', cls);
              path.setAttribute('fill', 'none');
              path.setAttribute('stroke', `url(#${grad.id})`);
              path.setAttribute('stroke-width', '1');
              path.setAttribute('stroke-linecap', 'round');
              svg.appendChild(path);
            }
            return { path, grad };
          };
          const entry = ensure('route-mobile-entry', [['0%', '#1E7A5C', '0'], ['34%', '#1E7A5C', '.36'], ['70%', '#255E77', '.24'], ['100%', '#1B4A8A', '.18']]);
          entry.grad.setAttribute('x1', String(rightX));
          entry.grad.setAttribute('x2', String(rightX));
          entry.grad.setAttribute('y1', String(y0));
          entry.grad.setAttribute('y2', String(yE));
          entry.path.setAttribute('d', `M ${rightX} ${y0} L ${rightX} ${yE}`);
          let mainStart = yE;
          const bgPhoto = heroSection.querySelector('[class*="hero__photo"]') as HTMLElement | null;
          if (bgPhoto && getComputedStyle(bgPhoto).position === 'absolute') {
            const pr = bgPhoto.getBoundingClientRect();
            const pTop = pr.top - mainRect.top;
            const yA = pTop + pr.height * 0.44;
            // Pod 72 % výšky fotky je postava už skoro rozpuštěná — linka je až do
            // té výšky schovaná (i přes průsvitnou ruku) a objeví se až pod ní.
            const yD = pTop + pr.height * 0.72;
            const yF = Math.min(pTop + pr.height * 0.9, yB - fr - 1);
            if (yF > yE + 20) {
              const span = yF - yE;
              const pA = Math.max(0, Math.min(1, (yA - yE) / span));
              const pC = Math.max(pA, Math.min(1, pA + 12 / span));
              const pD = Math.max(pC, Math.min(1, (yD - yE) / span));
              const mid = ensure('route-mobile-mid', [['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '.18'], ['0%', '#1B4A8A', '0'], ['0%', '#1B4A8A', '0'], ['100%', '#1B4A8A', '.18']]);
              const st = mid.grad.querySelectorAll('stop');
              st[1].setAttribute('offset', String(pA));
              st[2].setAttribute('offset', String(pC));
              st[3].setAttribute('offset', String(pD));
              mid.grad.setAttribute('x1', String(rightX));
              mid.grad.setAttribute('x2', String(rightX));
              mid.grad.setAttribute('y1', String(yE));
              mid.grad.setAttribute('y2', String(yF));
              mid.path.setAttribute('d', `M ${rightX} ${yE} L ${rightX} ${yF}`);
              mainStart = yF;
            }
          }
          return `M ${rightX} ${mainStart} V ${yB - fr} A ${fr} ${fr} 0 0 1 ${rightX - fr} ${yB} H ${axisScaled + fr} A ${fr} ${fr} 0 0 0 ${axisScaled} ${yB + fr} V ${endY}`;
        };
        if (isActive) {
          (main as HTMLElement).style.setProperty('--rec-shift', `${shift}px`);
        }

        if (isHero) {
          const available = bendY - r - HERO_ENTRY_START_Y - HERO_ENTRY_GAP_BEFORE_BEND;
          const entryLength = Math.min(HERO_ENTRY_MAX_LENGTH, Math.max(HERO_ENTRY_MIN_LENGTH, available));
          const entryEndY = HERO_ENTRY_START_Y + entryLength;

          const gradient = svg.querySelector('linearGradient');
          if (gradient) {
            gradient.setAttribute('y1', String(HERO_ENTRY_START_Y));
            gradient.setAttribute('y2', String(entryEndY));
          }

          const entryPath = svg.querySelector('.rec__route-entry') as SVGPathElement | null;
          if (entryPath) entryPath.setAttribute('d', `M ${entryX} ${HERO_ENTRY_START_Y} L ${entryX} ${entryEndY}`);

          if (lightPath) lightPath.setAttribute('d', heroArcPath(entryX, axisScaled, r, bendY, closingTop, entryEndY));
        } else if (lightPath) {
          lightPath.setAttribute('d', mobileFramePath(closingTop) ?? `M ${axisScaled} ${heroBottom - 20} V ${closingTop}`);
        }

        const gapBuffer = 20;
        let darkD = `M ${axisScaled} ${closingTop - 20} V ${totalHeight}`;
        if (darkPath && closingHeading) {
          const hRect = closingHeading.getBoundingClientRect();
          const svgRectNow = svg.getBoundingClientRect();
          const axisRealX = svgRectNow.left + axisScaled * (svgRectNow.width / vb);
          if (hRect.width > 0 && axisRealX >= hRect.left && axisRealX <= hRect.right) {
            const gapTop = hRect.top - mainRect.top - gapBuffer;
            const gapBottom = hRect.bottom - mainRect.top + gapBuffer;
            darkD = `M ${axisScaled} ${closingTop - 20} V ${gapTop} M ${axisScaled} ${gapBottom} V ${totalHeight}`;
          }
        }
        if (darkPath) darkPath.setAttribute('d', darkD);

        if (!isActive) return;

        const svgRect = svg.getBoundingClientRect();
        if (svgRect.height === 0 || svgRect.width === 0) return;
        const scaleY = svgRect.height / totalHeight;
        const scaleX = svgRect.width / vb;

        const axisRealX = svgRect.left + axisScaled * scaleX;
        const targetLocalX = (axisRealX + dotOffsetPx - svgRect.left) / scaleX;

        (Object.keys(markerTargets) as Array<keyof typeof markerTargets>).forEach((key) => {
          const target = markerTargets[key];
          const group = svg.querySelector(`[data-marker="${key}"]`);
          if (!target || !group) return;
          const centerY = firstLineCenterY(target);
          const localY = (centerY - svgRect.top) / scaleY;
          const notch = group.querySelector('.rec__notch');
          const dot = group.querySelector('.rec__dot');
          if (notch) {
            notch.setAttribute('y1', String(localY));
            notch.setAttribute('y2', String(localY));
            notch.setAttribute('x1', String(axisScaled));
            notch.setAttribute('x2', String(targetLocalX));
          }
          if (dot) {
            dot.setAttribute('cy', String(localY));
            dot.setAttribute('cx', String(targetLocalX));
          }
        });
      });
    };

    syncRoute();
    window.addEventListener('resize', syncRoute);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(main);
    }

    if (!reduceMotion) {
      const activeSvg = svgs.find((svg) => getComputedStyle(svg).display !== 'none');
      const paths = activeSvg ? (Array.from(activeSvg.querySelectorAll('.rec__route-path')) as SVGPathElement[]) : [];
      const dots = activeSvg ? (Array.from(activeSvg.querySelectorAll('.rec__dot')) as SVGCircleElement[]) : [];
      paths.forEach((path) => {
        const length = path.getTotalLength();
        if (length === 0) return;
        path.style.strokeDasharray = String(length);
        path.style.strokeDashoffset = String(length);
      });
      dots.forEach((dot) => dot.classList.add('is-pending'));
      window.setTimeout(() => {
        paths.forEach((path) => {
          path.style.transition = 'stroke-dashoffset var(--duration-line) var(--ease-out)';
          path.style.strokeDashoffset = '0';
        });
        window.setTimeout(() => {
          dots.forEach((dot) => {
            dot.classList.remove('is-pending');
            dot.classList.add('is-visible');
          });
        }, 450);
      }, 20);
    }

    const revealEls = Array.from(main.querySelectorAll('[data-reveal]')) as HTMLElement[];

    if (!reduceMotion && revealEls.length && 'IntersectionObserver' in window) {
      revealEls.forEach((el) => el.classList.add('is-pending'));

      const groups = new Map<Element | null, HTMLElement[]>();
      revealEls.forEach((el) => {
        const parent = el.closest('section');
        const list = groups.get(parent) ?? [];
        list.push(el);
        groups.set(parent, list);
      });

      const revealGroup = (section: Element | null) => {
        const els = groups.get(section) ?? [];
        const lastDelay = (els.length - 1) * 70;
        els.forEach((el, i) => {
          window.setTimeout(() => {
            el.classList.remove('is-pending');
            el.classList.add('is-visible');
          }, i * 70);
        });
        window.setTimeout(() => syncRoute(), lastDelay + 520);
      };

      /*
       * OPRAVA (nahlásil uživatel): `threshold: 0.15` vyžaduje, aby bylo
       * viditelných 15 % PLOCHY celé `<section>`, ne 15 % výšky viewportu.
       * `.rec-chapter--lead` teď nese 42 plných recenzí a je mnohonásobně
       * vyšší než viewport — jediná obrazovka pak nikdy nepokryje 15 % jejího
       * celkového obsahu, takže `isIntersecting` u dlouhých sekcí nikdy
       * nenastane a `[data-reveal]` děti (pruh, nadpis, text) zůstanou navždy
       * `opacity: 0`. `threshold: 0` reaguje na PRVNÍ průnik se sekcí bez
       * ohledu na její celkovou výšku — funguje stejně pro krátké i velmi
       * dlouhé sekce.
       */
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              revealGroup(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );

      Array.from(main.querySelectorAll('section')).forEach((section) => observer.observe(section));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  }

  // Hero CTA „Zobrazit recenze" — plynulý přesun na výpis na téže stránce.
  const scrollCta = document.querySelector('[data-scroll-target]');
  if (scrollCta) {
    scrollCta.addEventListener('click', (e) => {
      const href = scrollCta.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    });
  }

  // --- Formulář „Končí vám fixace?“: stejná pravidla a cesta jako
  // formulář „Na kolik dosáhnete?“ (honeypot, doba vyplnění, JSON odpověď),
  // navíc skrytá pole zdroje kliknutí (jen se souhlasem s marketingem).
  const refForm = document.querySelector<HTMLFormElement>('.ref-form');
  if (refForm) {
    const form = refForm;
    let startedAt: number | null = null;
    form.addEventListener('focusin', () => {
      if (startedAt === null) startedAt = performance.now();
    });
    const messages: Record<string, string> = {
      jmeno: 'Vyplňte prosím jméno a příjmení.',
      telefon: 'Vyplňte prosím telefonní číslo.',
      konec_fixace: 'Napište prosím, kdy vám fixace končí. Stačí přibližně.',
    };
    const fields = ['jmeno', 'telefon', 'konec_fixace'].map((n) => form.elements.namedItem(n) as HTMLInputElement);
    const validate = (input: HTMLInputElement) => {
      const ok = input.value.trim() !== '' && input.checkValidity();
      const err = document.getElementById(`${input.id}-chyba`);
      if (err) {
        err.textContent = ok ? '' : messages[input.name];
        err.hidden = ok;
      }
      if (ok) input.removeAttribute('aria-invalid');
      else input.setAttribute('aria-invalid', 'true');
      return ok;
    };
    fields.forEach((f) => f.addEventListener('blur', () => validate(f)));
    const summaryEl = form.querySelector<HTMLElement>('.ref-form__errors');
    const errorStatus = form.querySelector<HTMLElement>('.ref-status--error');
    const submit = form.querySelector<HTMLButtonElement>('.ref-form__submit');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit?.disabled) return;
      if (errorStatus) errorStatus.hidden = true;
      const allOk = fields.map(validate).every(Boolean);
      if (summaryEl) {
        summaryEl.hidden = allOk;
        summaryEl.textContent = allOk ? '' : 'Zkontrolujte prosím zvýrazněná pole.';
      }
      if (!allOk) return;

      const elapsed = form.elements.namedItem('vyplneno-ms') as HTMLInputElement;
      elapsed.value = String(Math.round(performance.now() - (startedAt ?? 0)));
      fillAttribution(form);

      if (submit) submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      let sent = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        const result = (await response.json().catch(() => null)) as { ok?: boolean } | null;
        sent = response.ok && result?.ok === true;
      } catch {
        sent = false;
      } finally {
        if (submit) submit.disabled = false;
        form.removeAttribute('aria-busy');
      }

      if (sent) {
        // Konverze „Odeslání formuláře“ (CookieConsent.astro, jen se souhlasem).
        document.dispatchEvent(new CustomEvent('pg:lead'));
        // Vyplněné údaje po odeslání smazat (jako kontaktní formulář na úvodní stránce).
        form.reset();
        // Poděkování uprostřed obrazovky (FormThanks.astro), formulář zůstává.
        document.dispatchEvent(new CustomEvent('pg:thanks', { detail: { text: 'Děkuji, ozvu se vám do jednoho pracovního dne.' } }));
      } else if (errorStatus) {
        errorStatus.hidden = false;
      }
    });
  }
</script>

