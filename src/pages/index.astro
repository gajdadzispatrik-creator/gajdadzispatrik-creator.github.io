---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroLine from '../components/HeroLine.astro';
import StatsBand from '../components/StatsBand.astro';
import ConnectionsSection from '../components/ConnectionsSection.astro';
import RouterSection from '../components/RouterSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import CasesSection from '../components/CasesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import aboutPhoto from '../assets/photos/patrik-duvera.webp';
import ArticlesSection from '../components/ArticlesSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { faqPage } from '../data/entity';
import { homeFaqs } from '../data/homeFaqs';

// Sekce Články je schovaná, dokud nevyjde první článek (5. 10. 2026) —
// trasa pak jde z O mně rovnou do FAQ (FaqSection `entry="left"`).
// Po prvním článku přepnout na true a vrátit záznamy Articles
// v scripts/audit-layout.mjs (HAS_ARTICLES).
const showArticles = false;
---

<BaseLayout
  title="Finanční poradce Ostrava | Patrik Gajdadzis"
  description="Finance se nemají řešit po částech. Bydlení, ochranu, investice a penzi propojuji do jednoho plánu, který dává smysl dnes i za několik let."
  jsonLd={[faqPage(homeFaqs)]}
>
  <Header />
  <main>
    <div class="hero-group">
      <Hero />
      <StatsBand />
      <HeroLine />
    </div>
    <ConnectionsSection />
    <RouterSection />
    <ProcessSection />
    <ReviewsSection />
    <BenefitsSection />
    <CasesSection />
    <AboutSection photoSrc={aboutPhoto.src} />
    {showArticles && <ArticlesSection />}
    <FaqSection entry={showArticles ? 'right' : 'left'} />
    <ContactSection />
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero-group {
    position: relative;
  }
</style>
