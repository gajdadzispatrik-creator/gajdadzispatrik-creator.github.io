    font-size: 21px;
  }

  .pri-step p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  /* ---------- Péče — statement + druhá fotografie ---------- */

  .pri-pece__closing {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* ---------- Otázky ---------- */

  .pri-faq {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .pri-faq__row {
    padding: 18px 0;
    border-top: 1px solid rgba(27, 74, 138, .14);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pri-faq__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .pri-faq dt {
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
  }

  .pri-faq dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Tmavé CTA ---------- */

  .pri-closing {
    position: relative;
    margin-top: 64px;
    padding-block: 56px;
    overflow: hidden;
    background: linear-gradient(168deg, var(--router-grad-1) 0%, var(--navy) 58%, var(--router-grad-2) 100%);
  }

  .pri-closing__glow {
    position: absolute;
    inset: 0;
    top: 0;
    height: 260px;
    background: radial-gradient(44% 60% at 76% 24%, rgba(46, 152, 115, .13) 0%, rgba(46, 152, 115, 0) 74%);
    pointer-events: none;
  }

  .pri-closing__grid {
    position: relative;
    z-index: 2;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pri-closing__grid h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--white);
    text-wrap: pretty;
  }

  .pri-closing__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pri-closing__body p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, .72);
  }

  .pri-closing__actions {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pri-closing__actions .pri-cta {
    width: 100%;
  }

  .pri-closing__actions .pri-phone {
    height: 48px;
    justify-content: center;
    font-size: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
    }
  }

  /* ============ Mobil (<768): obsah od popisku u tečky, ne na lince ============
     Popisek kapitoly stojí 36 px od kraje sekce (osa 24 + zářez) — obsah
     kapitol i závěrečné sekce začíná na stejné svislici, jako na tabletu
     (28. 9. 2026, dřív nadpisy a text ležely přímo na lince). */
  @media (max-width: 767px) {
    .pri-chapter__content {
      padding-left: calc(36px + var(--pri-shift, 0px));
    }

    .pri-closing__grid {
      padding-left: calc(60px + var(--pri-shift, 0px));
    }

    /* Kulatý portrét v Péči i na mobilu (dřív jen od tabletu) — pod
       závěrečnou větou kapitoly (28. 9. 2026; vedle věty byl sloupec
       textu moc úzký, uživatel zvolil text a pod ním fotku). */
    .pri-pece__photo {
      display: block;
      flex: none;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      /* Na střed stránky (ne sloupce textu): levý kraj obsahu kapitoly je
         24 + 36 px (+ posun osy), polovina fotky 80 px. */
      align-self: flex-start;
      margin-left: calc(50vw - 60px - var(--pri-shift, 0px) - 80px);
      /* Na mobilu fotka NAD závěrečnou větou (přání uživatele 28. 9. 2026). */
      order: -1;
    }

    /* Hero: fotka v pozadí jako na homepage, ale SVĚTLÁ varianta
       (28. 9. 2026, volba uživatele) — postava nahoře, dolů se plynule
       rozpustí do pozadí stránky (ne do tmavě modré), text zůstává tmavý
       na světlém. Homepage tak zůstává jediná s tmavým úvodem. */
    .pri-hero {
      position: relative;
      /* 260: minimum, aby text nezakryl obličej — nadpis začíná pod bradou,
         přes límec/hrudník v rozpuštěné části fotky. */
      padding-top: 260px;
      /* Hero na výšku displeje pod záhlavím (64 px) jako homepage — text
         a tlačítka přichycené ke spodku, fotka nahoře (29. 9. 2026).
         Spodek 40 px (telefonní řádek je tu o 4 px nižší): spodní hrana
         CTA leží 100 px nad koncem hero, takže v Safari na iOS 26 (plovoucí
         panel přes spodních ~140 px, 100svh = 772 px na iPhonu 17 Pro)
         zůstane tlačítko nad panelem a telefon pod ním — ověřeno podle
         screenshotu z iPhonu 17 Pro. */
      min-height: calc(100vh - 64px);
      min-height: calc(100svh - 64px);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 40px;
    }

    .pri-hero__text {
      position: relative;
      z-index: 3;
    }

    .pri-hero__photo {
      position: absolute;
      /* 24 px pod záhlavím — hlava mu nesmí být nalepená (28. 9. 2026). */
      top: 24px;
      left: 0;
      width: 100%;
      height: 560px;
    }

    .pri-hero__photo img {
      object-fit: cover;
      /* Obličej leží ve 40,4 % šířky výřezu (změřeno) — posun o 9,6 %
         dá hlavu přesně doprostřed stránky (přání uživatele 28. 9. 2026). */
      object-position: 50% 0;
      transform: translateX(9.6%);
      /* Dvě masky (průnik): spodek do ztracena + pravý kraj do ztracena,
         aby paže u pravého okraje nepůsobila uříznutě (28. 9. 2026). Obrázek
         je posunutý o 9,6 % doprava, viditelný pravý kraj je tedy na ~90 %
         jeho šířky — přechod 56 → 90 % (plynulý, 28. 9. 2026). */
      -webkit-mask-image:
        linear-gradient(180deg, #000 44%, rgba(0, 0, 0, .96) 48%, rgba(0, 0, 0, .85) 52%, rgba(0, 0, 0, .69) 56%, rgba(0, 0, 0, .5) 60%, rgba(0, 0, 0, .31) 64%, rgba(0, 0, 0, .15) 68%, rgba(0, 0, 0, .04) 72%, transparent 76%),
        linear-gradient(90deg, #000 56%, rgba(0, 0, 0, .98) 59%, rgba(0, 0, 0, .94) 62%, rgba(0, 0, 0, .85) 65%, rgba(0, 0, 0, .75) 68%, rgba(0, 0, 0, .63) 71%, rgba(0, 0, 0, .5) 74%, rgba(0, 0, 0, .37) 77%, rgba(0, 0, 0, .25) 80%, rgba(0, 0, 0, .15) 83%, rgba(0, 0, 0, .06) 86%, rgba(0, 0, 0, .02) 88%, transparent 90%);
      -webkit-mask-composite: source-in;
              mask-image:
        linear-gradient(180deg, #000 44%, rgba(0, 0, 0, .96) 48%, rgba(0, 0, 0, .85) 52%, rgba(0, 0, 0, .69) 56%, rgba(0, 0, 0, .5) 60%, rgba(0, 0, 0, .31) 64%, rgba(0, 0, 0, .15) 68%, rgba(0, 0, 0, .04) 72%, transparent 76%),
        linear-gradient(90deg, #000 56%, rgba(0, 0, 0, .98) 59%, rgba(0, 0, 0, .94) 62%, rgba(0, 0, 0, .85) 65%, rgba(0, 0, 0, .75) 68%, rgba(0, 0, 0, .63) 71%, rgba(0, 0, 0, .5) 74%, rgba(0, 0, 0, .37) 77%, rgba(0, 0, 0, .25) 80%, rgba(0, 0, 0, .15) 83%, rgba(0, 0, 0, .06) 86%, rgba(0, 0, 0, .02) 88%, transparent 90%);
              mask-composite: intersect;
    }
  }

  /* ============ Tablet: 768–1199 (kalibrace 834) ============ */
  @media (min-width: 768px) {
    .pri__route-svg--mobile {
      display: none;
    }

    .pri__route-svg--tablet {
      display: block;
    }

    .pri-chapter__bar p {
      padding-left: calc(64px + var(--pri-shift, 0px));
    }

    .pri-verify-badge {
      margin-left: calc(64px + var(--pri-shift, 0px));
    }

    .pri-hero {
      padding: 88px 40px 0;
    }

    .pri-hero__text {
      gap: 20px;
    }

    .pri-hero__text h1 {
      font-size: 52px;
      line-height: 1.04;
    }

    .pri-hero__lead {
      font-size: 17.5px;
      max-width: 600px;
    }

    .pri-hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 28px;
    }

    .pri-hero__actions .pri-cta {
      width: auto;
      padding-inline: 28px;
    }

    .pri-hero__actions .pri-phone {
      height: auto;
    }

    /* Jako /o-mne: fotka se rozpouští až na spodku hero, pod ní k „Začátku"
       jen padding kapitoly (72 px), ne dalších 80 px navíc. */
    .pri-chapter--zacatek {
      margin-top: 0;
      padding: 72px 40px;
    }

    .pri-chapter {
      padding: 72px 40px;
    }

    /* Obsah kapitol od popisku u tečky (osa 40 + 64 = 104 px), ne na ose
       — dřív nadpisy a text ležely přímo na lince. Stejně jako
       `.hyp-chapter__content` na /sluzby/hypoteky (28. 9. 2026). */
    .pri-chapter__content {
      padding-left: calc(64px + var(--pri-shift, 0px));
    }

    /* Na tabletu nadpis kapitoly NAD textem přes celou šířku (ne dva sloupce
       vedle sebe) — stejně jako /o-mne (28. 9. 2026, přání uživatele).
       Vedle sebe až od notebooku (pravidla přesunutá do bloku 1200+). */
    .pri-chapter__top {
      max-width: 640px;
    }

    /* Kulatý portrét v Péči i na tabletu (dřív až od 1200 px), vedle
       závěrečné věty jako na desktopu, jen menší. */
    .pri-pece__closing {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }

    .pri-pece__closing .pri-chapter__statement {
      flex: 1;
    }

    .pri-pece__photo {
      display: block;
      flex: none;
      width: 180px;
      height: 180px;
      border-radius: 50%;
    }

    .pri-chapter__bar p {
      font-size: 21px;
    }

    .pri-chapter__bar--muted p {
      font-size: 18px;
    }

    .pri-h2--dominant {
      font-size: 44px;
    }

    .pri-h2--std {
      font-size: 40px;
    }

    .pri-support__text {
      font-size: 18px;
    }

    .pri-chapter__statement {
      font-size: 24px;
    }

    .pri-steps {
      gap: 44px;
    }

    .pri-step__marker {
      display: block;
      top: 14px;
      width: 8px;
      height: 8px;
    }

    .pri-step--first .pri-step__marker {
      width: 9px;
      height: 9px;
    }

    .pri-step__connector {
      display: block;
      top: 14px;
      bottom: -58px;
      left: 3.5px;
    }

    .pri-step--first .pri-step__connector {
      left: 4px;
    }

    .pri-faq dt {
      font-size: 19px;
    }

    .pri-closing {
      margin-top: 80px;
      padding-block: 76px;
    }

    /* Text od linky odsazený stejně jako obsah kapitol (osa + 64 px). */
    .pri-closing__grid {
      padding-inline: 40px;
      padding-left: calc(104px + var(--pri-shift, 0px));
    }

    .pri-closing__grid h2 {
      font-size: 44px;
    }

    .pri-closing__body p {
      font-size: 17px;
    }

    .pri-closing__actions {
      flex-direction: row;
      gap: 32px;
    }

    .pri-closing__actions .pri-cta {
      width: auto;
      padding-inline: 28px;
    }

    .pri-closing__actions .pri-phone {
      height: auto;
    }
  }

  /* ============ Jen tablet (768–1199): hero jako homepage ============
     Rozložení 1:1 podle Hero.astro na tabletu (28. 9. 2026, přání uživatele
     „pozice textů jako na homepage"): text vlevo se stejnou velikostí
     nadpisu, šířkou a odstupy, fotka vpravo absolutně ve stejném bloku
     (top/left/šířka/výška stejné vzorce jako .hero-photo na homepage) —
     spodek bloku = spodek hero. Postava: cover (průhledné okraje výřezu se
     oříznou), hlava ~85 px jako na homepage; vidět ~816 px výřezu, pod
     prsty plynulé rozpuštění. */
  @media (min-width: 768px) and (max-width: 1199px) {
    .pri-hero {
      position: relative;
      padding: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px) 40px 0;
      min-height: clamp(656px, calc(656px + 0.255639 * (100vw - 834px)), 792px);
    }

    .pri-hero__text {
      gap: 0;
    }

    .pri-hero__text h1 {
      max-width: 490px;
      font-size: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
      line-height: .99;
    }

    .pri-hero__lead {
      margin-top: 60px;
      max-width: min(520px, calc(100vw - 392px));
      font-size: clamp(16.5px, calc(16.5px + 0.004699 * (100vw - 834px)), 19px);
    }

    .pri-hero__actions {
      margin-top: 46px;
      gap: clamp(32px, calc(32px + 0.007519 * (100vw - 834px)), 36px);
    }

    .pri-hero__photo {
      position: absolute;
      top: clamp(72px, calc(72px + 0.060150 * (100vw - 834px)), 104px);
      left: min(
        clamp(560px, calc(560px + 0.639098 * (100vw - 834px)), 900px),
        calc(100% - clamp(334px, calc(312px + 0.289474 * (100vw - 834px)), 466px) - 8px)
      );
      bottom: 0;
      /* Min. 334 px (ne 312): užší blok pod ~900 px ořezával cover-em boky
         fotky a uřízl loket vpravo (28. 9. 2026). */
      width: clamp(334px, calc(312px + 0.289474 * (100vw - 834px)), 466px);
      height: auto;
      margin: 0;
    }

    .pri-hero__photo img {
      height: calc(100% * 1.064);
      object-fit: cover;
