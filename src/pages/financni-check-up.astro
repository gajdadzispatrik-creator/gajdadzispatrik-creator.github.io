---
/**
 * Finanční check-up — 8 otázek na klikání, vyhodnocení přímo v prohlížeči,
 * nic se neodesílá. Texty schválil Patrik 4. 10. 2026
 * (docs/financni-check-up-navrh.md — tam jsou i pravidla vyhodnocení).
 *
 * Bez kapitol s trasou (nástroj, ne kapitola webu — stejně jako 404.astro),
 * proto ani záznam v `PAGES` (scripts/audit-layout.mjs). Linku do patičky
 * kreslí StandaloneRoute.astro. Hero odsazení a typografie 1:1 jako
 * 404.astro / sourozenecké podstránky.
 *
 * Všechny otázky i varianty výsledku jsou ve statickém HTML (skryté), JS
 * jen přepíná, co je vidět — check:typo tak vidí celý text. Výsledek lze
 * poslat přes kontaktní formulář: odpovědi jdou přes sessionStorage do
 * pole „Stručně popište svou situaci“ (ContactSection.astro), odešle je až
 * návštěvník sám.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandaloneRoute from '../components/StandaloneRoute.astro';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../data/entity';
import pecePhoto from '../assets/photos/patrik-pristup-pece.png';

// Nezlomitelná mezera za krátkými předložkami/spojkami a za číslem
// (CLAUDE.md „Konvence: nezlomitelná mezera").
const nb = (text: string) =>
  text
    .replace(/(^|[\s(])([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze|Do|Ke|Na|Od|Po|Pro|Se|Ve|Za|Ze) /g, '$1$2 ')
    .replace(/(^|[\s(])([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze|Do|Ke|Na|Od|Po|Pro|Se|Ve|Za|Ze) /g, '$1$2 ')
    .replace(/(\d) /g, '$1 ');

interface Question {
  id: string;
  title: string;
  q: string;
  options: string[];
}

const questions: Question[] = [
  {
    id: 'rezerva',
    title: 'Rezerva',
    q: 'Kdybyste zítra přišli o příjem, na jak dlouho by vám vystačily úspory?',
    options: ['Méně než měsíc', '1 až 3 měsíce', '3 až 6 měsíců', 'Déle než 6 měsíců'],
  },
  {
    id: 'pojisteni',
    title: 'Pojištění příjmu',
    q: 'Jste pojištění pro případ dlouhodobé nemoci nebo invalidity?',
    options: ['Ano a vím, na jaké částky', 'Ano, ale nevím přesně, co pojištění kryje', 'Ne', 'Nevím'],
  },
  {
    id: 'zavislost',
    title: 'Kdo na vás závisí',
    q: 'Živí váš příjem i další lidi, nebo z něj splácíte úvěr?',
    options: ['Ano', 'Ne'],
  },
  {
    id: 'hypoteka',
    title: 'Hypotéka',
    q: 'Máte hypotéku?',
    options: ['Nemám', 'Mám a vím, kdy mi končí fixace', 'Mám, ale nevím, kdy mi končí fixace'],
  },
  {
    id: 'bydleni',
    title: 'Plány s bydlením',
    q: 'Plánujete v příštích dvou letech koupi, stavbu nebo rekonstrukci bydlení?',
    options: ['Ano', 'Možná', 'Ne'],
  },
  {
    id: 'investice',
    title: 'Dlouhodobé peníze',
    q: 'Odkládáte si pravidelně peníze na delší dobu, na pět a více let?',
    options: ['Ano, pravidelně investuji', 'Spořím, ale peníze leží na účtu', 'Zatím ne'],
  },
  {
    id: 'penze',
    title: 'Penze',
    q: 'Víte, z čeho budete žít v důchodu?',
    options: [
      'Mám představu a pravidelně si na to odkládám',
      'Mám penzijní spoření nebo DIP, ale nevím, jestli to stačí',
      'Zatím to neřeším',
    ],
  },
  {
    id: 'smlouvy',
    title: 'Přehled o smlouvách',
    q: 'Kdy jste naposledy prošli své smlouvy (pojištění, úvěry, spoření)?',
    options: ['Během posledního roku', 'Před více lety', 'Ještě nikdy'],
  },
];

// Varianty textu každé oblasti; kterou zobrazit, rozhoduje skript níže
// (pravidla viz docs/financni-check-up-navrh.md, „Vyhodnocení").
interface Area {
  id: string;
  name: string;
  link: { label: string; href: string };
  /** Jedna krátká věta na lince výsledku. */
  short: Record<string, string>;
  /** Delší vysvětlení — jen u oblasti „Začal bych tady". */
  texts: Record<string, string>;
}

const areas: Area[] = [
  {
    id: 'rezerva',
    name: 'Rezerva',
    link: { label: 'Finanční plán', href: '/sluzby/financni-plan' },
    short: { ok: 'Rezervu máte.', check: 'Rezerva je menší, než je bezpečné.' },
    texts: {
      ok: 'Máte rezervu, která vás podrží i při nečekaném výpadku příjmu.',
      check:
        'Rezerva je základ, na kterém stojí všechno ostatní. Jak velká má být, záleží na vašich výdajích, příjmu a na tom, kdo na vás závisí. Spočítáme ji spolu.',
    },
  },
  {
    id: 'prijem',
    name: 'Příjem a rodina',
    link: { label: 'Pojištění', href: '/sluzby/pojisteni' },
    short: { ok: 'Pojištění příjmu máte, vyplatí se ověřit částky a nastavení.', check: 'Příjem nemáte jistě pojištěný.' },
    texts: {
      ok: 'Máte pojištěné to nejdůležitější, svůj příjem.',
      check:
        'Největší finanční riziko většiny lidí není škoda na majetku, ale dlouhý výpadek příjmu. Vyplatí se vědět, co by se v takové situaci stalo.',
      checkDep:
        'Na vašem příjmu závisí další lidé nebo splátky. O to důležitější je vědět, že ho máte dobře pojištěný.',
    },
  },
  {
    id: 'bydleni',
    name: 'Bydlení a hypotéka',
    link: { label: 'Hypotéky', href: '/sluzby/hypoteky' },
    short: {
      ok: 'Nic akutního neřešíte.',
      okFix: 'Víte, kdy končí fixace.',
      checkFix: 'Nevíte, kdy končí fixace.',
      checkPlan: 'Chystáte bydlení, vyplatí se znát čísla předem.',
    },
    texts: {
      ok: 'V oblasti bydlení teď nic akutního neřešíte.',
      okFix: 'Víte, kdy vám končí fixace, to je dobrý základ. Začít se vyplatí klidně i rok před tímto datem a zjistit, jaká je situace na trhu.',
      checkFix:
        'Vyplatí se zjistit, kdy vám končí fixace. Konec fixace je nejlepší chvíle hypotéku zkontrolovat. Začít se vyplatí klidně i rok předem a zjistit, jaká je situace na trhu, ne až když přijde nabídka od banky.',
      checkPlan:
        'Než začnete hledat, je dobré znát čísla: na jakou cenu dosáhnete, kolik budete potřebovat vlastních peněz a jaká splátka je pro vás rozumná.',
    },
  },
  {
    id: 'investice',
    name: 'Dlouhodobé peníze',
    link: { label: 'Investice', href: '/sluzby/investice' },
    short: { ok: 'Pravidelně investujete, vyplatí se ověřit strategii a poplatky.', check: 'Peníze vám leží na účtu.' },
    texts: {
      ok: 'Pravidelně odkládáte na delší dobu. Vyplatí se jen občas zkontrolovat, jestli investice pořád odpovídají vašim cílům.',
      check: 'Peníze, které nebudete potřebovat pět a více let, na běžném účtu časem ztrácejí hodnotu kvůli inflaci.',
    },
  },
  {
    id: 'penze',
    name: 'Penze',
    link: { label: 'Penze', href: '/sluzby/penze' },
    short: { ok: 'Na penzi si odkládáte.', check: 'Penzi zatím nemáte spočítanou.' },
    texts: {
      ok: 'Na penzi myslíte s předstihem, to je velká výhoda.',
      check: 'Čím dřív víte, kolik budete na penzi potřebovat, tím menší částky stačí odkládat.',
    },
  },
  {
    id: 'smlouvy',
    name: 'Přehled o smlouvách',
    link: { label: 'Finanční plán', href: '/sluzby/financni-plan' },
    short: { ok: 'Smlouvy jste nedávno procházeli, druhý pohled se ale vyplatí.', check: 'Smlouvy dlouho nikdo neprošel.' },
    texts: {
      ok: 'Smlouvy máte zkontrolované nedávno.',
      check:
        'Starší smlouvy často neodpovídají tomu, co dnes potřebujete. Chybí v nich důležité krytí a platíte v nich za věci, které nevyužijete.',
    },
  },
];

// Celkové hodnocení nad výsledkem podle počtu oblastí v pořádku
// (all = 6, good = 4–5, some = 2–3, many = 0–1).
const verdicts = [
  {
    id: 'all',
    title: 'Základ máte ve všech oblastech.',
    text: 'To je dobrý start. Jestli je všechno nastavené správně, ale ukáže až pohled do smluv: pojištění nebo investice můžete mít, a přesto na nevhodné částky nebo za zbytečně vysokou cenu.',
  },
  {
    id: 'good',
    title: 'Základ máte dobrý.',
    text: 'Pár oblastí se ale vyplatí projít. Najdete je hned níže i s tím, kde bych začal.',
  },
  {
    id: 'some',
    title: 'Některé důležité věci se vyplatí projít.',
    text: 'Nejde o nic, co by se nedalo vyřešit. Níže najdete, co vám vyšlo a kde bych začal.',
  },
  {
    id: 'many',
    title: 'Ve financích je prostor udělat pořádek.',
    text: 'Je to častější, než si myslíte, a dá se to vyřešit postupně, krok za krokem. Níže najdete, kde bych začal.',
  },
];

const config = {
  questions: questions.map((q) => ({ id: q.id, title: q.title, options: q.options })),
};
---

<BaseLayout
  title="Finanční check-up | Patrik Gajdadzis"
  description="Stačí 8 krátkých otázek a zhruba 2 minuty. Zjistěte, kde ve financích máte základ a kde se vyplatí podívat blíž."
>
  <Header />
  <main id="hero" class="chk">
    <StandaloneRoute />

    <section class="chk-hero" aria-labelledby="chk-heading">
      <div class="chk-hero__text" data-route-content data-checkup data-config={JSON.stringify(config)}>
        <h1 id="chk-heading">Jak na&nbsp;tom jsou vaše finance?</h1>

        <!-- Úvod -->
        <div class="chk-step chk-intro" data-step="intro">
          <p class="chk-hero__lead">
            Stačí 8&nbsp;krátkých otázek a&nbsp;zhruba 2&nbsp;minuty. Na&nbsp;konci uvidíte, kde máte základ a&nbsp;kde se&nbsp;vyplatí
            podívat blíž.
          </p>
          <p class="chk-intro__meta">Odpovědi zůstávají jen ve&nbsp;vašem prohlížeči, nikam se&nbsp;neodesílají.</p>
          <div class="chk-intro__actions">
            <button class="chk-cta" type="button" data-start>Začít</button>
          </div>
          <noscript>
            <p class="chk-intro__meta">
              Check-up potřebuje zapnutý JavaScript. Zavolejte mi na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
            </p>
          </noscript>
        </div>

        <!-- Otázky -->
        <div class="chk-step chk-quiz" data-step="quiz" hidden>
          {/* Postup jako trasa webu: SVG v pevné velikosti (bez roztažení),
              tečky jako <circle> s poloměry podle CLAUDE.md „Konvence: velikost
              teček" — aktuální otázka = hlavní (zelená) tečka. */}
          <svg class="chk-progress" width="260" height="10" viewBox="0 0 260 10" aria-hidden="true" focusable="false">
            <path d="M5 5H255" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" fill="none" />
            {questions.map((_, i) => (
              <circle class="chk-progress__dot" cx={5 + (i * 250) / (questions.length - 1)} cy="5" r="2.4" />
            ))}
          </svg>
          <p class="chk-quiz__count" aria-live="polite">Otázka <span data-count>1</span> z&nbsp;{questions.length}</p>

          {/* Všechny otázky v jedné buňce mřížky: výška = nejdelší otázka, takže
              „Zpět“ a vše pod ním při proklikávání neposkakuje. */}
          <div class="chk-questions">
          {
            questions.map((q, qi) => (
              <fieldset class="chk-question" data-question={qi} hidden>
                <legend class="chk-question__title" tabindex="-1">{nb(q.q)}</legend>
                <div class="chk-options">
                  {q.options.map((option, oi) => (
                    <button class="chk-option" type="button" data-option={oi}>
                      <span class="chk-option__mark" aria-hidden="true" />
                      <span>{nb(option)}</span>
                    </button>
                  ))}
                </div>
              </fieldset>
            ))
          }
          </div>

          <button class="chk-back" type="button" data-back>Zpět</button>
        </div>

        <!-- Výsledek: skóre → oblasti k projití (s „Začal bych tady“) → oblasti v pořádku → nabídka konzultace -->
        <div class="chk-step chk-result" data-step="result" hidden>
          <div class="chk-score">
            <p class="chk-score__label">Váš výsledek</p>
            <div class="chk-score__row">
              <p class="chk-score__number" aria-hidden="true">
                <span data-ok-count>0</span><span class="chk-score__of">z&nbsp;{areas.length}</span>
              </p>
              <div class="chk-score__meta">
                <svg class="chk-score__dots" width={10 + (areas.length - 1) * 18} height="10" viewBox={`0 0 ${10 + (areas.length - 1) * 18} 10`} aria-hidden="true" focusable="false">
                  <path d={`M5 5H${5 + (areas.length - 1) * 18}`} stroke="var(--line)" stroke-opacity=".18" stroke-width="1" fill="none" />
                  {areas.map((_, i) => <circle class="chk-score__dot" cx={5 + i * 18} cy="5" r="3.2" />)}
                </svg>
                <p class="chk-score__caption">oblastí, kde máte základ</p>
              </div>
            </div>
            <p class="sr-only" data-score-sr></p>
            {
              verdicts.map((v) => (
                <div class="chk-verdict" data-verdict={v.id} hidden>
                  <h2 class="chk-verdict__title" tabindex="-1">{nb(v.title)}</h2>
                  <p class="chk-verdict__text">{nb(v.text)}</p>
                </div>
              ))
            }
          </div>

          {/* Výsledek jako linka se zastávkami (hlavní grafický prvek webu):
              nahoře oblasti k projití, pod nimi ty se základem. Rozbalená je
              jen první k projití („Tady bych začal"). */}
          <div class="chk-map-wrap">
            <ol class="chk-map" data-map>
              {
                areas.map((area) => (
                  <li class="chk-stop" data-area={area.id}>
                    <svg class="chk-stop__dot" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" focusable="false">
                      <circle cx="4" cy="4" r="3.2" class="chk-dot" />
                    </svg>
                    <h3 class="chk-stop__name">
                      {nb(area.name)}
                    </h3>
                    <p class="chk-stop__status" data-status-ok>Základ máte</p>
                    <p class="chk-stop__status chk-stop__status--check" data-status-check>Vyplatí se&nbsp;podívat</p>
                    {Object.entries(area.short).map(([key, text]) => (
                      <p class="chk-stop__short" data-short={key} hidden>{nb(text)}</p>
                    ))}
                    <div class="chk-stop__detail">
                      <p class="chk-stop__lead">Tady bych začal</p>
                      {Object.entries(area.texts).map(([key, text]) => (
                        <p data-text={key} hidden>{nb(text)}</p>
                      ))}
                      <a class="chk-stop__link" href={area.link.href}>{area.link.label}</a>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="chk-offer">
            <div class="chk-offer__glow" aria-hidden="true"></div>
            <div class="chk-offer__person">
              <span class="chk-offer__avatar">
                <Image src={pecePhoto} width={160} alt="" loading="lazy" />
              </span>
              <p>
                <strong>Patrik Gajdadzis</strong>
                <span>Finanční poradce, Ostrava</span>
              </p>
            </div>
            <h2 class="chk-offer__heading" data-offer-heading>Chcete to probrat?</h2>
            <p class="chk-offer__text" data-offer-text="check">
              Na&nbsp;úvodní konzultaci projdeme, co vám vyšlo, i&nbsp;to, jak máte nastavené současné smlouvy. Trvá přibližně
              30&nbsp;minut, je nezávazná a&nbsp;zdarma.
            </p>
            <p class="chk-offer__text" data-offer-text="ok" hidden>
              Na&nbsp;úvodní konzultaci projdeme vaše smlouvy a&nbsp;ověříme, jestli částky a&nbsp;podmínky odpovídají tomu,
              co skutečně potřebujete. Trvá přibližně 30&nbsp;minut, je nezávazná a&nbsp;zdarma.
            </p>
            <div class="chk-offer__actions">
              <a class="chk-cta" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat termín online</a>
              <a class="chk-offer__link" href="/#kontakt" data-send>Poslat výsledek Patrikovi</a>
            </div>
            <p class="chk-offer__proof">
              <span class="chk-offer__star" aria-hidden="true">★</span> 5,0 na&nbsp;Google&nbsp;· 150+&nbsp;osobních klientů
            </p>
          </div>

          <div class="chk-result__footer">
            <button class="chk-back" type="button" data-restart>Projít znovu</button>
            <p class="chk-result__note">
              Přehled je orientační a&nbsp;vychází jen z&nbsp;vašich odpovědí. Konkrétní doporučení je možné až poté, co
              společně probereme vaši situaci i&nbsp;to, jak máte nastavené současné smlouvy.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  interface Config {
    questions: { id: string; title: string; options: string[] }[];
  }

  const root = document.querySelector<HTMLElement>('[data-checkup]');
  if (root) {
    const config = JSON.parse(root.dataset.config ?? '{}') as Config;
    const total = config.questions.length;
    const answers: number[] = [];
    let current = 0;

    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const questionEls = root.querySelectorAll<HTMLElement>('[data-question]');
    const dots = root.querySelectorAll<SVGCircleElement>('.chk-progress__dot');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]');
    const areaOrder = Array.from(root.querySelectorAll<HTMLElement>('[data-area]'));

    const showStep = (name: string) => {
      steps.forEach((s) => (s.hidden = s.dataset.step !== name));
    };

    const showQuestion = (index: number, focus = true) => {
      current = index;
      questionEls.forEach((q, i) => (q.hidden = i !== index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-done', i < index);
        d.classList.toggle('is-current', i === index);
      });
      if (countEl) countEl.textContent = String(index + 1);
      questionEls[index].querySelectorAll<HTMLElement>('[data-option]').forEach((o) => {
        o.classList.toggle('is-selected', Number(o.dataset.option) === answers[index]);
      });
      if (focus) questionEls[index].querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
      // Na mobilu otázka začíná pod velkým nadpisem — držet ji ve výhledu.
      const top = root.getBoundingClientRect().top;
      if (top < 0) root.scrollIntoView({ block: 'start' });
    };

    const a = (id: string) => answers[config.questions.findIndex((q) => q.id === id)];

    // Pravidla vyhodnocení — docs/financni-check-up-navrh.md, „Vyhodnocení".
    const evaluate = (): Record<string, { ok: boolean; texts: string[] }> => {
      const fixUnknown = a('hypoteka') === 2;
      const plans = a('bydleni') <= 1;
      return {
        rezerva: { ok: a('rezerva') >= 2, texts: [a('rezerva') >= 2 ? 'ok' : 'check'] },
        prijem: {
          ok: a('pojisteni') === 0,
          texts: [a('pojisteni') === 0 ? 'ok' : a('zavislost') === 0 ? 'checkDep' : 'check'],
        },
        bydleni: {
          ok: !fixUnknown && !plans,
          texts:
            fixUnknown || plans
              ? [...(fixUnknown ? ['checkFix'] : []), ...(plans ? ['checkPlan'] : [])]
              : [a('hypoteka') === 1 ? 'okFix' : 'ok'],
        },
        investice: { ok: a('investice') === 0, texts: [a('investice') === 0 ? 'ok' : 'check'] },
        penze: { ok: a('penze') === 0, texts: [a('penze') === 0 ? 'ok' : 'check'] },
        smlouvy: { ok: a('smlouvy') === 0, texts: [a('smlouvy') === 0 ? 'ok' : 'check'] },
      };
    };

    let summaryText = '';

    // Pořadí oblastí, kde se vyplatí podívat: od základu (rezerva, zajištění
    // příjmu) přes časově citlivé bydlení k dlouhodobým věcem. První dostane
    // štítek „Začal bych tady“.
    const PRIORITY = ['rezerva', 'prijem', 'bydleni', 'smlouvy', 'penze', 'investice'];
    // Oblasti ve 4. pádě do nadpisu nabídky („Pojďme se společně podívat na…“).
    const ACCUSATIVE: Record<string, string> = {
      rezerva: 'rezervu',
      prijem: 'zajištění příjmu',
      bydleni: 'bydlení',
      investice: 'investice',
      penze: 'penzi',
      smlouvy: 'vaše smlouvy',
    };
    const nbsp = (text: string) =>
      text.replace(/(^|\s)([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze) /g, '$1$2 ').replace(/(^|\s)([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze) /g, '$1$2 ');
    const joinCs = (items: string[]) =>
      items.length <= 1 ? items.join('') : `${items.slice(0, -1).join(', ')} a ${items[items.length - 1]}`;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const showResult = () => {
      const result = evaluate();
      const ids = Object.keys(result);
      const checkIds = PRIORITY.filter((id) => result[id] && !result[id].ok);
      const okIds = ids.filter((id) => result[id].ok);
      const okCount = okIds.length;

      // Skóre: číslo + řada teček (zelené v pořádku, ostatní k projití).
      const countEl = root.querySelector<HTMLElement>('[data-ok-count]');
      root.querySelectorAll<SVGCircleElement>('.chk-score__dot').forEach((dot, i) => {
        dot.classList.toggle('is-ok', i < okCount);
        dot.classList.remove('is-shown');
      });
      const sr = root.querySelector<HTMLElement>('[data-score-sr]');
      if (sr) sr.textContent = `Základ máte v ${okCount} z ${ids.length} oblastí.`;

      const verdict = okCount === ids.length ? 'all' : okCount >= 4 ? 'good' : okCount >= 2 ? 'some' : 'many';
      root.querySelectorAll<HTMLElement>('[data-verdict]').forEach((el) => (el.hidden = el.dataset.verdict !== verdict));

      // Zastávky na lince: k projití podle priority, pak v pořádku v pořadí
      // z markupu. Krátká věta podle odpovědí, detail jen u první k projití.
      const map = root.querySelector<HTMLElement>('[data-map]');
      const byId = new Map(areaOrder.map((el) => [el.dataset.area ?? '', el]));
      const ordered = [...checkIds, ...areaOrder.map((el) => el.dataset.area ?? '').filter((id) => okIds.includes(id))];
      ordered.forEach((id) => map?.appendChild(byId.get(id)!));
      const shortKey = (id: string): string => {
        const r = result[id];
        if (id === 'bydleni') return r.ok ? (a('hypoteka') === 1 ? 'okFix' : 'ok') : a('hypoteka') === 2 ? 'checkFix' : 'checkPlan';
        return r.ok ? 'ok' : 'check';
      };
      areaOrder.forEach((el) => {
        const id = el.dataset.area ?? '';
        const r = result[id];
        el.classList.toggle('is-check', !r.ok);
        el.classList.toggle('is-first', id === checkIds[0]);
        el.querySelector<HTMLElement>('[data-status-ok]')!.hidden = !r.ok;
        el.querySelector<HTMLElement>('[data-status-check]')!.hidden = r.ok;
        const key = shortKey(id);
        el.querySelectorAll<HTMLElement>('[data-short]').forEach((p) => (p.hidden = p.dataset.short !== key));
        el.querySelectorAll<HTMLElement>('[data-text]').forEach((p) => (p.hidden = !r.texts.includes(p.dataset.text ?? '')));
      });

      // Nabídka konzultace na míru tomu, co vyšlo.
      const heading = root.querySelector<HTMLElement>('[data-offer-heading]');
      if (heading) {
        const names = checkIds.map((id) => ACCUSATIVE[id]);
        heading.textContent = nbsp(
          names.length === 0
            ? 'Ověříme, že je všechno nastavené správně?'
            : names.length <= 3
              ? `Pojďme se společně podívat na ${joinCs(names)}.`
              : `Pojďme se společně podívat na ${names.slice(0, 2).join(', ')} a další oblasti.`,
        );
      }
      root.querySelectorAll<HTMLElement>('[data-offer-text]').forEach((p) => {
        p.hidden = p.dataset.offerText !== (checkIds.length ? 'check' : 'ok');
      });

      const nameOf = (id: string) => (byId.get(id)?.querySelector('.chk-stop__name')?.firstChild?.textContent ?? id).replace(/\u00A0/g, ' ').trim();
      summaryText = [
        'Výsledek finančního check-upu z webu:',
        checkIds.length ? `Vyplatí se podívat: ${checkIds.map(nameOf).join(', ')}` : '',
        okIds.length ? `Základ má: ${okIds.map(nameOf).join(', ')}` : '',
        '',
        'Odpovědi:',
        ...config.questions.map((q, i) => `${q.title}: ${q.options[answers[i]]}`),
      ]
        .filter((line, i, arr) => line !== '' || arr[i - 1] !== '')
        .join('\n');

      showStep('result');
      root.querySelector<HTMLElement>(`[data-verdict="${verdict}"] .chk-verdict__title`)?.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });

      // Číslo napočítá, tečky naběhnou jedna po druhé (bez animace při
      // prefers-reduced-motion).
      const dots = Array.from(root.querySelectorAll<SVGCircleElement>('.chk-score__dot'));
      if (reduceMotion) {
        if (countEl) countEl.textContent = String(okCount);
        dots.forEach((d) => d.classList.add('is-shown'));
        return;
      }
      dots.forEach((d, i) => window.setTimeout(() => d.classList.add('is-shown'), 120 + i * 90));
      const start = performance.now();
      const duration = 650;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        if (countEl) countEl.textContent = String(Math.round(okCount * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    root.querySelector('[data-start]')?.addEventListener('click', () => {
      showStep('quiz');
      showQuestion(0);
    });

    questionEls.forEach((q, qi) => {
      q.querySelectorAll<HTMLElement>('[data-option]').forEach((option) => {
        option.addEventListener('click', () => {
          answers[qi] = Number(option.dataset.option);
          if (qi + 1 < total) showQuestion(qi + 1);
          else showResult();
        });
      });
    });

    backBtn?.addEventListener('click', () => {
      if (current > 0) showQuestion(current - 1);
      else showStep('intro');
    });

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      answers.length = 0;
      showStep('quiz');
      showQuestion(0);
    });

    // Výsledek do kontaktního formuláře (ContactSection.astro si ho vyzvedne).
    root.querySelector('[data-send]')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('checkup-vysledek', summaryText);
      } catch {
        /* bez úložiště se jen otevře prázdný formulář */
      }
    });
  }
</script>

