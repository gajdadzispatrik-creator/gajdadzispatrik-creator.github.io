---
/**
 * Finanční check-up v2 — 10 otázek na klikání (9 oblastí + priorita),
 * vyhodnocení přímo v prohlížeči, nic se neodesílá. Otázky, texty a pravidla
 * schválil Patrik 5. 10. 2026: docs/financni-check-up-v2.md (verze 1:
 * docs/financni-check-up-navrh.md).
 *
 * Bez kapitol s trasou (nástroj, ne kapitola webu — stejně jako 404.astro),
 * proto ani záznam v `PAGES` (scripts/audit-layout.mjs). Linku do patičky
 * kreslí StandaloneRoute.astro. Hero odsazení a typografie 1:1 jako
 * 404.astro / sourozenecké podstránky.
 *
 * Všechny otázky i varianty výsledku jsou ve statickém HTML (skryté), JS
 * jen přepíná, co je vidět — check:typo tak vidí celý text. Výsledek lze
 * poslat přes kontaktní formulář: odpovědi jdou přes sessionStorage do
 * pole „Stručně popište svou situaci“ (ContactSection.astro), odešle je až
 * návštěvník sám.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandaloneRoute from '../components/StandaloneRoute.astro';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../data/entity';
import pecePhoto from '../assets/photos/patrik-pristup-pece.png';

// Nezlomitelná mezera za krátkými předložkami/spojkami a za číslem
// (CLAUDE.md „Konvence: nezlomitelná mezera").
const nb = (text: string) =>
  text
    .replace(/(^|[\s(])([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze|Do|Ke|Na|Od|Po|Pro|Se|Ve|Za|Ze) /g, '$1$2 ')
    .replace(/(^|[\s(])([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze|Do|Ke|Na|Od|Po|Pro|Se|Ve|Za|Ze) /g, '$1$2 ')
    .replace(/(\d) /g, '$1 ');

// Stav odpovědi: Z = základ máte, O = vyplatí se podívat, N = netýká se
// (oblast se ve výsledku neukáže a nepočítá do skóre). `short` = klíč krátké
// věty oblasti; bez něj ok/check podle stavu. Pravidla a texty schválil
// Patrik 5. 10. 2026 — docs/financni-check-up-v2.md.
type Status = 'Z' | 'O' | 'N';

interface Option {
  label: string;
  s?: Status;
  short?: string;
}

interface Question {
  id: string;
  /** Oblast, kterou otázka vyhodnocuje; bez ní = otázka na prioritu. */
  area?: string;
  title: string;
  q: string;
  options: Option[];
}

const questions: Question[] = [
  {
    id: 'rezerva',
    area: 'rezerva',
    title: 'Rezerva',
    q: 'Kolik měsíců byste vyžili bez příjmu?',
    options: [
      { label: 'Méně než 1', s: 'O' },
      { label: '1–3', s: 'O' },
      { label: '3–6', s: 'Z' },
      { label: 'Víc než 6', s: 'Z' },
    ],
  },
  {
    id: 'prijem',
    area: 'prijem',
    title: 'Příjem',
    q: 'Kdybyste půl roku nemohli pracovat, z čeho byste platili účty?',
    options: [
      { label: 'Z pojištění, mám to spočítané', s: 'Z' },
      { label: 'Z úspor', s: 'O' },
      { label: 'Z nemocenské', s: 'O' },
      { label: 'Netuším', s: 'O' },
    ],
  },
  {
    id: 'rodina',
    area: 'rodina',
    title: 'Rodina',
    q: 'Zvládla by rodina bez vašeho příjmu splácet a žít jako dnes?',
    options: [
      { label: 'Ano, mám to pojištěné', s: 'Z' },
      { label: 'Pár měsíců', s: 'O' },
      { label: 'Netuším', s: 'O', short: 'checkUnknown' },
      { label: 'Nikdo na mně nezávisí', s: 'N' },
    ],
  },
  {
    id: 'majetek',
    area: 'majetek',
    title: 'Majetek',
    q: 'Odpovídá pojistka vašeho bydlení a vybavení dnešní ceně?',
    options: [
      { label: 'Ano', s: 'Z' },
      { label: 'Je roky stará', s: 'O' },
      { label: 'Netuším', s: 'O' },
      { label: 'Nemám pojištěno', s: 'O' },
    ],
  },
  {
    id: 'bydleni',
    area: 'bydleni',
    title: 'Bydlení',
    q: 'Jak jste na tom s vlastním bydlením?',
    options: [
      { label: 'Bydlím ve vlastním', s: 'Z' },
      { label: 'Chci a vím, na kolik dosáhnu', s: 'Z', short: 'okPlan' },
      { label: 'Chci, ale nevím, na kolik dosáhnu', s: 'O' },
      { label: 'Neřeším', s: 'N' },
    ],
  },
  {
    id: 'auto',
    area: 'auto',
    title: 'Auto',
    q: 'Kdo zaplatí vaše auto, když nehodu zaviníte vy?',
    options: [
      // Havarijní se nevyplatí vždy (starší auto) — vědomá volba je základ,
      // okrová jen tam, kde to klient neřešil (5. 10. 2026).
      { label: 'Pojišťovna, mám havarijní', s: 'Z' },
      { label: 'Já, a počítám s tím', s: 'Z', short: 'okAware' },
      { label: 'Já, ale tohle mě nenapadlo', s: 'O' },
      { label: 'Netuším', s: 'O', short: 'checkUnknown' },
      { label: 'Nemám auto', s: 'N' },
    ],
  },
  {
    id: 'penze',
    area: 'penze',
    title: 'Penze',
    q: 'Kolik budete mít v důchodu?',
    options: [
      { label: 'Vím přesně', s: 'Z' },
      { label: 'Tuším', s: 'O' },
      { label: 'Netuším', s: 'O' },
    ],
  },
  {
    id: 'investice',
    area: 'investice',
    title: 'Investice',
    q: 'Vydělají vám úspory víc než inflace?',
    options: [
      { label: 'Ano', s: 'Z' },
      { label: 'Netuším', s: 'O', short: 'checkUnknown' },
      { label: 'Ne, leží na účtu', s: 'O' },
      { label: 'Nic neodkládám', s: 'O', short: 'checkNone' },
    ],
  },
  {
    id: 'deti',
    area: 'deti',
    title: 'Děti',
    q: 'Spoříte dětem na start do života?',
    options: [
      { label: 'Ano, pravidelně', s: 'Z' },
      { label: 'Občas', s: 'O' },
      { label: 'Ne', s: 'O' },
      { label: 'Nemám děti', s: 'N' },
    ],
  },
  {
    id: 'priorita',
    title: 'Chce řešit',
    q: 'Co chcete vyřešit nejdřív?',
    options: [
      { label: 'Bydlení' },
      { label: 'Zajištění příjmu a majetku' },
      { label: 'Rodina a děti' },
      { label: 'Investice' },
      { label: 'Penze' },
      { label: 'Chci celkový přehled' },
    ],
  },
];

// Odpověď na prioritu (index) → oblasti, které jdou ve výsledku nahoru,
// a nadpis nabídky. Poslední („celkový přehled") vyjmenuje oblasti k projití.
const priorities = [
  { areas: ['bydleni'], heading: 'Pojďme se podívat na vaše bydlení.' },
  { areas: ['prijem', 'majetek', 'auto'], heading: 'Pojďme se podívat na zajištění příjmu a majetku.' },
  { areas: ['rodina', 'deti'], heading: 'Pojďme se podívat na rodinu a děti.' },
  { areas: ['investice'], heading: 'Pojďme se podívat na vaše investice.' },
  { areas: ['penze'], heading: 'Pojďme se podívat na vaši penzi.' },
  { areas: [], heading: '' },
];

interface Area {
  id: string;
  name: string;
  /** 4. pád do nadpisu nabídky při „celkový přehled". */
  accusative: string;
  link: { label: string; href: string };
  /** Krátká věta na lince podle klíče (ok / check / varianty z odpovědí). */
  short: Record<string, string>;
  /** Rámeček „Tady bych začal" — jen u první oblasti k projití. */
  detail: string;
}

// Pořadí = výchozí pořadí oblastí k projití.
const areas: Area[] = [
  {
    id: 'rezerva',
    name: 'Rezerva',
    accusative: 'rezervu',
    link: { label: 'Finanční plán', href: '/sluzby/financni-plan' },
    short: { ok: 'Rezervu máte.', check: 'Rezerva vás dlouho nepodrží.' },
    detail: 'Rezerva je základ všeho. Kolik má být, spočítáme podle vašich výdajů.',
  },
  {
    id: 'prijem',
    name: 'Příjem',
    accusative: 'zajištění příjmu',
    link: { label: 'Pojištění', href: '/sluzby/pojisteni' },
    short: { ok: 'Máte pojištění, ověřte částky a cenu.', check: 'Půl roku bez příjmu byste nepokryli.' },
    detail: 'Nemocenská pokryje jen část příjmu. Podnikatelé bez dobrovolného pojištění nedostanou nic.',
  },
  {
    id: 'rodina',
    name: 'Rodina',
    accusative: 'zajištění rodiny',
    link: { label: 'Pojištění', href: '/sluzby/pojisteni' },
    short: {
      ok: 'Rodina je pojištěná, ověřte částky a cenu.',
      check: 'Rodina by bez vás dlouho nevydržela.',
      checkUnknown: 'Nevíte, jak dlouho by rodina vydržela.',
    },
    detail: 'Bez vašeho příjmu by rodině chyběly peníze na život i splátky. Ukážu vám, jak to vyřešit.',
  },
  {
    id: 'majetek',
    name: 'Majetek',
    accusative: 'pojištění majetku',
    link: { label: 'Pojištění', href: '/sluzby/pojisteni' },
    short: { ok: 'Pojistka odpovídá ceně, ověřte podmínky.', check: 'Pojistka nemusí stačit na obnovu.' },
    detail: 'Ceny bydlení za poslední roky vyletěly. Stará pojistka nestačí a pojišťovna plnění krátí.',
  },
  {
    id: 'bydleni',
    name: 'Bydlení',
    accusative: 'bydlení',
    link: { label: 'Hypotéky', href: '/sluzby/hypoteky' },
    short: { ok: 'Bydlíte ve vlastním.', okPlan: 'Víte, na kolik dosáhnete.', check: 'Nevíte, na kolik dosáhnete.' },
    detail: 'Nejdřív čísla, pak prohlídky. Spočítáme, na co dosáhnete a jaká splátka je rozumná.',
  },
  {
    id: 'auto',
    name: 'Auto',
    accusative: 'pojištění auta',
    link: { label: 'Pojištění', href: '/sluzby/pojisteni' },
    short: {
      ok: 'Auto máte pojištěné, ověřte podmínky a cenu.',
      okAware: 'Víte, co povinné ručení nekryje.',
      check: 'Při vlastní nehodě platíte auto sami.',
      checkUnknown: 'Nevíte, co vám pojištění kryje.',
    },
    detail: 'Povinné ručení platí jen škody druhým. Jestli se vám vyplatí havarijní, záleží na hodnotě auta.',
  },
  {
    id: 'penze',
    name: 'Penze',
    accusative: 'penzi',
    link: { label: 'Penze', href: '/sluzby/penze' },
    short: { ok: 'Víte, s čím počítat, ověřte nastavení spoření.', check: 'Nevíte, kolik budete mít v důchodu.' },
    detail: 'Čím dřív víte, kolik budete potřebovat, tím menší částky stačí odkládat.',
  },
  {
    id: 'deti',
    name: 'Děti',
    accusative: 'spoření pro děti',
    link: { label: 'Investice', href: '/sluzby/investice' },
    short: { ok: 'Dětem spoříte, ověřte nástroj a nastavení.', check: 'Na start dětí nemáte plán.' },
    detail: 'Díky času stačí i malé částky. Chce to jen plán.',
  },
  {
    id: 'investice',
    name: 'Investice',
    accusative: 'investice',
    link: { label: 'Investice', href: '/sluzby/investice' },
    short: {
      ok: 'Vydělávají víc než inflace, ověřte strategii, riziko a poplatky.',
      check: 'Úspory na účtu ztrácejí hodnotu.',
      checkUnknown: 'Nevíte, jestli úspory neztrácejí hodnotu.',
      checkNone: 'Nic si neodkládáte.',
    },
    detail: 'Peníze na účtu ztrácejí hodnotu. U investic rozhoduje strategie a poplatky.',
  },
];

// Hodnocení podle podílu oblastí se základem (z těch, které se klienta týkají).
const verdicts = [
  { id: 'all', title: 'Základ máte všude.', text: 'Jestli je nastavený správně, ukáže až pohled do smluv.' },
  { id: 'good', title: 'Základ máte dobrý.', text: 'Pár věcí se vyplatí doladit.' },
  { id: 'some', title: 'Pár důležitých věcí chybí.', text: 'Nic, co by se nedalo vyřešit. Začněme tím nejdůležitějším.' },
  { id: 'many', title: 'Je co zlepšovat.', text: 'Dá se to vyřešit krok za krokem.' },
];

const config = {
  questions: questions.map((q) => ({ id: q.id, area: q.area, title: q.title, options: q.options })),
  areaOrder: areas.map((a) => a.id),
  accusative: Object.fromEntries(areas.map((a) => [a.id, a.accusative])),
  names: Object.fromEntries(areas.map((a) => [a.id, a.name])),
  priorities,
};
---

<BaseLayout
  title="Finanční check-up | Patrik Gajdadzis"
  description="Stačí 10 krátkých otázek a zhruba 2 minuty. Zjistěte, kde ve financích máte základ a kde se vyplatí podívat blíž."
>
  <Header />
  <main id="hero" class="chk">
    <StandaloneRoute />

    <section class="chk-hero" aria-labelledby="chk-heading">
      <div class="chk-hero__text" data-route-content data-checkup data-config={JSON.stringify(config)}>
        <h1 id="chk-heading">Jak na&nbsp;tom jsou vaše finance?</h1>

        <!-- Úvod -->
        <div class="chk-step chk-intro" data-step="intro">
          <p class="chk-hero__lead">
            Stačí 10&nbsp;krátkých otázek a&nbsp;zhruba 2&nbsp;minuty. Na&nbsp;konci uvidíte, kde máte základ a&nbsp;kde se&nbsp;vyplatí
            podívat blíž.
          </p>
          <p class="chk-intro__meta">Odpovědi zůstávají jen ve&nbsp;vašem prohlížeči, nikam se&nbsp;neodesílají.</p>
          <div class="chk-intro__actions">
            <button class="chk-cta" type="button" data-start>Začít</button>
          </div>
          <noscript>
            <p class="chk-intro__meta">
              Check-up potřebuje zapnutý JavaScript. Zavolejte mi na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
            </p>
          </noscript>
        </div>

        <!-- Otázky -->
        <div class="chk-step chk-quiz" data-step="quiz" hidden>
          {/* Postup jako trasa webu: SVG v pevné velikosti (bez roztažení),
              tečky jako <circle> s poloměry podle CLAUDE.md „Konvence: velikost
              teček" — aktuální otázka = hlavní (zelená) tečka. */}
          <svg class="chk-progress" width="260" height="10" viewBox="0 0 260 10" aria-hidden="true" focusable="false">
            <path d="M5 5H255" stroke="var(--line)" stroke-opacity=".18" stroke-width="1" fill="none" />
            {questions.map((_, i) => (
              <circle class="chk-progress__dot" cx={5 + (i * 250) / (questions.length - 1)} cy="5" r="2.4" />
            ))}
          </svg>
          <p class="chk-quiz__count" aria-live="polite">Otázka <span data-count>1</span> z&nbsp;{questions.length}</p>

          {/* Všechny otázky v jedné buňce mřížky: výška = nejdelší otázka, takže
              „Zpět“ a vše pod ním při proklikávání neposkakuje. */}
          <div class="chk-questions">
          {
            questions.map((q, qi) => (
              <fieldset class="chk-question" data-question={qi} hidden>
                <legend class="chk-question__title" tabindex="-1">{nb(q.q)}</legend>
                <div class="chk-options">
                  {q.options.map((option, oi) => (
                    <button class="chk-option" type="button" data-option={oi}>
                      <span class="chk-option__mark" aria-hidden="true" />
                      <span>{nb(option.label)}</span>
                    </button>
                  ))}
                </div>
              </fieldset>
            ))
          }
          </div>

          <button class="chk-back" type="button" data-back>Zpět</button>
        </div>

        <!-- Výsledek: skóre → oblasti k projití (s „Začal bych tady“) → oblasti v pořádku → nabídka konzultace -->
        <div class="chk-step chk-result" data-step="result" hidden>
          <div class="chk-score">
            <p class="chk-score__label">Váš výsledek</p>
            <div class="chk-score__row">
              <p class="chk-score__number" aria-hidden="true">
                <span data-ok-count>0</span><span class="chk-score__of">z&nbsp;<span data-total>{areas.length}</span></span>
              </p>
              <div class="chk-score__meta">
                <svg class="chk-score__dots" width={10 + (areas.length - 1) * 18} height="10" viewBox={`0 0 ${10 + (areas.length - 1) * 18} 10`} aria-hidden="true" focusable="false">
                  <path d={`M5 5H${5 + (areas.length - 1) * 18}`} stroke="var(--line)" stroke-opacity=".18" stroke-width="1" fill="none" />
                  {areas.map((_, i) => <circle class="chk-score__dot" cx={5 + i * 18} cy="5" r="3.2" />)}
                </svg>
                <p class="chk-score__caption">oblastí, kde máte základ</p>
              </div>
            </div>
            <p class="sr-only" data-score-sr></p>
            {
              verdicts.map((v) => (
                <div class="chk-verdict" data-verdict={v.id} hidden>
                  <h2 class="chk-verdict__title" tabindex="-1">{nb(v.title)}</h2>
                  <p class="chk-verdict__text">{nb(v.text)}</p>
                </div>
              ))
            }
          </div>

          {/* Výsledek jako linka se zastávkami (hlavní grafický prvek webu):
              nahoře oblasti k projití, pod nimi ty se základem. Rozbalená je
              jen první k projití („Tady bych začal"). */}
          <div class="chk-map-wrap">
            <ol class="chk-map" data-map>
              {
                areas.map((area) => (
                  <li class="chk-stop" data-area={area.id}>
                    <svg class="chk-stop__dot" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" focusable="false">
                      <circle cx="4" cy="4" r="3.2" class="chk-dot" />
                    </svg>
                    <h3 class="chk-stop__name">
                      {nb(area.name)}
                    </h3>
                    <p class="chk-stop__status" data-status-ok>Základ máte</p>
                    <p class="chk-stop__status chk-stop__status--check" data-status-check>Vyplatí se&nbsp;podívat</p>
                    {Object.entries(area.short).map(([key, text]) => (
                      <p class="chk-stop__short" data-short={key} hidden>{nb(text)}</p>
                    ))}
                    <div class="chk-stop__detail">
                      <p class="chk-stop__lead">Tady bych začal</p>
                      <p>{nb(area.detail)}</p>
                      <a class="chk-stop__link" href={area.link.href}>{area.link.label}</a>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="chk-offer">
            <div class="chk-offer__glow" aria-hidden="true"></div>
            <div class="chk-offer__person">
              <span class="chk-offer__avatar">
                <Image src={pecePhoto} width={320} alt="" loading="lazy" />
              </span>
              <p>
                <strong>Patrik Gajdadzis</strong>
                <span>Finanční poradce, Ostrava</span>
              </p>
            </div>
            <h2 class="chk-offer__heading" data-offer-heading>Chcete to probrat?</h2>
            <p class="chk-offer__text">Projdeme, co vám vyšlo, i&nbsp;vaše smlouvy. 30&nbsp;minut, nezávazně a&nbsp;zdarma.</p>
            <div class="chk-offer__actions">
              <a class="chk-cta" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat termín online</a>
              <a class="chk-offer__link" href="/#kontakt" data-send>Poslat výsledek Patrikovi</a>
            </div>
            <p class="chk-offer__proof">
              <span class="chk-offer__star" aria-hidden="true">★</span> 5,0 na&nbsp;Google&nbsp;· 150+&nbsp;osobních klientů
            </p>
          </div>

          <div class="chk-result__footer">
            <button class="chk-back" type="button" data-restart>Projít znovu</button>
            <p class="chk-result__note">
              Přehled je orientační a&nbsp;vychází jen z&nbsp;vašich odpovědí. Konkrétní doporučení je možné až poté, co
              společně probereme vaši situaci i&nbsp;to, jak máte nastavené současné smlouvy.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  interface Config {
    questions: { id: string; area?: string; title: string; options: { label: string; s?: 'Z' | 'O' | 'N'; short?: string }[] }[];
    areaOrder: string[];
    accusative: Record<string, string>;
    names: Record<string, string>;
    priorities: { areas: string[]; heading: string }[];
  }

  const root = document.querySelector<HTMLElement>('[data-checkup]');
  if (root) {
    const config = JSON.parse(root.dataset.config ?? '{}') as Config;
    const total = config.questions.length;
    const answers: number[] = [];
    let current = 0;

    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const questionEls = root.querySelectorAll<HTMLElement>('[data-question]');
    const dots = root.querySelectorAll<SVGCircleElement>('.chk-progress__dot');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]');
    const areaOrder = Array.from(root.querySelectorAll<HTMLElement>('[data-area]'));

    const showStep = (name: string) => {
      steps.forEach((s) => (s.hidden = s.dataset.step !== name));
    };

    const showQuestion = (index: number, focus = true) => {
      current = index;
      questionEls.forEach((q, i) => (q.hidden = i !== index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-done', i < index);
        d.classList.toggle('is-current', i === index);
      });
      if (countEl) countEl.textContent = String(index + 1);
      questionEls[index].querySelectorAll<HTMLElement>('[data-option]').forEach((o) => {
        o.classList.toggle('is-selected', Number(o.dataset.option) === answers[index]);
      });
      if (focus) questionEls[index].querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
      // Na mobilu otázka začíná pod velkým nadpisem — držet ji ve výhledu.
      const top = root.getBoundingClientRect().top;
      if (top < 0) root.scrollIntoView({ block: 'start' });
    };

    // Vyhodnocení oblastí ze stavu zvolené odpovědi (Z/O/N) — pravidla
    // v datech otázek (frontmatter), docs/financni-check-up-v2.md.
    type AreaResult = { status: 'Z' | 'O' | 'N'; short: string };
    const evaluate = (): Record<string, AreaResult> => {
      const out: Record<string, AreaResult> = {};
      config.questions.forEach((q, i) => {
        if (!q.area) return;
        const opt = q.options[answers[i]];
        const status = opt?.s ?? 'N';
        out[q.area] = { status, short: opt?.short ?? (status === 'Z' ? 'ok' : 'check') };
      });
      return out;
    };
    const priorityIndex = () => {
      const i = config.questions.findIndex((q) => !q.area);
      return i < 0 ? -1 : answers[i];
    };

    let summaryText = '';

    const nbsp = (text: string) =>
      text.replace(/(^|\s)([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze) /g, '$1$2 ').replace(/(^|\s)([aikosuvzAIKOSUVZ]|do|ke|na|od|po|pro|se|ve|za|ze) /g, '$1$2 ');
    const joinCs = (items: string[]) =>
      items.length <= 1 ? items.join('') : `${items.slice(0, -1).join(', ')} a ${items[items.length - 1]}`;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const showResult = () => {
      const result = evaluate();
      const order = config.areaOrder;
      const relevant = order.filter((id) => result[id] && result[id].status !== 'N');
      const okIds = relevant.filter((id) => result[id].status === 'Z');
      const naIds = order.filter((id) => result[id]?.status === 'N');
      const pIdx = priorityIndex();
      const priority = pIdx >= 0 ? config.priorities[pIdx] : undefined;
      // Oblasti k projití: nejdřív ty z odpovědi na prioritu, pak výchozí pořadí.
      const checkAll = relevant.filter((id) => result[id].status === 'O');
      const checkIds = [
        ...checkAll.filter((id) => priority?.areas.includes(id)),
        ...checkAll.filter((id) => !priority?.areas.includes(id)),
      ];
      const okCount = okIds.length;
      const total = relevant.length;

      // Skóre: číslo + řada teček jen pro oblasti, které se klienta týkají.
      const countEl = root.querySelector<HTMLElement>('[data-ok-count]');
      const totalEl = root.querySelector<HTMLElement>('[data-total]');
      if (totalEl) totalEl.textContent = String(total);
      const scoreDots = Array.from(root.querySelectorAll<SVGCircleElement>('.chk-score__dot'));
      scoreDots.forEach((dot, i) => {
        dot.style.display = i < total ? '' : 'none';
        dot.classList.toggle('is-ok', i < okCount);
        dot.classList.remove('is-shown');
      });
      const scoreSvg = root.querySelector<SVGSVGElement>('.chk-score__dots');
      if (scoreSvg) {
        const w = 10 + Math.max(0, total - 1) * 18;
        scoreSvg.setAttribute('width', String(w));
        scoreSvg.setAttribute('viewBox', `0 0 ${w} 10`);
        scoreSvg.querySelector('path')?.setAttribute('d', `M5 5H${5 + Math.max(0, total - 1) * 18}`);
      }
      const sr = root.querySelector<HTMLElement>('[data-score-sr]');
      if (sr) sr.textContent = `Základ máte v ${okCount} z ${total} oblastí.`;

      const ratio = total ? okCount / total : 1;
      const verdict = ratio === 1 ? 'all' : ratio >= 2 / 3 ? 'good' : ratio >= 1 / 3 ? 'some' : 'many';
      root.querySelectorAll<HTMLElement>('[data-verdict]').forEach((el) => (el.hidden = el.dataset.verdict !== verdict));

      // Zastávky na lince: k projití (první „Tady bych začal"), pak se
      // základem; oblasti „netýká se" schované.
      const map = root.querySelector<HTMLElement>('[data-map]');
      const byId = new Map(areaOrder.map((el) => [el.dataset.area ?? '', el]));
      [...checkIds, ...okIds, ...naIds].forEach((id) => {
        const el = byId.get(id);
        if (el) map?.appendChild(el);
      });
      areaOrder.forEach((el) => {
        const id = el.dataset.area ?? '';
        const r = result[id];
        const na = !r || r.status === 'N';
        el.hidden = na;
        if (na) return;
        const ok = r.status === 'Z';
        el.classList.toggle('is-check', !ok);
        el.classList.toggle('is-first', id === checkIds[0]);
        el.querySelector<HTMLElement>('[data-status-ok]')!.hidden = !ok;
        el.querySelector<HTMLElement>('[data-status-check]')!.hidden = ok;
        el.querySelectorAll<HTMLElement>('[data-short]').forEach((p) => (p.hidden = p.dataset.short !== r.short));
      });

      // Nabídka podle priority; „celkový přehled" vyjmenuje oblasti k projití.
      const heading = root.querySelector<HTMLElement>('[data-offer-heading]');
      if (heading) {
        const names = checkIds.map((id) => config.accusative[id]);
        heading.textContent = nbsp(
          checkIds.length === 0
            ? 'Ověříme, že je všechno nastavené správně?'
            : priority?.heading
              ? priority.heading
              : names.length <= 3
                ? `Pojďme se společně podívat na ${joinCs(names)}.`
                : `Pojďme se společně podívat na ${names.slice(0, 2).join(', ')} a další oblasti.`,
        );
      }

      const name = (id: string) => config.names[id] ?? id;
      const pq = config.questions.find((q) => !q.area);
      const header = [
        'Výsledek finančního check-upu z webu:',
        pq && pIdx >= 0 ? `Chce řešit: ${pq.options[pIdx].label}` : '',
        checkIds.length ? `Vyplatí se podívat: ${checkIds.map(name).join(', ')}` : '',
        okIds.length ? `Základ má: ${okIds.map(name).join(', ')}` : '',
        naIds.length ? `Netýká se: ${naIds.map(name).join(', ')}` : '',
      ].filter(Boolean);
      summaryText = [
        ...header,
        '',
        'Odpovědi:',
        ...config.questions.filter((q) => q.area).map((q) => `${q.title}: ${q.options[answers[config.questions.indexOf(q)]]?.label ?? '—'}`),
      ].join('\n');

      showStep('result');
      root.querySelector<HTMLElement>(`[data-verdict="${verdict}"] .chk-verdict__title`)?.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });

      // Číslo napočítá, tečky naběhnou jedna po druhé (bez animace při
      // prefers-reduced-motion).
      const shown = scoreDots.slice(0, total);
      if (reduceMotion) {
        if (countEl) countEl.textContent = String(okCount);
        shown.forEach((d) => d.classList.add('is-shown'));
        return;
      }
      shown.forEach((d, i) => window.setTimeout(() => d.classList.add('is-shown'), 120 + i * 90));
      const start = performance.now();
      const duration = 650;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        if (countEl) countEl.textContent = String(Math.round(okCount * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    root.querySelector('[data-start]')?.addEventListener('click', () => {
      showStep('quiz');
      showQuestion(0);
    });

    questionEls.forEach((q, qi) => {
      q.querySelectorAll<HTMLElement>('[data-option]').forEach((option) => {
        option.addEventListener('click', () => {
          answers[qi] = Number(option.dataset.option);
          if (qi + 1 < total) showQuestion(qi + 1);
          else showResult();
        });
      });
    });

    backBtn?.addEventListener('click', () => {
      if (current > 0) showQuestion(current - 1);
      else showStep('intro');
    });

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      answers.length = 0;
      showStep('quiz');
      showQuestion(0);
    });

    // Výsledek do kontaktního formuláře (ContactSection.astro si ho vyzvedne).
    root.querySelector('[data-send]')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('checkup-vysledek', summaryText);
      } catch {
        /* bez úložiště se jen otevře prázdný formulář */
      }
    });
  }
</script>

