---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { businessEntity, personEntity, websiteEntity } from '../data/entity';

interface Props {
  title: string;
  description: string;
  /** Výchozí `index, follow`. Použij `noindex, follow` pro stránky, které
   *  nemají být ve výsledcích vyhledávání (např. dočasně skrytý `/clanky`). */
  robots?: string;
  /** Open Graph typ — `website` pro většinu stránek, `profile` pro `/o-mne`. */
  ogType?: string;
  /** Doplňková strukturovaná data specifická pro danou stránku (Service,
   *  ProfilePage, BreadcrumbList apod.) — sloučí se s globální Person/WebSite
   *  entitou do jednoho `@graph`, Person/WebSite se NIKDY neduplikují. */
  jsonLd?: Record<string, unknown>[];
  /** `false` vynechá canonical a og:url — pro stránku 404, která se zobrazuje
   *  na libovolné neexistující adrese, takže nemá vlastní kanonickou URL. */
  canonical?: boolean;
}

const { title, description, robots = 'index, follow', ogType = 'website', jsonLd = [], canonical = true } = Astro.props;

// Canonical se počítá automaticky ze skutečné cesty stránky (žádná ruční
// hodnota na 14 místech) — sjednoceno bez koncového lomítka (kromě domovské
// stránky), stejná konvence jako všechny interní `href` na webu (viz
// prelaunch audit, „Trailing slash“).
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath !== '/' && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath;
const canonicalURL = new URL(normalizedPath || '/', Astro.site).toString();

const jsonLdGraph = {
  '@context': 'https://schema.org',
  // Firma (Google Business Profile) je na každé stránce, protože na ni
  // Person odkazuje přes `workLocation` — bez ní by odkaz visel do prázdna.
  '@graph': [websiteEntity, personEntity, businessEntity, ...jsonLd],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Náhled na GitHub Pages (PUBLIC_PREVIEW=1 v .github/workflows/preview.yml) se nesmí dostat do Googlu. */}
    <meta name="robots" content={import.meta.env.PUBLIC_PREVIEW ? 'noindex, nofollow' : robots} />
    {canonical && <link rel="canonical" href={canonicalURL} />}
    <link
      rel="preload"
      href="/fonts/manrope/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- ř, š, č, ž, ě, ů jsou v latin-ext — bez preloadu by v nadpisech probliklo náhradní písmo. -->
    <link
      rel="preload"
      href="/fonts/manrope/manrope-latin-ext.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Logo PG (monogram z linky, src/assets/brand/, 4. 10. 2026). */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Patrik Gajdadzis" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Patrik Gajdadzis, finanční poradce, Ostrava" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#hero">Přeskočit na&nbsp;obsah</a>
    <slot />
    <CookieConsent />
    <slot name="footer" />
    <script>
      /*
       * Tečky na dekorativní trase (CLAUDE.md „Konvence: velikost teček
       * a délka zářezů"):
       * trasy jsou SVG s preserveAspectRatio="none", které se roztahují
       * s šířkou okna i výškou sekce — tečka by se roztáhla s nimi (jinak
       * velká v každé sekci, mimo kalibrační šířku elipsa). Na každé takové
       * SVG se zapisuje zpětné měřítko (--dot-sx/--dot-sy), global.css jím
       * tečku doškáluje, takže na obrazovce má vždy poloměr přesně `r` px.
       * Přepočet při změně velikosti SVG (ResizeObserver — i přepnutí
       * stupně z display:none) a při změně viewBoxu ze skriptů sekcí.
       */
      const syncDots = (svg: SVGSVGElement) => {
        const vb = svg.viewBox.baseVal;
        const rect = svg.getBoundingClientRect();
        if (!vb || !vb.width || !vb.height || !rect.width || !rect.height) return;
        svg.style.setProperty('--dot-sx', String(vb.width / rect.width));
        svg.style.setProperty('--dot-sy', String(vb.height / rect.height));
        // Statické zářezy (data-notch-axis + data-notch-px na SVG, data-notch
        // na zářezu a jeho tečkách): konec zářezu = osa + přesně N px na
        // obrazovce, ne N lokálních jednotek roztažených se šířkou okna.
        const notchPx = parseFloat(svg.dataset.notchPx ?? '');
        if (notchPx) {
          const x = parseFloat(svg.dataset.notchAxis ?? '0') + (notchPx * vb.width) / rect.width;
          svg.querySelectorAll('[data-notch]').forEach((el) => {
            if (el instanceof SVGCircleElement) el.setAttribute('cx', String(x));
            else el.setAttribute('d', (el.getAttribute('d') ?? '').replace(/H\s*[\d.]+/g, `H ${x}`));
          });
        }
      };
      const resizeObserver = new ResizeObserver((entries) => entries.forEach((e) => syncDots(e.target as SVGSVGElement)));
      const viewBoxObserver = new MutationObserver((records) => records.forEach((r) => syncDots(r.target as SVGSVGElement)));
      document.querySelectorAll<SVGSVGElement>('svg[preserveAspectRatio="none"]').forEach((svg) => {
        if (!svg.querySelector('circle')) return;
        resizeObserver.observe(svg);
        viewBoxObserver.observe(svg, { attributes: true, attributeFilter: ['viewBox'] });
        syncDots(svg);
      });
    </script>
  </body>
</html>
