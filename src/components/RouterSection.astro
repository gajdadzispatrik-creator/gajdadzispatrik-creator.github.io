---
/**
 * Sekce „Co řešíte?“ — vodorovná osa (tmavá varianta).
 * Zdroj: design-exploration/financial-architecture/section-router/claude-code-task-router.md
 *
 * Kompoziční princip: kontinuální linka z předchozí sekce se narovná do jedné
 * vodorovné osy (desktop) / svislé osy se zářezy (tablet, mobil). Pět oblastí
 * visí střídavě nad a pod osou na desktopu; na užších šířkách je pořadí
 * jednoduchý svislý seznam vpravo od svislé osy.
 *
 * Kotva (--x, --y) na každém <li> nese souřadnici z osy ve stejném souřadném
 * prostoru jako SVG (viz --vb na .router) — tečka i text z ní vychází, blok
 * textu je pak posunutý o --oy (svislý posun od kotvy, různý pro dominantu/
 * ostatní a pro nad/pod osou). Left/right se počítá jako procento --vb, takže
 * text sleduje stejné roztažení jako osa na libovolné šířce (viz revize 2
 * předchozí sekce — želené řešení bez pevného capu).
 */
const areas = [
  {
    name: 'Bydlení',
    desc: 'Koupě, výstavba, rekonstrukce nebo refinancování.',
    pos: 'pos-1',
    side: 'above',
    dominant: true,
  },
  {
    name: 'Finanční plán',
    desc: 'Přehled, rezervy a dlouhodobé cíle.',
    pos: 'pos-2',
    side: 'below',
    dominant: false,
  },
  {
    name: 'Investice',
    desc: 'Tvorba majetku podle cíle a času.',
    pos: 'pos-3',
    side: 'above',
    dominant: false,
  },
  {
    name: 'Pojištění',
    desc: 'Ochrana příjmu, rodiny a majetku.',
    pos: 'pos-4',
    side: 'below',
    dominant: false,
  },
  {
    name: 'Penze',
    desc: 'Plán budoucího příjmu a finanční rezervy.',
    pos: 'pos-5',
    side: 'above',
    dominant: false,
  },
];
---

<section class="router" aria-labelledby="co-resite">
  <div class="router__stage">
    <h2 id="co-resite" class="router__heading">Co řešíte?</h2>

    <ol class="router__areas">
      {areas.map((area) => (
        <li class={`router__area router__area--${area.pos} router__area--${area.side} ${area.dominant ? 'router__area--dominant' : ''}`}>
          <a class="router__link" href="/sluzby" aria-label={area.name}>
            <span class="router__name">{area.name}</span>
            <span class="router__desc">{area.desc}</span>
            <span class="router__more">Více</span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <!-- Desktop 1200+ -->
  <svg
    class="router__axis router__axis--desktop"
    viewBox="0 0 1440 1000"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="router__axis-path"
      d="M 1300 -20 V 68 A 28 28 0 0 1 1272 96 H 148 A 28 28 0 0 0 120 124 V 532 A 28 28 0 0 0 148 560 H 1272 A 28 28 0 0 1 1300 588 V 1000"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="router__dot router__dot--pos-1" cx="260" cy="560" r="3.5" fill="var(--emerald)"></circle>
    <circle class="router__dot router__dot--pos-2" cx="480" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-3" cx="700" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-4" cx="920" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-5" cx="1120" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
  </svg>

  <!-- Tablet 768–1199 -->
  <svg
    class="router__axis router__axis--tablet"
    viewBox="0 0 834 1100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-notch-axis="40"
    data-notch-px="44"
  >
    <path
      class="router__axis-path"
      d="M 794 -20 V 56 A 22 22 0 0 1 772 78 H 62 A 22 22 0 0 0 40 100 V 1100"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <path
      class="router__axis-notches"
      data-notch
      d="M 40 336 H 90 M 40 560 H 90 M 40 700 H 90 M 40 840 H 90 M 40 980 H 90"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <circle class="router__dot router__dot--pos-1" data-notch cx="90" cy="336" r="3.2" fill="var(--emerald)"></circle>
    <circle class="router__dot router__dot--pos-2" data-notch cx="90" cy="560" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-3" data-notch cx="90" cy="700" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-4" data-notch cx="90" cy="840" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-5" data-notch cx="90" cy="980" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
  </svg>

  <!--
    Notebook 1200–1399, proporčně odvozeno z desktopu stejnou afinní
    transformací (x' = 0.977966·x − 21.356) jako notebook varianta trasy
    v ConnectionsSection.astro — sjednocuje hranici mezistupně s předchozí
    sekcí, aby linka na 1200–1399 px navazovala bez mezery.
  -->
  <svg
    class="router__axis router__axis--laptop"
    viewBox="0 0 1366 1000"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="router__axis-path"
      d="M 1250 -20 V 68 A 28 28 0 0 1 1223 96 H 123 A 28 28 0 0 0 96 124 V 532 A 28 28 0 0 0 123 560 H 1223 A 28 28 0 0 1 1250 588 V 1000"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="router__dot router__dot--pos-1" cx="233" cy="560" r="3.5" fill="var(--emerald)"></circle>
    <circle class="router__dot router__dot--pos-2" cx="448" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-3" cx="663" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-4" cx="878" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-5" cx="1074" cy="560" r="2.6" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
  </svg>

  <!--
    Mobil <768: ConnectionsSection.astro na mobilu byla přeladěná na stejnou
    osu x=24 (oprava 14. 9. 2026, viz její komentář „Osa sjednocená na
    x=24") — RouterSection tu osu už dřív měla jako svou vlastní (§8), takže
    žádný zákrut na vstupu není potřeba, trasa jen pokračuje rovně dolů.
    (Historie: nejdřív tu byl vstup na x=366 zkopírovaný ze vzoru širších
    tierů, což vytvářelo viditelnou mezeru; provizorní oprava na zákrut
    x=40→24 pak měla nesymetrický, „zamotaný“ oblouk — obojí zbytečné, teď
    obě sekce sdílí stejnou osu už na zdroji.)
  -->
  <!--
    Časová osa (1. 10. 2026, přání uživatele: tečky přímo na lince, ale bez
    proplétání „hadem"). Rovná osa x=24 shora dolů, tečky leží přímo na ní,
    text vpravo ve sloupci nadpisu (osa + 32 px), tečka svisle na středu
    názvu oblasti (výjimka z „celého bloku" — dominanta má výrazně vyšší
    blok, viz CLAUDE.md bod 2). Končí na x=24, kde navazuje ProcessSection.
  -->
  <svg
    class="router__axis router__axis--mobile"
    viewBox="0 0 390 998"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="router__axis-path"
      d="M 24 -20 V 998"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="router__dot router__dot--pos-1" cx="24" cy="208" r="3.2" fill="var(--emerald)"></circle>
    <circle class="router__dot router__dot--pos-2" cx="24" cy="419" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-3" cx="24" cy="559" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-4" cx="24" cy="699" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
    <circle class="router__dot router__dot--pos-5" cx="24" cy="839" r="2.4" fill="var(--line-on-dark)" fill-opacity=".65"></circle>
  </svg>
</section>

<script>
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  // Na tabletu/desktopu (≥768px) se linka i texty vykreslují rovnou v hotovém
  // stavu, bez postupné animace — na zadání uživatele 24. 8. 2026.
  const disableAnimation = reduceMotion || window.matchMedia('(min-width: 768px)').matches;

  const section = document.querySelector<HTMLElement>('.router');

  /*
   * Mobil: výška sekce = konec poslední oblasti + 72 px (rozestup sekcí,
   * 4. 10. 2026). Popisky se na úzkých telefonech zalamují na víc řádků,
   * pevná výška by dole nechávala pokaždé jinou mezeru. ViewBox a osa se
   * prodlužují spolu se sekcí, takže svislé měřítko trasy zůstává 1 a tečky
   * sedí na svých --y. CSS výška zůstává jako výchozí stav bez JS.
   */
  const mobileAxis = section?.querySelector<SVGSVGElement>('.router__axis--mobile');
  const lastArea = section?.querySelector<HTMLElement>('.router__area--pos-5');
  /*
   * Oblasti jdou za sebou s pevnou mezerou podle skutečné výšky textu (box
   * oblasti → další oblast 75 px po dominantě, jinak 40 px — hodnoty
   * schváleného mobilu 375 px, 4. 10. 2026). Pevné --y z CSS platí jen na
   * 360–430 px: na širším telefonu mezera po dominantě rostla na 100 px, na
   * 320 px se dlouhý popisek přiblížil další oblasti na 16 px. Tečka (--y)
   * leží na prvním řádku názvu (--oy).
   */
  const AREA_GAPS = [75, 40, 40, 40];
  const areaEls = section ? Array.from(section.querySelectorAll<HTMLElement>('.router__area')) : [];
  const layoutMobileAreas = (mobile: boolean) => {
    areaEls.forEach((el, i) => {
      if (!mobile) { el.style.removeProperty('--y'); return; }
      if (i === 0) return;
      const prev = areaEls[i - 1];
      const oy = parseFloat(getComputedStyle(el).getPropertyValue('--oy')) || 0;
      const y = prev.offsetTop + prev.offsetHeight + AREA_GAPS[i - 1] - oy;
      el.style.setProperty('--y', String(y));
      mobileAxis?.querySelector(`.router__dot--pos-${i + 1}`)?.setAttribute('cy', String(y));
    });
  };
  const syncMobileHeight = () => {
    if (!section || !mobileAxis || !lastArea) return;
    if (getComputedStyle(mobileAxis).display === 'none') {
      layoutMobileAreas(false);
      section.style.removeProperty('height');
      return;
    }
    layoutMobileAreas(true);
    const height = Math.round(lastArea.offsetTop + lastArea.offsetHeight + 72);
    section.style.height = `${height}px`;
    mobileAxis.setAttribute('viewBox', `0 0 390 ${height}`);
    mobileAxis.querySelector('.router__axis-path')?.setAttribute('d', `M 24 -20 V ${height}`);
  };
  if (section) {
    syncMobileHeight();
    document.fonts.ready.then(syncMobileHeight);
    new ResizeObserver(syncMobileHeight).observe(lastArea ?? section);
    window.addEventListener('resize', syncMobileHeight);
  }

  if (section && !disableAnimation) {
    const activeSvg = Array.from(section.querySelectorAll('.router__axis')).find(
      (svg) => getComputedStyle(svg).display !== 'none'
    );
    const path = activeSvg?.querySelector('.router__axis-path') as SVGPathElement | null;
    const heading = section.querySelector('.router__heading');
    const areas = Array.from(section.querySelectorAll('.router__area'));

    if (path) {
      const length = path.getTotalLength();
      path.style.strokeDasharray = String(length);
      path.style.strokeDashoffset = String(length);

      const circles = Array.from(activeSvg!.querySelectorAll('.router__dot'));
      const steps = 2000;
      const thresholds = circles.map((circle) => {
        const cx = parseFloat(circle.getAttribute('cx') ?? '0');
        const cy = parseFloat(circle.getAttribute('cy') ?? '0');
        let best = Infinity;
        let bestLen = 0;
        for (let i = 0; i <= steps; i++) {
          const l = (length * i) / steps;
          const pt = path.getPointAtLength(l);
          const d = Math.hypot(pt.x - cx, pt.y - cy);
          if (d < best) {
            best = d;
            bestLen = l;
          }
        }
        return bestLen / length;
      });

      areas.forEach((area) => area.classList.add('is-pending'));
      heading?.classList.add('is-pending');

      let ticking = false;
      const update = () => {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, rect.height > 0 ? (vh - rect.top) / rect.height : 0));

        path.style.strokeDashoffset = String(length * (1 - progress));

        areas.forEach((area, i) => {
          if (progress >= thresholds[i] && area.classList.contains('is-pending')) {
            area.classList.remove('is-pending');
            area.classList.add('is-visible');
          }
        });

        if (progress > 0.02 && heading?.classList.contains('is-pending')) {
          heading.classList.remove('is-pending');
          heading.classList.add('is-visible');
        }

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  }
</script>

<style>
  .router {
    position: relative;
    overflow: hidden;
    /* Mobil: obsah 72 px od horní i spodní hrany (na 375–430 px), položky
       po 140 px — popisky 16 px se na 320 px zalomí a nesmí se dotknout
       další položky (1. 10. 2026). */
    height: 998px;
    background: linear-gradient(196deg, var(--router-grad-1) 0%, var(--navy) 52%, var(--router-grad-2) 100%);
    --vb: 390;
  }

  .router__dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  .router::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    height: 420px;
    background: radial-gradient(74% 44% at 30% 40%, rgba(46, 152, 115, .13) 0%, rgba(46, 152, 115, 0) 74%);
    pointer-events: none;
  }

  /*
   * Wide desktop: centrované designové plátno (CLAUDE.md). `.router` zůstává
   * full-width tmavý pás (pozadí + trasa, viz strop na `.router__axis--desktop`
   * níže) — ale nadpis a oblasti (dřív přímé děti `.router`, pozicované
   * procentuálně vůči jeho ŠÍŘCE) potřebují STEJNÝ souřadný základ jako trasa
   * a jako sousední (capnuté) sekce, jinak se od nich na wide desktopu
   * opticky odtrhnou (zjištěno 25. 8. 2026 — dřívější implementace capovala
   * jen trasu, ne obsah, takže nadpis zůstal fixovaný na 120px od viewportu
   * místo od stage). `.router__stage` je nová obalová vrstva jen pro obsah
   * (ne pro trasu, ta zůstává přímým potomkem `.router`) — stejná výška jako
   * sekce, aby `top`/`left` kotvy uvnitř zůstaly beze změny pod 1400px.
   */
  .router__stage {
    position: relative;
    height: 100%;
  }

  /*
   * Odsazení nadpisu od svislého úseku osy musí zůstat stejný počet
   * fyzických px na libovolné šířce (§3), i když samotná osa (--axis-x)
   * procentuálně škáluje s viewportem stejně jako zbytek kompozice —
   * proto se pevný --offset přičítá až po převodu --axis-x na %, ne se
   * škáluje spolu s ním.
   */
  .router__heading {
    position: absolute;
    left: calc((var(--axis-x) * 100% / var(--vb)) + (var(--offset) * 1px));
    top: 72px;
    margin: 0;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.05em;
    font-size: 42px;
    color: var(--white);
    --axis-x: 24;
    --offset: 32;
  }

  .router__heading.is-pending {
    opacity: 0;
    transform: translateY(12px);
  }

  .router__heading.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  .router__areas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Obecná formule pro všechny oblasti: left/right jako procento --vb (aby
   * text sledoval stejné roztažení jako osa při libovolné šířce), top jako
   * kotva --y + posun --oy, reveal-transform složený z --reveal-mag (JS) a
   * --reveal-dir (CSS, dáno stranou nad/pod osou) — obě položky se násobí,
   * takže JS nikdy nepřepisuje celý transform, jen jednu proměnnou (viz oprava
   * v revizi 2 předchozí sekce).
   */
  .router__area {
    position: absolute;
    left: calc(var(--x) * 100% / var(--vb) + var(--tx, 0px));
    right: calc(var(--rx) * 100% / var(--vb));
    top: calc((var(--y) + var(--oy)) * 1px);
    transform: translateY(calc(var(--reveal-mag, 0px) * var(--reveal-dir, 1)));
    margin: 0;
    /* Mobil: text ve sloupci nadpisu — osa x=24 + 32 px (stejně jako
       .router__heading), tečka leží přímo na ose. */
    --x: 24;
    --tx: 32px;
    --rx: 24;
    --reveal-dir: 1;
  }

  .router__area.is-pending {
    opacity: 0;
    --reveal-mag: 14px;
  }

  .router__area.is-visible {
    opacity: 1;
    --reveal-mag: 0px;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  .router__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 80px;
  }

  .router__name {
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.04em;
    font-size: 24px;
    color: var(--white);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .router__desc {
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, .56);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .router__more {
    font-size: 16px;
    font-weight: 600;
    color: var(--emerald-light);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .router__link:hover .router__name {
    color: var(--emerald-light);
  }

  .router__link:hover .router__desc {
    color: rgba(255, 255, 255, .7);
  }

  .router__link:focus-visible {
    outline: 2px solid var(--emerald-light);
    outline-offset: 4px;
  }

  /* Dominanta (Bydlení) — dvojnásobné písmo, vlastní gap, trvalá vlasová linka pod „Více“. */
  .router__area--dominant .router__link {
    gap: 14px;
  }

  .router__area--dominant .router__name {
    font-size: 36px;
    letter-spacing: -.045em;
  }

  .router__area--dominant .router__desc {
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, .72);
    text-wrap: pretty;
  }

  .router__area--dominant .router__more {
    display: inline-block;
    width: fit-content;
    font-size: 16px;
    color: var(--white);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--emerald);
    transition: color var(--duration-hover) var(--ease-out), border-color var(--duration-hover) var(--ease-out);
  }

  .router__area--dominant .router__link:hover .router__more {
    border-color: var(--emerald-hover);
  }

  /* Tečka na ose roste o 1 px v hoveru odpovídající oblasti. */
  .router:has(.router__area--pos-1 .router__link:hover) .router__dot--pos-1 {
    r: 4.5;
  }

  .router:has(.router__area--pos-2 .router__link:hover) .router__dot--pos-2 {
    r: 3.6;
  }

  .router:has(.router__area--pos-3 .router__link:hover) .router__dot--pos-3 {
    r: 3.6;
  }

  .router:has(.router__area--pos-4 .router__link:hover) .router__dot--pos-4 {
    r: 3.6;
  }

  .router:has(.router__area--pos-5 .router__link:hover) .router__dot--pos-5 {
    r: 3.6;
  }

  .router__axis {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .router__dot {
    transition: r var(--duration-hover) var(--ease-out);
  }

  .router__axis--tablet,
  .router__axis--laptop,
  .router__axis--desktop {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .router__area,
    .router__heading {
      opacity: 1;
      transform: none;
    }
  }

