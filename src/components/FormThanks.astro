---
/**
 * Poděkování po odeslání formuláře (Patrik 4. 11. 2026): okénko uprostřed
 * obrazovky, po pár vteřinách samo zmizí. Jediné místo pro všechny formuláře
 * (kontakt na úvodní stránce, Končí vám fixace?, Na kolik dosáhnete?).
 *
 * Formulář po úspěšném odeslání pošle:
 *   document.dispatchEvent(new CustomEvent('pg:thanks', { detail: { text: '…' } }))
 *
 * Odkaz na rezervaci: kdo je rozhodnutý, vybere termín hned. Klik se měří jako
 * rezervace (CookieConsent.astro hlídá odkazy na calendar.app.google).
 * Zmizí po 8 s; když na okénko najede myš nebo je v něm fokus, počká.
 */
import { BOOKING_URL } from '../data/entity';
---

<div class="thanks" data-thanks hidden>
  <div class="thanks__panel" role="status" aria-live="polite">
    <button class="thanks__close" type="button" aria-label="Zavřít" data-thanks-close>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <span class="thanks__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <p class="thanks__text" data-thanks-text></p>
    <a class="thanks__link" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat termín rovnou v&nbsp;kalendáři</a>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-thanks]');
  const panel = root?.querySelector<HTMLElement>('.thanks__panel');
  const textEl = root?.querySelector<HTMLElement>('[data-thanks-text]');
  const DURATION = 8000;
  let timer: number | undefined;
  let hovering = false;

  const hide = () => {
    if (!root) return;
    window.clearTimeout(timer);
    root.classList.remove('is-open');
    window.setTimeout(() => {
      if (!root.classList.contains('is-open')) root.hidden = true;
    }, 250);
  };

  const schedule = () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (hovering || root?.contains(document.activeElement)) schedule();
      else hide();
    }, DURATION);
  };

  document.addEventListener('pg:thanks', (event) => {
    if (!root || !textEl) return;
    const detail = (event as CustomEvent<{ text?: string }>).detail;
    textEl.textContent = detail?.text ?? 'Děkuji. Ozvu se vám co nejdříve.';
    root.hidden = false;
    requestAnimationFrame(() => root.classList.add('is-open'));
    schedule();
  });

  panel?.addEventListener('mouseenter', () => { hovering = true; });
  panel?.addEventListener('mouseleave', () => { hovering = false; });
  root?.querySelector('[data-thanks-close]')?.addEventListener('click', hide);
  // Klik mimo okénko ho zavře.
  root?.addEventListener('click', (event) => {
    if (event.target === root) hide();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root && !root.hidden) hide();
  });
</script>

<style>
  .thanks {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(15, 39, 71, .18);
    opacity: 0;
    transition: opacity 250ms var(--ease-out);
  }

  .thanks[hidden] {
    display: none;
  }

  .thanks.is-open {
    opacity: 1;
  }

  .thanks__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: min(440px, 100%);
    box-sizing: border-box;
    padding: 36px 32px 32px;
    border-radius: var(--radius-panel);
    background: var(--white);
    box-shadow: var(--shadow-stats);
    text-align: center;
    transform: translateY(12px) scale(.98);
    transition: transform 250ms var(--ease-out);
  }

  .thanks.is-open .thanks__panel {
    transform: none;
  }

  .thanks__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(30, 122, 92, .1);
    color: var(--emerald);
  }

  .thanks__text {
    margin: 0;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.5;
    color: var(--navy);
    text-wrap: balance;
  }

  /* Odkaz jako .kontakt__booking-link (žádná vlastní varianta). */
  .thanks__link {
    font-weight: 600;
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--emerald);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: color var(--duration-hover) var(--ease-out), text-decoration-color var(--duration-hover) var(--ease-out);
  }

  .thanks__link:hover {
    color: var(--emerald-hover);
    text-decoration-color: var(--emerald-hover);
  }

  .thanks__close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--duration-hover) var(--ease-out);
  }

  .thanks__close:hover {
    color: var(--navy);
  }

  .thanks__close:focus-visible,
  .thanks__link:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks,
    .thanks__panel {
      transition: none;
    }
  }
</style>
