---
import HeroPhoto from './HeroPhoto.astro';
---

<section id="hero" class="hero">
  <div class="hero__inner">
    <h1 class="hero__title">
      <span class="hero__title-line hero__title-line--1">Finance</span><br />
      <span class="hero__title-line hero__title-line--2">se&nbsp;nemají řešit</span><br />
      <span class="hero__title-line hero__title-line--3">po&nbsp;částech.</span>
    </h1>

    <p class="hero__subhead">
      Bydlení, ochranu, investice a&nbsp;penzi propojuji do&nbsp;jednoho plánu. <br class="hero__subhead-break" />
      Aby dával smysl dnes i&nbsp;za&nbsp;několik let.
    </p>

    <div class="hero__actions">
      <a class="hero__cta" href="/#kontakt">Nezávazná konzultace</a>

      <a class="hero__phone" href="tel:+420775217721">
        <svg class="hero__phone-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.2 18.5 5.5 13.8 5.5 6.5c0-1.1.9-2 1-3z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span>+420&nbsp;775&nbsp;217&nbsp;721</span>
      </a>
    </div>
  </div>

  <HeroPhoto />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    color: var(--navy);
    min-height: 764px;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    padding-inline-start: clamp(24px, calc(24px + 0.036036 * (100vw - 390px)), 40px);
    padding-inline-end: 32px;
    padding-top: 340px;
  }

  /* --- Typografie --- */

  .hero__title {
    font-weight: 700;
    line-height: .99;
    letter-spacing: -.05em;
    font-size: clamp(42px, calc(42px + 0.031532 * (100vw - 390px)), 56px);
    max-width: 334px;
    color: var(--white);
  }

  /* Bez animace nástupu — na přání uživatele 29. 9. 2026 se vše zobrazí hned. */
  .hero__title-line {
    display: inline-block;
  }

  .hero__subhead {
    margin-top: 24px;
    max-width: 300px;
    font-size: 16.5px;
    line-height: 1.6;
    font-weight: 400;
    color: rgba(255, 255, 255, .78);
  }

  .hero__subhead-break {
    display: none;
  }

  /* --- Akce --- */

  .hero__actions {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    width: 100%;
    background: var(--emerald);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    border-radius: var(--radius-btn);
    transition: background-color var(--duration-hover) var(--ease-out), transform var(--duration-hover) var(--ease-out);
  }

  .hero__cta:hover {
    background: var(--emerald-hover);
  }

  .hero__cta:active {
    transform: translateY(1px);
  }

  .hero__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    font-weight: 600;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    color: var(--white);
    transition: color var(--duration-hover) var(--ease-out);
  }

  .hero__phone:hover {
    color: var(--emerald-light);
  }

  .hero__phone-icon {
    width: 18px;
    height: 18px;
  }

  /* --- Fotografie (HeroPhoto.astro) --- */

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(120, 152, 193, 0) 0%,
      rgba(92, 127, 172, .42) 16%,
      rgba(58, 92, 138, .68) 40%,
      rgba(32, 62, 104, .86) 62%,
      rgba(19, 45, 80, .96) 80%,
      #0f2747 94%,
      #0f2747 100%
    );
    /* Horní hrana modrého pozadí textu se plynule rozpouští — pod hlavou
       (od 215 px) delší kosinovou křivkou do 375 px, tedy lehce do první
       řádky nadpisu (340 px), aby přechod nebyl strmý (28. 9. 2026). */
    -webkit-mask-image: linear-gradient(180deg, transparent 215px, rgba(0, 0, 0, .02) 228px, rgba(0, 0, 0, .06) 242px, rgba(0, 0, 0, .15) 255px, rgba(0, 0, 0, .25) 268px, rgba(0, 0, 0, .37) 282px, rgba(0, 0, 0, .5) 295px, rgba(0, 0, 0, .63) 308px, rgba(0, 0, 0, .75) 322px, rgba(0, 0, 0, .85) 335px, rgba(0, 0, 0, .94) 348px, rgba(0, 0, 0, .98) 362px, #000 375px);
            mask-image: linear-gradient(180deg, transparent 215px, rgba(0, 0, 0, .02) 228px, rgba(0, 0, 0, .06) 242px, rgba(0, 0, 0, .15) 255px, rgba(0, 0, 0, .25) 268px, rgba(0, 0, 0, .37) 282px, rgba(0, 0, 0, .5) 295px, rgba(0, 0, 0, .63) 308px, rgba(0, 0, 0, .75) 322px, rgba(0, 0, 0, .85) 335px, rgba(0, 0, 0, .94) 348px, rgba(0, 0, 0, .98) 362px, #000 375px);
    pointer-events: none;
  }

  /* ============ Mobil (<768): hero na výšku displeje ============
     28. 9. 2026: hero vyplní obrazovku pod záhlavím (64 px), nejméně ale
     700 px — pod tím by nadpis s tmavým pozadím zakryl obličej. Text je
     přichycený ke SPODKU (36 px nad pásem, jako dřív při 764 px), fotka
     zůstává nahoře; tmavé pozadí i jeho rozpuštění se počítají od spodku,
     takže pod textem vypadají na každé výšce stejně jako dřív na 764 px.
     Na 764 px vychází všechno 1:1 jako předtím. HeroLine.astro (mobilní
     linka) používá stejný vzorec výšky. */
  @media (max-width: 767px) {
    .hero {
      min-height: max(700px, calc(100vh - 64px));
      min-height: max(700px, calc(100svh - 64px));
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .hero__inner {
      padding-top: 0;
      padding-bottom: 36px;
    }

    .hero::after {
      background: linear-gradient(
        180deg,
        rgba(120, 152, 193, 0) calc(100% - 764px),
        rgba(92, 127, 172, .42) calc(100% - 642px),
        rgba(58, 92, 138, .68) calc(100% - 458px),
        rgba(32, 62, 104, .86) calc(100% - 290px),
        rgba(19, 45, 80, .96) calc(100% - 153px),
        #0f2747 calc(100% - 46px),
        #0f2747 100%
      );
      -webkit-mask-image: linear-gradient(180deg, transparent calc(100% - 549px), rgba(0, 0, 0, .02) calc(100% - 536px), rgba(0, 0, 0, .06) calc(100% - 522px), rgba(0, 0, 0, .15) calc(100% - 509px), rgba(0, 0, 0, .25) calc(100% - 496px), rgba(0, 0, 0, .37) calc(100% - 482px), rgba(0, 0, 0, .5) calc(100% - 469px), rgba(0, 0, 0, .63) calc(100% - 456px), rgba(0, 0, 0, .75) calc(100% - 442px), rgba(0, 0, 0, .85) calc(100% - 429px), rgba(0, 0, 0, .94) calc(100% - 416px), rgba(0, 0, 0, .98) calc(100% - 402px), #000 calc(100% - 389px));
              mask-image: linear-gradient(180deg, transparent calc(100% - 549px), rgba(0, 0, 0, .02) calc(100% - 536px), rgba(0, 0, 0, .06) calc(100% - 522px), rgba(0, 0, 0, .15) calc(100% - 509px), rgba(0, 0, 0, .25) calc(100% - 496px), rgba(0, 0, 0, .37) calc(100% - 482px), rgba(0, 0, 0, .5) calc(100% - 469px), rgba(0, 0, 0, .63) calc(100% - 456px), rgba(0, 0, 0, .75) calc(100% - 442px), rgba(0, 0, 0, .85) calc(100% - 429px), rgba(0, 0, 0, .94) calc(100% - 416px), rgba(0, 0, 0, .98) calc(100% - 402px), #000 calc(100% - 389px));
    }
  }

  /* ============ Tablet: 768–1199 ============ */
  @media (min-width: 768px) {
    .hero {
      min-height: clamp(656px, calc(656px + 0.255639 * (100vw - 834px)), 792px);
      color: var(--navy);
    }

    .hero::after {
      display: none;
    }

    .hero__inner {
      padding-inline-end: clamp(40px, calc(40px + 0.105263 * (100vw - 834px)), 96px);
      padding-top: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
    }

    .hero__title {
      color: var(--navy);
      /* 470px zalamovalo „se nemají řešit“ na dva řádky těsně pod 1200px,
         kde tabletový font-size vzorec dosahuje ~75px (přirozená šířka řádku
         ~474px) — 490px dává bezpečnou rezervu při zachování jednoho řádku. */
      max-width: 490px;
      font-size: clamp(56px, calc(56px + 0.052632 * (100vw - 834px)), 84px);
    }

    .hero__subhead {
      color: var(--text);
      /* Na úzkém tabletu užší, aby se nepotkal s posunutou fotkou
         (100vw − 392 = místo vlevo od fotky s odstupem). */
      max-width: min(520px, calc(100vw - 392px));
      margin-top: 60px;
      font-size: clamp(16.5px, calc(16.5px + 0.004699 * (100vw - 834px)), 19px);
    }

    .hero__subhead-break {
      display: inline;
    }

    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: clamp(32px, calc(32px + 0.007519 * (100vw - 834px)), 36px);
      margin-top: 46px;
    }

    .hero__cta {
      width: auto;
      padding-inline: 28px;
      height: 56px;
    }

    .hero__phone {
      height: 56px;
      color: var(--navy);
    }

    .hero__phone:hover {
      color: var(--emerald);
    }

    /* Velikost postavy = hero na /pristup (stejně velká hlava na každé
       tabletové šířce, přání uživatele 28. 9. 2026). --hp-w je šířka bloku
       = měřítko fotky × 434; vzorce odvozené z měření /pristup (tam je
       měřítko po částech: do ~964 px podle výšky, pak podle šířky).
       Výška bloku = 790 px zdroje (pás uřízne fotku kousek pod rukou),
       spodek na spodku hero = na statistickém pásu. Loket ~15 px od kraje. */
    .hero :global(.hero-photo) {
      --hp-w: max(
        calc(305.5px + 0.102 * (100vw - 834px)),
        calc(284.5px + 0.264 * (100vw - 834px))
      );
      inset: auto;
      bottom: 0;
      left: calc(100% - var(--hp-w) - 3px);
      width: var(--hp-w);
      height: calc(var(--hp-w) * 1.8203);
      border-radius: 0;
    }
  }

  /* Úzký tablet (768–833): na /pristup se postava zmenšuje, aby se ruka
     nedotkla telefonu — tady stejně, ať jsou obě stejně velké. */
  @media (min-width: 768px) and (max-width: 833px) {
    .hero :global(.hero-photo) {
      --hp-w: calc(305.6px - 0.8147 * (834px - 100vw));
    }
  }

  /* Tablet: nadpis na stejné svislé jako logo v hlavičce a začátek linky —
     40 px na 834, úměrně šířce okna (4. 10. 2026). Notebook má vlastní. */
  @media (min-width: 768px) and (max-width: 1199px) {
    .hero__inner {
      padding-inline-start: calc(40 * 100% / 834);
    }
  }

  /* ============ Laptop/Desktop: 1200+ ============ */
  @media (min-width: 1200px) {
    .hero__inner {
      padding-top: clamp(84px, calc(84px + 0.054054 * (100vw - 1366px)), 88px);
    }

    .hero__title {
      max-width: 780px;
      font-size: clamp(84px, calc(84px + 0.108108 * (100vw - 1366px)), 92px);
    }

    .hero__subhead {
      max-width: 590px;
      margin-top: 85px;
      font-size: clamp(19px, calc(19px + 0.013514 * (100vw - 1366px)), 20px);
    }

    .hero__actions {
      margin-top: 50px;
      gap: clamp(36px, calc(36px + 0.054054 * (100vw - 1366px)), 40px);
    }

    .hero__cta {
      height: clamp(56px, calc(56px + 0.027027 * (100vw - 1366px)), 58px);
      padding-inline: 30px;
    }

    .hero__phone {
      height: clamp(56px, calc(56px + 0.027027 * (100vw - 1366px)), 58px);
    }

    /* Blok fotky o 80 px výš (top 104 → 24, výška +80) — spodní hrana dál
       přesně na statistickém pásu; víc místa pro větší postavu i s rukama. */
    .hero :global(.hero-photo) {
      top: 24px;
      left: clamp(900px, calc(900px + 0.594595 * (100vw - 1366px)), 944px);
      width: clamp(466px, calc(466px + 0.459459 * (100vw - 1366px)), 500px);
      /* Spodek bloku = spodek hero = horní hrana statistického pásu na každé
         šířce. Dřív pevná výška (768–780 px) na notebooku přečnívala hero
         o ~22 px a pás tak uřízl ruku (28. 9. 2026). */
      bottom: 0;
      height: auto;
    }
  }

  @media (min-width: 1400px) {
    .hero {
      min-height: clamp(792px, calc(792px + 0.162162 * (100vw - 1366px)), 804px);
      /* Wide desktop: centrované designové plátno (CLAUDE.md) — no-op pod
         --stage-max, nad ní zastaví další roztahování obsahu s viewportem.
         HeroLine.astro (dekorativní linka, sourozenec uvnitř .hero-group)
         dostává STEJNÝ strop samostatně, aby zůstala navázaná na obsah. */
      max-width: var(--stage-max);
      margin-inline: auto;
    }

    .hero__inner {
      padding-inline-start: clamp(96px, calc(96px + 0.324324 * (100vw - 1366px)), 120px);
    }

    /* Široký desktop: fotka jde s pravou stranou hero, ne na pevném x=944
       (vpravo by zůstávalo prázdno). Na 1440 px beze změny (944), od šířky
       hero 1564 px se drží 120 px od pravého kraje (500 + 120 = 620). */
    .hero :global(.hero-photo) {
      left: max(944px, calc(100% - 620px));
    }

    .hero__subhead {
      margin-top: 77px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-line {
      opacity: 1;
      transform: none;
    }
  }
</style>
