---
/**
 * Graf porovnání částek — vodorovné pruhy, každý složený z částí
 * (např. „náklady roku čekání" = nájem + zdražení + vlastní zdroje proti
 * „úspoře na splátce"). Délka pruhů v poměru k největšímu součtu.
 * Řádek s `accent: true` je v barvě značky (to, na co má čtenář koukat).
 * V MDX:
 * <GrafPorovnani title="…" rows={[{ label: '…', segments: [{ label: 'Nájem', value: 204000 }] }]} />
 */
import { czechNbsp } from '../../lib/rehype-czech-nbsp.mjs';
import { kc } from './graf-format';

interface Props {
  title: string;
  rows: { label: string; segments: { label: string; value: number }[]; accent?: boolean }[];
  note?: string;
}
const { title, rows, note } = Astro.props;
const sum = (r: Props['rows'][number]) => r.segments.reduce((s, x) => s + x.value, 0);
const max = Math.max(...rows.map(sum));
const PALETTE = ['var(--navy)', 'var(--line)', 'var(--line-on-dark)'];
const color = (r: Props['rows'][number], i: number) => (r.accent ? 'var(--emerald)' : PALETTE[i % PALETTE.length]);
---

<figure class="graf">
  <figcaption class="graf__title">
    <span class="graf__label">Graf</span>
    <span>{czechNbsp(title)}</span>
  </figcaption>

  <ul class="graf__rows">
    {
      rows.map((r) => (
        <li class="graf__row">
          <p class="graf__row-head">
            <span class="graf__row-label">{czechNbsp(r.label)}</span>
            <strong class:list={['graf__row-total', { 'graf__row-total--accent': r.accent }]}>{kc(sum(r))}</strong>
          </p>
          <div class="graf__bar" style={`width:${Math.max((sum(r) / max) * 100, 1.2)}%`}>
            {r.segments.map((s, i) => (
              <span style={`flex:${s.value} 0 0;background:${color(r, i)}`} />
            ))}
          </div>
          {r.segments.length > 1 && (
            <p class="graf__parts">
              {r.segments.map((s, i) => (
                <span>
                  <i class="graf__swatch" style={`background:${color(r, i)}`} />
                  {czechNbsp(s.label)} {kc(s.value)}
                </span>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ul>

  {note && <p class="graf__note">{czechNbsp(note)}</p>}
</figure>

<style>
  .graf {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 24px 20px;
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .graf__title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    color: var(--navy);
  }

  .graf__label {
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-size: 11.5px;
    line-height: 18px;
    color: var(--emerald);
  }

  .graf__rows {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .graf__row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .graf__row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
    margin: 0;
  }

  .graf__row-label {
    font-weight: 600;
    font-size: 16px;
    color: var(--navy);
  }

  .graf__row-total {
    font-weight: 700;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    color: var(--navy);
  }

  .graf__row-total--accent {
    color: var(--emerald);
  }

  .graf__bar {
    display: flex;
    gap: 2px;
    height: 18px;
    overflow: hidden;
    border-radius: 5px;
  }

  .graf__parts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .graf__parts span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .graf__swatch {
    flex: none;
    width: 14px;
    height: 10px;
    border-radius: 3px;
  }

  .graf__note {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-quiet);
  }

  @media (min-width: 768px) {
    .graf {
      padding: 28px 32px;
    }

    .graf__bar {
      height: 22px;
    }
  }
</style>
