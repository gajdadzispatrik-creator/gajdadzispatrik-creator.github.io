---
/**
 * Příklad výpočtu — řádky „položka … částka" a výsledek.
 * V MDX: <Priklad title="…" rows={[['Položka', '1 000 Kč'], …]} result={['Celkem', '…']} note="…" />
 */
import { czechNbsp } from '../../lib/rehype-czech-nbsp.mjs';

interface Props {
  title: string;
  rows: [string, string][];
  result?: [string, string];
  note?: string;
}
const { title, rows, result, note } = Astro.props;
---

<figure class="priklad">
  <figcaption class="priklad__title">
    <span class="priklad__label">Příklad</span>
    <span>{czechNbsp(title)}</span>
  </figcaption>
  <dl class="priklad__rows">
    {
      rows.map(([label, value]) => (
        <div class="priklad__row">
          <dt>{czechNbsp(label)}</dt>
          <dd>{czechNbsp(value)}</dd>
        </div>
      ))
    }
    {
      result && (
        <div class="priklad__row priklad__row--result">
          <dt>{czechNbsp(result[0])}</dt>
          <dd>{czechNbsp(result[1])}</dd>
        </div>
      )
    }
  </dl>
  {note && <p class="priklad__note">{czechNbsp(note)}</p>}
</figure>

<style>
  .priklad {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 24px;
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .priklad__title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    color: var(--navy);
  }

  .priklad__label {
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-size: 11.5px;
    line-height: 18px;
    color: var(--emerald);
  }

  .priklad__rows {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .priklad__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;   /* popisek ↔ částka: na 320 px dřív hraničních 16 px */
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }

  .priklad__row dt {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--text);
  }

  .priklad__row dd {
    flex: none;
    margin: 0;
    font-size: 16.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--navy);
    text-align: right;
  }

  .priklad__row--result {
    padding-top: 14px;
    border-top: 1.5px solid var(--navy);
  }

  .priklad__row--result dt,
  .priklad__row--result dd {
    font-weight: 700;
    font-size: 18px;
    color: var(--navy);
  }

  .priklad__row--result dd {
    color: var(--emerald);
  }

  .priklad__note {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .priklad {
      padding: 28px 32px;
    }
  }
</style>
