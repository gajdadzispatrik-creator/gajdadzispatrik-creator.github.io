---
/**
 * „Z praxe" — Patrikova zkušenost v článku. V MDX: <Praxe>Text…</Praxe>.
 * Malá fotka + popisek odliší osobní zkušenost od výkladu kolem.
 */
import { Image } from 'astro:assets';
import personPhoto from '../../assets/photos/patrik-pristup-pece.png';
---

<aside class="praxe" aria-label="Z praxe">
  <p class="praxe__head">
    <span class="praxe__avatar"><Image src={personPhoto} width={96} alt="" loading="lazy" /></span>
    <span class="praxe__label">Z&nbsp;praxe</span>
  </p>
  <div class="praxe__body"><slot /></div>
</aside>

<style>
  .praxe {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .praxe__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
  }

  /* Ořez fotky stejně jako kontaktní blok a /pristup. */
  .praxe__avatar {
    flex: none;
    width: 36px;
    height: 36px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--about-photo-1);
  }

  .praxe__avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transform: translateY(9%) scale(1.25);
    transform-origin: 50% 0;
  }

  .praxe__label {
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-size: 11.5px;
    line-height: 18px;
    color: var(--emerald);
  }

  .praxe__body :global(p) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--navy);
  }

  .praxe__body :global(p + p) {
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .praxe {
      padding: 28px 32px;
    }

    .praxe__body :global(p) {
      font-size: 19px;
    }
  }
</style>
