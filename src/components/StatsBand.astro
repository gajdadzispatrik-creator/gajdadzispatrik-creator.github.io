---
/**
 * OPRAVA (úkol „Předspouštěcí P0 technické dotažení“): třetí položka
 * (`Od 2020` / „Ve financích“) byla na výslovné přání uživatele odstraněna
 * — na veřejném webu se nemá uvádět rok zahájení finanční praxe. Nenahrazeno
 * žádnou vymyšlenou statistikou. `stats-band__list`/`stats-band__item` je
 * plynulý flex layout (`flex:1` na položce), dva prvky ho beze změny
 * rovnoměrně rozdělí — žádná další úprava layoutu nebyla potřeba.
 */
const stats = [
  { number: '150+', label: 'osobních klientů' },
  { number: '5,0', label: 'Google recenze' },
];
---

<section class="stats-band" aria-label="Klíčové údaje">
  <ul class="stats-band__list">
    {stats.map((stat) => (
      <li class="stats-band__item">
        <span class="stats-band__number">
          {stat.number}
        </span>
        <span class="stats-band__label">{stat.label}</span>
      </li>
    ))}
  </ul>
  <div class="stats-band__tint" aria-hidden="true"></div>
</section>

<script>
  /*
   * Safari na iOS 26 kreslí spodní panel (adresa + navigace) přes stránku
   * a jeho barvu bere z prvku přichyceného ke spodní hraně obrazovky, jinak
   * ze světlého pozadí stránky — přes tmavé hero pak panel svítil šedě.
   * Tenký proužek `position: fixed` je na mobilu zapnutý POŘÁD a jen mění
   * barvu podle toho, co zrovna leží pod spodní hranou obrazovky (tmavé
   * hero/pás → navy, jinak skutečné pozadí sekce), takže je v ostatních
   * prohlížečích neviditelný. Dřívější verze proužek mimo hero vypínala —
   * Safari pak po návratu nahoru nechal kolem panelu bílý obdélník (barvu
   * pozadí stránky převzatou ve chvíli, kdy proužek chyběl).
   * Na přání uživatele 29. 9. 2026 (iPhone 17 Pro, Safari).
   */
  const band = document.querySelector('.stats-band') as HTMLElement | null;
  const tint = band?.querySelector('.stats-band__tint') as HTMLElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;

  if (band && tint && hero) {
    const navy = getComputedStyle(band).backgroundColor;
    // Barva přechodu (tmavé sekce: linear-gradient s téměř svislým úhlem)
    // v bodě y — lineární interpolace mezi zastávkami podle výšky prvku.
    const gradientAt = (el: Element, image: string, y: number) => {
      const stops = [...image.matchAll(/rgba?\(([^)]+)\)\s+([\d.]+)%/g)].map((m) => ({
        c: m[1].split(',').map((v) => parseFloat(v)),
        at: parseFloat(m[2]) / 100,
      }));
      if (stops.length < 2) return '';
      const r = el.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, (y - r.top) / r.height));
      let i = 0;
      while (i < stops.length - 2 && t > stops[i + 1].at) i++;
      const a = stops[i];
      const b = stops[i + 1];
      const k = b.at > a.at ? Math.min(1, Math.max(0, (t - a.at) / (b.at - a.at))) : 1;
      const mix = [0, 1, 2].map((j) => Math.round(a.c[j] + (b.c[j] - a.c[j]) * k));
      return `rgb(${mix.join(', ')})`;
    };
    // Barva obsahu pod bodem — přeskočí přichycené vrstvy (cookie lišta,
    // menu), ty si Safari vzorkuje samo.
    const bgUnder = (x: number, y: number) => {
      for (const hit of document.elementsFromPoint(x, y)) {
        let el: Element | null = hit;
        let color = '';
        let fixed = false;
        while (el && el !== document.documentElement) {
          const cs = getComputedStyle(el);
          if (cs.position === 'fixed') { fixed = true; break; }
          // Jen plochy přes (skoro) celou šířku — ne tlačítka a drobné prvky.
          if (el.getBoundingClientRect().width < window.innerWidth * 0.8) { el = el.parentElement; continue; }
          if (!color && cs.backgroundImage.startsWith('linear-gradient')) color = gradientAt(el, cs.backgroundImage, y);
          const c = cs.backgroundColor;
          if (!color && c && c !== 'transparent' && c !== 'rgba(0, 0, 0, 0)') color = c;
          el = el.parentElement;
        }
        if (!fixed && color) return color;
      }
      return getComputedStyle(document.documentElement).backgroundColor;
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      // Proužek existuje jen v Safari na iPhonu (CSS @supports) — jinde nic.
      if (getComputedStyle(tint).display === 'none') return;
      const vh = window.innerHeight;
      // Tmavá plná barva hero začíná ~150 px nad jeho koncem (.hero::after)
      // — pozadí samotné sekce hero je světlé, proto zvlášť.
      const onNavy = hero.getBoundingClientRect().bottom - 150 < vh
        && band.getBoundingClientRect().bottom > vh + 4;
      tint.style.backgroundColor = onNavy ? navy : bgUnder(window.innerWidth / 2, vh - 2);
    };
    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .stats-band {
    position: relative;
    z-index: 2;
    background: var(--navy);
    box-shadow: var(--shadow-stats-mobile);
  }

  .stats-band__list {
    display: flex;
    flex-direction: column;
  }

  /* Safari na iOS 26 bere barvu spodního panelu z fixed prvku ≥ 3 px
     vysokého, ≥ 80 % širokého a nejvýš 3 px od spodní hrany (vyžaduje
     viewport-fit=cover, BaseLayout). 12 px s bottom −8 px = 4 px na
     obrazovce i při sbalování panelu. Zobrazený jen ve WebKitu na iOS
     (@supports níže), jinde vůbec neexistuje. Barvu nastavuje skript. */
  .stats-band__tint {
    display: none;
    position: fixed;
    left: 0;
    bottom: -8px;
    width: 100%;
    height: 12px;
    background-color: var(--navy);
    pointer-events: none;
  }

  @supports (-webkit-touch-callout: none) {
    @media (max-width: 767px) {
      .stats-band__tint {
        display: block;
      }
    }
  }

  .stats-band__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 84px;
    text-align: center;
  }

  .stats-band__number {
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--white);
    font-size: 26px;
  }

  .stats-band__label {
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1;
    color: rgba(255, 255, 255, .62);
    font-size: 11.5px;
  }

  @media (min-width: 768px) {
    .stats-band {
      box-shadow: var(--shadow-stats-tablet);
      padding-inline: 40px;
    }

    .stats-band__list {
      flex-direction: row;
    }

    .stats-band__item {
      flex: 1;
      height: 100px;
    }

    .stats-band__number {
      font-size: 28px;
    }

    .stats-band__label {
      font-size: 10px;
      color: rgba(255, 255, 255, .46);
    }
  }

  @media (min-width: 1200px) {
    .stats-band {
      padding-inline: 96px;
    }

    .stats-band__item {
      height: 96px;
    }

    .stats-band__number {
      font-size: 32px;
    }

    .stats-band__label {
      font-size: 10.5px;
    }
  }

  @media (min-width: 1400px) {
    .stats-band {
      box-shadow: var(--shadow-stats);
      padding-inline: 120px;
    }

    /*
     * Wide desktop: centrované designové plátno (CLAUDE.md). `.stats-band`
     * zůstává full-width tmavý pás (§„1. Full-width layer“, sourozenec
     * `.hero-line--desktop` v `.hero-group`, viz HeroLine.astro) — tři čísla
     * uvnitř dřív rostla s celým viewportem (`padding-inline` samo o sobě
     * strop netvoří). `max-width` počítaný jako `--stage-max` MÍNUS oba
     * padding (240 = 120+120) capne jen samotný seznam a `margin-inline:
     * auto` ho vystředí uvnitř zbylého (už odsazeného) prostoru — dřívější
     * implementace tuhle sekci vůbec neřešila (nebyla to sekce s vlastní
     * trasou/textem u tečky, proto unikla pozornosti).
     */
    .stats-band__list {
      max-width: calc(var(--stage-max) - 240px);
      margin-inline: auto;
    }

    .stats-band__number {
      font-size: 34px;
    }
  }
</style>
