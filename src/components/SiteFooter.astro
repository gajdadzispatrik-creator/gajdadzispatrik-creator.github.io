---
/**
 * Footer — Uzavření trasy (varianta 20a, po dvou úpravách viz §3 zadání).
 * Zdroj: úkol pro Claude Code „Footer (Uzavření trasy)“, §1–§16. Poslední
 * prvek stránky, řadí se pod ContactSection.astro.
 *
 * Dvě schválené úpravy proti content-homepage.md §13:
 * 1) „BEplan finanční plánování“ v Projektech a profesních vazbách vynecháno
 *    (jen tři položky).
 * 2) Blok „Provozovatel webu“ (IČO, Hlavní třída) ve footeru není — patří na
 *    samostatnou stránku s regulatorními informacemi.
 * Navigace používá „Recenze“, ne „Reference“ (schváleno, §4 zadání).
 *
 * ODCHYLKA (technický požadavek, §13 zadání to sám vyžaduje — stejná třída
 * chyby jako `Odchylka 2` v ContactSection.astro/CasesSection.astro):
 * §6–§9 dávají konkrétní `top`/`left` souřadnice pro tři pásma. Sekce je
 * postavená jako svislý tok (`margin`/`gap`, ne pevný `top`) — výška plyne
 * z obsahu. Odsazení textové značky od osy trasy používá STEJNOU konvenci
 * jako všude jinde na webu (56 px desktop/notebook/tablet, 32 px mobil),
 * ne doslovný jednorázový výpočet ze zadání (212/186/118/96) — ten byl jen
 * vedlejším produktem statického příkladu trasy v zadání. Zakončení trasy
 * (lom, vodorovný segment, tečka) i obě dělicí linky se naopak POVINNĚ
 * dopočítávají z REÁLNÉ pozice značky/pásem (`getBoundingClientRect`) — přesně
 * podle §13 „Nejdůležitější technické pravidlo“ — takže na zvolení fixního
 * odsazení značky nezáleží, geometrie trasy se mu vždy přizpůsobí.
 *
 * Stav URL adres (aktualizováno 24. 8. 2026 při kontrole odkazů na celém webu):
 * - Tři právní stránky existují a jsou propojené: `/zpracovani-osobnich-udaju`,
 *   `/cookies`, `/regulatorni-informace` (LegalLayout.astro + src/data/legal/).
 * - Mint reality & finance, Hypotéka Ostrava a Registr ČNB ověřeny přímým
 *   prohlížením webu a propojeny (`https://www.mintreality.cz/`,
 *   `https://www.hypotekaostrava.cz/`, `https://www.cnb.cz/cnb/jerrs`).
 * - „Kontakt“ v navigaci vede na `/#kontakt` (kotva `ContactSection.astro`
 *   `id="kontakt"`), ne na neexistující `/kontakt`.
 * - Facebook a Instagram doplněny (25. 8. 2026):
 *   https://www.facebook.com/patrik.gajdadzis/, https://www.instagram.com/patrikgajdadzis/.
 *   Google odkaz (24. 9. 2026) vede na záložku Recenze v Mapách —
 *   `GOOGLE_REVIEWS_URL` ze src/data/entity.ts, stejně jako recenze.
 * - AKTUALIZOVÁNO (úkol „Předspouštěcí P0 technické dotažení“): `serviceLinks`
 *   propojeny na 5 hotových detailních stránek (`/sluzby/*`) — dřív `href:
 *   null`, ačkoli stránky už existovaly (nalezeno auditem 9. 9. 2026).
 * - `/clanky` dočasně odstraněna z `navLinks` (skutečné články zatím nejsou
 *   připravené, viz zadání úkolu výše) — stránka samotná dál existuje
 *   (`src/pages/clanky.astro`, `noindex`), jen bez veřejného odkazu odsud.
 * - „Kariéra" dočasně skrytá (24. 9. 2026, přání uživatele) — nemá zatím
 *   cílovou stránku. Až bude, vrátit do `navLinks` mezi „O mně" a „Kontakt".
 */
import { GOOGLE_REVIEWS_URL } from '../data/entity';

interface LinkItem {
  label: string;
  href: string | null;
  shortLabel?: string;
}

const navLinks: LinkItem[] = [
  { label: 'Služby', href: '/sluzby' },
  { label: 'Jak pracuji', href: '/pristup' },
  { label: 'Recenze', href: '/recenze' },
  { label: 'O mně', href: '/o-mne' },
  { label: 'Kontakt', href: '/#kontakt' },
];

const serviceLinks: LinkItem[] = [
  { label: 'Finanční plánování', href: '/sluzby/financni-plan' },
  { label: 'Hypotéky', href: '/sluzby/hypoteky' },
  { label: 'Investice', href: '/sluzby/investice' },
  { label: 'Pojištění', href: '/sluzby/pojisteni' },
  { label: 'Penze', href: '/sluzby/penze' },
];

const projectLinks: LinkItem[] = [
  { label: 'Mint reality & finance', href: 'https://www.mintreality.cz/' },
  { label: 'Hypotéka Ostrava', href: 'https://www.hypotekaostrava.cz/' },
  { label: 'Registr České národní banky', shortLabel: 'Registr ČNB', href: 'https://www.cnb.cz/cnb/jerrs' },
];

const legalLinks = [
  { label: 'Zpracování osobních údajů', href: '/zpracovani-osobnich-udaju' as string | null, isButton: false },
  { label: 'Cookies', href: '/cookies' as string | null, isButton: false },
  { label: 'Regulatorní informace', href: '/regulatorni-informace' as string | null, isButton: false },
  { label: 'Nastavení cookies', href: null as string | null, isButton: true },
];

const socialLinks: LinkItem[] = [
  { label: 'Google', href: GOOGLE_REVIEWS_URL },
  { label: 'Facebook', href: 'https://www.facebook.com/patrik.gajdadzis/' },
  { label: 'Instagram', href: 'https://www.instagram.com/patrikgajdadzis/' },
];

// Jednobarevné (currentColor) glyfy — žádná nová barva, jen bílá s
// průhledností stejně jako zbytek footeru (§24 CLAUDE.md zakazuje nové barvy).
const socialIcons: Record<string, string> = {
  Google:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M21.35 11.1h-9.18v2.98h5.4c-.23 1.5-1.7 4.4-5.4 4.4-3.25 0-5.9-2.7-5.9-6s2.65-6 5.9-6c1.85 0 3.09.79 3.8 1.47l2.6-2.5C17.05 3.9 14.7 2.9 12.17 2.9 6.9 2.9 2.65 7.1 2.65 12.34s4.25 9.44 9.52 9.44c5.5 0 9.14-3.86 9.14-9.3 0-.63-.07-1.1-.16-1.58z" fill="currentColor"/></svg>',
  Facebook:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14.5 8.3h1.9V5.1c-.33-.05-1.47-.15-2.79-.15-2.76 0-4.65 1.73-4.65 4.9v2.5H6.1v3.6h2.86V22h3.72v-6.05h2.75l.44-3.6h-3.19V9.86c0-1.04.28-1.56 1.82-1.56z" fill="currentColor"/></svg>',
  Instagram:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3.3" y="3.3" width="17.4" height="17.4" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.1" stroke="currentColor" stroke-width="1.6"/><circle cx="17.15" cy="6.85" r="1.05" fill="currentColor"/></svg>',
};
---

<footer class="footer">
