    <line class="footer__divider footer__divider--2" x1="120" y1="620" x2="1320" y2="620"></line>
    <circle class="footer__dot" cx="190" cy="184" r="3.5" fill="var(--emerald)"></circle>
  </svg>

  <!-- Notebook 1200–1399 (kalibrace 1366). Vstup x=96, radius 28 — stejná logika jako desktop. -->
  <svg
    class="footer__route footer__route--laptop"
    viewBox="0 0 1366 700"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-entry="96"
    data-radius="28"
    data-gap="22"
  >
    <path
      class="footer__route-path"
      d="M 96 -20 V 146 A 28 28 0 0 0 124 174 H 164"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <line class="footer__divider footer__divider--1" x1="96" y1="312" x2="1270" y2="312"></line>
    <line class="footer__divider footer__divider--2" x1="96" y1="580" x2="1270" y2="580"></line>
    <circle class="footer__dot" cx="164" cy="174" r="3.5" fill="var(--emerald)"></circle>
  </svg>

  <!-- Tablet 768–1199 (kalibrace 834). Vstup x=40, radius 22. -->
  <svg
    class="footer__route footer__route--tablet"
    viewBox="0 0 834 900"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-entry="40"
    data-radius="22"
    data-gap="22"
  >
    <path
      class="footer__route-path"
      d="M 40 -20 V 100 A 22 22 0 0 0 62 122 H 96"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <line class="footer__divider footer__divider--1" x1="40" y1="270" x2="794" y2="270"></line>
    <line class="footer__divider footer__divider--2" x1="40" y1="560" x2="794" y2="560"></line>
    <circle class="footer__dot" cx="96" cy="122" r="3.2" fill="var(--emerald)"></circle>
  </svg>

  <!--
    Mobil <768 (kalibrace 390). Vstup x=24. Bez zatočení ke značce — značka
    je zarovnaná s ostatním obsahem patičky a na zatočení před ní není místo;
    trasa jde rovně dolů a končí tečkou na ose 18 px nad značkou
    (data-straight, 28. 9. 2026, přání uživatele).
  -->
  <svg
    class="footer__route footer__route--mobile"
    viewBox="0 0 390 1200"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-entry="24"
    data-radius="18"
    data-gap="20"
    data-straight="true"
  >
    <path
      class="footer__route-path"
      d="M 24 -20 V 92 A 18 18 0 0 0 42 110 H 76"
      fill="none"
      stroke="var(--line-on-dark)"
      stroke-opacity=".3"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <line class="footer__divider footer__divider--1" x1="24" y1="220" x2="366" y2="220"></line>
    <line class="footer__divider footer__divider--2" x1="24" y1="480" x2="366" y2="480"></line>
    <circle class="footer__dot" cx="76" cy="110" r="3.2" fill="var(--emerald)"></circle>
  </svg>
</footer>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Na tabletu/desktopu (≥768px) se linka i texty vykreslují rovnou v hotovém
  // stavu, bez postupné animace — na zadání uživatele 24. 8. 2026.
  const disableAnimation = reduceMotion || window.matchMedia('(min-width: 768px)').matches;

  const footer = document.querySelector('.footer');
  if (footer) {
    const allSvgs = Array.from(footer.querySelectorAll('.footer__route')) as SVGSVGElement[];
    const brand = footer.querySelector('.footer__brand') as HTMLElement | null;
    const top = footer.querySelector('.footer__top') as HTMLElement | null;
    const columns = footer.querySelector('.footer__columns') as HTMLElement | null;

    const getActiveSvg = (): SVGSVGElement | undefined =>
      allSvgs.find((svg) => getComputedStyle(svg).display !== 'none');

    let currentSvg: SVGSVGElement | undefined;
    let path: SVGPathElement | null = null;
    let dividers: SVGLineElement[] = [];
    let dot: SVGCircleElement | null = null;

    const bindActiveSvg = (svg: SVGSVGElement) => {
      currentSvg = svg;
      path = svg.querySelector('.footer__route-path');
      dividers = Array.from(svg.querySelectorAll('.footer__divider'));
      dot = svg.querySelector('.footer__dot');
    };

    // Getter funkce místo přímého čtení sdílených `let` v pozdějších closures
    // — stejný důvod jako v ContactSection.astro (TS jinak zúží typ na `never`).
    const getPath = (): SVGPathElement | null => path;
    const getDot = (): SVGCircleElement | null => dot;

    /*
     * Nejdůležitější technické pravidlo zadání (§13): `x` zakončení trasy se
     * počítá ze SKUTEČNÉ levé hrany značky (−22/−20 px), ne z pevného čísla;
     * `y` obou dělicích linek ze skutečné spodní hrany pásma nad nimi (+ ≥
     * 30 px). Lom (bendY) je zvolen tak, aby tečka vyšla na svislém středu
     * značky.
     */
    const syncRoute = () => {
      const svg = getActiveSvg();
      if (!svg) return;
      if (svg !== currentSvg) bindActiveSvg(svg);
      if (!brand || !top || !columns) return;

      const svgRect = svg.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      // Chybějící `svgRect.width === 0` byla dlouho zdokumentovaná, neopravená
      // chyba (CLAUDE.md „SiteFooter.astro — drobná chyba nalezená při
      // testování CookieConsent"): při `scaleX === 0` (SVG má na některých
      // načteních přechodně nulovou šířku, než se layout ustálí) dělení níž
      // vyrobí `Infinity`/`NaN` v `d` i v souřadnicích tečky — trasa/tečka
      // pak dočasně skončí na jiném místě, než kde linka reálně končí.
      // Opraveno 14. 9. 2026 po nahlášení uživatelem.
      if (svgRect.height === 0 || svgRect.width === 0 || viewBox.height === 0 || viewBox.width === 0) return;
      const scaleY = svgRect.height / viewBox.height;
      const scaleX = svgRect.width / viewBox.width;
      svg.style.setProperty('--dot-fix', String(scaleY / scaleX));

      const entryX = parseFloat(svg.dataset.entry ?? '0');
      const r = parseFloat(svg.dataset.radius ?? '28');
      const gap = parseFloat(svg.dataset.gap ?? '22');

      const brandRect = brand.getBoundingClientRect();
      const endXReal = brandRect.left - gap;
      const endX = (endXReal - svgRect.left) / scaleX;
      const bendYReal = brandRect.top + brandRect.height / 2;
      const bendY = (bendYReal - svgRect.top) / scaleY;

      const straight = svg.dataset.straight === 'true';
      // Mobil: značka stojí na ose (zarovnaná s kontakty), trasa proto končí
      // tečkou 18 px NAD ní, ne ve výšce jejího středu (tečka by byla na „P").
      const straightEndY = (brandRect.top - 18 - svgRect.top) / scaleY;
      if (path) {
        const d = straight
          ? `M ${entryX} -20 V ${straightEndY}`
          : `M ${entryX} -20 V ${bendY - r} A ${r} ${r} 0 0 0 ${entryX + r} ${bendY} H ${endX}`;
        path.setAttribute('d', d);
      }
      if (dot) {
        dot.setAttribute('cx', String(straight ? entryX : endX));
        dot.setAttribute('cy', String(straight ? straightEndY : bendY));
      }

      const topRect = top.getBoundingClientRect();
      const columnsRect = columns.getBoundingClientRect();
      const divider1Y = (topRect.bottom + 40 - svgRect.top) / scaleY;
      const divider2Y = (columnsRect.bottom + 40 - svgRect.top) / scaleY;
      if (dividers[0]) {
        dividers[0].setAttribute('y1', String(divider1Y));
        dividers[0].setAttribute('y2', String(divider1Y));
      }
      if (dividers[1]) {
        dividers[1].setAttribute('y1', String(divider2Y));
        dividers[1].setAttribute('y2', String(divider2Y));
      }
    };

    const initialSvg = getActiveSvg();
    if (initialSvg) bindActiveSvg(initialSvg);
    syncRoute();
    window.addEventListener('resize', syncRoute);

    // `font-display: swap` (fonts.css) — viz CLAUDE.md „Konvence: kontinuální
    // linka, tečky a text“ bod 5.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(footer);
      if (top) resizeObserver.observe(top);
      if (columns) resizeObserver.observe(columns);
      if (brand) resizeObserver.observe(brand);
    }

    if (!disableAnimation) {
      const fadeUpEls = Array.from(footer.querySelectorAll('.footer__reveal-up'));
      fadeUpEls.forEach((el) => el.classList.add('is-pending'));

      let contentRevealed = false;
      const revealContent = () => {
        if (contentRevealed) return;
        contentRevealed = true;
        fadeUpEls.forEach((el) => {
          el.classList.remove('is-pending');
          el.classList.add('is-visible');
        });
      };

      let mainLength = 0;
      const dividerLengths = new Map<SVGLineElement, number>();
      let dotThreshold = 1;

      const measure = () => {
        syncRoute();
        const p = getPath();
        if (p) {
          mainLength = p.getTotalLength();
          p.style.strokeDasharray = String(mainLength);
        }
        dividers.forEach((line) => {
          const x1 = parseFloat(line.getAttribute('x1') ?? '0');
          const x2 = parseFloat(line.getAttribute('x2') ?? '0');
          const len = Math.abs(x2 - x1);
          dividerLengths.set(line, len);
          line.style.strokeDasharray = String(len);
        });
        const d = getDot();
        if (p && d && mainLength > 0) {
          const cx = parseFloat(d.getAttribute('cx') ?? '0');
          const cy = parseFloat(d.getAttribute('cy') ?? '0');
          let best = Infinity;
          const steps = 1500;
          for (let s = 0; s <= steps; s++) {
            const l = (mainLength * s) / steps;
            const pt = p.getPointAtLength(l);
            const dist = Math.hypot(pt.x - cx, pt.y - cy);
            if (dist < best) {
              best = dist;
              dotThreshold = l / mainLength;
            }
          }
        }
      };
      measure();
      const initialPath = getPath();
      if (initialPath) initialPath.style.strokeDashoffset = String(mainLength);
      dividers.forEach((line) => {
        line.style.strokeDashoffset = String(dividerLengths.get(line) ?? 0);
      });
      const initialDot = getDot();
      if (initialDot) initialDot.classList.add('is-pending');

      let ticking = false;
      const update = () => {
        measure();
        const rect = footer.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, rect.height > 0 ? (vh - rect.top) / rect.height : 0));

        // Trasa končí u značky nahoře v patičce — kreslí se podle toho, kde je
        // její KONEC (tečka) v okně: celá je hotová, když tečka dojede do 85 %
        // výšky okna. Dřív se kreslila podle scrollu CELOU patičkou (na mobilu
        // ~1100 px), takže k tečce dojela až na úplném konci stránky a do té
        // doby byla tečka odtržená od linky (28. 9. 2026).
        const currentPath = getPath();
        const endDot = getDot();
        let pathProgress = progress;
        if (currentPath && endDot) {
          const dr = endDot.getBoundingClientRect();
          const endY = dr.top + dr.height / 2;
          const startY = rect.top - 20;
          const span = Math.max(1, endY - startY);
          pathProgress = Math.min(1, Math.max(0, (vh * 0.85 - startY) / span));
        }
        if (currentPath) {
          currentPath.style.strokeDashoffset = String(mainLength * (1 - pathProgress));
        }
        dividers.forEach((line) => {
          const len = dividerLengths.get(line) ?? 0;
          line.style.strokeDashoffset = String(len * (1 - progress));
        });
        const currentDot = getDot();
        // Tolerance: tečka je na samém konci trasy (práh ≈ 1) a na konci
        // stránky vychází progres kvůli zaokrouhlení jen 0,9999 — bez ní se
        // tečka na mobilu nikdy neukázala (28. 9. 2026).
        if (currentDot && pathProgress >= dotThreshold - 0.01) {
          currentDot.classList.remove('is-pending');
          currentDot.classList.add('is-visible');
        }

        if (rect.top < vh) revealContent();

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  }
</script>

