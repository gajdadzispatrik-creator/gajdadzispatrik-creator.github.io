                    {link.shortLabel && <span class="footer__col-short">{link.shortLabel}</span>}
                    <svg class="footer__ext-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                      <path d="M4 2h6v6M10 2 2 10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
