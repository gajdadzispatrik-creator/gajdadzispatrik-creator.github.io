---
/**
 * Sekce „Finální kontaktní sekce“ — Telefon jako pás (varianta 19b).
 * Zdroj: úkol pro Claude Code „sekce Finální kontaktní sekce (Telefon jako
 * pás)“, §1–§15. Řadí se pod FaqSection.astro (poslední hotová sekce homepage).
 *
 * ODCHYLKA 1 (§2, krok 2 — zadání samo tuto kontrolu vyžaduje):
 * §6–§9 předpokládají vstup této sekce na x=640/600/500/366 podle vzoru
 * sekcí se skutečnou „policí“ (Articles/Router/Process). Reálně změřeno
 * v prohlížeči (getPointAtLength na živých `.faq__route-path` větvích, viz
 * tabulka v souhrnu úkolu) na všech 12 required šířkách:
 * - desktop (1400+): reálný výstup FaqSection = 640 ✓ odpovídá zadání (§6)
 * - notebook (1200–1399): reálný výstup = 600 ✓ odpovídá zadání (§7)
 * - tablet (768–1199): FaqSection na tabletu NEMÁ polici — trasa se lomí
 *   rovnou na vlastní osu x=40 a dál pokračuje svisle (`.faq__route--tablet`
 *   d="M 794 -20 ... V 40 ... V 1000"). Reálný výstup je tedy 40, ne 500.
 * - mobil (<768): FaqSection na mobilu nemá lom ani polici — jde rovnou
 *   svisle na vlastní ose x=24 (`.faq__route--mobile` d="M 24 -20 V 1400").
 *   Reálný výstup je tedy 24, ne 366.
 * Protože 40/24 se navíc shodují s VLASTNÍ osou této sekce na daných
 * stupních (§8/§9), tablet a mobil proto NEMAJÍ lom (trasa jde od vstupu
 * rovnou dolů) — stejný princip jako u CasesSection.astro (Odchylka 1) a
 * AboutSection/ReviewsSection/BenefitsSection navzájem na týchž šířkách.
 * Desktop a notebook mají lom podle zadání beze změny (§6/§7 souhlasí
 * s reálným stavem).
 *
 * ODCHYLKA 2 (technický požadavek, dokument to sám nepřímo vyžaduje —
 * viz §14 bod 6 „Ve návrhu byla tato věta dvakrát oříznutá"):
 * §6–§9 dávají konkrétní `top` souřadnice pro nadpis/pás/kolony/formulář,
 * které předpokládají konkrétní počet řádků nadpisu a pásu. Protože výška
 * sekce plyne z obsahu (víceřádkový nadpis, český text, dvouřádkový pás na
 * tabletu) a `top`-based layout je přesně třída chyby, která už jednou
 * způsobila oříznutý text, je celá sekce postavená jako svislý tok (flex/
 * grid s `margin`/`gap`), ne bloky na pevných `top`. Stejný princip jako
 * `Odchylka 3` v CasesSection.astro. Lom trasy a Y souřadnice vodorovnice
 * s kotvou se po vykreslení přepočítávají ze skutečné pozice obsahu
 * (`getBoundingClientRect`), stejný princip jako `syncRoute` v
 * CasesSection.astro.
 *
 * Odesílání formuláře: POST na `public/api/poptavka.php` (Wedos PHP), který
 * poptávku pošle e-mailem na patrik@mintfinance.cz. Ochrana proti spamu =
 * skryté pole `website` + doba vyplnění `vyplneno-ms` (měřená od první
 * interakce). V `npm run dev` PHP neběží — lokálně skončí odeslání chybovou
 * hláškou, funkční test až na hostingu.
 */
import { BOOKING_URL, WHATSAPP_URL } from '../data/entity';

interface RadioOption {
  value: string;
  label: string;
}

const interestAreas = [
  'Finanční plán',
  'Hypotéka a bydlení',
  'Investice',
  'Pojištění',
  'Penze',
  'Kontrola současných financí',
  'Jiné',
];

const contactPreferences: RadioOption[] = [
  { value: 'telefon', label: 'Telefon' },
  { value: 'email', label: 'E-mail' },
  { value: 'whatsapp', label: 'WhatsApp' },
];

// Dvě části — na mobilu každá na vlastním řádku (bez „·“). „Termín po předchozí
// domluvě“ zůstává jen u adresy (4. 10. 2026, vedle online rezervace navíc).
const bandDetails = [
  ['Osobně v Ostravě-⁠Porubě', 'Online přes Google Meet nebo WhatsApp'],
];
---

<section id="kontakt" class="kontakt" aria-labelledby="kontakt-nadpis">
  <div class="kontakt__inner">
    <div class="kontakt__intro">
      <h2 id="kontakt-nadpis" class="kontakt__heading kontakt__reveal-clip">Proberme, co potřebujete vyřešit.</h2>
      <p class="kontakt__text kontakt__reveal-up">
        Nezávazná konzultace trvá přibližně 30&nbsp;minut. Ozvu se&nbsp;vám osobně a&nbsp;domluvíme vhodný termín.
      </p>
    </div>

    <a class="kontakt__band kontakt__reveal-up" href="tel:+420775217721">
      <span class="kontakt__band-phone">
        <svg class="kontakt__band-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6.6 10.8c1.7 3.4 4.4 6.1 7.8 7.8l2.5-2.5c.3-.3.8-.4 1.2-.3 1.3.4 2.7.6 4.1.6.6 0 1 .4 1 1V21c0 .6-.4 1-1 1C10.6 22 2 13.4 2 3c0-.6.4-1 1-1h3.8c.6 0 1 .4 1 1 0 1.4.2 2.8.6 4.1.1.4 0 .9-.3 1.2L6.6 10.8Z"></path>
        </svg>
        <span class="kontakt__band-number">+420&nbsp;775&nbsp;217&nbsp;721</span>
      </span>
      <span class="kontakt__band-meta">
        <span class="kontakt__band-divider" aria-hidden="true"></span>
        <ul class="kontakt__band-details">
          {bandDetails.map((parts) => (
            <li>{parts.map((part, i) => (
              <>{i > 0 && <span class="kontakt__band-sep">{' · '}</span>}<span class="kontakt__band-part">{part}</span></>
            ))}</li>
          ))}
        </ul>
      </span>
    </a>

    <div class="kontakt__body">
      <div class="kontakt__side">
        <!--
          Online cesty v jednom bloku (4. 10. 2026): rezervace přes Google Kalendář
          (plán schůzek, hlídá obsazené časy — odkaz, ne vložené okno: rychlost,
          cookies, design) a WhatsApp jen na mobilu a tabletu (na počítači ho skoro
          nikdo nemá; ne plovoucí tlačítko, brief §24). Adresa je v patičce.
        -->
        <div class="kontakt__form-intro">
          <p class="kontakt__form-intro-label">Online</p>
          <div class="kontakt__online-links">
            <a class="kontakt__booking-link" href={BOOKING_URL} target="_blank" rel="noopener">Vybrat volný termín v&nbsp;kalendáři</a>
            <a class="kontakt__booking-link kontakt__whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">Napsat na&nbsp;WhatsApp</a>
          </div>
        </div>

        <div class="kontakt__form-intro">
          <p class="kontakt__form-intro-label">Nebo napište</p>
          <p class="kontakt__form-intro-text">Ozvu se&nbsp;do&nbsp;jednoho pracovního dne.</p>
        </div>
      </div>

      <form class="kontakt__form kontakt__reveal-up" method="post" action="/api/poptavka.php" novalidate>
        <p class="kontakt__form-errors" role="alert" hidden></p>

        <!-- Ochrana proti spamu: skryté pole vyplní jen robot; dobu vyplnění doplní JS. -->
        <div class="kontakt__hp" aria-hidden="true">
          <label for="kontakt-website">Nevyplňujte</label>
          <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="vyplneno-ms" value="" />

        <div class="kontakt__grid">
          <div class="kontakt__field">
            <label for="kontakt-jmeno">Jméno a&nbsp;příjmení <span class="kontakt__required" aria-hidden="true">*</span></label>
            <input id="kontakt-jmeno" name="jmeno" type="text" autocomplete="name" required aria-describedby="kontakt-jmeno-chyba" />
            <p class="kontakt__field-error" id="kontakt-jmeno-chyba" hidden></p>
          </div>

          <div class="kontakt__field">
            <label for="kontakt-telefon">Telefon <span class="kontakt__required" aria-hidden="true">*</span></label>
            <input id="kontakt-telefon" name="telefon" type="tel" autocomplete="tel" required aria-describedby="kontakt-telefon-chyba" />
            <p class="kontakt__field-error" id="kontakt-telefon-chyba" hidden></p>
          </div>

          <div class="kontakt__field">
            <label for="kontakt-email">E-mail <span class="kontakt__required" aria-hidden="true">*</span></label>
            <input id="kontakt-email" name="email" type="email" autocomplete="email" required aria-describedby="kontakt-email-chyba" />
            <p class="kontakt__field-error" id="kontakt-email-chyba" hidden></p>
          </div>

          <div class="kontakt__field">
            <label for="kontakt-oblast">Oblast zájmu <span class="kontakt__required" aria-hidden="true">*</span></label>
            <select id="kontakt-oblast" name="oblast" required aria-describedby="kontakt-oblast-chyba">
              <option value="" disabled selected>Vyberte</option>
              {interestAreas.map((area) => (
                <option value={area}>{area}</option>
              ))}
            </select>
            <p class="kontakt__field-error" id="kontakt-oblast-chyba" hidden></p>
          </div>
        </div>

        <fieldset class="kontakt__fieldset">
          <legend>Preferovaný způsob kontaktu <span class="kontakt__required" aria-hidden="true">*</span></legend>
          <div class="kontakt__radios" role="group" aria-describedby="kontakt-preferovany-chyba">
            {contactPreferences.map((option) => (
              <label class="kontakt__radio">
                <input type="radio" name="preferovany-kontakt" value={option.value} required />
                <span class="kontakt__radio-mark" aria-hidden="true"></span>
                {option.label}
              </label>
            ))}
          </div>
          <p class="kontakt__field-error" id="kontakt-preferovany-chyba" hidden></p>
        </fieldset>

        <div class="kontakt__field">
          <label for="kontakt-situace">Stručně popište svou situaci <span class="kontakt__optional">(nepovinné)</span></label>
          <textarea id="kontakt-situace" name="situace"></textarea>
        </div>

        <button class="kontakt__submit" type="submit">Odeslat poptávku</button>

        <p class="kontakt__status kontakt__status--success" role="status" hidden>Děkuji. Ozvu se&nbsp;vám co nejdříve.</p>
        <p class="kontakt__status kontakt__status--error" role="alert" hidden>
          Zprávu se&nbsp;nepodařilo odeslat. Zkuste to znovu nebo mi zavolejte na&nbsp;<a href="tel:+420775217721">+420&nbsp;775&nbsp;217&nbsp;721</a>.
        </p>

        <p class="kontakt__privacy">
          Údaje použiji pouze pro&nbsp;vyřízení vaší poptávky a&nbsp;navazující komunikaci. <a href="/zpracovani-osobnich-udaju">Zásady zpracování osobních údajů</a>
        </p>
      </form>
    </div>
  </div>

  <!-- Desktop 1400+ (kalibrace 1440). Vstup x=640 (= reálný výstup FaqSection), osa x=120, radius 28. -->
  <svg
    class="kontakt__route kontakt__route--desktop"
    viewBox="0 0 1440 1400"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-bend="true"
    data-entry="640"
    data-axis="120"
    data-radius="28"
    data-content-right="1320"
    data-dot-x="240"
  >
    <path
      class="kontakt__route-path"
      d="M 640 -20 V 290 A 28 28 0 0 1 612 318 H 148 A 28 28 0 0 0 120 346 V 1400"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="kontakt__dot" cx="120" cy="500" r="3.5" fill="var(--emerald)"></circle>
  </svg>

  <!-- Notebook 1200–1399 (kalibrace 1366). Vstup x=600, osa x=96, radius 28 — stejná logika jako desktop. -->
  <svg
    class="kontakt__route kontakt__route--laptop"
    viewBox="0 0 1366 1400"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-bend="true"
    data-entry="600"
    data-axis="96"
    data-radius="28"
    data-content-right="1270"
    data-dot-x="210"
  >
    <path
      class="kontakt__route-path"
      d="M 600 -20 V 250 A 28 28 0 0 1 572 278 H 124 A 28 28 0 0 0 96 306 V 1400"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="kontakt__dot" cx="96" cy="460" r="3.5" fill="var(--emerald)"></circle>
  </svg>

  <!--
    Tablet 768–1199 (kalibrace 834). Vstup x=40 (viz Odchylka 1) = vlastní osa
    (§8) — shoduje se s reálným výstupem FaqSection, žádný lom potřeba.
  -->
  <svg
    class="kontakt__route kontakt__route--tablet"
    viewBox="0 0 834 1600"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-bend="false"
    data-axis="40"
    data-content-right="794"
    data-dot-x="110"
  >
    <path
      class="kontakt__route-path"
      d="M 40 -20 V 1600"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <circle class="kontakt__dot" cx="40" cy="560" r="3.2" fill="var(--emerald)"></circle>
  </svg>

  <!--
    Mobil <768 (kalibrace 390). Vstup x=24 (viz Odchylka 1) = vlastní osa
    (§9) — stejný princip jako tablet výše.
  -->
  <svg
    class="kontakt__route kontakt__route--mobile"
    viewBox="0 0 390 1800"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-bend="false"
    data-axis="24"
    data-content-right="366"
    data-dot-x="46"
  >
    <path
      class="kontakt__route-path"
      d="M 24 -20 V 1800"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <circle class="kontakt__dot" cx="24" cy="480" r="3.2" fill="var(--emerald)"></circle>
  </svg>
</section>

<script>
  import { firstLineCenterY } from '../scripts/first-line';
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  // Na tabletu/desktopu (≥768px) se linka i texty vykreslují rovnou v hotovém
  // stavu, bez postupné animace — na zadání uživatele 24. 8. 2026.
  const disableAnimation = reduceMotion || window.matchMedia('(min-width: 768px)').matches;

  const section = document.querySelector('.kontakt');
  if (section) {
    const allSvgs = Array.from(section.querySelectorAll('.kontakt__route')) as SVGSVGElement[];
    const heading = section.querySelector('.kontakt__heading') as HTMLElement | null;
    const introLabel = section.querySelector('.kontakt__form-intro-label') as HTMLElement | null;
    const body = section.querySelector('.kontakt__body') as HTMLElement | null;

    const getActiveSvg = (): SVGSVGElement | undefined =>
      allSvgs.find((svg) => getComputedStyle(svg).display !== 'none');

    let currentSvg: SVGSVGElement | undefined;
    let path: SVGPathElement | null = null;
    let dot: SVGCircleElement | null = null;

    const bindActiveSvg = (svg: SVGSVGElement) => {
      currentSvg = svg;
      path = svg.querySelector('.kontakt__route-path');
      dot = svg.querySelector('.kontakt__dot');
    };

    // Getter funkce místo přímého čtení `path`/`dot` v pozdějších closures —
    // TS jinak u tří sdílených `let` proměnných napříč vnořenými funkcemi
    // (bindActiveSvg/syncRoute/measure/update) chybně zúží typ na `never`.
    const getPath = (): SVGPathElement | null => path;
    const getDot = (): SVGCircleElement | null => dot;

    /*
     * OPRAVA 1. 9. 2026 (na žádost uživatele — tečka měla sedět na
     * vodorovné „poličce" v mezeře mezi pásem a formulářovým blokem;
     * uživatel chtěl misto toho stejný vzor jako FaqSection.astro — tečka
     * přímo NA hlavní svislé lince, bez zářezu/odsazení). `cx` zůstává
     * statická (rovná se ose `path`u, viz `.kontakt__dot` v markupu), jen
     * `cy` se přepočítává na skutečnou svislou pozici popisku „Nebo napište"
     * (`.kontakt__form-intro-label`) — stejný princip jako `syncDotPosition`
     * v FaqSection.astro/ReviewsSection.astro. Lom trasy (desktop/notebook)
     * leží nad prvním řádkem nadpisu — dopočítán ze skutečné pozice
     * nadpisu, stejný princip jako `syncRoute` v CasesSection.astro.
     */
    const syncRoute = () => {
      const svg = getActiveSvg();
      if (!svg) return;
      if (svg !== currentSvg) bindActiveSvg(svg);
      if (!introLabel) return;

      const svgRect = svg.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      // Chybějící `svgRect.width === 0` je zdokumentovaná pojistka proti
      // přechodné `Infinity`/`NaN` (dělení nulou), když má SVG
      // na některých načteních dočasně nulovou šířku — viz SiteFooter.astro
      // (oprava 14. 9. 2026).
      if (svgRect.height === 0 || svgRect.width === 0 || viewBox.height === 0 || viewBox.width === 0) return;
      const scaleY = svgRect.height / viewBox.height;
      const scaleX = svgRect.width / viewBox.width;

      const dotY = (firstLineCenterY(introLabel) - svgRect.top) / scaleY;
      if (dot) dot.setAttribute('cy', String(dotY));

      if (svg.dataset.bend === 'true' && path && heading) {
        const entryX = parseFloat(svg.dataset.entry ?? '0');
        const axisX = parseFloat(svg.dataset.axis ?? '0');
        const r = parseFloat(svg.dataset.radius ?? '28');

        const headingRect = heading.getBoundingClientRect();
        const bendY = (headingRect.top - 56 - svgRect.top) / scaleY;

        const d =
          `M ${entryX} -20 V ${bendY - r} A ${r} ${r} 0 0 1 ${entryX - r} ${bendY} ` +
          `H ${axisX + r} A ${r} ${r} 0 0 0 ${axisX} ${bendY + r} V ${viewBox.height}`;
        path.setAttribute('d', d);
      }
    };

    const initialSvg = getActiveSvg();
    if (initialSvg) bindActiveSvg(initialSvg);
    syncRoute();
    window.addEventListener('resize', syncRoute);

    // `font-display: swap` (fonts.css) — viz CLAUDE.md „Konvence: kontinuální
    // linka, tečky a text“ bod 5.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(section);
      if (introLabel) resizeObserver.observe(introLabel);
      if (heading) resizeObserver.observe(heading);
      if (body) resizeObserver.observe(body);
    }

    if (!disableAnimation) {
      const clipEl = section.querySelector('.kontakt__reveal-clip');
      const fadeUpEls = Array.from(section.querySelectorAll('.kontakt__reveal-up'));

      if (clipEl) clipEl.classList.add('is-pending');
      fadeUpEls.forEach((el) => el.classList.add('is-pending'));

      let contentRevealed = false;
      const revealContent = () => {
        if (contentRevealed) return;
        contentRevealed = true;
        if (clipEl) {
          clipEl.classList.remove('is-pending');
          clipEl.classList.add('is-visible');
        }
        fadeUpEls.forEach((el) => {
          el.classList.remove('is-pending');
          el.classList.add('is-visible');
        });
      };

      let pathLength = 0;
      let dotThreshold = 1;

      const measure = () => {
        syncRoute();
        if (path) {
          pathLength = path.getTotalLength();
          path.style.strokeDasharray = String(pathLength);
        }
        if (path && dot && pathLength > 0) {
          const cx = parseFloat(dot.getAttribute('cx') ?? '0');
          const cy = parseFloat(dot.getAttribute('cy') ?? '0');
          let best = Infinity;
          const steps = 1500;
          for (let s = 0; s <= steps; s++) {
            const l = (pathLength * s) / steps;
            const pt = path.getPointAtLength(l);
            const d = Math.hypot(pt.x - cx, pt.y - cy);
            if (d < best) {
              best = d;
              dotThreshold = l / pathLength;
            }
          }
        }
      };
      measure();
      const initialPath = getPath();
      if (initialPath) initialPath.style.strokeDashoffset = String(pathLength);
      const initialDot = getDot();
      if (initialDot) initialDot.classList.add('is-pending');

      let ticking = false;
      const update = () => {
        measure();
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, rect.height > 0 ? (vh - rect.top) / rect.height : 0));

        const currentPath = getPath();
        if (currentPath) {
          currentPath.style.strokeDashoffset = String(pathLength * (1 - progress));
        }
        const currentDot = getDot();
        if (currentDot && progress >= dotThreshold) {
          currentDot.classList.remove('is-pending');
          currentDot.classList.add('is-visible');
        }

        if (rect.top < vh) revealContent();

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }

    // --- Formulář: validace při odeslání / opuštění pole, odeslání na /api/poptavka.php ---
    const form = section.querySelector('.kontakt__form') as HTMLFormElement | null;
    if (form) {
      const submitButton = form.querySelector('.kontakt__submit') as HTMLButtonElement | null;
      const elapsedInput = form.elements.namedItem('vyplneno-ms') as HTMLInputElement | null;
      // Doba vyplnění se měří od první interakce s formulářem — server odmítne
      // odeslání rychlejší než 3 s (typicky robot). Když interakci nezachytíme
      // (např. automatické vyplnění bez fokusu), měří se od načtení stránky,
      // aby člověk nikdy nedostal chybu jen kvůli měření.
      let startedAt: number | null = null;
      const markStart = () => {
        if (startedAt === null) startedAt = performance.now();
      };
      ['focusin', 'input', 'change'].forEach((type) => form.addEventListener(type, markStart));
      const errorSummary = form.querySelector('.kontakt__form-errors') as HTMLElement | null;
      const successStatus = form.querySelector('.kontakt__status--success') as HTMLElement | null;
      const errorStatus = form.querySelector('.kontakt__status--error') as HTMLElement | null;
      const radiosGroup = form.querySelector('.kontakt__radios') as HTMLElement | null;
      const radiosError = form.querySelector('#kontakt-preferovany-chyba') as HTMLElement | null;

      const fieldMessages: Record<string, string> = {
        jmeno: 'Vyplňte prosím jméno a příjmení.',
        telefon: 'Vyplňte prosím telefonní číslo.',
        email: 'Vyplňte prosím platnou e-mailovou adresu.',
        oblast: 'Vyberte prosím oblast zájmu.',
      };

      const setFieldError = (input: HTMLInputElement | HTMLSelectElement, show: boolean) => {
        const errorEl = document.getElementById(`${input.id}-chyba`);
        if (!errorEl) return;
        if (show) {
          errorEl.textContent = fieldMessages[input.name] ?? 'Toto pole je povinné.';
          errorEl.hidden = false;
          input.setAttribute('aria-invalid', 'true');
        } else {
          errorEl.textContent = '';
          errorEl.hidden = true;
          input.removeAttribute('aria-invalid');
        }
      };

      const validateField = (input: HTMLInputElement | HTMLSelectElement) => {
        const valid = input.checkValidity();
        setFieldError(input, !valid);
        return valid;
      };

      const namedFields = ['jmeno', 'telefon', 'email', 'oblast'] as const;
      namedFields.forEach((name) => {
        const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        if (input) input.addEventListener('blur', () => validateField(input));
      });

      const validateRadios = () => {
        const radios = Array.from(form.querySelectorAll('input[name="preferovany-kontakt"]')) as HTMLInputElement[];
        const checked = radios.some((r) => r.checked);
        if (radiosError) {
          radiosError.textContent = checked ? '' : 'Vyberte prosím preferovaný způsob kontaktu.';
          radiosError.hidden = checked;
        }
        radiosGroup?.setAttribute('aria-invalid', checked ? 'false' : 'true');
        return checked;
      };
      form.querySelectorAll('input[name="preferovany-kontakt"]').forEach((r) => {
        r.addEventListener('blur', () => {
          if (document.activeElement?.getAttribute('name') !== 'preferovany-kontakt') validateRadios();
        });
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitButton?.disabled) return;
        if (successStatus) successStatus.hidden = true;
        if (errorStatus) errorStatus.hidden = true;

        let allValid = true;
        namedFields.forEach((name) => {
          const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
          if (input && !validateField(input)) allValid = false;
        });
        if (!validateRadios()) allValid = false;

        if (!allValid) {
          if (errorSummary) {
            errorSummary.textContent = 'Zkontrolujte prosím zvýrazněná pole ve formuláři.';
            errorSummary.hidden = false;
          }
          return;
        }

        if (errorSummary) {
          errorSummary.textContent = '';
          errorSummary.hidden = true;
        }

        if (elapsedInput) {
          elapsedInput.value = String(Math.round(performance.now() - (startedAt ?? 0)));
        }

        if (submitButton) submitButton.disabled = true;
        form.setAttribute('aria-busy', 'true');
        let sent = false;
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          });
          const result = (await response.json().catch(() => null)) as { ok?: boolean } | null;
          sent = response.ok && result?.ok === true;
        } catch {
          sent = false;
        } finally {
          if (submitButton) submitButton.disabled = false;
          form.removeAttribute('aria-busy');
        }

        if (sent) {
          if (successStatus) successStatus.hidden = false;
          form.reset();
          startedAt = null;
        } else if (errorStatus) {
          errorStatus.hidden = false;
        }
      });
    }
  }
</script>

