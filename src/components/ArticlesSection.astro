---
/**
 * Sekce „Odborný obsah“ — Police článků (varianta 13c).
 * Zdroj: úkol pro Claude Code „sekce Odborný obsah (Police článků)“, §1–§14.
 * Navazuje na AboutSection.astro — trasa vstupuje ZLEVA (první sekce na webu
 * s tímto směrem vstupu, viz §2 zadání).
 *
 * ODCHYLKA (§12 technických požadavků, stejný typ rozporu jako u AboutSection
 * — viz ODCHYLKA 2 v AboutSection.astro):
 * §6–§9 dávají prvkům pevné `top` v px (odvozené z fixního odhadu výšky
 * sekce „Rám"), ale §12 ve stejném dokumentu to výslovně zakazuje — výška
 * sekce má plynout z obsahu. Novější/konkrétnější pravidlo (§12) má přednost.
 * Nadpis, úvod, výčet témat, police článků a akce jsou proto v normálním
 * toku (gap/margin), ne na position:absolute. Čísla z §6–§9 posloužila jen
 * jako reference pro odhad proporcí a poměru mezer, ne jako doslovné
 * souřadnice. Trasa (dvojitý lom → police → lom) se stejně jako
 * v AboutSection dopočítává v JS ze skutečné vykreslené pozice police
 * (spodní hrana `.articles__list`, na které stojí obsah článků) —
 * viz `syncRoute` níže.
 *
 * Vstupní x trasy (svislice zleva) na všech čtyřech šířkách odpovídá
 * skutečnému výstupu AboutSection.astro (změřeno getPointAtLength na
 * `.about__route-path` při 390/768/834/1024/1180/1200/1280/1366/1399/1400/
 * 1440/1920 px) — desktop 120/1440, notebook 96/1366, tablet 40/834,
 * mobil 24/390. Zadání §6–§9 uvádí stejná čísla, žádný přepočet tedy
 * nebyl potřeba (viz tabulka švu v závěrečném hlášení).
 *
 * `hypotekaOstravaHref` ověřeno 24. 8. 2026 (kontrola všech odkazů na webu) —
 * https://www.hypotekaostrava.cz/ je reálný, funkční web projektu, na kterém
 * Patrik Gajdadzis vystupuje jako ředitel/hypoteční specialista.
 */
import { articleHref, getPublishedArticles, readingMinutes } from '../data/articles';
import { czechNbsp } from '../lib/rehype-czech-nbsp.mjs';

interface Article {
  category: string;
  title: string | null;
  excerpt: string | null;
  href: string | null;
  minutes?: number;
  lineWidths: number[];
}

const placeholders: Article[] = [
  { category: 'Hypotéky a bydlení', title: null, excerpt: null, href: null, lineWidths: [100, 100, 62] },
  { category: 'Finanční plánování', title: null, excerpt: null, href: null, lineWidths: [100, 56] },
  { category: 'Investice', title: null, excerpt: null, href: null, lineWidths: [100, 100, 48] },
];

// Tři nejnovější zveřejněné články (src/content/clanky, 5. 10. 2026);
// prázdná místa doplní zástupné řádky, dokud nejsou tři.
const allPublished = await getPublishedArticles();
const published: Article[] = allPublished.slice(0, 3).map((a) => ({
  category: czechNbsp(a.data.category),
  title: czechNbsp(a.data.title),
  excerpt: czechNbsp(a.data.description),
  href: articleHref(a),
  minutes: readingMinutes(a),
  lineWidths: [],
}));
const articles: Article[] = [...published, ...placeholders.slice(published.length)];

// Témata vpravo nahoře: jen ta, ke kterým už je článek, jako odkaz na
// /clanky s předvybraným filtrem. Bez článků celá taxonomie jako prostý text.
const allTopics = ['Hypotéky a bydlení', 'Finanční plánování', 'Investice', 'Pojištění', 'Penze'];
const plain = (s: string) => s.replace(/\u00A0/g, ' ');
const usedTopics = allTopics.filter((t) => allPublished.some((a) => plain(a.data.category) === plain(t)));
const topics = (usedTopics.length ? usedTopics : allTopics).map((t) => ({
  label: czechNbsp(t),
  href: usedTopics.length ? `/clanky?tema=${encodeURIComponent(plain(t))}#clanky-vypis` : null,
}));

const hypotekaOstravaHref = 'https://www.hypotekaostrava.cz/';
---

<section class="articles" aria-labelledby="clanky">
  <div class="articles__inner">
    <div class="articles__top">
      <div class="articles__intro">
        <h2 id="clanky" class="articles__heading articles__reveal-clip">Finance srozumitelně.</h2>
        <p class="articles__lead articles__reveal-up">
          Praktické články, zkušenosti a&nbsp;odpovědi na&nbsp;otázky, které klienti skutečně řeší.
        </p>
      </div>

      <div class="articles__topics articles__reveal-up">
        <p class="articles__topics-label">Témata</p>
        <ul class="articles__topics-list">
          {topics.map((topic) => (
            <li>{topic.href ? <a class="articles__topic-link" href={topic.href}>{topic.label}</a> : topic.label}</li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="articles__list">
      {articles.map((article, i) => (
        <li class={`articles__item articles__reveal-item${i === 2 ? ' articles__item--off-shelf' : ''}`}>
          <p class="articles__category">
            {article.category}
            {article.minutes && <span class="articles__minutes">&nbsp;· {article.minutes}&nbsp;min čtení</span>}
          </p>
          {article.title ? (
            <>
              <h3 class="articles__title"><a href={article.href ?? '#'}>{article.title}</a></h3>
              {article.excerpt && <p class="articles__excerpt">{article.excerpt}</p>}
            </>
          ) : (
            <>
              <div class="articles__placeholder" aria-hidden="true">
                <span class="articles__placeholder-label">Titulek - placeholder</span>
                {article.lineWidths.map((w) => (
                  <span class="articles__placeholder-line" style={`width:${w}%`}></span>
                ))}
              </div>
              <span class="sr-only">Článek bude doplněn</span>
            </>
          )}
        </li>
      ))}
    </ul>

    <div class="articles__actions">
      <!-- „Všechny články“ zpět od 5. 10. 2026 (zveřejněné první články). -->
      <a class="articles__cta" href="/clanky">Všechny články</a>
      <span class="articles__divider" aria-hidden="true"></span>
      <p class="articles__external">
        <span class="articles__external-lead">Hypoteční články také na&nbsp;</span><a class="articles__external-link" href={hypotekaOstravaHref} target="_blank" rel="noopener noreferrer">Hypotéka Ostrava
          <svg class="articles__external-icon" viewBox="0 0 11 11" aria-hidden="true" focusable="false">
            <path
              d="M4 2H2a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7M6 1h4v4M10 1 5 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <span class="sr-only">(externí web)</span>
        </a>
      </p>
    </div>
  </div>

  <!-- Desktop 1400+ (kalibrace 1440). Vstup x=120 (= reálný výstup AboutSection), výstup x=1300, radius 28. -->
  <svg
    class="articles__route articles__route--desktop"
    viewBox="0 0 1440 900"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-shelf="true"
    data-entry="120"
    data-exit="1300"
    data-radius="28"
    data-gap="22"
  >
    <path
      class="articles__route-path"
      d="M 120 -20 V 552 A 28 28 0 0 0 148 580 H 1272 A 28 28 0 0 1 1300 608 V 900"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="articles__dot articles__dot--lead" cx="240" cy="580" r="3.5" fill="var(--emerald)"></circle>
    <circle class="articles__dot" cx="720" cy="580" r="2.6" fill="var(--line)" fill-opacity=".5"></circle>
    <circle class="articles__dot" cx="1060" cy="580" r="2.6" fill="var(--line)" fill-opacity=".5"></circle>
  </svg>

  <!-- Notebook 1200–1399 (kalibrace 1366). Vstup x=96, výstup x=1250, radius 28. -->
  <svg
    class="articles__route articles__route--laptop"
    viewBox="0 0 1366 900"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-shelf="true"
    data-entry="96"
    data-exit="1250"
    data-radius="28"
    data-gap="22"
  >
    <path
      class="articles__route-path"
      d="M 96 -20 V 524 A 28 28 0 0 0 124 552 H 1222 A 28 28 0 0 1 1250 580 V 900"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="articles__dot articles__dot--lead" cx="216" cy="552" r="3.5" fill="var(--emerald)"></circle>
    <circle class="articles__dot" cx="660" cy="552" r="2.6" fill="var(--line)" fill-opacity=".5"></circle>
    <circle class="articles__dot" cx="980" cy="552" r="2.6" fill="var(--line)" fill-opacity=".5"></circle>
  </svg>

  <!--
    Tablet 768–1199 (kalibrace 834). Vstup x=40, police y dopočtená v JS,
    radius 22, po polici svislice dolů (výstup x=794) a zářez pro třetí
    (mimo policii stojící) článek na x=750 — viz §8 zadání.
  -->
  <svg
    class="articles__route articles__route--tablet"
    viewBox="0 0 834 1000"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-shelf="true"
    data-off-shelf="false"
    data-entry="40"
    data-exit="794"
    data-radius="22"
    data-notch-x="750"
    data-gap="22"
  >
    <path
      class="articles__route-path"
      d="M 40 -20 V 448 A 22 22 0 0 0 62 470 H 772 A 22 22 0 0 1 794 492 V 640"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <!--
      Odbočka pro „mimopoliční" třetí článek (data-off-shelf, zářez x=750)
      zrušena 28. 9. 2026: třetí článek ve skutečném rozvržení stojí na polici
      ve 2. sloupci pod druhým, linka police vede pod ním — odbočka pak mířila
      zespodu nahoru a tečka končila uprostřed článku přes jeho řádky.
      Třetí tečka zůstává (JS podle ní odhaluje třetí článek); sedí na polici
      ve stejném sloupci jako druhá — skrytá (visibility), jinak by se dvě
      poloprůhledné tečky přes sebe sečetly do tmavší (4. 10. 2026).
    -->
    <circle class="articles__dot articles__dot--lead" cx="140" cy="470" r="3.2" fill="var(--emerald)"></circle>
    <circle class="articles__dot" cx="470" cy="470" r="2.4" fill="var(--line)" fill-opacity=".5"></circle>
    <circle class="articles__dot" cx="470" cy="470" r="2.4" fill="var(--line)" fill-opacity=".5" visibility="hidden"></circle>
  </svg>

  <!--
    Mobil <768 (kalibrace 390). Police neexistuje — svislice u levého okraje
    (x=24, shodné s AboutSection) se třemi zářezy vedoucími k tečkám vedle
    textu jednotlivých článků (stejný princip jako ConnectionsSection mobil).
  -->
  <svg
    class="articles__route articles__route--mobile"
    viewBox="0 0 390 1200"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-shelf="false"
    data-axis="24"
    data-gap="22"
  >
    <path
      class="articles__route-path"
      d="M 24 -20 V 1200"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <path
      class="articles__route-notches"
      d="M 24 448 H 46 M 24 646 H 46 M 24 828 H 46"
      fill="none"
      stroke="var(--line)"
      stroke-opacity=".18"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <circle class="articles__dot articles__dot--lead" cx="46" cy="448" r="3.2" fill="var(--emerald)"></circle>
    <circle class="articles__dot" cx="46" cy="646" r="2.4" fill="var(--line)" fill-opacity=".5"></circle>
    <circle class="articles__dot" cx="46" cy="828" r="2.4" fill="var(--line)" fill-opacity=".5"></circle>
  </svg>
</section>

<script>
  import { firstLineCenterY } from '../scripts/first-line';
  // Bez animací nástupu textu a linky — na přání uživatele 29. 9. 2026 se vše
  // zobrazí hned (stejná cesta jako prefers-reduced-motion).
  const reduceMotion = true;
  // Na tabletu/desktopu (≥768px) se linka i texty vykreslují rovnou v hotovém
  // stavu, bez postupné animace — na zadání uživatele 24. 8. 2026.
  const disableAnimation = reduceMotion || window.matchMedia('(min-width: 768px)').matches;

  const section = document.querySelector('.articles');
  if (section) {
    const allSvgs = Array.from(section.querySelectorAll('.articles__route')) as SVGSVGElement[];
    const list = section.querySelector('.articles__list') as HTMLElement | null;
    const items = list ? (Array.from(list.querySelectorAll('.articles__item')) as HTMLElement[]) : [];
    const thirdItem = section.querySelector('.articles__item--off-shelf') as HTMLElement | null;
    const heading = section.querySelector('.articles__reveal-clip');
    const fadeUpEls = Array.from(section.querySelectorAll('.articles__reveal-up'));
    const itemEls = Array.from(section.querySelectorAll('.articles__reveal-item')) as HTMLElement[];

    /*
     * Aktivní SVG (podle breakpointu) se muselo dřív dohledávat jednou při
     * načtení stránky — jenže při resize PŘES hranici stupně (např. z desktopu
     * na tablet bez reloadu) by pak trasa/tečky patřily skryté SVG a nová
     * viditelná SVG by zůstala na statických počátečních souřadnicích
     * (nikdy nesynchronizovaná JS výpočtem). `getActiveSvg()` se proto volá
     * znovu při každém resize/ResizeObserver callbacku, ne jen jednou.
     */
    const getActiveSvg = (): SVGSVGElement | undefined =>
      allSvgs.find((svg) => getComputedStyle(svg).display !== 'none');

    let currentSvg: SVGSVGElement | undefined;
    let path: SVGPathElement | null = null;
    let notchPath: SVGPathElement | null = null;
    let continuePath: SVGPathElement | null = null;
    let dots: SVGCircleElement[] = [];
    let paths: SVGPathElement[] = [];
    const lengths = new Map<SVGPathElement, number>();
    // Prahy (0–1 progresu čtení trasy), při kterých se má odhalit článek u dané tečky.
    const dotThresholds: number[] = [];

    const bindActiveSvg = (svg: SVGSVGElement) => {
      currentSvg = svg;
      path = svg.querySelector('.articles__route-path');
      notchPath = svg.querySelector('.articles__route-notch');
      continuePath = svg.querySelector('.articles__route-continue');
      dots = Array.from(svg.querySelectorAll('.articles__dot'));
      paths = [path, notchPath, continuePath].filter(Boolean) as SVGPathElement[];
      lengths.clear();
      if (!disableAnimation) {
        dots.forEach((dot) => {
          dot.classList.remove('is-visible');
          dot.classList.add('is-pending');
        });
        itemEls.forEach((el) => {
          el.classList.remove('is-visible');
          el.classList.add('is-pending');
        });
      }
    };

    /*
     * Police (i mimopoliční třetí položka na tabletu) je content-driven —
     * výška sekce plyne z obsahu (viz ODCHYLKA výše), takže reálná pozice
     * spodní hrany `.articles__list` (na které "stojí" obsah článků) není
     * známá předem. Stejný princip jako `syncRoute` v AboutSection.astro.
     */
    const syncRoute = () => {
      const svg = getActiveSvg();
      if (!svg) return;
      if (svg !== currentSvg) bindActiveSvg(svg);
      if (!path || !list) return;

      const svgRect = svg.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      // Chybějící `svgRect.width === 0` je zdokumentovaná pojistka proti
      // přechodné `Infinity`/`NaN` (dělení nulou), když má SVG
      // na některých načteních dočasně nulovou šířku — viz SiteFooter.astro
      // (oprava 14. 9. 2026).
      if (svgRect.height === 0 || svgRect.width === 0 || viewBox.height === 0 || viewBox.width === 0) return;
      const scaleX = svgRect.width / viewBox.width;
      const scaleY = svgRect.height / viewBox.height;

      const gapPx = parseFloat(svg.dataset.gap ?? '22');

      if (svg.dataset.shelf !== 'true') {
        // Mobil: zářez z osy k tečce 14 px před textem, svisle na středu
        // popisku kategorie (CLAUDE.md „text vedle tečky na svislém úseku“).
        // Dřív tečka seděla přímo na ose ~13 px pod popiskem a zářezy zůstaly
        // na pevných souřadnicích mimo tečky (28. 9. 2026).
        const axisX = parseFloat(svg.dataset.axis ?? '0');
        const notches = svg.querySelector('.articles__route-notches');
        let notchD = '';
        items.forEach((item, i) => {
          const dot = dots[i];
          if (!dot) return;
          const label = (item.querySelector('.articles__category') ?? item) as HTMLElement;
          const r = label.getBoundingClientRect();
          // Bez posunu z animace odhalení (translateY na položce) — jinak by
          // tečka zůstala o posun níž, když se přepočet trefí před odhalením.
          const t = new DOMMatrixReadOnly(getComputedStyle(item).transform === 'none' ? undefined : getComputedStyle(item).transform);
          const y = (firstLineCenterY(label) - t.m42 - svgRect.top) / scaleY;
          const x = (r.left - t.m41 - 14 - svgRect.left) / scaleX;
          dot.setAttribute('cx', String(x));
          dot.setAttribute('cy', String(y));
          notchD += `M ${axisX} ${y} H ${x} `;
        });
        if (notches) notches.setAttribute('d', notchD.trim());
        return;
      }

      const entryX = parseFloat(svg.dataset.entry ?? '0');
      const exitX = parseFloat(svg.dataset.exit ?? '0');
      const r = parseFloat(svg.dataset.radius ?? '28');
      const hasOffShelf = svg.dataset.offShelf === 'true';
      const shelfItems = hasOffShelf ? items.slice(0, 2) : items;

      const listRect = list.getBoundingClientRect();
      const shelfY = (listRect.bottom + gapPx - svgRect.top) / scaleY;

      let tailY = viewBox.height;
      if (hasOffShelf && thirdItem) {
        const tr = thirdItem.getBoundingClientRect();
        tailY = (tr.top + gapPx - svgRect.top) / scaleY;
      }

      const d = `M ${entryX} -20 V ${shelfY - r} A ${r} ${r} 0 0 0 ${entryX + r} ${shelfY} H ${exitX - r} A ${r} ${r} 0 0 1 ${exitX} ${shelfY + r} V ${tailY}`;
      path.setAttribute('d', d);

      shelfItems.forEach((item, i) => {
        const dot = dots[i];
        if (!dot) return;
        const ir = item.getBoundingClientRect();
        const x = (ir.left - svgRect.left) / scaleX;
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(shelfY));
      });

      if (hasOffShelf && thirdItem) {
        const notchX = parseFloat(svg.dataset.notchX ?? String(exitX - 44));
        if (notchPath) notchPath.setAttribute('d', `M ${exitX} ${tailY} H ${notchX}`);
        if (continuePath) continuePath.setAttribute('d', `M ${exitX} ${tailY} V ${viewBox.height}`);
        const dot3 = dots[2];
        if (dot3) {
          dot3.setAttribute('cx', String(notchX));
          dot3.setAttribute('cy', String(tailY));
        }
      }
    };

    const initialSvg = getActiveSvg();
    if (initialSvg) bindActiveSvg(initialSvg);
    syncRoute();
    window.addEventListener('resize', syncRoute);

    // `font-display: swap` (fonts.css) — viz CLAUDE.md „Konvence: kontinuální
    // linka, tečky a text“ bod 5.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => syncRoute());
    }

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => syncRoute());
      resizeObserver.observe(section);
      if (list) resizeObserver.observe(list);
    }

    if (!disableAnimation) {
      if (heading) heading.classList.add('is-pending');
      fadeUpEls.forEach((el) => el.classList.add('is-pending'));
      itemEls.forEach((el) => el.classList.add('is-pending'));

      let contentRevealed = false;
      const revealContent = () => {
        if (contentRevealed) return;
        contentRevealed = true;
        if (heading) {
          heading.classList.remove('is-pending');
          heading.classList.add('is-visible');
        }
        fadeUpEls.forEach((el) => {
          el.classList.remove('is-pending');
          el.classList.add('is-visible');
        });
      };

      const measure = () => {
        syncRoute();
        paths.forEach((p) => {
          const length = p.getTotalLength();
          lengths.set(p, length);
          p.style.strokeDasharray = String(length);
        });
        const mainLength = path ? lengths.get(path) ?? 0 : 0;
        dots.forEach((dot, i) => {
          if (!path || mainLength === 0) return;
          const cx = parseFloat(dot.getAttribute('cx') ?? '0');
          const cy = parseFloat(dot.getAttribute('cy') ?? '0');
          let best = Infinity;
          let bestT = 1;
          const steps = 800;
          for (let s = 0; s <= steps; s++) {
            const l = (mainLength * s) / steps;
            const pt = path.getPointAtLength(l);
            const d = Math.hypot(pt.x - cx, pt.y - cy);
            if (d < best) {
              best = d;
              bestT = l / mainLength;
            }
          }
          dotThresholds[i] = bestT;
        });
      };
      measure();
      paths.forEach((p) => (p.style.strokeDashoffset = String(lengths.get(p) ?? 0)));

      let ticking = false;
      const update = () => {
        measure();
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, rect.height > 0 ? (vh - rect.top) / rect.height : 0));

        paths.forEach((p) => {
          const length = lengths.get(p) ?? 0;
          p.style.strokeDashoffset = String(length * (1 - progress));
        });

        dots.forEach((dot, i) => {
          if (progress >= (dotThresholds[i] ?? 1)) {
            dot.classList.remove('is-pending');
            dot.classList.add('is-visible');
            const item = itemEls[i];
            if (item) {
              item.classList.remove('is-pending');
              item.classList.add('is-visible');
            }
          }
        });

        if (rect.top < vh) revealContent();

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
