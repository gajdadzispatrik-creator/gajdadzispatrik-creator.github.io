</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Na tabletu/desktopu (≥768px) se linka i texty vykreslují rovnou v hotovém
  // stavu, bez postupné animace — na zadání uživatele 24. 8. 2026.
  const disableAnimation = reduceMotion || window.matchMedia('(min-width: 768px)').matches;

  const section = document.querySelector('.connections');
  if (section && !disableAnimation) {
    const paths = Array.from(section.querySelectorAll('.connections__route-path'));
    const lengths = new Map();
    paths.forEach((path) => {
      const length = (path as SVGPathElement).getTotalLength();
      lengths.set(path, length);
      (path as SVGPathElement).style.strokeDasharray = String(length);
      (path as SVGPathElement).style.strokeDashoffset = String(length);
    });

    let ticking = false;
    const updateProgress = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      // Progress reaches 1 exactly when the section's bottom edge reaches the
      // viewport's bottom edge — the natural end of scroll for a section that
      // sits last on the page (it can never scroll fully past the viewport).
      const progress = Math.min(1, Math.max(0, rect.height > 0 ? (vh - rect.top) / rect.height : 0));

      paths.forEach((path) => {
        const length = lengths.get(path) ?? 0;
        (path as SVGPathElement).style.strokeDashoffset = String(length * (1 - progress));
      });

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateProgress();

    const revealTargets = section.querySelectorAll('.connections__area, .connections__heading-line');
    revealTargets.forEach((el) => el.classList.add('is-pending'));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('is-pending');
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.4 }
    );

    revealTargets.forEach((el) => revealObserver.observe(el));
  }
</script>

<style>
  .connections {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    height: 900px;
    /*
     * Šířka viewBoxu aktuální trasy (SVG i kotvy oblastí jsou definované ve
     * stejném souřadném prostoru). Trasa se kreslí přes width:100% — roztahuje
     * se plynule s viewportem stejně jako navazující linka v Hero sekci nad
     * touto (HeroLine.astro), takže na sebe automaticky navazují na jakékoli
     * šířce. Text oblastí proto musí sledovat STEJNÉ procentuální roztažení
     * (viz --vb v .connections__area), ne pevné px — jinak by se při jiné než
     * kalibrační šířce rozjel od tečky i od navazující linky nad sekcí.
     */
    --vb: 390;
    /*
     * Tečky na trase (<circle>) leží ve stejném neuniformně roztahovaném SVG
     * jako trasa sama (preserveAspectRatio="none" — šířka roste s viewportem
     * přes width:100%, výška sekce je na každém stupni pevná a přesně sedí
     * s výškou viewBoxu, takže svislé měřítko je vždy 1). Vodorovné měřítko
     * ale s viewportem roste, takže by z kruhu mimo kalibrační šířku
     * (390/834/1366/1440) vyšla elipsa. --dot-fix dopočítá násobek, kterým
     * se tečka doškáluje ve vodorovném směru zpět na kruh.
     */
    --dot-fix: calc(var(--vb) * 1px / 100vw);
  }

  .connections__route circle {
    transform: scaleX(var(--dot-fix));
    transform-box: fill-box;
    transform-origin: center;
  }

  .connections__heading {
    position: absolute;
    left: 70px;
    right: 24px;
    top: 86px;
    margin: 0;
    font-weight: 700;
    font-size: 34px;
    line-height: 1.06;
    letter-spacing: -.04em;
    color: var(--navy);
  }

  .connections__text {
    position: absolute;
    left: 70px;
    right: 24px;
    /* 172 = konec nadpisu (86 + 2 řádky @ 34px/1.06 ≈ 72px) + 14px — konvence
       „mezera nadpis → úvodní text“ v CLAUDE.md, sjednoceno na 14px napříč
       webem (1. 9. 2026) stejně jako CasesSection/ArticlesSection/
       ContactSection/podstránky; původní 222px byl reziduum z doby před
       touto konvencí, 3–6× větší než ustálená hodnota. */
    top: 172px;
    margin: 0;
    font-weight: 500;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text);
  }

  .connections__areas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Jedna kotva (--x, --y) na oblast = zdroj pravdy pro tečku i text.
   * Text nikdy nemá vlastní absolutní pozici — odvozuje se z kotvy přes
   * obecný offset (--ox, --oy, --tx, --ty), který se liší jen podle úseku
   * trasy (vodorovný/svislý) a šířky, ne podle jednotlivé oblasti:
   * - vodorovný úsek: text POD tečkou, zarovnaný na ni vlevo (stejná
   *   konvence jako ProcessSection.astro/RouterSection.astro — žádné
   *   translateX(-50%), levá hrana textu = x tečky),
   * - svislý úsek: text VPRAVO od tečky, svisle na ni vycentrovaný.
   */
  .connections__area {
    position: absolute;
    left: calc((var(--x) + var(--ox)) * 100% / var(--vb));
    top: calc((var(--y) + var(--oy)) * 1px);
    transform: translate(var(--tx), var(--ty)) translateY(var(--reveal-y, 0px));
    margin: 0;
    letter-spacing: -.025em;
    /* Mobil: text vždy vpravo od kotvy, vertikálně vycentrovaný (§4). */
    text-align: left;
    --ox: 12;
    --oy: 0;
    --tx: 0;
    --ty: -50%;
  }

  /*
   * Mobil (base) — kotvy §4 (shodné s tečkami). Všech pět pozic má stejnou
   * typografickou váhu. --x posunuto z 62 na 46 (oprava 14. 9. 2026) — osa
   * trasy na mobilu se sjednotila na x=24 (viz komentář u trasy níže), takže
   * zářez/tečka teď končí na 46 (24+22), ne na 62 (40+22).
   */
  .connections__area--pos-1 {
    --x: 46;
    --y: 400;
    font-weight: 600;
    font-size: 22px;
    color: var(--navy-ink);
  }

  .connections__area--pos-2 {
    --x: 46;
    --y: 484;
    font-weight: 600;
    font-size: 22px;
    color: var(--navy-ink);
  }

  .connections__area--pos-3 {
    --x: 46;
    --y: 568;
    font-weight: 600;
    font-size: 22px;
    color: var(--navy-ink);
  }

  .connections__area--pos-4 {
    --x: 46;
    --y: 652;
    font-weight: 600;
    font-size: 22px;
    color: var(--navy-ink);
  }

  .connections__area--pos-5 {
    --x: 46;
    --y: 736;
    font-weight: 600;
    font-size: 22px;
    color: var(--navy-ink);
  }

  .connections__end-label {
    position: absolute;
    left: 54px;
    top: 824px;
    margin: 0;
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Mobil: uvnitř smyčky trasy zarovnaný doprava — 30 px před její pravou
     svislicí (x=378/390), zrcadlově k 30 px od osy vlevo (28. 9. 2026). */
  @media (max-width: 767px) {
    .connections__end-label {
      left: auto;
      right: calc(100% - 378 * 100% / 390 + 30px);
    }
  }

  .connections__route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .connections__route--tablet,
  .connections__route--laptop,
  .connections__route--desktop {
    display: none;
  }

  /* --- Pohyb --- */

  .connections__heading-line {
    display: inline-block;
  }

  .connections__heading-line.is-pending {
    opacity: 0;
    transform: translateY(12px);
  }

  .connections__heading-line.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  .connections__heading-line:nth-child(1).is-visible {
    transition-delay: 0ms;
  }

  /*
   * Odhalení (pending/visible) nesmí přepsat kotvící transform výše — skládá
   * se s ním přes samostatnou custom property, jinak by po dokončení reveal
   * animace text spadl zpět na neposunutou pozici (mimo tečku).
   */
  .connections__area.is-pending {
    opacity: 0;
    --reveal-y: 12px;
  }

  .connections__area.is-visible {
    opacity: 1;
    --reveal-y: 0px;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .connections__area,
    .connections__heading-line {
      opacity: 1;
      transform: none;
    }
  }

  /* ============ Tablet: 768–1199 ============ */
  @media (min-width: 768px) {
    .connections {
      height: 900px;
      --vb: 834;
    }

    .connections__heading {
      left: 40px;
      right: auto;
      top: 556px;
      width: 520px;
      font-size: 44px;
      line-height: 1.06;
    }

    .connections__text {
      left: 40px;
      right: auto;
      /* 663 = konec nadpisu (556 + 2 řádky @ 44px/1.06 ≈ 93px) + 14px. */
      top: 663px;
      width: 440px;
      font-size: 17px;
    }

    /* Popisek u svislého konce trasy (x=794) jako na notebooku/desktopu —
       vpravo od čáry na tabletu není místo (jen ~40 px k okraji), proto
       vlevo od ní, zarovnaný doprava 24 px před čárou (28. 9. 2026). */
    .connections__end-label {
      display: block;
      left: auto;
      right: calc(100% - 794 * 100% / var(--vb) + 24px);
      top: 700px;
      font-size: 12px;
    }

    /* Tablet: h → text zarovnaný pod tečku vlevo (x+0, y+12, bez translateX — stejná konvence jako ProcessSection.astro/RouterSection.astro); v → vpravo od tečky, svisle vycentrovaný (x+16, translateY(-50%)). */
    .connections__area--pos-1 {
      --x: 140;
      --y: 192;
      --ox: 0;
      --oy: 12;
      --tx: 0;
      --ty: 0;
      text-align: left;
      font-size: 19px;
    }

    .connections__area--pos-2 {
      --x: 432;
      --y: 286;
      --ox: 16;
      --oy: 0;
      --ty: -50%;
      font-size: 19px;
    }

    .connections__area--pos-3 {
      --x: 432;
      --y: 392;
      --ox: 16;
      --oy: 0;
      --ty: -50%;
      font-size: 19px;
    }

    .connections__area--pos-4 {
      --x: 560;
      --y: 474;
      --ox: 0;
      --oy: 12;
      --tx: 0;
      --ty: 0;
      text-align: left;
      font-size: 19px;
    }

    .connections__area--pos-5 {
      --x: 700;
      --y: 474;
      --ox: 0;
      --oy: 12;
      --tx: 0;
      --ty: 0;
      text-align: left;
      font-size: 19px;
    }

    .connections__route--mobile {
      display: none;
    }

    .connections__route--tablet {
      display: block;
    }
  }

  /* ============ Notebook: 1200–1399 ============ */
  @media (min-width: 1200px) {
    .connections {
      height: 940px;
      --vb: 1366;
    }

    .connections__heading {
      left: 96px;
      top: 508px;
      width: 587px;
      font-size: 56px;
      line-height: 1.05;
      letter-spacing: -.045em;
    }

    .connections__text {
      left: 96px;
      /* 640 = konec nadpisu (508 + 2 řádky @ 56px/1.05 ≈ 118px) + 14px. */
      top: 640px;
      width: 411px;
      font-size: 18px;
      text-wrap: pretty;
    }

    /*
     * Kotva vedle svislého úseku trasy na x=1250 notebook / 1300 desktop
     * (stejný --vb procentuální systém jako u teček oblastí, aby popisek při
