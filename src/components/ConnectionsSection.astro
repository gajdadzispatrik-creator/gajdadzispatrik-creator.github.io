---
/**
 * S2 — „Neřeším produkty. Řeším souvislosti.“
 * Zdroj: design-exploration/financial-architecture/section-connections/claude-code-task-s2.md
 * + Revize 1 (nové pořadí/texty oblastí, sdílený gradient linky s hero).
 * Souřadnice odpovídají variantě 5b. Notebook (1366) je proporčně odvozen
 * z desktopové kompozice (§7 zadání) — přesné souřadnice pro 1366 nejsou
 * v zadání dané, u ostatních tří šířek jsou exaktní.
 *
 * Pozice na trase (1 = nejvýš, 5 = nejníž) nesou souřadnice a typografickou
 * váhu — dominance jde s pozicí (pos-1), ne se slovem. Text v jednotlivých
 * pozicích se mění nezávisle na --x/--y.
 */
const areas = [
  { name: 'Rezerva', pos: 'pos-1' },
  { name: 'Ochrana', pos: 'pos-2' },
  { name: 'Bydlení', pos: 'pos-3' },
  { name: 'Investice', pos: 'pos-4' },
  { name: 'Penze', pos: 'pos-5' },
];
---

