  >
    <!-- Smyčka kolem „Jeden plán" (28. 9. 2026, přání uživatele): z osy
         doprava skoro ke kraji (x=378 jako svislice hero linky), obtočí
         popisek (824–839) a zpět doleva na osu x=24, kde navazuje
         RouterSection. Poloměry 18 jako hero linka na mobilu. -->
    <path
      class="connections__route-path"
      d="M24,0 V772 A18,18 0 0 0 42,790 H360 A18,18 0 0 1 378,808 V854 A18,18 0 0 1 360,872 H42 A18,18 0 0 0 24,890 V900"
