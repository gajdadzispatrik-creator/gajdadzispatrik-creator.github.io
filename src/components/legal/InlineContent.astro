---
/**
 * Vykreslí pole `InlineSegment` (viz src/data/legal/types.ts) — obyčejný
 * text, zvýrazněný `[DOPLNIT: …]` blok, nebo odkaz (interní/externí).
 * Jediné místo, které tohle umí — bloky v LegalBlock.astro ho volají pro
 * odstavce, položky seznamu, buňky tabulky i řádky bloku identifikace.
 */
import type { InlineSegment } from '../../data/legal/types';

interface Props {
  segments: InlineSegment[];
}

const { segments } = Astro.props;
---

{
  segments.map((seg) =>
    typeof seg === 'string' ? (
      seg
    ) : 'doplnit' in seg ? (
      <mark class="legal-mark">[DOPLNIT: {seg.doplnit}]</mark>
    ) : seg.external ? (
      <a href={seg.href} class="legal-link" target="_blank" rel="noopener noreferrer">
        {seg.label}
        <span class="sr-only"> (externí web)</span>
      </a>
    ) : (
      <a href={seg.href} class="legal-link">
        {seg.label}
      </a>
    )
  )
}

<style>
  .legal-mark {
    background: var(--doplnit-bg);
    color: var(--doplnit-text);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
  }

  .legal-link {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--emerald);
    text-underline-offset: 3px;
    transition: color var(--duration-hover) var(--ease-out);
  }

  .legal-link:hover {
    color: var(--emerald-hover);
  }
</style>
