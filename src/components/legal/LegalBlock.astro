---
/**
 * Vykreslí jeden `Block` (viz src/data/legal/types.ts) uvnitř sekce právní
 * stránky. `id` na `<h3>` navazuje na obecné pravidlo hierarchie nadpisů
 * (LegalLayout.astro sekce už mají `<h2 id>` — podsekce zatím žádná ze tří
 * stránek nepoužívá, ale typ je připravený pro budoucí obsah).
 *
 * Tabulka nese explicitní `role="table"/"row"/"columnheader"/"rowheader"/
 * "cell"` vedle skutečných `<table>`/`<tr>`/`<th>`/`<td>` — na mobilu se
 * řádek CSS překlopí na `display: flex` (viz §10 zadání, „překlop na
 * dvojice pod sebou“), což ve většině prohlížečů odstraní implicitní ARIA
 * sémantiku tabulky odvozenou z `display: table-*`. Explicitní role ji
 * drží i po překlopení — sémantika tabulky tak zůstává na všech šířkách,
 * přesně jak zadání vyžaduje.
 */
import type { Block } from '../../data/legal/types';
import InlineContent from './InlineContent.astro';

interface Props {
  block: Block;
}

const { block } = Astro.props;
---

{
  block.type === 'lawyer-review' && (
    <div class="legal-review">
      <p class="legal-review__label">Ke&nbsp;kontrole právníkem</p>
      <p class="legal-p">
        <InlineContent segments={block.content} />
      </p>
    </div>
  )
}

{
  block.type === 'p' && (
    <p class="legal-p">
      <InlineContent segments={block.content} />
    </p>
  )
}

{block.type === 'h3' && <h3 id={block.id} class="legal-h3">{block.text}</h3>}

{
  block.type === 'list' && (
    <ul class="legal-list">
      {block.items.map((item) => (
        <li>
          <InlineContent segments={item} />
        </li>
      ))}
    </ul>
  )
}

{
  block.type === 'identity' && (
    <address class="legal-identity">
      <p class="legal-identity__label">{block.label}</p>
      {block.lines.map((line) => (
        <p class="legal-identity__line">
          <InlineContent segments={line} />
        </p>
      ))}
    </address>
  )
}

{
  block.type === 'table' && (
    <table class="legal-table" role="table">
      <caption class="sr-only">{block.caption}</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">
            {block.columns[0]}
          </th>
          <th scope="col" role="columnheader">
            {block.columns[1]}
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {block.rows.map(([label, value]) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              <InlineContent segments={label} />
            </th>
            <td role="cell">
              <InlineContent segments={value} />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}

{
  block.type === 'cookie-settings-button' && (
    <button type="button" class="legal-cookie-btn" data-open-cookie-settings>
      {block.label}
    </button>
  )
}

<style>
  .legal-p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text);
  }

  .legal-review {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 18px;
    border-left: 2px solid var(--emerald);
  }

  .legal-review__label {
    margin: 0;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--emerald);
  }

  .legal-review .legal-p {
    margin: 0;
  }

  .legal-h3 {
    margin: 0;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    color: var(--navy);
  }

  .legal-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legal-list li {
    position: relative;
    padding-left: 22px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text);
  }

  .legal-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .8em;
    width: 10px;
    height: 1px;
    background: var(--line);
    opacity: .4;
  }

  .legal-identity {
    font-style: normal;
    padding: 18px 20px;
    border-left: 2px solid var(--emerald);
    background: rgba(30, 122, 92, .045);
  }

  .legal-identity__label {
    margin: 0 0 8px;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--emerald);
  }

  .legal-identity__line {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .legal-table {
    width: 100%;
    border-collapse: collapse;
  }

  .legal-table caption {
    text-align: left;
  }

  .legal-table th,
  .legal-table td {
    text-align: left;
    vertical-align: top;
    padding: 16px 16px 16px 0;
  }

  .legal-table thead th {
    padding-top: 0;
    padding-bottom: 12px;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-quiet);
    border-bottom: 1px solid rgba(27, 74, 138, .14);
  }

  .legal-table tbody tr {
    border-bottom: 1px solid rgba(27, 74, 138, .14);
  }

  .legal-table tbody tr:last-child {
    border-bottom: none;
  }

  .legal-table tbody th {
    width: 200px;
    font-weight: 600;
    color: var(--navy);
  }

  .legal-table tbody td {
    font-size: 16px;
    color: var(--text-muted);
  }

  .legal-cookie-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 28px;
    border-radius: var(--radius-btn);
    background: var(--emerald);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    transition: background-color var(--duration-hover) var(--ease-out);
  }

  .legal-cookie-btn:hover {
    background: var(--emerald-hover);
  }

  /* Mobil (base): tabulka se překlopí na dvojice řádek pod sebou — table-*
     display přechází na flex, proto explicitní role v markupu výše drží
     sémantiku (viz komentář nahoře souboru). */
  .legal-table thead {
    display: none;
  }

  .legal-table tbody tr {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
  }

  .legal-table th,
  .legal-table td {
    padding: 0;
  }

  .legal-table tbody th {
    width: auto;
    font-size: 16px;
  }

  .legal-table tbody td {
    font-size: 16px;
  }

  /* ============ Tablet a výš: 768px+ ============ */
  @media (min-width: 768px) {
    .legal-identity {
      padding: 22px 26px;
    }

    .legal-identity__label {
      font-size: 11.5px;
    }

    .legal-identity__line {
      font-size: 16px;
    }

    .legal-table thead {
      display: table-header-group;
    }

    .legal-table tbody tr {
      display: table-row;
      padding: 0;
    }

    .legal-table th,
    .legal-table td {
      padding: 16px 16px 16px 0;
    }

    .legal-table tbody th {
      width: 200px;
      font-size: 16px;
    }

    .legal-table tbody td {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-cookie-btn {
      transition: none;
    }
  }
</style>
