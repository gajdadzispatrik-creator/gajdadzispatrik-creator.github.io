# Kanonická adresa webu: https://patrikgajdadzis.cz (bez www, bez koncového
# lomítka kromě domovské stránky) — shodně s canonical, sitemap.xml, og:url
# a JSON-LD (astro.config.mjs `site`, src/data/entity.ts).
#
# Wedos: tenhle soubor leží v /www/domains/patrikgajdadzis.cz/ a hostingová
# /www/.htaccess sem požadavky interně přepisuje — %{REQUEST_URI} proto může
# obsahovat už přepsanou interní cestu (/domains/...). Cestu pro externí
# přesměrování bereme vždy z %{THE_REQUEST} (původní řádek požadavku
# „GET /cesta?dotaz HTTP/1.1“) a cílového hosta píšeme napevno, takže
# nemůže vzniknout zdvojené „www.“ ani prosáklá interní cesta.
# Pořadí pravidel zajišťuje, že každá varianta dojde na cíl jedním 301.

Options -Indexes
DirectoryIndex index.html
# Astro generuje /sluzby/index.html, ale canonical je /sluzby (bez lomítka) —
# bez tohohle by Apache /sluzby sám přesměroval na /sluzby/.
DirectorySlash Off

RewriteEngine On

# 1) /cokoli/index.html → /cokoli (duplicitní adresa obsahu)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^?\s]*?)/?index\.html(\?[^\s]*)?\s [NC]
RewriteRule ^ https://patrikgajdadzis.cz%1%2 [R=301,L,NE,QSD]

# 2) Koncové lomítko → bez lomítka (domovská stránka „/“ výjimkou)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^?\s]*?[^/?\s])/+(\?[^\s]*)?\s
RewriteRule ^ https://patrikgajdadzis.cz%1%2 [R=301,L,NE,QSD]

# 3) www → bez www (a zároveň na HTTPS)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S+)\s
RewriteRule ^ https://patrikgajdadzis.cz%1 [R=301,L,NE,QSD]

# 4) HTTP → HTTPS (X-Forwarded-Proto pro případ SSL ukončeného na proxy,
#    jinak by vznikla smyčka)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S+)\s
RewriteRule ^ https://patrikgajdadzis.cz%1 [R=301,L,NE,QSD]

# 5) Čisté URL bez lomítka → obsah složky (/sluzby → /sluzby/index.html).
#    %{REQUEST_FILENAME} je skutečná cesta na disku, na přepsání URL nezávisí.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Neexistující adresa → stránka 404 (src/pages/404.astro), se stavovým
# kódem 404, ne 200 — jinak by vyhledávače indexovaly prázdné adresy.
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

# Bezpečnostní hlavičky. CSP záměrně neomezuje skripty (web má inline
# skripty a později přibude Google Analytics) — řeší jen vložení do cizího
# rámu, podvržení <base> a pluginy. HSTS bez includeSubDomains/preload.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Cache: soubory v /_astro/ mají v názvu otisk obsahu, takže je lze cachovat
# natrvalo; fonty otisk nemají (30 dní); HTML se vždy ověří, aby se změny
# projevily hned. Regex bez ^ — na Wedosu může REQUEST_URI začínat /domains/….
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.woff2$#">
    Header set Cache-Control "public, max-age=2592000"
  </ElseIf>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>

# Manifest webu (ikony pro Android) — Apache ho jinak nemusí znát.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>
